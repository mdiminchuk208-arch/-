data-nscript="beforeInteractive">(function(){
  var EVENT = "watchman:bootstrap";
  function done(state){
    window.__watchman_bootstrap__ = state;
    try { window.dispatchEvent(new Event(EVENT)); } catch(e) {}
  }
  var s = document.createElement('script');
  s.async = true;
  s.setAttribute('data-name', 'watchman-sdk');
  s.src = "https://watchman-sdk.gotoda.co/watchman.umd.js";
  s.onload = function(){
    var w = window.__watchman__;
    if (!w || typeof w.config !== 'function') { done({ status: 'no-config' }); return; }
    var uid = null;
    try { uid = window.sessionStorage.getItem("mexc_session_uid") || null; } catch(e) {}
    try {
      w.config({
        appid: "mxc-web-community",
        uid: uid,
        env: "prod",
        customMeasures: [{"type":"dctTime","measureName":"__watchman&&_$$dctTime__"}]
      });
      done({ status: 'ready' });
    } catch(e) {
      done({ status: 'config-error', reason: String((e && e.message) || e) });
    }
  };
  s.onerror = function(){ done({ status: 'load-failed' }); };
  document.head.appendChild(s);
})();</script><link rel="preload" href="https://static.mocortech.com/mxc-web-community/_next/static/css/316872109d65e577.css" as="style"/><link rel="stylesheet" href="https://static.mocortech.com/mxc-web-community/_next/static/css/316872109d65e577.css" data-n-g=""/><link rel="preload" href="https://static.mocortech.com/mxc-web-community/_next/static/css/3ec39a8fcb4e2bad.css" as="style"/><link rel="stylesheet" href="https://static.mocortech.com/mxc-web-community/_next/static/css/3ec39a8fcb4e2bad.css"/><noscript data-n-css=""></noscript><script defer="" nomodule="" src="https://static.mocortech.com/mxc-web-community/_next/static/chunks/polyfills-c67a75d1b6f99dc8.js"></script><script defer="" src="https://static.mocortech.com/mxc-web-community/_next/static/chunks/856943-c432efa4e574cd68.js"></script><script defer="" src="https://static.mocortech.com/mxc-web-community/_next/static/chunks/44628-ec74f457ff3b50b5.js"></script><script defer="" src="https://static.mocortech.com/mxc-web-community/_next/static/chunks/232730-d7bd89a1f1aef928.js"></script><script defer="" src="https://static.mocortech.com/mxc-web-community/_next/static/chunks/677055-d0192634925cdc1a.js"></script><script defer="" src="https://static.mocortech.com/mxc-web-community/_next/static/chunks/632583-8b24134e94642319.js"></script><script defer="" src="https://static.mocortech.com/mxc-web-community/_next/static/chunks/147530-37e9e4fc7f76519d.js"></script><script defer="" src="https://static.mocortech.com/mxc-web-community/_next/static/chunks/7573.d32ad4e554c8c5d3.js"></script><script defer="" src="https://static.mocortech.com/mxc-web-community/_next/static/chunks/32283-ad086f4a4f79dff9.js"></script><script defer="" src="https://static.mocortech.com/mxc-web-community/_next/static/chunks/927815-cfd539f4e24aa8fd.js"></script><script defer="" src="https://static.mocortech.com/mxc-web-community/_next/static/chunks/188460-ee84fa1b544163a0.js"></script><script defer="" src="https://static.mocortech.com/mxc-web-com