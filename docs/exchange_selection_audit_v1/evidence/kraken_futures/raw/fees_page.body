dule][upnykidcuh38hx2e5buez][field_content":"$10M+","fee_schedule][-bsa_aifuajanqcyepey6][field_content":"0.000%","fee_schedule][h2vtnto6pck6vxlspojtp][field_content":"0.055%","fee_schedule][v-pccjbkdqwv4li5zuko9][field_content":"$50M+","fee_schedule][j4kqvtlkha-cz-ei_pzue][field_content":"-0.003%","fee_schedule][g1ku68gjgm3cmw3ojaq8q][field_content":"0.050%","fee_schedule][s0jsoh_ielvtwzvervvil][field_content":"$100M+","fee_schedule][0_vqj2m8ltgl-fift85sp][field_content":"-0.005%","fee_schedule][tggcn2hvy0x4tng5nqlp1][field_content":"0.045%","fee_schedule][w5i-rmoowiebw1dpd-uxv][field_content":"$250M+","fee_schedule][uwv587rj5mhobeuh_dovl][field_content":"-0.007%","fee_schedule][koogy9u3ka0ufplnx-aup][field_content":"0.035%","fee_schedule][wqpwg8xqtpeatcwu7ifrz][field_content":"$1B+","fee_schedule][riugswixvwxe2m-6lhcs7][field_content":"-0.010%","fee_schedule][qbxdmbjweoqvn3aqgol5i][field_content":"0.025%","fee_schedule][2fbc64531bb7][field_search_placeholder":"Search","fee_schedule][7dc8461f7f91][field_body":"\u003cp>\u003csup>30-day spot crypto and/or spot xStocks volume determines your current tier.\u003c/sup>\u003c/p>","fee_schedule][13be188888b5][field_title":"Pro xStocks","fee_schedule][5a69c4d6927f][field_link][title":"Get started with Kraken Pro","fee_schedule][0181001fa4ac][field_body":"\u003cul>\n\t\u003cli>Fees are charged on a per-trade basis.\u003c/li>\n\t\u003cli>Fees are calculated as a percentage of the trade&#39;s quote currency volume (by default). Certain pairs allow the fee to be calculated based on the trade&#39;s base currency, which can be specified when ordering using the Fee Currency option.\u003c/li>\n\t\u003cli>User fee volume levels are measured using the equivalent market value of the listed &quot;Fee Volume Currency&quot; at the time of the trade. Note that this currency may be different from the pair&#39;s base or quote currency.\u003c/li>\n\t\u003cli>User fee volume levels are measured and applicable for trades occurring in the last 30 days only.\u003c/li>\n\t\u003cli>Discount tiers are assessed after every trade, so you get your discounts when you earn them.\u003c/li>\n\t\u003cli>Our volume-based discounts are designed to be attainable so investors of all sizes are rewarded for their trades.\u003c/li>\n\t\u003cli>If you&rsquo;re not a frequent trader but you do big volume, consider our OTC service for a more cost-effective, personal experience.\u003c/li>\n\u003c/ul>\n","fee_schedule][0181001fa4ac][field_heading":"Kraken Pro fee considerations","fee_schedule][666c460b9726][field_body":"\u003cp>Almost all of our cryptocurrency pairs follow the same fee schedule, which incentivizes market makers to increase liquidity - meaning it&rsquo;s easier for you to execute trades at the price you want.\u003c/p>\n\n\u003cp>&nbsp;\u003c/p>\n","fee_schedule][666c460b9726][field_heading":"Low fees for both makers and takers","fee_schedule][0bd8194733c1][field_navigation_cta][title":"Sign up","fee_schedule][0bd8194733c1][field_read_time_additional_text":"min","fee_schedule][0bd8194733c1][field_subtitle":"Fees as low as 0%","fee_schedule][0bd8194733c1][field_title":"Fee Schedule","fee_schedule][0bd8194733c1][field_tldr_title":"Key takeaways","fee_schedule][2b28f048bfdb][field_app_banner_cta][title":"Get the App","fee_schedule][2b28f048bfdb][field_app_banner_review_count":"(3k)","fee_schedule][2b28f048bfdb][field_app_banner_title":"Kraken","template_navigation_disclaimer_uk][4667acc8-3a08-410d-8705-f56a3f3215ce][field_category":"global","template_navigation_disclaimer_uk][0984d42737d6][field_content":"\u003cp>Don’t invest unless you’re prepared to lose all the money you invest. This is a high-risk investment and you should not expect to be protected if something goes wrong. \u003ca href=\"https://www.kraken.com/legal/uk/disclaimer\" rel=\"noopener noreferrer nofollow\" target=\"_blank\">Take 2 minutes to learn more\u003c/a>.\u003c/p>\n"}}}},"mode":{"cookie":null,"qs":null},"dehydratedState":{"mutations":[],"queri