ontent of Column 2","field_content":"$100M+"},{"_key":"eb524aa65d47","cell_description":"Content of Column 3","field_content":"25m"},{"_key":"4982f00c33d3","cell_description":"Content of Column 4","field_content":"\u003cp>0.0 %\u003c/p>"},{"_key":"d79549c95e74","cell_description":"Content of Column 5","field_content":"\u003cp>0.08 %\u003c/p>"}],"row_description":"Row :: Pro 2"},{"_key":"4f6a3e3b2be3","field_cells":[{"_key":"39a8dba628aa","cell_description":"Content of Column 1","field_content":"Pro 3"},{"_key":"d5f5c5601a0b","cell_description":"Content of Column 2","field_content":"$250M+"},{"_key":"c26bf5829030","cell_description":"Content of Column 3","field_content":"50m"},{"_key":"58e66bd152a4","cell_description":"Content of Column 4","field_content":"\u003cp>0.0 %\u003c/p>"},{"_key":"c186324186b4","cell_description":"Content of Column 5","field_content":"\u003cp>0.07 %\u003c/p>"}],"row_description":"Row :: Pro 3"},{"_key":"25557256eaf7","field_cells":[{"_key":"83028a6019b4","cell_description":"Content of Column 1","field_content":"Pro 4"},{"_key":"e7b7debf26f1","cell_description":"Content of Column 2","field_content":"$400M+"},{"_key":"d6182ff74ba3","cell_description":"Content of Column 3","field_content":"80m"},{"_key":"9fafe3f2c8dc","cell_description":"Content of Column 4","field_content":"\u003cp>0.0 %\u003c/p>"},{"_key":"a8f84b835f1d","cell_description":"Content of Column 5","field_content":"\u003cp>0.06 %\u003c/p>"}],"row_description":"Row :: Pro 4"},{"_key":"e494c7ebb483","field_cells":[{"_key":"09376c0b69fe","cell_description":"Content of Column 1","field_content":"Pro 5"},{"_key":"92c631779f65","cell_description":"Content of Column 2","field_content":"$500M+"},{"_key":"4475c3d38f67","cell_description":"Content of Column 3","field_content":"100m"},{"_key":"e9d94645bb8d","cell_description":"Content of Column 4","field_content":"\u003cp>0.0 %\u003c/p>"},{"_key":"65152cf3714c","cell_description":"Content of Column 5","field_content":"\u003cp>0.05 %\u003c/p>"}],"row_description":"Row :: Pro 5"}],"field_search_placeholder":"Search","table_expanded_table":false,"table_mobile_style":"classic"}],"field_id":"cross-platform-fee-tiers","field_title":"Cross-platform Fee Tiers"},{"_key":"05afa3e595af","_type":"paragraphAccordionItem","field_children":[{"_key":"5e8f6e1c3b34","_type":"paragraphArticleBodyLc","field_body":"\u003cp>Kraken uses a maker-taker fee tier system with volume incentives based on your spot volume and your assets on platform (AoP) in the past 30 days.*\u003c/p>\u003cp>Our fee tiers are built to reward traders regardless of which product of the Kraken platform they use, thus driving maximum liquidity.\u003c/p>\u003cp>\u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://support.kraken.com/articles/cross-platform-fee-tier-changes\">\u003cem>More information about cross-platform fee tiers\u003c/em>\u003c/a>\u003c/p>\u003cp>Certain services, including Telegram chat trading, use request-for-quote pricing. For these trades, the quoted price is all-inclusive and already reflects Kraken's spread and fees.\u003c/p>\u003cp>\u003csup>*Volume generated with Instant Buy does not count towards your 30 day volume incentives.\u003c/sup>\u003c/p>\u003cp>\u003cspan>Scroll table to the right to view percentages\u003c/span>\u003c/p>"},{"_key":"d2dc585d7816","_type":"paragraphArticleBodyTable","field_rows":[{"_key":"0c9a1a91671c","field_cells":[{"_key":"ddf6bd598e1f","cell_description":"Content of Column 1","field_content":"Tier"},{"_key":"545edb2a3f1f","cell_description":"Content of Column 2","field_content":"\u003cp>Spot 30-Day Vol (USD) \u003cstrong>OR\u003c/strong>\u003c/p>"},{"_key":"87c66e16e0ad","cell_description":"Content of Column 3","field_content":"AoP (USD)"},{"_key":"5e969c429614","cell_description":"Content of Column 4","field_content":"\u003cp>Maker (%)\u003c/p>"},{"_key":"3c30aff9d884","cell_description":"Content of Column 5","field_content":"\u003cp>Taker (%)\u003c/p>"}],"row_description"