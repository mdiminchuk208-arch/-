iption":"Content of Column 2","field_content":"0.00%"},{"_key":"w0QhKS8wLjyUm381D7SwL","cell_description":"Content of Column 3","field_content":"0.01%"}],"row_description":"Row :: $10,000,000 +"},{"_key":"Wb0JXYDrIA_H9hj9CS_MT","field_cells":[{"_key":"9Hdp0WtUhVat_8U-aLEKm","cell_description":"Content of Column 1","field_content":"$100,000,000 +"},{"_key":"60tIeF9PI7W2t_MdgP6eZ","cell_description":"Content of Column 2","field_content":"0.00%"},{"_key":"zeL6kMqZAkL3xMwPSHMCk","cell_description":"Content of Column 3","field_content":"0.001%"}],"row_description":"Row :: $100,000,000 +"}],"table_expanded_table":false,"table_mobile_style":"classic"},{"_key":"50bcd2b6ab95","_type":"paragraphArticleBodyLc","field_body":"\u003cp>\u003csup>*Fee schedule volume-based discounts are based on crypto trading volume only. Making purchases using the Buy Crypto widget, Kraken app as well as trading stablecoin and FX pairs on our order books does not contribute to the fee schedule 30-day volume.&nbsp;&nbsp; &nbsp;\u003c/sup>\u003c/p>\n"}],"field_id":"stablecoin-pegged-token-fx-pairs","field_is_expanded":false,"field_title":"Stablecoin, Pegged Token & FX Pairs"},{"_key":"6a01f3b3e6a1","_type":"paragraphAccordionItem","field_children":[{"_key":"d23e340e65e3","_type":"paragraphArticleBodyLc","field_body":"\u003cp>The USDG fee schedule aims to make USDG a compelling and efficient stablecoin within the Kraken ecosystem &mdash; promoting deep liquidity, tighter spreads, and minimal trading costs.\u003c/p>\n"},{"_key":"ae680c179682","_type":"paragraphArticleBodyLc","field_body":"\u003cp>\u003csup>This fee schedule applies only to pairs where USDG is the base currency (for example: USDG/USD)\u003c/sup>\u003c/p>\n"},{"_key":"1075e428bcc3","_type":"paragraphArticleBodyTable","field_rows":[{"_key":"ee3fa8c6ca1d","_type":"paragraphArticleBodyTableRow","field_cells":[{"_key":"754a43aa03e0","_type":"paragraphArticleBodyTableCell","cell_description":"30- Day Volume (USD)","field_content":"\u003cp>30- Day Volume (USD)\u003c/p>\n"},{"_key":"e7265d7e8cf3","_type":"paragraphArticleBodyTableCell","cell_description":"Maker","field_content":"\u003cp>Maker\u003c/p>\n"},{"_key":"98af6946e2e2","_type":"paragraphArticleBodyTableCell","cell_description":"Taker","field_content":"\u003cp>Taker\u003c/p>\n"}],"row_description":"Row :: add here"},{"_key":"0f7e5602382d","field_cells":[{"_key":"48dc6542f8da","cell_description":"Content of Column 1","field_content":"$0 +"},{"_key":"3f4927502b37","cell_description":"Content of Column 2","field_content":"\u003cp>0.0%\u003c/p>\n"},{"_key":"9f77ec9b3fea","cell_description":"Content of Column 3","field_content":"\u003cp>0.01%\u003c/p>\n"}],"row_description":"Row :: $0 +"},{"_key":"ff55069d0a3e","field_cells":[{"_key":"e86f1400873c","cell_description":"Content of Column 1","field_content":"$100,000,000 + **"},{"_key":"0b675f29bb3e","cell_description":"Content of Column 2","field_content":"\u003cp>0.0%\u003c/p>\n"},{"_key":"820ff1887497","cell_description":"Content of Column 3","field_content":"\u003cp>0.001%\u003c/p>\n"}],"row_description":"Row :: $100,000,000 + **"}],"table_expanded_table":false,"table_mobile_style":"classic"}],"field_id":"usdg-pairs","field_is_expanded":false,"field_title":"USDG Pairs"},{"_key":"36aa0e0c3cce","_type":"paragraphAccordionItem","field_children":[{"_key":"cda5e14c6952","_type":"paragraphArticleBodyLc","field_body":"\u003cp>The USDe schedule applies to orderbook USDe pairs which will be part of this 0 fee campaign until the 30th June, 2026\u003c/p>"},{"_key":"25b9bc2d1b36","_type":"paragraphArticleBodyTable","field_rows":[{"_key":"f508d6d272b3","_type":"paragraphArticleBodyTableRow","field_cells":[{"_key":"6389e42a2ac6","_type":"paragraphArticleBodyTableCell","cell_description":"30- Day Volume (USD)","field_content":"\u003cp>30- Day Volume (USD)\u003c/p>\n"},{"_key":"d5c7abbbbaca","_type":"paragraphArticleBodyTableCell","cell_description":"Maker","field_content":"\u003cp>Maker\u003c/p>\n"},{"_key":"adb28ef1483d","_type":"paragraphArticleBodyTableCell","cell_description":"Taker","field_content":"\u003cp>Taker\u003c/p>\n"}],"row_description":"Row :: add here"},{"_key":"0d30a81406e1","field_cells":[{"_key":"a30712fb63aa","cell_description":"Content of Column 1","field_content":"$0 +"},{"_key":"7c1f6c2aec3b","cell_description":"Content of Column 2","field_content":"\u003cp>0.0%\u003c/p>\n"},{"_key":"f97de8b84005","cell_description":"Content of Column 3","field_content":"\u003cp>0.0%\u003c/p>"}],"row_description":"Row :: $0 +"}],"table_expanded_table":false,"table_mobile_style":"classic"}],"field_id":"usde-pairs","field_is_expanded":false,"field_title":"USDe Pairs"},{"_key":"a397d4943fe3","_type":"paragraphAccordionItem","field_children":[{"_key":"33428e2a7230","_type":"paragraphArticleBodyLc","field_body":"\u003cp>All margin fees are applied in addition to volume based trading fees at the opening and closing of margin positions.\u003c/p>"},{"_key":"faa1387cc1ff","_type":"paragraphArticleBodyLc","field_body":"\u003cp>Margin rates fluctuate based on market conditions, but your rollover rate will be locked in at the time of order execution. This rate will be displayed on the order form as you fill out your order.\u003c/p>\u003cp>Eligible clients are able to maintain open spot positions on margin for an unlimited duration, as long as margin requirements are met.\u003c/p>\u003cp>• \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://support.kraken.com/hc/en-us/articles/227876608-Margin-trading-pairs-and-their-maximum-leverage\">See leverage available for all pairs.\u003c/a>\u003cbr>• \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://support.kraken.com/hc/en-us/articles/209238787-Margin-borrow-limits\">See margin allowance limits.\u003c/a>\u003cbr>• \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://support.kraken.com/hc/en-us/articles/206161568-What-are-the-fees-opening-and-rollover-for-trading-using-margin-\">See margin trading fees\u003c/a>\u003c/p>\u003cp>Additionally,Kraken may liquidate positions automatically at the current index price of the market, immediately closing the position and realizing any associated losses. \u003cbr>\u003c/p>\u003cp>This process includes a 2% liquidation fee as a way to manage risk associated with that market and prevent further losses due to slippage. As these orders do not go through the order book, they do not incur the standard trading fee.\u003c/p>"},{"_key":"9f03e766397d","_type":"paragraphArticleBodyTable","field_rows":[{"_key":"b8150d8a5d90","_type":"paragraphArticleBodyTableRow","field_cells":[{"_key":"e95931810526","_type":"paragraphArticleBodyTableCell","cell_description":"Currency","field_content":"\u003cp>Currency\u003c/p>\n"},{"_key":"bbbcb4c17e3a","_type":"paragraphArticleBodyTableCell","cell_description":"Opening fee","field_content":"\u003cp>Opening fee\u003c/p>\n"},{"_key":"96ae2db12cbd","_type":"paragraphArticleBodyTableCell","cell_description":"Rollover fee","field_content":"\u003cp>Rollover fee\u003c/p>\n"}],"row_description":"Row :: add here"},{"_key":"WBKh593OQ9Qg3GFaB7tZk","field_cells":[{"_key":"e-to__SzlEJjsMqu-h-og","cell_description":"Content of Column 1","field_content":"Ox (ZRX)"},{"_key":"NWXUiiu-w_EhPMWMbPbIm","cell_description":"Content of Column 2","field_content":"0.02% - 0.04%"},{"_key":"5pgC7se8l17zhb1Imhq7f","cell_description":"Content of Column 3","field_content":"0.02% - 0.04% per 4 hours"}],"row_description":"Row :: Ox (ZRX)"},{"_key":"L_GwNarEDWPwZlM90In6r","field_cells":[{"_key":"dbob7uYAVhSqrQVO98XoN","cell_description":"Content of Column 1","field_content":"Aave (AAVE)"},{"_key":"mJBO2aNe-yZcYJ9xMvJmD","cell_description":"Content of Column 2","field_content":"0.02% - 0.04%"},{"_key":"df-AeqOCF0KCG_pSgy0jb","cell_description":"Content of Column 3","field_content":"0.02% - 0.04% per 4 hours"}],"row_description":"Row :: Aave (AAVE)"},{"_key":"5ae3wgBDz7DYQw5HJ0aw2","field_cells":[