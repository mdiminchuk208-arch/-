_US"],"contactPoint":{"@type":"ContactPoint","url":"https://support.kraken.com/forms","contactType":"Customer Service"},"address":{"@type":"PostalAddress","streetAddress":"1603 Capitol Ave Suite 517B","addressLocality":"Cheyenne","addressRegion":"WY","postalCode":"82001","addressCountry":"US"},"hasCertification":[{"@type":"Certification","@id":"https://www.kraken.com/#cert-iso-27001","name":"ISO/IEC 27001:2022","description":"Information Security Management System (ISMS) certification.","url":"https://www.kraken.com/features/security"},{"@type":"Certification","@id":"https://www.kraken.com/#cert-soc2-type1","name":"SOC 2 Type 1 examination (custody and funding services)","description":"SOC 2 Type 1 examination completed for custody and funding services.","url":"https://blog.kraken.com/news/kraken-completes-soc-2-type-i-for-custody-and-funding-services"}]},{"@type":"Service","@id":"https://www.kraken.com/#service-institutional-custody","name":"Institutional-grade qualified custody offering","provider":{"@id":"https://www.kraken.com/#organization"},"hasCertification":[{"@type":"Certification","@id":"https://www.kraken.com/#cert-soc2-type2","name":"SOC 2 Type 2 compliance examination (institutional-grade qualified custody offering)","description":"SOC 2 Type 2 compliance examination for the institutional-grade qualified custody offering.","url":"https://blog.kraken.com/product/security/soc-2-type-2"}]},{"@type":"WebSite","@id":"https://www.kraken.com/#website","url":"https://www.kraken.com/","name":"Kraken","alternateName":"Kraken Exchange","description":"Buy, sell, trade and learn about crypto on Kraken — the simple, powerful crypto platform that grows with you.","publisher":{"@id":"https://www.kraken.com/#organization"},"potentialAction":{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"https://www.kraken.com/search?q={query}"},"query":"required"}},{"@type":"BreadcrumbList","@id":"https://www.kraken.com/features/fee-schedule#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Kraken.com","item":"https://www.kraken.com/"},{"@type":"ListItem","position":2,"name":"Features","item":"https://www.kraken.com/features"},{"@type":"ListItem","position":3,"name":"Fee Schedule","item":"https://www.kraken.com/features/fee-schedule"}]},{"@type":"WebPage","@id":"https://www.kraken.com/features/fee-schedule#webpage","url":"https://www.kraken.com/features/fee-schedule","name":"Fee Structures | Explore our trading fees | Kraken","description":"Find all of the details around Kraken's trading fee schedule here. Get started with Kraken today.","isPartOf":{"@id":"https://www.kraken.com/#website"},"publisher":{"@id":"https://www.kraken.com/#organization"},"breadcrumb":{"@id":"https://www.kraken.com/features/fee-schedule#breadcrumb"}}]}</script><script data-rh="true" id="schema-graph-«R2ecuqq»" type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Article","headline":"Fee Schedule","description":"Fees as low as 0%","articleBody":"— Industry leading fees across all our products\n\nWhether you’re just getting started on your investing journey or you’re a seasoned crypto trader, you’ll find a Kraken product that fits your needs at a competitive price point you’ll love. Browse the table below to learn more about the fee structure for each of our offerings.\n\n— Kraken Pro fee considerations\n\n\t• Fees are charged on a per-trade basis.\n\t• Fees are calculated as a percentage of the trade's quote currency volume (by default). Certain pairs allow the fee to be calculated based on the trade's base currency, which can be specified when ordering using the Fee Currency option.\n\t• User fee volume levels are measured using the equivalent market value of the listed \"Fee Volume Currency\" at the time of the trade. Note that this currency may be different from the pair's base or quote currency.\n\t• User fee volume levels are measured and applicable for trades occurring in the last 30 days only.\n\t• Discount tiers are assessed after every trade, so you get your discounts when you earn them.\n\t• Our volume-based discounts are designed to be attainable so investors of all sizes are rewarded for their trades.\n\t• If you’re not a frequent trader but you do big volume, consider our OTC service for a more cost-effective, personal experience.\n\n— Low fees for both makers and takers\n\nAlmost all of our cryptocurrency pairs follow the same fee schedule, which incentivizes market makers to increase liquidity - meaning it’s easier for you to execute trades at the price you want.","datePublished":"2026-10-08T00:00:00.000Z","wordCount":291,"timeRequired":"PT2M"}]}</script><link data-rh="true" id="css-onload" type="text/css" rel="stylesheet" href="https://www.kraken.com/css/facade-onload/16194.css"/><link data-rh="true" rel="shortcut icon" sizes="32x32" href="/favicon.ico"/><link data-rh="true" rel="icon" type="image/png" sizes="16x16" href="/_assets/icons/favicon-16x16.png"/><link data-rh="true" rel="apple-touch-icon" sizes="180x180" href="/_assets/icons/apple-touch-icon.png"/><link data-rh="true" rel="alternate" href="https://www.kraken.com/features/fee-schedule" hrefLang="x-default"/><link data-rh="true" rel="alternate" href="https://www.kraken.com/features/fee-schedule" hrefLang="en-us"/><link data-rh="true" rel="alternate" href="https://www.kraken.com/es/features/fee-schedule" hrefLang="es-es"/><link data-rh="true" rel="alternate" href="https://www.kraken.com/de/features/fee-schedule" hrefLang="de-de"/><link data-rh="true" rel="alternate" href="https://www.kraken.com/fr/features/fee-schedule" hrefLang="fr-fr"/><link data-rh="true" rel="alternate" href="https://www.kraken.com/it/features/fee-schedule" hrefLang="it-it"/><link data-rh="true" rel="alternate" href="https://www.kraken.com/nl/features/fee-schedule" hrefLang="nl-nl"/><link data-rh="true" rel="alternate" href="https://www.kraken.com/pl/features/fee-schedule" hrefLang="pl-pl"/><link data-rh="true" rel="al