fPLNx-aUp","cell_description":"Content of Column 3","field_content":"0.035%"}],"row_description":"Row :: $250M+"},{"_key":"6uSY7lO7RoSHvgCxHKVlp","field_cells":[{"_key":"wQpWG8XqTpeAtcwu7iFrz","cell_description":"Content of Column 1","field_content":"$1B+"},{"_key":"riUGSWixVWxe2m-6lHcS7","cell_description":"Content of Column 2","field_content":"-0.010%"},{"_key":"qbxDmBJWEOQvn3aqgOL5I","cell_description":"Content of Column 3","field_content":"0.025%"}],"row_description":"Row :: $1B+"}],"field_search_placeholder":"Search","table_expanded_table":false},{"_key":"7dc8461f7f91","_type":"paragraphArticleBodyLc","field_body":"\u003cp>\u003csup>30-day spot crypto and/or spot xStocks volume determines your current tier.\u003c/sup>\u003c/p>"}],"field_id":"pro-xstocks","field_is_expanded":false,"field_title":"Pro xStocks"}]},{"_key":"5a69c4d6927f","_type":"paragraphArticleButtonLink","field_download_on_click":false,"field_event":{"_ref":"c1d5f6a8-fdbf-4737-bb69-ec7b32f6cd13","_type":"taxonomyAnalyticsEvents","_id":"c1d5f6a8-fdbf-4737-bb69-ec7b32f6cd13","firstPublishedAt":"2024-06-26T09:26:17.518Z","name":"Create Account CTA Clicked"},"field_is_download_link":false,"field_link":{"_type":"link","text":"Get started with Kraken Pro","url":"{{ \"https://p.k.xyz/9f1e\" if isMobile else \"/sign-up?rfr=pro-web\" }}"},"field_nofollow":false,"field_skip_automatic_adjustments":false},{"_key":"0181001fa4ac","_type":"paragraphArticleHeadingBody","field_body":"\u003cul>\n\t\u003cli>Fees are charged on a per-trade basis.\u003c/li>\n\t\u003cli>Fees are calculated as a percentage of the trade&#39;s quote currency volume (by default). Certain pairs allow the fee to be calculated based on the trade&#39;s base currency, which can be specified when ordering using the Fee Currency option.\u003c/li>\n\t\u003cli>User fee volume levels are measured using the equivalent market value of the listed &quot;Fee Volume Currency&quot; at the time of the trade. Note that this currency may be different from the pair&#39;s base or quote currency.\u003c/li>\n\t\u003cli>User fee volume levels are measured and applicable for trades occurring in the last 30 days only.\u003c/li>\n\t\u003cli>Discount tiers are assessed after every trade, so you get your discounts when you earn them.\u003c/li>\n\t\u003cli>Our volume-based discounts are designed to be attainable so investors of all sizes are rewarded for their trades.\u003c/li>\n\t\u003cli>If you&rsquo;re not a frequent trader but you do big volume, consider our OTC service for a more cost-effective, personal experience.\u003c/li>\n\u003c/ul>\n","field_heading":"Kraken Pro fee considerations","field_level":2,"field_skip_navigation":false},{"_key":"666c460b9726","_type":"paragraphArticleHeadingBody","field_body":"\u003cp>Almost all of our cryptocurrency pairs follow the same fee schedule, which incentivizes market makers to increase liquidity - meaning it&rsquo;s easier for you to execute trades at the price you want.\u003c/p>\n\n\u003cp>&nbsp;\u003c/p>\n","field_heading":"Low fees for both makers and takers","field_level":1,"field_skip_navigation":true}],"field_navigation_cta":{"text":"Sign up","url":"/sign-up"},"field_read_time_additional_text":"min","field_subtitle":"Fees as low as 0%","field_subtitle_type":"heading5","field_title":"Fee Schedule","field_title_type":"heading1","field_tldr_title":"Key takeaways"},{"_key":"2b28f048bfdb","_type":"paragraphSmartAppBanner","field_app_banner_cta":{"classes":"","text":"Get the App","url":"https://kraken.app.link/tnyg2GgkHFb"},"field_app_banner_review_count":"(3k)","field_app_banner_star_rating":5,"field_app_banner_title":"Kraken","field_cta_event":{"_ref":"ead5baf5-98df-4880-a63e-9fc79c27d702","_type":"taxonomyAnalyticsEvents","_id":"ead5baf5-98df-4880-a63e-9fc79c27d702","firstPublishedAt":"2024-06-26T09:26:28.284Z","name":"App Banner Clicked"},"field_cta_event_properties":{}}],"field_page_disable_app_banner":true,"field_page_disable_live_chat":false,"field_page_meta":{"description":"F