vailable_on":"Available on","config_globalsearch_facade][field_global_search_staking_bonded":"Bonded","config_globalsearch_facade][field_global_search_staking_bonded_time":"Bonded time","config_globalsearch_facade][field_global_search_staking_explore_label":"Explore {{asset}}","config_globalsearch_facade][field_global_search_staking_flexible":"Flexible","config_globalsearch_facade][field_global_search_staking_payout":"Payout","config_globalsearch_facade][field_global_search_staking_title":"Earn with {{asset}}","config_globalsearch_facade][field_global_search_staking_weekly":"Weekly","config_globalsearch_facade][field_global_search_subsection_etfs":"ETFs","config_globalsearch_facade][field_global_search_subsection_stocks":"Stocks","config_globalsearch_facade][field_global_search_subsection_xstocks":"xStocks","config_globalsearch_facade][field_global_search_to_navigate_label":"to navigate","config_globalsearch_facade][field_global_search_to_select_label":"to select","config_globalsearch_facade][field_global_search_trigger_label":"Search","config_globalsearch_facade][field_global_search_view_all":"View all","template_footer_ctas_consumer][dc200802-247d-48ef-847e-0804338625a3][field_category":"global","template_footer_ctas_consumer][90f8258acb66][field_destination_type":"internal_link","template_footer_ctas_consumer][90f8258acb66][field_text":"My account","template_footer_ctas_consumer][7c73aeae2e6b][field_destination_type":"kraken","template_footer_ctas_consumer][7c73aeae2e6b][field_text":"Create account","template_footer_ctas_consumer][c8c4f9bf48ec][field_link][title":"Sign in","template_footer_ctas_consumer][4f848de77c1b][field_destination_type":"internal_link","template_footer_ctas_consumer][4f848de77c1b][field_text":"My account","template_footer_ctas_consumer][8af4f9251a1d][field_destination_type":"kraken","template_footer_ctas_consumer][8af4f9251a1d][field_text":"Create account","template_footer_ctas_consumer][03c070bf311b][field_link][title":"Sign in","template_footer_ctas_consumer][cb1754e0819d][field_icon_set":"support","template_footer_ctas_consumer][67ee13ba1fb3][field_destination_type":"external_link","template_footer_ctas_consumer][84e72fb6d6e6][field_icon_set":"support","template_footer_ctas_consumer][894277429f6a][field_destination_type":"external_link","template_footer_ctas_consumer][dacc300881b9][field_icon_set":"support","template_footer_ctas_consumer][93a38878cba6][field_destination_type":"external_link","template_footer_ctas_consumer][b69edd9a2cc4][field_icon_set":"support","template_footer_ctas_consumer][8222947d13a3][field_destination_type":"external_link","template_footer_ctas_consumer][385d698db5b8][field_icon_set":"support","template_footer_ctas_consumer][f5f0cee4324b][field_destination_type":"external_link","template_footer_ctas_consumer][24021008cdea][field_icon_set":"support","template_footer_ctas_consumer][80bf5205c5bc][field_destination_type":"external_link","template_footer_ctas_consumer][ff4d6a302f5f][field_icon_set":"support","template_footer_ctas_consumer][f04d01ebca43][field_destination_type":"external_link","template_footer_ctas_consumer][2f2559982736][field_icon_set":"support","template_footer_ctas_consumer][468af1eb6f5c][field_destination_type":"external_link","template_footer_ctas_consumer][e0bc32eb3655][field_icon_set":"support","template_footer_ctas_consumer][b33a310aaf2d][field_destination_type":"external_link","template_footer_ctas_consumer][9c1189c40238][field_icon_set":"support","template_footer_ctas_consumer][e83fc4b3642a][field_destination_type":"external_link","template_footer_ctas_consumer][d3bbfbab9514][field_icon_set":"support","template_footer_ctas_consumer][a4818a0609ce][field_destination_type":"external_link","template_footer_ctas_consumer][77327bf0bd8b][field_icon_set":"support","template_footer_ctas_consumer][decd6fe875aa][field_destination_type":"external_link","template_footer_ctas_consumer][a3cadec4c4be][field_icon_set":"support","template_footer_ctas_consumer][95b6c9d5b532][field_destination_type":"external_link","template_footer_ctas_consumer][41deba40480e][field_icon_set":"support","template_footer_ctas_consumer][f5d8811a44d0][field_destination_type":"external_link","fee_schedule][field_page_meta][description":"Find all of the details around Kraken's trading fee schedule here. Get started with Kraken today.","fee_schedule][field_page_meta][title":"Fee Structures | Explore our trading fees | Kraken","fee_schedule][0bd8194733c1][field_audio_title":"Kraken AI podcast","fee_schedule][0bd8194733c1][field_author_additional_text":"By","fee_schedule][67a2b3b834a6][field_body":"\u003cp>Whether you&rsquo;re just getting started on your investing journey or you&rsquo;re a seasoned crypto trader, you&rsquo;ll find a Kraken product that fits your needs at a competitive price point you&rsquo;ll love. Browse the table below to learn more about the fee structure for each of our offerings.\u003c/p>\n","fee_schedule][67a2b3b834a6][field_heading":"Industry leading fees across all our products","fee_schedule][948adcf2e8e2][field_heading":"Kraken","fee_schedule][14bf1ede810f][field_body":"\u003cp>Instantly buy, sell or convert \u003ca href=\"/prices/bitcoin\">Bitcoin\u003c/a> or other cryptocurrencies&nbsp; on Kraken.com or via the Kraken App.*\u003c/p>\n","fee_schedule][258d7b862b0f][field_body":"\u003cp>\u003cstrong>Kraken Fees\u003c/strong>\u003cbr>\u003cbr>When you buy, sell, or convert cryptocurrencies or fiat on Kraken, fees apply. These include:\u003cbr>\u003cbr>\u003cu>Trading Fees\u003c/u>: Kraken charges a 1% trading fee on instant and recurring trades and a 1.5% fee on custom orders, which are waived for Kraken+ members on trading volume up to $10,000 per month (details below).\u003cbr>\u003cbr>\u003cu>Payment Fees\u003c/u>: Additional fees may apply depending on your chosen payment method, such as using a credit/debit card, Apple Pay/Google Pay ACH transfer, or your Kraken account balance.\u003cbr>For small balance conversions using the “Convert Small Balances” feature, a fixed 3% fee applies to amounts below the minimum order size.\u003cbr>\u003cbr>\u003cstrong>Spread\u003c/strong>\u003cbr>\u003cbr>When using Kraken’s Instant Buy/Sell Services, including custom and recurring purchases, the price you see includes a spread, the difference between the market rate and the rate you receive. This spread ensures price certainty at the time of order execution.\u003cbr>Kraken may retain any excess spread from a transaction. Please note that the spread may vary for similar transactions. The size of the spread varies based on factors such as: market volatility, asset type, order size and type, Kraken VIP status, and overall account activity.\u003cbr>\u003cbr>\u003cstrong>Kraken+\u003c/strong>\u003cbr>\u003cbr>\u003cu>Zero Trading Fees\u003c/u>: Kraken+ members enjoy zero trading fees on up to $10,000 USD (or the local currency equivalent) in monthly trading volume for major currencies (USD, GBP, CAD, AUD, EUR, CHF).\u003cbr>This benefit applies only to trades made through the Buy, Sell, or Convert features on the Kraken app or web, and does not include Spot, Futures, API, or OTC trades on Kraken Pro.\u003cbr>\u003cbr>Note: While trading fees are waived, spreads and card processing fees still apply.\u003c/p>","fee_schedule][500dfbfe2bd2][field_body":"\u003cp>\u003csup>*Currently the Kraken App is only available in the countries listed in the &ldquo;Requirements&rdquo; section of \u003ca href=\"https://support.kraken.com/hc/en-us/articles/360048212832-Buy-Crypto-with-your-credit-or-debit-card\">this article\u003c/a>.\u003c/sup>\u003c/p>\n","fee_schedule][61b57aa63085][field_title":"Instant Buy/Sell","fee_schedule][a67cf3717414][field_body":"\u003cp>On-chain staking utilizes blockchain Proof-of-Stake protocol to generate rewards through a process typically called &ldquo;staking&rdquo;.\u003c/p>\n\n\u003cp>Benefits of On-chain staking on Kraken:\u003c/p>\n\n\u003cul>\n\t\u003cli>Start earning rewards instantly &mdash; no waiting or bonding periods\u003c/li>\n\t\u003cli>One of the highest returns in the industry\u003c/li>\n\t\u003cli>Stake your assets in just three clicks from your Kraken balances\u003c/li>\n\t\u003cli>Instant un-staking when using Flexible terms\u003c/li>\n\u003c/ul>\n","fee_schedule][4fce26160ef6][field_body":"\u003cul>\n\t\u003cli>There are currently no transaction fees for Rewards staking or unstaking. On-chain staking commissions apply and are deducted from the rewards earned on your staked assets.\u003c/li>\n\t\u003cli>Flexible staking on assets with an on-chain unbonding period and staked assets in our Rewards program is subject to a 20% commission.\u003c/li>\n\t\u003cli>Bonded staking and flexible staking on assets with no on-chain unbonding period are subject to commissions based on current balances staked per asset.\u003c/li>\n\t\u003cli>For more information, please see&nbsp;\u003ca href=\"https://support.kraken.com/hc/articles/360037682011\">Fees in our On-chain staking support page.\u003c/a>\u003c/li>\n\u003c/ul>\n","fee_schedule][4a5f52b6d086][field_body":"\u003cp>\u003csup>*Availability can be&nbsp;\u003ca data-sk=\"tooltip_parent\" data-stringify-link=\"https://support.kraken.com/hc/en-us/articles/360001368823\" href=\"https://support.kraken.com/hc/en-us/articles/360001368823\" target=\"_blank\">found here\u003c/a>. If On-chain staking is not showing as an option on your account, you may not be eligible.\u003c/sup>\u003c/p>\n","fee_schedule][693709b7bf43][field_title":"On-chain Staking","fee_schedule][9d6e6bb262e8][field_body":"\u003cp>Kraken may adjust its deposit and withdrawal fees in response to changes in the underlying costs, market conditions, or user activity. Clients are encouraged to review the account deposit or withdrawal page on Kraken&#39;s website and app for the most current information regarding deposit and withdrawal fees.\u003c/p>\n\n\u003cul>\n\t\u003cli>Kraken&rsquo;s deposit and withdrawal transaction fees are based on the method and currency used.\u003c/li>\n\t\u003cli>Funding Fees can be both Static (fixed) and Dynamic (variable) in order to reflect the network and processing fees associated with a specific transaction as well as different costs incurred by Kraken.\u003c/li>\n\t\u003cli>Kraken may implement a percentage-based fee to accurately reflect different costs incurred by Kraken.\u003c/li>\n\t\u003cli>Funding Fees can be both coin-denominated or percentage-based.\u003c/li>\n\t\u003cli>Fees displayed upon confirmation of a transaction are always the fees incurred by clients.\u003c/li>\n\t\u003cli>For more information please check our article on&nbsp;\u003ca href=\"https://support.kraken.com/hc/articles/360000292886\">Cryptocurrency deposit fees and minimums\u003c/a>,&nbsp;\u003ca href=\"https://support.kraken.com/hc/articles/360000767986\">Cryptocurrency withdrawal fees and minimums\u003c/a>,&nbsp;\u003ca href=\"https://support.kraken.com/hc/articles/360000381846\">Cash deposit options\u003c/a>, and&nbsp;\u003ca href=\"https://support.kraken.com/hc/articles/360000423043\">Cash withdrawal options\u003c/a>.\u003c/li>\n\u003c/ul>\n","fee_schedule][caf25b833c09][field_title":"Deposit & Withdrawal","fee_schedule][59c003caf3b3][field_body":"\u003cp>Kraken offers commission-free trading for 11k+ stocks and ETFs\u003c/p>\n","fee_schedule][8dc0e581937b][field_body":"\u003cul>\n\t\u003cli>Zero commission for trading stocks and ETFs.\u003c/li>\n\t\u003cli>Regulatory agencies may charge fees that are passed to the investor. \u003ca href=\"/legal/equities\">Learn more here.\u003c/a>\u003c/li>\n\u003c/ul>\n","fee_schedule][4e5becfed615][field_body":"\u003cp>\u003csup>*Currently available in the U.S. only\u003c/sup>\u003c/p>\n","fee_schedule][fa69312b9511][field_title":"Stocks","fee_schedule][13cb8d986d70][field_body":"\u003cul>\n\t\u003cli>\u003cstrong>&nbsp;\u003c/strong>There are no trading fees when purchasing xStocks with USDG or USD on Kraken.\u003c/li>\n\t\u003cli>The standard 1% instant buy/sell trading fee applies when purchasing xStocks using other assets.\u003c/li>\n\t\u003cli>To lock in a price, a spread may be included in the asset price for each transaction.\u003c/li>\n\u003c/ul>\n","fee_schedule][116de76c3869][field_body":"\u003cp>\u003csup>*Availability can be \u003ca href=\"https://support.kraken.com/articles/xstocks-availability\" style=\"text-decoration:none\">\u003cu>found here\u003c/u>\u003c/a>. If xStocks is not showing as an option on your account, you may not be eligible.\u003c/sup>\u003c/p>\n","fee_schedule][53b68fdf7ab7][field_title":"xStocks","fee_schedule][2588a8b6cec4][field_body":"\u003cp>A simple, flexible way to trade on where you think prices are headed on &mdash; without needing to own the underlying asset.\u003c/p>\n","fee_schedule][e39ef4071dce][field_body":"\u003cul>\n\t\u003cli>A 0.25% fee is applied to the notional value of the trade to open the position.\u003c/li>\n\t\u003cli>A 0.25% fee is applied to the closed notional value of the trade to close the position.\u003c/li>\n\u003c/ul>\n","fee_schedule][c08528cc224e][field_body":"\u003cp>\u003csup>*Currently available in certain geos\u003c/sup>\u003c/p>\n","fee_schedule][a99989800de3][field_title":"Perps","fee_schedule][727b740c5ddb][field_link][title":"Get started with Kraken","fee_schedule][fd02da0ae1dc][field_heading":"Kraken Pro","fee_schedule][5f85f29789ca][field_text":"\u003cp>Kraken has recently introduced Cross-platform fee tiers, read \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://www.kraken.com/features/fee-schedule#cross-platform-fee-tiers\">here\u003c/a> for details.\u003c/p>\u003cp>\u003cbr>\u003c/p>\u003cp>You can also check out our \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://support.kraken.com/articles/cross-platform-fee-tier-changes\">support article\u003c/a> which contains additional information.\u003c/p>","fee_schedule][7ed0101fac9d][field_body":"\u003cp>Cross-platform fee tiers are not available in Ukraine.\u003c/p>","fee_schedule][552c960c9823][field_body":"\u003cp>Your tier is based on the \u003cstrong>best of\u003c/strong>:\u003c/p>\u003cul>\u003cli>\u003cp>Your \u003cstrong>spot trading volume\u003c/strong>\u003c/p>\u003c/li>\u003cli>\u003cp>Your \u003cstrong>futures trading volume\u003c/strong>\u003c/p>\u003c/li>\u003cli>\u003cp>Your \u003cstrong>Assets on Platform (AoP)\u003c/strong>\u003c/p>\u003c/li>\u003c/ul>\u003cp>Your tier reflects the most favorable of the three measures. So if your futures volume is where you're most active, that now counts toward your spot tier, automatically. If more than one measure qualifies you for the same tier, your rates remain unchanged, qualifying through multiple measures at the same tier does not provide additional benefits.\u003c/p>\u003cp>\u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://support.kraken.com/articles/cross-platform-fee-tier-changes\">\u003cem>More information about cross-platform fee tiers\u003c/em>\u003c/a>\u003c/p>\u003cspan style=\"font-size: 0.75em;\">Scroll table to the right to view percentages\u003c/span>","fee_schedule][552c960c9823][field_heading":"How your tier is determined","fee_schedule][be738d5bffa2][field_content":"Tier","fee_schedule][23f2288696b2][field_content":"\u003cp>Spot 30-Day Vol (USD) \u003cstrong>OR\u003c/strong>\u003c/p>","fee_schedule][cef9af22df96][field_content":"\u003cp>Futures 30-Day Vol (USD) \u003cstrong>OR\u003c/strong>\u003c/p>","fee_schedule][85b6bc8c3c79][field_content":"AoP (USD)","fee_schedule][d7f36cdbf4ab][field_content":"\u003cp>Spot Maker (%)\u003c/p>","fee_schedule][00317840316a][field_content":"\u003cp>Spot Taker (%)\u003c/p>","fee_schedule][b92042e180b6][field_content":"Tier 1","fee_schedule][b9efe9254277][field_content":"$0+","fee_schedule][82f075feb3e8][field_content":"&lt; $5M","fee_schedule][bd8e1e37a491][field_content":"N/A","fee_schedule][4e47204a1405][field_content":"\u003cp>0.40 %\u003c/p>","fee_schedu