xt-ds-body1 [&amp;_blockquote]:before:bg-ds-dimmed [&amp;_blockquote]:before:w-ds-2 [&amp;_blockquote]:relative [&amp;_blockquote]:before:absolute [&amp;_blockquote]:before:-inset-y-0 [&amp;_blockquote]:before:start-0 [&amp;_blockquote]:before:content-[&quot;&quot;] [&amp;_em]:italic [&amp;_h1]:text-[2em] [&amp;_h2]:text-[1.55em] [&amp;_h3]:text-[1.33em] [&amp;_h4]:text-[1.11em] [&amp;_h5]:font-medium [&amp;_h6]:font-medium [&amp;_*:not(span)+*:not(span)]:mt-[1em] [&amp;_p+ol]:mt-[.75em] [&amp;_p+ul]:mt-[.75em] [&amp;_ol+p]:mt-[1.25em] [&amp;_ol+ul]:mt-[1.25em] [&amp;_ol+ol]:mt-[1.25em] [&amp;_ul+p]:mt-[1.25em] [&amp;_ul+ol]:mt-[1.25em] [&amp;_ul+ul]:mt-[1.25em] [&amp;_ul&gt;li+li]:mt-[.75em] [&amp;_ul&gt;li]:break-words [&amp;_ul]:list-disc [&amp;_ol&gt;li+li]:mt-[.75em] [&amp;_ol&gt;li::marker]:font-bold [&amp;_ol]:list-decimal [&amp;_a]:text-ds-purple-500 [&amp;_a:hover]:text-ds-purple-700 [&amp;_a:hover]:underline group-[.theme-set]/theme:[&amp;_a]:text-ds-brand [&amp;_ul]:ps-[1.5em] [&amp;_ol]:ps-[1.7em]"><p><sup>30-day spot crypto and/or spot xStocks volume determines your current tier.</sup></p></div></div></div></div></div></div></div></div><div class="h-px w-full" style="box-shadow:var(--box-shadow-ds-accordion, inset 0 1px 0 0 #686b821f)"></div></div></div><div class="pt-5 lg:pb-4 lg:pt-7"><div><a class="text-ds-button-primary-high hover:text-ds-button-primary-high-hover active:bg-ds-button-primary-high-active bg-ds-button-primary-high-gradient hover:bg-ds-button-primary-high-gradient-hover bg-ds-button-primary-high hover:bg-ds-button-primary-high-hover rounded-ds-button-xl focus-visible:outline-offset-ds-button relative box-border border-0 focus-visible:outline focus-visible:outline-2 disabled:pointer-events-none cursor-pointer outline-ds-button ms-ds-0 me-ds-0 mt-ds-0 mb-ds-0 p-ds-button-xl inline-block whitespace-nowrap no-underline text-ds-button-xl" href="/sign-up?rfr=pro-web" tabindex="0" data-ds-component="Button" data-ds-part="root" data-ds-tone="primary" data-ds-emphasis="high" data-ds-size="xl"><span class="flex items-center justify-center gap-ds-button-xl"><span>Get started with Kraken Pro</span></span></a></div></div><div class="pt-8 lg:pt-10"><div id="018-kraken-pro-fee-considerations" style="--header-height:0px" class="space-y-2 scroll-mt-[calc(var(--header-height)+5rem)] lg:scroll-mt-[calc(var(--header-height)+2rem)]"><div class="flex items-center"><div class="text-ds-primary text-ds-heading4 ms-ds-0 me-ds-0 mt-ds-0 mb-ds-0"><h3 class="[&amp;_a:hover]:font-inherit [&amp;_a:hover]:underline [&amp;_a]:no-underline [&amp;_blockquote]:ps-ds-6 [&amp;_blockquote]:text-ds-body1 [&amp;_blockquote]:before:bg-ds-dimmed [&amp;_blockquote]:before:w-ds-2 [&amp;_blockquote]:relative [&amp;_blockquote]:before:absolute [&amp;_blockquote]:before:-inset-y-0 [&amp;_blockquote]:before:start-0 [&amp;_blockquote]:before:content-[&quot;&quot;] [&amp;_em]:italic [&amp;_h1]:text-[2em] [&amp;_h2]:text-[1.55em] [&amp;_h3]:text-[1.33em] [&amp;_h4]:text-[1.11em] [&amp;_h5]:font-medium [&amp;_h6]:font-medium [&amp;_*:not(span)+*:not(span)]:mt-[1em] [&amp;_p+ol]:mt-[.75em] [&amp;_p+ul]:mt-[.75em] [&amp;_ol+p]:mt-[1.25em] [&amp;_ol+ul]:mt-[1.25em] [&amp;_ol+ol]:mt-[1.25em] [&amp;_ul+p]:mt-[1.25em] [&amp;_ul+ol]:mt-[1.25em] [&amp;_ul+ul]:mt-[1.25em] [&amp;_ul&gt;li+li]:mt-[.75em] [&amp;_ul&gt;li]:break-words [&amp;_ul]:list-disc [&amp;_ol&gt;li+li]:mt-[.75em] [&amp;_ol&gt;li::marker]:font-bold [&amp;_ol]:list-decimal [&amp;_a]:text-ds-purple-500 [&amp;_a:hover]:text-ds-purple-700 [&amp;_a:hover]:underline group-[.theme-set]/theme:[&amp;_a]:text-ds-brand [&amp;_ul]:ps-[1.5em] [&amp;_ol]:ps-[1.7em] scroll-mt-[calc(var(--header-height)+5rem)] lg:scroll-mt-[calc(var(--header-height)+2rem)] flex-1">Kraken Pro fee considerations</h3></div></div><div class="text-ds-primary text-ds-body1 ms-ds-0 me-ds-0 mt-ds-0 mb-ds-0"><div class="[&amp;_a:hover]:font-inherit [&amp;_a:hover]:underline [&amp;_a]:no-underline [&amp;_blockquote]:ps-ds-6 [&amp;_blockquote]:text-ds-body1 [&amp;_blockquote]:before:bg-ds-dimmed [&amp;_blockquote]:before:w-ds-2 [&amp;_blockquote]:relative [&amp;_blockquote]:before:absolute [&amp;_blockquote]:before:-inset-y-0 [&amp;_blockquote]:before:start-0 [&amp;_blockquote]:before:content-[&quot;&quot;] [&amp;_em]:italic [&amp;_h1]:text-[2em] [&amp;_h2]:text-[1.55em] [&amp;_h3]:text-[1.33em] [&amp;_h4]:text-[1.11em] [&amp;_h5]:font-medium [&amp;_h6]:font-medium [&amp;_*:not(span)+*:not(span)]:mt-[1em] [&amp;_p+ol]:mt-[.75em] [&amp;_p+ul]:mt-[.75em] [&amp;_ol+p]:mt-[1.25em] [&amp;_ol+ul]:mt-[1.25em] [&amp;_ol+ol]:mt-[1.25em] [&amp;_ul+p]:mt-[1.25em] [&amp;_ul+ol]:mt-[1.25em] [&amp;_ul+ul]:mt-[1.25em] [&amp;_ul&gt;li+li]:mt-[.75em] [&amp;_ul&gt;li]:break-words [&amp;_ul]:list-disc [&amp;_ol&gt;li+li]:mt-[.75em] [&amp;_ol&gt;li::marker]:font-bold [&amp;_ol]:list-decimal [&amp;_a]:text-ds-purple-500 [&amp;_a:hover]:text-ds-purple-700 [&amp;_a:hover]:underline group-[.theme-set]/theme:[&amp;_a]:text-ds-brand [&amp;_ul]:ps-[1.5em] [&amp;_ol]:ps-[1.7em]"><ul>
<li>Fees are charged on a per-trade basis.</li>
<li>Fees are calculated as a percentage of the trade&#x27;s quote currency volume (by default). Certain pairs allow the fee to be calculated based on the trade&#x27;s base currency, which can be specified when ordering using the Fee Currency option.</li>
<li>User fee volume levels are measured using the equivalent market value of the listed &quot;Fee Volume Currency&quot; at the time of the trade. Note that this currency may be different from the pair&#x27;s base or quote currency.</li>
<li>User fee volume levels are measured and applicable for trades occurring in the last 30 days only.</li>
<li>Discount tiers are assessed after every trade, so you get your discounts when you earn them.</li>
<li>Our volume-based discounts are designed to be attainable so investors of all sizes are rewarded for their trades.</li>
<li>If you’re not a frequent trader but you do big volume, consider our OTC service for a more cost-effective, personal experience.</li>
</ul>
</div></div></div></div><div class="pt-14 lg:pt-20"><div id="666-low-fees-for-both-makers-and-takers" style="--header-height:0px" class="space-y-4 scroll-mt-[calc(var(--header-height)+5rem)] lg:scroll-mt-[calc(var(--header-height)+2rem)]"><div class="flex items-center"><div class="text-ds-primary text-ds-heading3 ms-ds-0 me-ds-0 mt-ds-0 mb-ds-0"><h2 class="[&amp;_a:hover]:font-inherit [&amp;_a:hover]:underline [&amp;_a]:no-underline [&amp;_blockquote]:ps-ds-6 [&amp;_blockquote]:text-ds-body1 [&amp;_blockquote]:before:bg-ds-dimmed [&amp;_blockquote]:before:w-ds-2 [&amp;_blockquote]:relative [&amp;_blockquote]:before:absolute [&amp;_blockquote]:before:-inset-y-0 [&amp;_blockquote]:before:start-0 [&amp;_blockquote]:before:content-[&quot;&quot;] [&amp;_em]:italic [&amp;_h1]:text-[2em] [&amp;_h2]:text-[1.55em] [&amp;_h3]:text-[1.33em] [&amp;_h4]:text-[1.11em] [&amp;_h5]:font-medium [&amp;_h6]:font-medium [&amp;_*:not(span)+*:not(span)]:mt-[1em] [&amp;_p+ol]:mt-[.75em] [&amp;_p+ul]:mt-[.75em] [&amp;_ol+p]:mt-[1.25em] [&amp;_ol+ul]:mt-[1.25em] [&amp;_ol+ol]:mt-[1.25em] [&amp;_ul+p]:mt-[1.25em] [&amp;_ul+ol]:mt-[1.25em] [&amp;_ul+ul]:mt-[1.25em] [&amp;_ul&gt;li+li]:mt-[.75em] [&amp;_ul&gt;li]:break-words [&amp;_ul]:list-disc [&amp;_ol&gt;li+li]:mt-[.75em] [&amp;_ol&gt;li::marker]:font-bold [&amp;_ol]:list-decimal [&amp;_a]:text-ds-purple-500 [&amp;_a:hover]:text-ds-purple-700 [&amp;_a:hover]:underline group-[.theme-set]/theme:[&amp;_a]:text-ds-brand [&amp;_ul]:ps-[1.5em] [&amp;_ol]:ps-[1.7em] scroll-mt-[calc(var(--header-height)+5rem)] lg:scroll-mt-[calc(var(--header-height)+2rem)] flex-1">Low fees for both makers and takers</h2></div></div><div class="text-ds-primary text-ds-body1 ms-ds-0 me-ds-0 mt-ds-0 mb-ds-0"><div class="[&amp;_a:hover]:font-inherit [&amp;_a:hover]:underline [&amp;_a]:no-underline [&amp;_blockquote]:ps-ds-6 [&amp;_blockquote]:text-ds-body1 [&amp;_blockquote]:before:bg-ds-dimmed [&amp;_blockquote]:before:w-ds-2 [&amp;_blockquote]:relative [&amp;_blockquote]:before:absolute [&amp;_blockquote]:before:-inset-y-0 [&amp;_blockquote]:before:start-0 [&amp;_blockquote]:before:content-[&quot;&quot;] [&amp;_em]:italic [&amp;_h1]:text-[2em] [&amp;_h2]:text-[1.55em] [&amp;_h3]:text-[1.33em] [&amp;_h4]:text-[1.11em] [&amp;_h5]:font-medium [&amp;_h6]:font-medium [&amp;_*:not(span)+*:not(span)]:mt-[1em] [&amp;_p+ol]:mt-[.75em] [&amp;_p+ul]:mt-[.75em] [&amp;_ol+p]:mt-[1.25em] [&amp;_ol+ul]:mt-[1.25em] [&amp;_ol+ol]:mt-[1.25em] [&amp;_ul+p]:mt-[1.25em] [&amp;_ul+ol]:mt-[1.25em] [&amp;_ul+ul]:mt-[1.25em] [&amp;_ul&gt;li+li]:mt-[.75em] [&amp;_ul&gt;li]:break-words [&amp;_ul]:list-disc [&amp;_ol&gt;li+li]:mt-[.75em] [&amp;_ol&gt;li::marker]:font-bold [&amp;_ol]:list-decimal [&amp;_a]:text-ds-purple-500 [&amp;_a:hover]:text-ds-purple-700 [&amp;_a:hover]:underline group-[.theme-set]/theme:[&amp;_a]:text-ds-brand [&amp;_ul]:ps-[1.5em] [&amp;_ol]:ps-[1.7em]"><p>Almost all of our cryptocurrency pairs follow the same fee schedule, which incentivizes market makers to increase liquidity - meaning it’s easier for you to execute trades at the price you want.</p>
<p> </p>
</div></div></div></div></div></div><div class="pointer-events-none absolute inset-0 start-1/2 w-full max-w-[1920px] max-[1279px]:hidden ltr:-translate-x-1/2 rtl:translate-x-1/2"><div class="h-full w-fit ps-7"><nav style="--header-height:0px" class="sticky top-[calc(var(--header-height)+4.5rem)] h-max pb-20 transition-all duration-300 ease-in-out"><div class="theme-dark:bg-[#0b0611e0] theme-pay-light:ds-pay-light-bg w-[232px] rounded-lg bg-[#f6f5f9e0] p-3 backdrop-blur-[10px] pointer-events-auto"><a href="#948-kraken" class="block cursor-pointer overflow-hidden rounded-lg no-underline transition-[opacity,height,padding-top,padding-bottom,background-color] p-1"><div class="text-ds-dimmed text-ds-body1 ms-ds-0 me-ds-0 mt-ds-0 mb-ds-0"><div class="[&amp;_a:hover]:font-inherit [&amp;_a:hover]:underline [&amp;_a]:no-underline [&amp;_blockquote]:ps-ds-6 [&amp;_blockquote]:text-ds-body1 [&amp;_blockquote]:before:bg-ds-dimmed [&amp;_blockquote]:before:w-ds-2 [&amp;_blockquote]:relative [&amp;_blockquote]:before:absolute [&amp;_blockquote]:before:-inset-y-0 [&amp;_blockquote]:before:start-0 [&amp;_blockquote]:before:content-[&quot;&quot;] [&amp;_em]:italic [&amp;_h1]:text-[2em] [&amp;_h2]:text-[1.55em] [&amp;_h3]:text-[1.33em] [&amp;_h4]:text-[1.11em] [&amp;_h5]:font-medium [&amp;_h6]:font-medium [&amp;_*:not(span)+*:not(span)]:mt-[1em] [&amp;_p+ol]:mt-[.75em] [&amp;_p+ul]:mt-[.75em] [&amp;_ol+p]:mt-[1.25em] [&amp;_ol+ul]:mt-[1.25em] [&amp;_ol+ol]:mt-[1.25em] [&amp;_ul+p]:mt-[1.25em] [&amp;_ul+ol]:mt-[1.25em] [&amp;_ul+ul]:mt-[1.25em] [&amp;_ul&gt;li+li]:mt-[.75em] [&amp;_ul&gt;li]:break-words [&amp;_ul]:list-disc [&amp;_ol&gt;li+li]:mt-[.75em] [&amp;_ol&gt;li::marker]:font-bold [&amp;_ol]:list-decimal [&amp;_a]:text-ds-purple-500 [&amp;_a:hover]:text-ds-purple-700 [&amp;_a:hover]:underline group-[.theme-set]/theme:[&amp;_a]:text-ds-brand [&amp;_ul]:ps-[1.5em] [&amp;_ol]:ps-[1.7em]">Kraken</div></div></a><a href="#fd0-kraken-pro" class="block cursor-pointer overflow-hidden r