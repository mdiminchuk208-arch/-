ode":"[\n  {\n    \"@type\": [\"Organization\", \"FinancialService\"],\n    \"@id\": \"https://www.kraken.com/#organization\",\n    \"name\": \"Kraken\",\n    \"legalName\": \"Payward, Inc.\",\n    \"foundingDate\": \"2011\",\n    \"url\": \"https://www.kraken.com/\",\n    \"description\": \"Kraken is a global cryptocurrency exchange offering spot trading, derivatives, staking, institutional custody, and fiat on-ramps.\",\n    \"areaServed\": \"Worldwide\",\n    \"founder\": [\n      { \"@type\": \"Person\", \"name\": \"Thanh Luu\" },\n      { \"@type\": \"Person\", \"name\": \"Michael Gronager\" },\n      { \"@type\": \"Person\", \"name\": \"Jesse Powell\" }\n    ],\n    \"knowsAbout\": [\n      \"Cryptocurrency trading\",\n      \"Bitcoin\",\n      \"Ethereum\",\n      \"Crypto derivatives\",\n      \"Digital asset custody\",\n      \"Staking\",\n      \"Institutional crypto services\"\n    ],\n    \"logo\": {\n      \"@type\": \"ImageObject\",\n      \"@id\": \"https://www.kraken.com/#logo\",\n      \"url\": \"https://assets.kraken.com/marketing/static/kraken-logo.jpg\",\n      \"contentUrl\": \"https://assets.kraken.com/marketing/static/kraken-logo.jpg\",\n      \"width\": 900,\n      \"height\": 900,\n      \"caption\": \"Kraken\"\n    },\n    \"image\": { \"@id\": \"https://www.kraken.com/#logo\" },\n    \"sameAs\": [\n      \"https://www.facebook.com/KrakenFX\",\n      \"https://twitter.com/krakenfx\",\n      \"https://www.youtube.com/@KrakenCryptoExchange\",\n      \"https://en.wikipedia.org/wiki/Kraken_(cryptocurrency_exchange)\",\n      \"https://www.linkedin.com/company/krakenfx\",\n      \"https://www.instagram.com/krakenfx/\",\n      \"https://www.reddit.com/r/Kraken\",\n      \"https://www.tiktok.com/@krakenfx\",\n      \"https://t.me/kraken_exchange_official\",\n      \"https://discord.com/invite/krakenexchange\",\n      \"https://apps.apple.com/us/app/kraken-buy-crypto-bitcoin/id1481947260\",\n      \"https://play.google.com/store/apps/details?id=com.kraken.invest.app&hl=en_US\"\n    ],\n    \"contactPoint\": {\n      \"@type\": \"ContactPoint\",\n      \"url\": \"https://support.kraken.com/forms\",\n      \"contactType\": \"Customer Service\"\n    },\n    \"address\": {\n      \"@type\": \"PostalAddress\",\n      \"streetAddress\": \"1603 Capitol Ave Suite 517B\",\n      \"addressLocality\": \"Cheyenne\",\n      \"addressRegion\": \"WY\",\n      \"postalCode\": \"82001\",\n      \"addressCountry\": \"US\"\n    },\n    \"hasCertification\": [\n      {\n        \"@type\": \"Certification\",\n        \"@id\": \"https://www.kraken.com/#cert-iso-27001\",\n        \"name\": \"ISO/IEC 27001:2022\",\n        \"description\": \"Information Security Management System (ISMS) certification.\",\n        \"url\": \"https://www.kraken.com/features/security\"\n      },\n      {\n        \"@type\": \"Certification\",\n        \"@id\": \"https://www.kraken.com/#cert-soc2-type1\",\n        \"name\": \"SOC 2 Type 1 examination (custody and funding services)\",\n        \"description\": \"SOC 2 Type 1 examination completed for custody and funding services.\",\n        \"url\": \"https://blog.kraken.com/news/kraken-completes-soc-2-type-i-for-custody-and-funding-services\"\n      }\n    ]\n  },\n  {\n    \"@type\": \"Service\",\n    \"@id\": \"https://www.kraken.com/#service-institutional-custody\",\n    \"name\": \"Institutional-grade qualified custody offering\",\n    \"provider\": { \"@id\": \"https://www.kraken.com/#organization\" },\n    \"hasCertification\": [\n      {\n        \"@type\": \"Certification\",\n        \"@id\": \"https://www.kraken.com/#cert-soc2-type2\",\n        \"name\": \"SOC 2 Type 2 compliance examination (institutional-grade qualified custody offering)\",\n        \"description\": \"SOC 2 Type 2 compliance examination for the institutional-grade qualified custody offering.\",\n        \"url\": \"https://blog.kraken.com/product/security/soc-2-type-2\"\n      }\n    ]\n  },\n  {\n    \"@type\": \"WebSite\",\n    \"@id\": \"https://www.kraken.com/#website\",\n    \"url\": \"https://www.kraken.com/\",\n    \"name\": \"Kraken\",\n    \"alternateName\": \"Kraken Exchange\",\n    \"description\": \"Buy, sell, trade and learn about crypto on Kraken — the simple, powerful crypto platform that grows with you.\",\n    \"publisher\": { \"@id\": \"https://www.kraken.com/#organization\" },\n    \"potentialAction\": {\n      \"@type\": \"SearchAction\",\n      \"target\": {\n        \"@type\": \"EntryPoint\",\n        \"urlTemplate\": \"https://www.kraken.com/search?q={query}\"\n      },\n      \"query\": \"required\"\n    }\n  }\n]"}],"field_default_social_sharing_img":{"_type":"image","asset":{"_ref":"image-fb7be0bec460a4c04256ee14d1e84bc4f53fac01-1600x900-png","_type":"sanity.imageAsset","mimeType":"image/png","metadata":{"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.7777777777777777,"height":900,"width":1600},"lqip":""},"_id":"image-fb7be0bec460a4c04256ee14d1e84bc4f53fac01-1600x900-png","sanityUrl":"https://assets-cms.kraken.com/images/51n36hrp/facade/fb7be0bec460a4c04256ee14d1e84bc4f53fac01-1600x900.png","backdropTone":"dark"}},"field_header_icon_height":34,"firstPublishedAt":"2026-01-19T14:04:05.416Z","lastPublishedAt":"2026-08-10T10:43:24.112Z","score":0},"globalSearch":{"_id":"config.globalSearch-facade","_system":{"base":{"id":"config.globalSearch-facade","rev":"KUrG3XTMuPQBLrSQ0SMu3y"}},"_type":"config.globalSearch","field_global_Search_swap_widget_cta":"Convert {{asset1}} to {{asset2}}","field_global_Search_swap_widget_label":"Buy Bitcoin and 490+ other crypto assets","field_global_search_action_auto_earn":"Auto earn {{asset}}","field_global_search_action_buy":"Buy {{asset}}","field_global_search_action_buy_crypto":"Buy crypto","field_global_search_action_convert":"Convert {{asset}}","field_global_search_action_convert_crypto":"Convert crypto","field_global_search_action_convert_money":"Convert money","field_global_search_action_explore_categories":"Explore all categories","field_global_search_action_explore_stocks":"Explore Stocks","field_global_search_action_predict":"Predict {{asset}} Price","field_global_search_action_sell":"Sell {{asset}}","field_global_search_action_sell_crypto":"Sell crypto","field_global_search_action_send_money":"Send money","field_global_search_action_stake":"Stake {{asset}}","field_global_search_action_tokenized_stocks":"Explore xStocks","field_global_search_category_assets_label":"{{assetCount}} assets","field_global_search_enabled":true,"field_global_search_filter_all_label":"All","field_global_search_filter_asset_categories":"Asset Categories","field_global_search_filter_assets":"Assets","field_global_search_filter_categories":"Categories","field_global_search_filter_converter":"Converter","field_global_search_filter_crypto_label":"Crypto","field_global_search_filter_learn_label":"Learn","field_global_search_filter_markets":"Markets","field_global_search_filter_new_crypto":"New Crypto","field_global_search_filter_no_results":"No Results","field_global_search_filter_staking_earn":"Staking & Earn","field_global_search_filter_stocks_label":"Stocks","field_global_search_filter_support_label":"Support","field_global_search_filter_topics":"Topics","field_global_search_focused_button_text":"Esc","field_global_search_futures_maturity_label":"Future {{maturity}}","field_global_search_futures_perp_label":"Perp","field_global_search_input_placeholder":"Find your next trade","field_global_search_markets_to_label":"to","field_global_search_no_results_action":"Try another term or explore trending topics below.","field_global_search_no_results_message":"No results found for \"{{term}}\"","field_global_search_section_categories":"Categories","field_global_search_section_category_assets":"Category Assets","field_global_search_section_crypto_assets":"Crypto Assets","field_global_search_section_futures":"Futures","field_global_search_section_most_popular":"Most popular global markets","field_global_search_section_newly_listed":"Newly listed crypto","field_global_search_section_popular_actions":"Popular actions","field_global_search_section_popular_categories":"Popular Categories","field_global_search_section_popular_markets":"Popular Markets","field_global_search_section_popular_searches":"Popular searches","field_global_search_section_popular_stocks":"Popular stocks","field_global_search_section_spot_margin_markets":"Spot & Margin","field_global_search_section_staking_earn":"Staking & Earn","field_global_search_section_stocks":"Stocks","field_global_search_section_support":"Support","field_global_search_section_top_category_assets":"Top {{category}} assets","field_global_search_staking_available_on":"Available on","field_global_search_staking_bonded":"Bonded","field_global_search_staking_bonded_time":"Bonded time","field_global_search_staking_explore_label":"Explore {{asset}}","field_global_search_staking_flexible":"Flexible","field_global_search_staking_payout":"Payout","field_global_search_staking_title":"Earn with {{asset}}","field_global_search_staking_weekly":"Weekly","field_global_search_subsection_etfs":"ETFs","field_global_search_subsection_stocks":"Stocks","field_global_search_subsection_xstocks":"xStocks","field_global_search_to_navigate_label":"to navigate","field_global_search_to_select_label":"to select","field_global_search_trigger_label":"Search","field_global_search_view_all":"View all","firstPublishedAt":"2026-01-19T14:03:59.892Z","lastPublishedAt":"2026-03-19T21:27:12.782Z","score":0}},"data":{"_createdAt":"2025-09-12T13:14:24.000Z","_id":"6a7eb887-7ef2-4f67-b315-57003746caef","_system":{"base":{"id":"6a7eb887-7ef2-4f67-b315-57003746caef","rev":"BLSIjgAk8l8udL15Auyd9W"}},"_type":"page","content_source_locale":"en_us","enabled_locales":[],"field_hidden_menu_links":[],"field_hide_footer":false,"field_hide_footer_cta":false,"field_page_components":[{"_key":"0bd8194733c1","_type":"paragraphArticleLayout","field_audio_title":"Kraken AI podcast","field_author_additional_text":"By","field_children":[{"_key":"67a2b3b834a6","_type":"paragraphArticleHeadingBody","field_body":"\u003cp>Whether you&rsquo;re just getting started on your investing journey or you&rsquo;re a seasoned crypto trader, you&rsquo;ll find a Kraken product that fits your needs at a competitive price point you&rsquo;ll love. Browse the table below to learn more about the fee structure for each of our offerings.\u003c/p>\n","field_heading":"Industry leading fees across all our products","field_level":1,"field_skip_navigation":true},{"_key":"948adcf2e8e2","_type":"paragraphArticleHeadingBody","field_heading":"Kraken","field_heading_image":{"_type":"image","field_figma_image":{"_ref":"figma-image-z5bldEook1JzFJ4byZXDcE-29227_9276","_type":"taxonomyFigmaImage","field_alt":"Kraken App","_id":"figma-image-z5bldEook1JzFJ4byZXDcE-29227_9276","image":{"asset":{"_type":"sanity.imageAsset","mimeType":"image/svg+xml","metadata":{"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1,"height":1024,"width":1024},"lqip":""},"_ref":"image-d0f1f312fb60e79892d6c61b3bce79b41c2c9986-1024x1024-svg","sanityUrl":"https://assets-cms.kraken.com/images/51n36hrp/facade/d0f1f312fb60e79892d6c61b3bce79b41c2c9986-1024x1024.svg"}}}},"field_level":1,"field_skip_navigation":false},{"_key":"7295b0bbbade","_type":"paragraphAccordion","field_children":[{"_key":"61b57aa63085","_type":"paragraphAccordionItem","field_children":[{"_key":"14bf1ede810f","_type":"paragraphArticleBodyLc","field_body":"\u003cp>Instantly buy, sell or convert \u003ca href=\"/prices/bitcoin\">Bitcoin\u003c/a> or other cryptocurrencies&nbsp; on Kraken.com or via the Kraken App.*\u003c/p>\n"},{"_key":"258d7b862b0f","_type":"paragraphArticleBodyLc","field_body":"\u003cp>\u003cstrong>Kraken Fees\u003c/strong>\u003cbr>\u003cbr>When you buy, sell, or convert cryptocurrencies or fiat on Kraken, fees apply. These include:\u003cbr>\u003cbr>\u003cu>Trading Fees\u003c/u>: Kraken charges a 1% trading fee on instant and recurring trades and a 1.5% fee on custom orders, which are waived for Kraken+ members on trading volume up to $10,000 per month (details below).\u003cbr>\u003cbr>\u003cu>Payment Fees\u003c/u>: Additional fees may apply depending on your chosen payment method, such as using a credit/debit card, Apple Pay/Google Pay ACH transfer, or your Kraken account balance.\u003cbr>For small balance conversions using the “Convert Small Balances” feature, a fixed 3% fee applies to amounts below the minimum order size.\u003cbr>\u003cbr>\u003cstrong>Spread\u003c/strong>\u003cbr>\u003cbr>When using Kraken’s Instant Buy/Sell Services, including custom and recurring purchases, the price you see includes a spread, the difference between the market rate and the rate you receive. This spread ensures price certainty at the time of order execution.\u003cbr>Kraken may retain any excess spread from a transaction. Please note that the spread may vary for similar transactions. The size of the spread varies based on factors such as: market volatility, asset type, order size and type, Kraken VIP status, and overall account activity.\u003cbr>\u003cbr>\u003cstrong>Kraken+\u003c/strong>\u003cbr>\u003cbr>\u003cu>Zero Trading Fees\u003c/u>: Kraken+ members enjoy zero trading fees on up to $10,000 USD (or the local currency equivalent) in monthly trading volume for major currencies (USD, GBP, CAD, AUD, EUR, CHF).\u003cbr>This benefit applies only to trades made through the Buy, Sell, or Convert features on the Kraken app or web, and does not include Spot, Futures, API, or OTC trades on Kraken Pro.\u003cbr>\u003cbr>Note: While trading fees are waived, spreads and card processing fees still apply.\u003c/p>"},{"_key":"500dfbfe2bd2","_type":"paragraphArticleBodyLc","field_body":"\u003cp>\u003csup>*Currently the Kraken App is only available in the countries listed in the &ldquo;Requirements&rdquo; section of \u003ca href=\"https://support.kraken.com/hc/en-us/articles/360048212832-Buy-Crypto-with-your-credit-or-debit-card\">this article\u003c/a>.\u003c/sup>\u003c/p>\n"}],"field_id":"instant-buysell","field_is_expanded":false,"field_title":"Instant Buy/Sell"},{"_key":"693709b7bf43","_type":"paragraphAccordionItem","field_children":[{"_key":"a67cf3717414","_type":"paragraphArticleBodyLc","field_body":"\u003cp>On-chain staking utilizes blockchain Proof-of-Stake protocol to generate rewards through a process typically called &ldquo;staking&rdquo;.\u003c/p>\n\n\u003cp>Benefits of On-chain staking on Kraken:\u003c/p>\n\n\u003cul>\n\t\u003cli>Start earning rewards instantly &mdash; no waiting or bonding periods\u003c/li>\n\t\u003cli>One of the highest returns in the industry\u003c/li>\n\t\u003cli>Stake your assets in just three clicks from your Kraken balances\u003c/li>\n\t\u003cli>Instant un-staking when using Flexible terms\u003c/li>\n\u003c/ul>\n"},{"_key":"4fce26160ef6","_type":"paragraphArticleBodyLc","field_body":"\u003cul>\n\t\u003cli>There are currently no transaction fees for Rewards staking or unstaking. On-chain staking commissions apply and are deducted from the rewards earned on your staked assets.\u003c/li>\n\t\u003cli>Flexible staking on assets with an on-chain unbonding period and staked assets in our Rewards program is subject to a 20% commission.\u003c/li>\n\t\u003cli>Bonded staking and flexible staking on assets with no on-chain unbonding period are subject to commissions based on current balances staked per asset.\u003c/li>\n\t\u003cli>For more information, please see&nbsp;\u003ca href=\"https://support.kraken.com/hc/articles/360037682011\">Fees in our On-chain staking support page.\u003c/a>\u003c/li>\n\u003c/ul>\n"},{"_key":"4a5f52b6d086","_type":"paragraphArticleBodyLc","field_body":"\u003cp>\u003csup>*Availability can be&nbsp;\u003ca data-sk=\"tooltip_parent\" data-stringify-link=\"https://support.kraken.com/hc/en-us/articles/360001368823\" href=\"https://support.kraken.com/hc/en-us/articles/360001368823\" target=\"_blank\">found here\u003c/a>. If On-chain staking is not showing as an option on your account, you may not be eligible.\u003c/sup>\u003c/p>\n"}],"field_id":"onchain-staking","field_is_expanded":false,"field_title":"On-chain Staking"},{"_key":"caf25b833c09","_type":"paragraphAccordionItem","field_children":[{"_key":"9d6e6bb262e8","_type":"paragraphArticleBodyLc","field_body":"\u003cp>Kraken may adjust its deposit and withdrawal fees in response to changes in the underlying costs, market conditions, or user activity. Clients are encouraged to review the account deposit or withdrawal page on Kraken&#39;s website and app for the most current information regarding deposit and withdrawal fees.\u003c/p>\n\n\u003cul>\n\t\u003cli>Kraken&rsquo;s deposit and withdrawal transaction fees are based on the method and currency used.\u003c/li>\n\t\u003cli>Funding Fees can be both Static (fixed) and Dynamic (variable) in order to reflect the network and processing fees associated with a specific transaction as well as different costs incurred by Kraken.\u003c/li>\n\t\u003cli>Kraken may implement a percentage-based fee to accurately reflect different costs incurred by Kraken.\u003c/li>\n\t\u003cli>Funding Fees can be both coin-denominated or percentage-based.\u003c/li>\n\t\u003cli>Fees displayed upon confirmation of a transaction are always the fees incurred by clients.\u003c/li>\n\t\u003cli>For more information please check our article on&nbsp;\u003ca href=\"https://support.kraken.com/hc/articles/360000292886\">Cryptocurrency deposit fees and minimums\u003c/a>,&nbsp;\u003ca href=\"https://support.kraken.com/hc/articles/360000767986\">Cryptocurrency withdrawal fees and minimums\u003c/a>,&nbsp;\u003ca href=\"https://support.kraken.com/hc/articles/360000381846\">Cash deposit options\u003c/a>, and&nbsp;\u003ca href=\"https://support.kraken.com/hc/articles/360000423043\">Cash withdrawal options\u003c/a>.\u003c/li>\n\u003c/ul>\n"}],"field_id":"deposit-withdrawal","field_is_expanded":false,"field_title":"Deposit & Withdrawal"},{"_key":"fa69312b9511","_type":"paragraphAccordionItem","field_children":[{"_key":"59c003caf3b3","_type":"paragraphArticleBodyLc","field_body":"\u003cp>Kraken offers commission-free trading for 11k+ stocks and ETFs\u003c/p>\n"},{"_key":"8dc0e581937b","_type":"paragraphArticleBodyLc","field_body":"\u003cul>\n\t\u003cli>Zero commission for trading stocks and ETFs.\u003c/li>\n\t\u003cli>Regulatory agencies may charge fees that are passed to the investor. \u003ca href=\"/legal/equities\">Learn more here.\u003c/a>\u003c/li>\n\u003c/ul>\n"},{"_key":"4e5becfed615","_type":"paragraphArticleBodyLc","field_body":"\u003cp>\u003csup>*Currently available in the U.S. only\u003c/sup>\u003c/p>\n"}],"field_id":"stocks","field_is_expanded":false,"field_title":"Stocks"},{"_key":"53b68fdf7ab7","_type":"paragraphAccordionItem","field_children":[{"_key":"13cb8d986d70","_type":"paragraphArticleBodyLc","field_body":"\u003cul>\n\t\u003cli>\u003cstrong>&nbsp;\u003c/strong>There are no trading fees when purchasing xStocks with USDG or USD on Kraken.\u003c/li>\n\t\u003cli>The standard 1% instant buy/sell trading fee applies when purchasing xStocks using other assets.\u003c/li>\n\t\u003cli>To lock in a price, a spread may be included in the asset price for each transaction.\u003c/li>\n\u003c/ul>\n"},{"_key":"116de76c3869","_type":"paragraphArticleBodyLc","field_body":"\u003cp>\u003csup>*Availability can be \u003ca href=\"https://support.kraken.com/articles/xstocks-availability\" style=\"text-decoration:none\">\u003cu>found here\u003c/u>\u003c/a>. If xStocks is not showing as an option on your account, you may not be eligible.\u003c/sup>\u003c/p>\n"}],"field_id":"xstocks","field_is_expanded":false,"field_title":"xStocks"},{"_key":"a99989800de3","_type":"paragraphAccordionItem","field_children":[{"_key":"2588a8b6cec4","_type":"paragraphArticleBodyLc","field_body":"\u003cp>A simple, flexible way to trade on where you think prices are headed on &mdash; without needing to own the underlying asset.\u003c/p>\n"},{"_key":"e39ef4071dce","_type":"paragraphArticleBodyLc","field_body":"\u003cul>\n\t\u003cli>A 0.25% fee is applied to the notional value of the trade to open the position.\u003c/li>\n\t\u003cli>A 0.25% fee is applied to the closed notional value of the trade to close the position.\u003c/li>\n\u003c/ul>\n"},{"_key":"c08528cc224e","_type":"paragraphArticleBodyLc","field_body":"\u003cp>\u003csup>*Currently available in certain geos\u003c/sup>\u003c/p>\n"}],"field_id":"perps","field_is_expanded":false,"field_title":"Perps"}]},{"_key":"727b740c5ddb","_type":"paragraphArticleButtonLink","field_download_on_click":false,"field_event":{"_ref":"c1d5f6a8-fdbf-4737-bb69-ec7b32f6cd13","_type":"taxonomyAnalyticsEvents","_id":"c1d5f6a8-fdbf-4737-bb69-ec7b32f6cd13","firstPublishedAt":"2024-06-26T09:26:17.518Z","name":"Create Account CTA Clicked"},"field_is_download_link":false,"field_link":{"_type":"link","text":"Get started with Kraken","url":"{{ \"https://k.k.xyz/JDNW\" if isMobile else \"/sign-up\" }}"},"field_nofollow":false,"field_skip_automatic_adjustments":false},{"_key":"fd02da0ae1dc","_type":"paragraphArticleHeadingBody","field_heading":"Kraken Pro","field_heading_image":{"_type":"image","field_figma_image":{"_ref":"figma-image-z5bldEook1JzFJ4byZXDcE-29227_9294","_type":"taxonomyFigmaImage","field_alt":"Kraken Pro","_id":"figma-image-z5bldEook1JzFJ4byZXDcE-29227_9294","image":{"asset":{"_type":"sanity.imageAsset","mimeType":"image/svg+xml","metadata":{"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1,"height":1024,"width":1024},"lqip":""},"_ref":"image-00d9685fa4627cc0abd8a2957e8efcfdffbbc2dc-1024x1024-svg","sanityUrl":"https://assets-cms.kraken.com/images/51n36hrp/facade/00d9685fa4627cc0abd8a2957e8efcfdffbbc2dc-1024x1024.svg"}}}},"field_level":1,"field_skip_navigation":false},{"_key":"f425085487e5","_type":"paragraphSpacingVertical","field_size":4},{"_key":"5f85f29789ca","_type":"paragraphNotification","field_text":"\u003cp>Kraken has recently introduced Cross-platform fee tiers, read \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://www.kraken.com/features/fee-schedule#cross-platform-fee-tiers\">here\u003c/a> for details.\u003c/p>\u003cp>\u003cbr>\u003c/p>\u003cp>You can also check out our \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://support.kraken.com/articles/cross-platform-fee-tier-changes\">support article\u003c/a> which contains additional information.\u003c/p>","field_tone":"positive"},{"_key":"77efcfab2fb8","_type":"paragraphAccordion","field_children":[{"_key":"2fb567ed473d","_type":"paragraphAccordionItem","field_children":[{"_key":"334243cbc40b","_type":"paragraphArticleHeadingBody","field_body":"\u003cp>Previously, your tier on each product was based solely on your trading volume in that product. Going forward, your tier is based on the \u003cstrong>best of\u003c/strong>:\u003c/p>\u003cul>\u003cli>\u003cp>Your \u003cstrong>spot trading volume\u003c/strong>\u003c/p>\u003c/li>\u003cli>\u003cp>Your \u003cstrong>Assets on Platform (AoP)\u003c/strong>\u003c/p>\u003c/li>\u003c/ul>\u003cp>The measure that qualifies you for the highest tier applies. Holding assets on Kraken can now qualify you for lower trading fees, the more you hold, the lower your rate could be. If more than one measure qualifies you for the same tier, your rates remain unchanged, qualifying through multiple measures at the same tier does not provide additional benefits.\u003c/p>\u003cp>\u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://support.kraken.com/articles/cross-platform-fee-tier-changes\">\u003cem>More information about cross-platform fee tiers\u003c/em>\u003c/a>\u003c/p>\u003cspan style=\"font-size: 0.75em;\">Scroll table to the right to view percentages\u003c/span>","field_heading":"How your tier is determined","field_level":2,"field_skip_navigation":false},{"_key":"525fdc8edfc3","_type":"paragraphArticleBodyTable","field_rows":[{"_key":"c2dbce0277dd","field_cells":[{"_key":"4583256a5a76","cell_description":"Content of Column 1","field_content":"Tier"},{"_key":"245b8a31771f","cell_description":"Content of Column 2","field_content":"\u003cp>Spot 30-Day Vol (USD) \u003cstrong>OR\u003c/strong>\u003c/p>"},{"_key":"1eab1f281b4e","cell_description":"Content of Column 3","field_content":"AoP (USD)"},{"_key":"b3d0c45cbb7f","cell_description":"Content of Column 4","field_content":"\u003cp>Maker (%)\u003c/p>"},{"_key":"fbe23e2ef068","cell_description":"Content of Column 5","field_content":"\u003cp>Taker (%)\u003c/p>"}],"row_description":"Row :: Tier"},{"_key":"b3b5db6885b8","field_cells":[{"_key":"7c098271d1d4","cell_description":"Content of Column 1","field_content":"Tier 1"},{"_key":"14ea4b73b757","cell_description":"Content of Column 2","field_content":"$0+"},{"_key":"4ef704765a31","cell_description":"Content of Column 3","field_content":"N/A"},{"_key":"e918e93cabb4","cell_description":"Content of Column 4","field_content":"\u003cp>0.40 %\u003c/p>"},{"_key":"45adbb8298b2","cell_description":"Content of Column 5","field_content":"\u003cp>0.80 %\u003c/p>"}],"row_description":"Row :: Tier 1"},{"_key":"aacca0fb0440","field_cells":[{"_key":"c81f7c2e1dff","cell_description":"Content of Column 1","field_content":"Tier 2"},{"_key":"287a345427d5","cell_description":"Content of Column 2","field_content":"$2.5K+"},{"_key":"4fbba9b8bff2","cell_description":"Content of Column 3","field_content":"N/A"},{"_key":"6417d5ae05dc","cell_description":"Content of Column 4","field_content":"\u003cp>0.30 %\u003c/p>"},{"_key":"591badd7a574","cell_description":"Content of Column 5","field_content":"\u003cp>0.60 %\u003c/p>"}],"row_description":"Row :: Tier 2"},{"_key":"3961d7b9d119","field_cells":[{"_key":"60356465d4ae","cell_description":"Content of Column 1","field_content":"Tier 3"},{"_key":"4c035ca3a4a6","cell_description":"Content of Column 2","field_content":"$10K+"},{"_key":"2afd35338f8b","cell_description":"Content of C