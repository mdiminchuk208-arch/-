  <div class="status-day font-regular">
    <h3 class="date border-color font-large">Sep <var data-var="date">29</var>, <var data-var="year">2026</var></h3>
  </div>

      </div>


      <div class="page-footer border-color font-small">
          <a href="/history" class="history-footer-link"><span style="font-family:arial" aria-hidden="true">&larr;</span> Incident History</a>

        <span class="color-secondary powered-by"><a class="color-secondary" target="_blank" rel="noopener noreferrer nofollow" href="https://www.atlassian.com/software/statuspage?utm_campaign=status.kraken.com&amp;utm_content=SP-notifications&amp;utm_medium=powered-by&amp;utm_source=inapp">Powered by Atlassian Statuspage</a></span>
      </div>
    </div>

      <div class="custom-footer-container">
    <script>
(function () {
  'use strict';

  var CFG = {
    collapseGroups: true,   // component groups start closed unless they have an issue
    keepOpenUpdates: 1,     // updates shown per past incident before collapsing
    search: true,           // component search field
    strip: true,            // status summary above the incidents
    scrollAfter: 12,        // child rows before a group list becomes scrollable
    issuesFirst: true,      // affected rows first, then alphabetical
    historyCard: true,      // promote the footer history link to a card
    clampMaintenance: true, // fade out long scheduled maintenance notices
    clampHeight: 150        // visible height in px before the fade
  };

  var STATES = [
    { key: 'major',    test: /major outage/i },
    { key: 'partial',  test: /partial outage/i },
    { key: 'degraded', test: /degraded/i },
    { key: 'maint',    test: /maintenance/i },
    { key: 'ok',       test: /operational/i }
  ];

  var LABEL = {
    ok:       'operational',
    degraded: 'degraded',
    partial:  'partial outage',
    major:    'major outage',
    maint:    'under maintenance'
  };

  var RANK = { ok: 0, maint: 1, degraded: 2, partial: 3, major: 4 };

  // Used when an incident is open, since the component list may not tell the
  // whole story
  var GENERAL = {
    degraded: 'Some systems degraded',
    partial:  'Some systems experiencing an outage',
    major:    'Some systems experiencing a major outage',
    maint:    'Maintenance in progress'
  };

  function $(sel, root) { return (root || document).querySelector(sel); }
  function $$(sel, root) { return Array.prototype.slice.call((root || document).querySelectorAll(sel)); }
  function text(el) { return el ? (el.textContent || '').replace(/\s+/g, ' ').trim() : ''; }

  function classify(str) {
    for (var i = 0; i < STATES.length; i++) {
      if (STATES[i].test.test(str)) return STATES[i].key;
    }
    return null;
  }

  /* ── Subscribe control into the header bar ────────────────── */
  /* Statuspage positions this element with an inline top value after load,
     so it can be re-parented at any point. The slot is kept permanently and
     the control is put back on every run rather than moved once. */
  function subscribe() {
    var slot = $('#k-subscribe-slot');
    if (!slot) return;

    var host = $('.updates-dropdown-container') ||
               $('[data-js-hook="updates-dropdown-container"]');
    if (!host) {
      var btn = $('#show-updates-dropdown') || $('.show-updates-dropdown');
      host = btn ? (btn.closest('[class*="updates-dropdown"]') || btn) : null;
    }
    if (!host) return;

    if (host.parentNode !== slot) slot.appendChild(host);
    host.classList.add('k-subscribe-host');

    // The inline offset is measured against its original position
    if (host.style.top) host.style.top = '';

    // If the panel is a sibling rather than a child, bring it along
    var panel = document.querySelector('.updates-dropdown');
    if (panel && !host.contains(panel) && panel.parentNode !== slot) slot.appendChild(panel);

    var label = $('.subscribe-text-full', host);
    if (label && text(label) !== 'Subscribe') label.textContent = 'Subscribe';
  }

  /* ── Components ───────────────────────────────────────────── */
  function components() {
    var tally = { ok: 0, degraded: 0, partial: 0, major: 0, maint: 0 };

    // Statuspage rounds the first card top-only and the last bottom-only to
    // fuse the list into one block, from a selector too specific to override
    // in CSS. Their declaration is !important, which outranks a plain inline
    // style, so this has to be inline AND important to win.
    $$('.components-container > .component-container').forEach(function (card) {
      if (card.style.getPropertyPriority('border-radius') === 'important') return;
      card.style.setProperty('border-radius', '12px', 'important');
    });

    $$('.component-inner-container').forEach(function (row) {
      var pill = $('.component-status', row);
      var state = classify(text(pill));

      if (!state) {
        var cls = row.className;
        if (/status-red/.test(cls)) state = 'major';
        else if (/status-orange/.test(cls)) state = 'partial';
        else if (/status-yellow/.test(cls)) state = 'degraded';
        else if (/status-blue/.test(cls)) state = 'maint';
        else if (/status-green/.test(cls)) state = 'ok';
      }
      if (!state) return;

      // Statuspage sizes .component-status itself, so the pill is boxed in a
      // fixed-width column to keep every status on one vertical line.
      if (pill && !pill.parentNode.classList.contains('k-status-col')) {
        var col = document.createElement('span');
        col.className = 'k-status-col';
        pill.parentNode.insertBefore(col, pill);
        col.appendChild(pill);
      }

      row.classList.remove('k-c-ok', 'k-c-degraded', 'k-c-partial', 'k-c-major', 'k-c-maint');
      row.classList.add('k-c-' + state);
      row.dataset.kState = state;
      tally[state]++;
    });

    // Standalone components, no children
    $$('.component-container').forEach(function (card) {
      if ($('.child-components-container', card)) return;
      var header = card.querySelector(':scope > .component-inner-container');
      var st = header && header.dataset.kState;
      markIssue(card, st && st !== 'ok' ? st : null);
    });

    $$('.component-container').forEach(function (group) {
      var kids = $('.child-components-container', group);
      if (!kids) return;
      if (!group.classList.contains('is-group')) group.classList.add('is-group');

      var header = group.querySelector(':scope > .component-inner-container');
      if (!header) return;

      var rows = $$('.component-inner-container', kids);
      var bad = rows.filter(function (r) { return r.dataset.kState && r.dataset.kState !== 'ok'; });

      if (!group.dataset.kDone) {
        group.dataset.kDone = '1';

        var caret = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        caret.setAttribute('class', 'k-caret');
        caret.setAttribute('viewBox', '0 0 24 24');
        caret.setAttribute('fill', 'none');
        caret.setAttribute('stroke', 'currentColor');
        caret.setAttribute('stroke-width', '2');
        caret.setAttribute('stroke-linecap', 'round');
        caret.setAttribute('stroke-linejoin', 'round');
        caret.setAttribute('aria-hidden', 'true');
        var path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        path.setAttribute('d', 'M9 18l6-6-6-6');
        caret.appendChild(path);
        header.insertBefore(caret, header.firstChild);

        header.setAttribute('role', 'button');
        header.setAttribute('tabindex', '0');
        header.addEventListener('click', function (e) {
          if (e.detail > 0 && header.blur) header.blur();
          toggleGroup(group);
        });
        header.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggleGroup(group); }
        });

        applyOpen(group, !CFG.collapseGroups || bad.length > 0, false);
        kids.addEventListener('transitionend', onGroupTransitionEnd);
      }

      var rollup = $('.k-rollup', header);
      if (!rollup) {
        rollup = document.createElement('span');
        rollup.className = 'k-rollup';
        var col = $('.k-status-col', header) || $('.component-status', header);
        if (col) header.insertBefore(rollup, col); else header.appendChild(rollup);
      }
      var label = rows.length
        ? (rows.length - bad.length) + ' of ' + rows.length + ' operational'
        : '';
      if (rollup.textContent !== label) rollup.textContent = label;

      markIssue(group, bad.length ? worstOf(bad) : null);
      orderRows(kids, rows, bad);

      if (rows.length > CFG.scrollAfter && !kids.classList.contains('k-scroll')) {
        kids.classList.add('k-scroll');
        kids.addEventListener('scroll', function () {
          var atEnd = kids.scrollTop + kids.clientHeight >= kids.scrollHeight - 8;
          group.classList.toggle('k-at-end', atEnd);
        });
      }

      setExpanded(group);
      updateScroll(group);
    });

    return tally;
  }

  /* Affected rows move to the top of their group so they are visible without
     scrolling a list that can run to several hundred entries. */
  /* ── Row order inside a group ─────────────────────────────── */
  /* Affected rows first, then everything else, each block alphabetical.
     Saves reordering hundreds of components by hand in the Statuspage UI,
     and the ordering there no longer matters for how the page reads. */
  function orderRows(kids, rows, bad) {
    rows.forEach(function (r) { r.classList.remove('k-after-issues'); });
    if (rows.length < 2) return;

    function name(r) { return text($('.name', r)).toLowerCase(); }

    function alpha(a, b) {
      return name(a).localeCompare(name(b), undefined, {
        numeric: true,      // Bitcoin 2 after Bitcoin 10 would be wrong
        sensitivity: 'base' // ignores case and accents
      });
    }

    var isBad = {};
    bad.forEach(function (r, i) { isBad[i] = true; });

    var badRows = rows.filter(function (r) { return bad.indexOf(r) > -1; }).sort(alpha);
    var okRows = rows.filter(function (r) { return bad.indexOf(r) === -1; }).sort(alpha);
    var want = badRows.concat(okRows);

    // Only touch the DOM when the order actually changes, otherwise the
    // mutation observer sees this as new nodes and re-runs on a loop
    var same = true;
    for (var i = 0; i < want.length; i++) {
      if (want[i] !== rows[i]) { same = false; break; }
    }
    if (!same) {
      var frag = document.createDocumentFragment();
      want.forEach(function (r) { frag.appendChild(r); });
      kids.appendChild(frag);
    }

    if (badRows.length && okRows.length) {
      okRows[0].classList.add('k-after-issues');
    }
  }

  function worstOf(rows) {
    var worst = 'ok';
    rows.forEach(function (r) {
      if (RANK[r.dataset.kState] > RANK[worst]) worst = r.dataset.kState;
    });
    return worst;
  }

  function markIssue(card, state) {
    ['degraded', 'partial', 'major', 'maint'].forEach(function (k) {
      card.classList.toggle('k-issue-' + k, state === k);
    });
    card.classList.toggle('k-has-issue', !!state);
  }

  /* Show the bottom fade only while there is more list below the fold */
  function updateScroll(group) {
    var kids = $('.child-components-container', group);
    if (!kids) return;
    var overflowing = kids.classList.contains('k-scroll') &&
      kids.scrollHeight > kids.clientHeight + 8;
    group.classList.toggle('k-scrollable', overflowing && group.classList.contains('k-open'));
    if (!overflowing) group.classList.remove('k-at-end');
  }

  /* ── Group open state ─────────────────────────────────────── */
  /* Height is animated rather than toggling display, which cannot
     transition. Long lists are capped by the scroll class, so the animated
     distance stays bounded no matter how many rows a group holds. */
  function applyOpen(group, open, animate) {
    var kids = $('.child-components-container', group);
    if (!kids) return;

    var was = group.classList.contains('k-open');

    if (!animate) {
      group.classList.toggle('k-open', open);
      setExpanded(group);
      kids.style.transition = 'none';
      if (open) {
        // Cleared, not set to none. The scroll cap lives in CSS and an
        // inline height would override it, leaving long lists uncapped.
        kids.style.maxHeight = '';
        kids.style.overflowY = '';
      } else {
        kids.style.maxHeight = '0px';
        kids.style.overflowY = 'hidden';
      }
      void kids.offsetHeight;
      kids.style.transition = '';
      updateScroll(group);
      return;
    }

    if (open === was) return;

    if (open) {
      group.classList.toggle('k-open', true);
      setExpanded(group);
      var cap = kids.classList.contains('k-scroll') ? 440 : kids.scrollHeight;
      var target = Math.min(kids.scrollHeight, cap);
      kids.style.overflowY = 'hidden';
      kids.style.maxHeight = target + 'px';
    } else {
      // Measured before the class comes off. Removing it collapses the
      // padding and restores max-height 0, so measuring afterwards reads
      // zero and the close animates from nothing to nothing.
      //
      // While open the computed max-height is none, and none to a pixel
      // value cannot be transitioned. Two frames are needed so the pixel
      // height is painted before the collapse starts, a forced reflow read
      // is not enough here.
      kids.style.overflowY = 'hidden';
      kids.style.maxHeight = kids.getBoundingClientRect().height + 'px';

      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          group.classList.toggle('k-open', false);
          setExpanded(group);
          kids.style.maxHeight = '0px';
          updateScroll(group);
        });
      });
      return;
    }

    updateScroll(group);
  }

  function onGroupTransitionEnd(e) {
    if (e.propertyName !== 'max-height') return;
    var kids = e.currentTarget;
    var group = kids.closest('.component-container');
    if (!group || !group.classList.contains('k-open')) return;
      kids.style.maxHeight = '';
      kids.style.overflow = '';
      kids.style.overflowY = '';
    updateScroll(group);
  }

  function toggleGroup(group) {
    applyOpen(group, !group.classList.contains('k-open'), true);
  }

  function setExpanded(group) {
    var header = group.querySelector(':scope > .component-inner-container');
    if (header) header.setAttribute('aria-expanded', group.classList.contains('k-open') ? 'true' : 'false');
  }

  /* ── Component search ─────────────────────────────────────── */
  function search() {
    if (!CFG.search) return;
    var section = $('.components-section');
    if (!section || $('#k-search-wrap')) return;

    var wrap = document.createElement('div');
    wrap.id = 'k-search-wrap';
    wrap.innerHTML =
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">' +
      '<circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>' +
      '<input id="k-search" type="search" autocomplete="off" placeholder="Search components, assets or networks">';
    section.parentNode.insertBefore(wrap, section);

    var empty = document.createElement('div');
    empty.id = 'k-search-empty';
    empty.textContent = 'No components match that search';
    section.parentNode.insertBefore(empty, section.nextSibling);

    var input = $('#k-search', wrap);
    var timer = null;

    input.addEventListener('input', function () {
      clearTimeout(timer);
      timer = setTimeout(function () { runFilter(input.value.trim().toLowerCase(), empty); }, 120);
    });
  }

  function runFilter(q, empty) {
    var hits = 0;

    $$('.component-container').forEach(function (group) {
      var header = group.querySelector(':scope > .component-inner-container');
      var kids = $('.child-components-container', group);
      var groupName = text($('.name', header)).toLowerCase();
      var groupHit = !q || groupName.indexOf(q) > -1;
      var childHits = 0;

      if (kids) {
        $$('.component-inner-container', kids).forEach(function (row) {
          var hit = !q || groupHit || text($('.name', row)).toLowerCase().indexOf(q) > -1;
          row.classList.toggle('k-hidden-row', !hit);
          if (hit) childHits++;
        });
      }

      var show = groupHit || childHits > 0;
      group.classList.toggle('k-hidden-row', !show);
      if (show) hits++;

      if (q) {
        applyOpen(group, childHits > 0 && !groupHit, false);
      } else if (CFG.collapseGroups) {
        applyOpen(group, group.classList.contains('k-has-issue'), false);
      }
      setExpanded(group);

      var kids2 = $('.child-components-container', group);
      if (kids2) kids2.scrollTop = 0;
      updateScroll(group);
    });

    if (empty) empty.classList.toggle('k-show', q.length > 0 && hits === 0);
  }

  /* ── Which incidents map to a component ───────────────────── */
  /* The index gives no way to tell whether an open incident touches a
     component. Asset search, for example, leaves every component reading
     Operational. The unresolved incidents endpoint carries a components
     array, so it is asked once per page load and the strip re-rendered.
     null means not known yet, in which case the strip assumes the
     components tell the story, which is the common case. */
  var unmapped = null;

  function loadIncidentMap() {
    if (unmapped !== null || loadIncidentMap.busy) return;
    if (!window.fetch) return;
    if (!$$('.unresolved-incidents .unresolved-incident').length) return;
    loadIncidentMap.busy = true;

    fetch('/api/v2/incidents/unresolved.json', { credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        var list = (data && data.incidents) || [];
        unmapped = list.filter(function (i) {
          return !i.components || !i.components.length;
        }).length;
        strip();
      })
      .catch(function () { unmapped = 0; });
  }

  /* ── Status strip ─────────────────────────────────────────── */
  /* Names the affected area rather than issuing a site-wide verdict.
     "All systems operational" requires both a clean component list and no
     open incident, since the two do not always move together. When an
     incident is open but no component is flagged, the strip stands down
     and lets the incident card speak. */
  function strip() {
    if (!CFG.strip) return;
    if (!$('.layout-content.status-index')) return;

    var container = $('.layout-content .container');
    if (!container) return;

    // Maintenance is tracked separately from degradation. Rolling both into
    // one worst-of label would describe a component that is merely under
    // maintenance as degraded whenever anything else is degraded.
    var worst = 'ok', degraded = [], maint = [];

    $$('.component-container').forEach(function (card) {
      var header = card.querySelector(':scope > .component-inner-container');
      var kids = $('.child-components-container', card);
      var name = text($('.name', header));
      var leaves = kids ? $$('.component-inner-container', kids) : (header ? [header] : []);
      var cardWorst = 'ok';

      leaves.forEach(function (row) {
        var st = row.dataset.kState;
        if (!st || st === 'ok') return;
        if (RANK[st] > RANK[cardWorst]) cardWorst = st;
        if (RANK[st] > RANK[worst]) worst = st;
      });

      if (cardWorst === 'ok' || !name) return;
      if (cardWorst === 'maint') maint.push(name);
      else degraded.push({ name: name, state: cardWorst });
    });

    var open = $$('.unresolved-incidents .unresolved-incident').length;
    var el = $('#k-strip');

    if (!degraded.length && !maint.length && !open) {
      // Nothing anywhere
      if (!el) {
        el = document.createElement('section');
        el.id = 'k-strip';
        el.innerHTML =
          '<span class="k-strip-dot"></span>' +
          '<span class="k-strip-main"></span>' +
          '<span class="k-strip-affected"></span>' +
          '<span class="k-strip-time"></span>';
        container.insertBefore(el, container.firstChild);
      }
      el.className = 'k-h-ok k-all-clear';
      $('.k-strip-main', el).textContent = 'All systems operational';
      $('.k-strip-affected', el).textContent = '';
      $('.k-strip-affected', el).style.display = 'none';
      stamp(el);
      return;
    }

    if (!el) {
      el = document.createElement('section');
      el.id = 'k-strip';
      el.innerHTML =
        '<span class="k-strip-dot"></span>' +
        '<span class="k-strip-main"></span>' +
        '<span class="k-strip-affected"></span>' +
        '<span class="k-strip-time"></span>';
      container.insertBefore(el, container.firstChild);
    }

    var main = $('.k-strip-main', el);
    var note = $('.k-strip-affected', el);

    function join(names) {
      var shown = names.slice(0, 2).join(' and ');
      if (names.length > 2) shown += ' and ' + (names.length - 2) + ' other areas';
      return shown;
    }

    function maintPhrase() {
      if (maint.length > 2) return maint.length + ' areas under maintenance';
      return join(maint) + ' under maintenance';
    }

    var dWorst = 'degraded';
    degraded.forEach(function (d) { if (RANK[d.state] > RANK[dWorst]) dWorst = d.state; });

    // General only when an open incident touches no component at all. If
    // every incident maps to something flagged, naming it is both accurate
    // and more useful than a vague headline.
    var vague = open && (unmapped === null ? !degraded.length : unmapped > 0);

    if (vague) {
      el.className = 'k-h-' + (degraded.length ? dWorst : 'degraded');
      main.textContent = GENERAL[degraded.length ? dWorst : 'degraded'];

      if (degraded.length) {
        note.textContent = join(degraded.map(function (d) { return d.name; })) + ' ' + LABEL[dWorst];
      } else if (maint.length) {
        note.textContent = maintPhrase();
      } else {
        note.textContent = 'See the open incidents below';
      }
      note.style.display = '';

    } else if (degraded.length) {
      // No incident open, so the components are the whole story and can be
      // named directly
      el.className = 'k-h-' + dWorst;
      // Safe to claim here: this branch only runs when nothing is open, or
      // when every open incident maps to a component that is already named
      main.textContent = join(degraded.map(function (d) { return d.name; })) + ' ' + LABEL[dWorst];
      note.textContent = maint.length ? maintPhrase() : 'Everything else is operating normally';
      note.style.display = '';

    } else {
      el.className = 'k-h-maint';
      main.textContent = maintPhrase();
      note.textContent = 'Everything else is operating normally';
      note.style.display = '';
    }

    stamp(el);
  }

  function stamp(el) {
    var now = new Date();
    var t = $('.k-strip-time', el);
    if (t) {
      t.textContent = 'Loaded ' + ('0' + now.getUTCHours()).slice(-2) + ':' +
                      ('0' + now.getUTCMinutes()).slice(-2) + ' UTC';
    }
  }

  /* ── Metrics header ───────────────────────────────────────── */
  /* The heading and the timeframe links are loose siblings, and the heading
     is not reliably inside .custom-metrics-container, so both are located
     defensively and given a real header row. */
  var TF_ORDER = { day: 0, week: 1, month: 2 };

  /* The heading is not an h1-h4 on this template, so it is located by
     elimination: the first short-text child that is neither the header row
     nor a metric card. */
  function findMetricsTitle(box) {
    var tag = box.querySelector('h1, h2, h3, h4');
    if (tag) return tag;

    var kids = Array.prototype.slice.call(box.children);
    for (var i = 0; i < kids.length; i++) {
      var el = kids[i];
      if (el.classList.contains('k-metrics-head')) continue;
      if (el.querySelector && (el.querySelector('a.timeframe') || el.querySelector('.metric'))) continue;
      if (el.classList.contains('metric') || el.classList.contains('metrics-container')) continue;
      var txt = text(el);
      if (txt && txt.length > 0 && txt.length < 40) return el;
    }
    return null;
  }

  function metricsHeader() {
    var box = $('.custom-metrics-container');
    if (!box) return;

    var links = $$('a.timeframe');
    var title = findMetricsTitle(box);
    if (!links.length && !title) return;

    var head = $('.k-metrics-head');
    if (!head) {
      head = document.createElement('div');
      head.className = 'k-metrics-head';
      box.insertBefore(head, box.firstChild);
    }

    // Heading first, toggle underneath it
    if (title && title.parentNode !== head) {
      title.classList.add('k-metrics-title');
      head.insertBefore(title, head.firstChild);
    }

    if (links.length) {
      var track = $('.k-timeframes', head);
      if (!track) {
        track = document.createElement('span');
        track.className = 'k-timeframes';
        head.appendChild(track);
      }
      links.sort(function (x, y) {
        var a1 = TF_ORDER[x.getAttribute('data-time-period')];
        var b1 = TF_ORDER[y.getAttribute('data-time-period')];
        return (a1 === undefined ? 9 : a1) - (b1 === undefined ? 9 : b1);
      });
      links.forEach(function (link) {
        if (link.parentNode !== track) track.appendChild(link);
      });
      if (track !== head.lastElementChild) head.appendChild(track);
    }
  }

  /* ── History card above the footer ────────────────────────── */
  /* The footer link is easy to miss, so it is promoted to a card. Anchored
     off .page-footer, which is present on every template. */
  function historyCard() {
    if (!CFG.historyCard) return;
    if (!$('.layout-content.status-index')) return;
    if ($('#k-history-card')) return;

    var footer = $('.page-footer');
    if (!footer || !footer.parentNode) return;

    var link = footer.querySelector('a[href*="/history"]');
    if (!link) {
      link = $$('a', footer).filter(function (a) {
        return /incident history/i.test(text(a));
      })[0];
    }
    var href = link ? link.getAttribute('href') : '/history';

    var card = document.createElement('a');
    card.id = 'k-history-card';
    card.href = href;
    card.innerHTML =
      '<span class="k-history-label">History</span>' +
      '<span class="k-history-sub">Every past incident and maintenance window</span>';
    footer.parentNode.insertBefore(card, footer);
  }

  /* ── Collapse long maintenance notices ────────────────────── */
  /* Delisting notices run to twenty lines. The body is wrapped, clamped and
     faded out, with the title and schedule left fully visible above it. */
  function clampMaintenance() {
    if (!CFG.clampMaintenance) return;
    var box = $('.scheduled-maintenances-container');
    if (!box) return;

    var items = $$('.scheduled-maintenance', box);
    if (!items.length) {
      items = Array.prototype.slice.call(box.children).filter(function (el) {
        return el.querySelector && el.querySelector('.markdown-display, .whitespace-pre-wrap');
      });
    }

    items.forEach(function (item) {
      if (item.dataset.kClamp) return;
      item.dataset.kClamp = '1';

      var kids = Array.prototype.slice.call(item.children);
      if (kids.length < 2) return;

      var wrap = document.createElement('div');
      item.insertBefore(wrap, kids[1]);
      kids.slice(1).forEach(function (k) { wrap.appendChild(k); });

      if (wrap.scrollHeight <= CFG.clampHeight + 48) return;

      wrap.classList.add('k-clamp');

      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'k-more';
      btn.textContent = 'Show more';
      btn.setAttribute('aria-expanded', 'false');
      btn.addEventListener('click', function (e) {
        if (e.detail > 0) btn.blur();

        var open = !wrap.classList.contains('k-expanded');
        btn.textContent = open ? 'Show less' : 'Show more';
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');

        if (open) {
          // Animated to the real height. The old rule went to a fixed 4000px,
          // so the easing was calibrated for a distance the content never
          // travelled and the reveal finished almost immediately.
          wrap.classList.add('k-expanded');
          wrap.style.maxHeight = wrap.scrollHeight + 'px';
        } else {
          wrap.style.maxHeight = wrap.scrollHeight + 'px';
          requestAnimationFrame(function () {
            requestAnimationFrame(function () {
              wrap.classList.remove('k-expanded');
              wrap.style.maxHeight = CFG.clampHeight + 'px';
            });
          });
        }
      });

      wrap.addEventListener('transitionend', function (e) {
        if (e.propertyName !== 'max-height') return;
        if (wrap.classList.contains('k-expanded')) wrap.style.maxHeight = 'none';
      });
      item.appendChild(btn);
    });
  }

  /* ── Timeframe scroll jump ────────────────────────────────── */
  /* The Day / Week / Month links are <a href="#">. Statuspage's own handler
     normally swallows the click, but once the timeframe changes it re-renders
     the metric cards, and a click that lands during that re-render falls
     through to the browser, which treats "#" as jump to top of document.
     Preventing the default stops the jump; their handler still runs, since
     preventDefault only cancels the browser's navigation, not other
     listeners. The scroll position is restored on the next frame as a
     belt-and-braces measure against the re-render moving the page. */
  document.addEventListener('click', function (e) {
    var link = e.target.closest && e.target.closest('a.timeframe');
    if (!link) return;

    e.preventDefault();

    var y = window.pageYOffset;
    requestAnimationFrame(function () {
      if (Math.abs(window.pageYOffset - y) > 2) window.scrollTo(0, y);
    });
  });

  /* ── Pointer focus on Statuspage's own controls ───────────── */
  /* Show all incidents, the filter and the month arrows are Statuspage's
     anchors, so there is no handler of ours to drop focus in. detail is 0
     for keyboard activation, so keyboard users keep their ring. */
  document.addEventListener('click', function (e) {
    var hit = e.target.closest && e.target.closest(
      '.expand-incidents a, .show-filter, .history-nav a, .pagination a');
    if (!hit || e.detail === 0 || !hit.blur) return;
    // Deferred: Statuspage handles the click and focuses the anchor itself,
    // so blurring synchronously here is undone a moment later
    setTimeout(function () { hit.blur(); }, 0);
  });

  /* ── Collapse incidents ───────────────────────────────────── */
  /* Statuspage's Show all button doubles as Collapse, and removes the cards
     synchronously on click. The click is caught in the capture phase so the
     exit can play first, then replayed once the animation has finished.
     Only cards beyond the first three animate, since those are the ones
     Statuspage actually takes away. */
  var KEEP_ON_COLLAPSE = 3;

  document.addEventListener('click', function (e) {
    var link = e.target.closest && e.target.closest('.expand-incidents a');
    if (!link || link.dataset.kReplay) return;
    if (!/collapse/i.test(text(link))) return;

    var month = link.closest('.month');
    if (!month) return;

    var cards = $$('.incident-container', month);
    var going = cards.slice(KEEP_ON_COLLAPSE);
    if (!going.length) return;

    e.preventDefault();
    e.stopPropagation();

    going.forEach(function (c, i) {
      c.style.animationDelay = Math.min(going.length - 1 - i, 6) * 10 + 'ms';
      c.classList.add('k-collapsing');
    });

    link.dataset.kReplay = '1';
    setTimeout(function () {
      going.forEach(function (c) {
        c.classList.remove('k-collapsing');
        c.style.animationDelay = '';
      });
      delete link.dataset.kReplay;
      link.click();
      if (link.blur) link.blur();
    }, 300);
  }, true);

  /* ── History page title ───────────────────────────────────── */
  /* Statuspage titles this page "Incident History", but it lists maintenance
     windows too, and the card that links here now says History. Renamed to
     match. The heading is not reliably an h1, so the page title block is
     searched for whichever element holds the text. */
  function historyTitle() {
    var page = $('.layout-content.status-full-history');
    if (!page) return;

    // Only elements that hold the text directly, so renaming a wrapper does
    // not destroy the heading inside it before the loop reaches it
    $$('h1, h2, h3, h4, .page-title, .page-title *', page).forEach(function (el) {
      if (el.dataset.kTitle) return;
      if (el.children.length) return;
      if (!/incident history/i.test(text(el))) return;
      el.dataset.kTitle = '1';
      el.textContent = text(el).replace(/incident history/i, 'History');
    });

    if (/incident history/i.test(document.title)) {
      document.title = document.title.replace(/incident history/i, 'History');
    }
  }

  /* ── Reveal newly shown history cards ─────────────────────── */
  /* "Show all incidents" injects the rest of the month. Cards present on the
     first pass are marked as seen, so only the injected ones animate and the
     page does not animate itself on load. Staggered slightly, capped so a
     large month does not crawl in. */
  var revealReady = false;

  function revealNew() {
    var cards = $$('.status-full-history .incident-container');
    if (!cards.length) return;

    var fresh = cards.filter(function (c) { return !c.dataset.kSeen; });
    fresh.forEach(function (c) { c.dataset.kSeen = '1'; });

    if (!revealReady) { revealReady = true; return; }

    // Only a short stagger, and it stops compounding after ten cards, so a
    // month with thirty incidents still lands in well under half a second.
    fresh.forEach(function (c, i) {
      c.style.animationDelay = Math.min(i, 10) * 14 + 'ms';
      c.classList.add('k-reveal');
      c.addEventListener('animationend', function () {
        c.classList.remove('k-reveal');
        c.style.animationDelay = '';
        c.style.willChange = '';
      }, { once: true });
    });
  }

  /* ── Uptime tab on the history page ───────────────────────── */
  /* With the showcase enabled anywhere, Statuspage adds an Incidents and
     Uptime tab bar to the history page. The tab carries no reliable class,
     so it is matched on its text, and the bar itself goes once only one tab
     is left, since a single tab is not a choice. */
  function hideUptimeTab() {
    var page = $('.layout-content.status-full-history');
    if (!page) return;

    $$('a, button, li', page).forEach(function (el) {
      if (el.querySelector('a, button')) return;
      if (!/^uptime$/i.test(text(el))) return;

      var tab = el.closest('li') || el;
      tab.style.display = 'none';

      var bar = tab.parentElement;
      if (!bar) return;
      var left = Array.prototype.filter.call(bar.children, function (c) {
        return c.style.display !== 'none';
      });
      if (left.length <= 1) bar.style.display = 'none';
    });
  }

  /* ── Uptime showcase legend ───────────────────────────────── */
  /* The bars themselves are hidden in CSS. The line that introduces them
     carries no class of its own, so it is matched on its text. */
  function hideUptimeLegend() {
    var section = $('.components-section');
    if (!section) return;
    $$(':scope > *', section).forEach(function (el) {
      if (el.classList.contains('components-container')) return;
      if (/uptime over the past/i.test(text(el))) el.style.display = 'none';
    });
  }

  /* ── Scheduled maintenance above the components ───────────── */
  function maintenance() {
    var block = $('.scheduled-maintenances-container');
    var head = $('.k-section-head.k-components-head') || $('#k-search-wrap') || $('.components-section');
    if (!block || !head || !head.parentNode) return;
    if (block.nextElementSibling === head) return;
    head.parentNode.insertBefore(block, head);
  }

  /* ── Components heading ───────────────────────────────────── */
  function componentsHeading() {
    var section = $('.components-section');
    if (!section || $('.k-section-head.k-components-head')) return;
    var head = document.createElement('div');
    head.className = 'k-section-head k-components-head';
    head.innerHTML = '<h2>Components</h2>';
    var anchor = $('#k-search-wrap') || section;
    anchor.parentNode.insertBefore(head, anchor);
  }

  /* ── Incident update states and severity ──────────────────── */
  function incidents() {
    $$('.update, .update-row').forEach(function (u) {
      if (u.dataset.kState) return;
      var label = (text(u.querySelector('strong')) || text(u.querySelector('.update-title'))).toLowerCase();
      if (!label) return;
      u.dataset.kState = '1';

      if (/investigat/.test(label)) u.classList.add('k-st-investigating');
      else if (/identif/.test(label)) u.classList.add('k-st-identified');
      else if (/monitor|verif/.test(label)) u.classList.add('k-st-monitoring');
      else if (/resolv/.test(label)) u.classList.add('k-st-resolved');
      else if (/complet/.test(label)) u.classList.add('k-st-completed');
      else if (/in progress/.test(label)) u.classList.add('k-st-progress');
      else if (/schedul/.test(label)) u.classList.add('k-st-scheduled');
      else if (/postmortem/.test(label)) u.classList.add('k-st-postmortem');
    });

    $$('.unresolved-incident, .status-day .incident-container, .status-full-history .incident-container').forEach(function (card) {
      if (card.dataset.kSev) return;
      card.dataset.kSev = '1';

      var title = $('.incident-title', card) || card.querySelector('a.incident-title');
      var cls = title ? title.className : '';
      var sev = 'degraded';
      if (/impact-critical/.test(cls)) sev = 'major';
      else if (/impact-major/.test(cls)) sev = 'partial';
      else if (/impact-maintenance/.test(cls)) sev = 'maint';
      // impact-none means logged with no impact, not that it is over. It used
      // to map to resolved, which turned live incidents green.

      // History rows carry the resolution as plain prose with no status label,
      // so the text is checked as well as the update classes.
      // Statuspage does not always class an in progress maintenance as
      // impact-maintenance, so the update labels are checked too. Scheduled
      // and In progress only ever appear on a maintenance.
      var isMaint = sev === 'maint' ||
                    /^\s*\[scheduled\]/i.test(text(title)) ||
                    !!card.querySelector('.k-st-scheduled, .k-st-progress');
      if (isMaint) sev = 'maint';

      // Statuspage lists updates newest first, so the first one is the
      // current state. Scanning the whole card instead would pick up an older
      // "has been resolved" line and turn a live incident green, which is
      // what happened on the history page.
      var latest = card.querySelector('.update, .update-row');
      var status = latest
        ? (text(latest.querySelector('strong')) ||
           text(latest.querySelector('.update-title'))).toLowerCase()
        : '';

      var done = /resolv|complet/.test(status);
      if (done && sev !== 'maint') sev = 'resolved';

      card.classList.add('k-sev-' + sev);

      // Maintenance and incidents look identical on the history list, so
      // maintenance gets a label and the redundant title prefix comes off.
      card.classList.add(isMaint ? 'k-kind-maint' : 'k-kind-incident');

      if (isMaint && title && !$('.k-kind', card)) {
        var link = title.tagName === 'A' ? title : title.querySelector('a');
        if (link) {
          link.textContent = link.textContent.replace(/^\s*\[scheduled\]\s*/i, '');
        }
        var tag = document.createElement('span');
        tag.className = 'k-kind';
        tag.textContent = 'Maintenance';
        title.parentNode.insertBefore(tag, title);
      }
    });
  }

  /* ── Incident page subheader ──────────────────────────────── */
  /* Statuspage writes "Incident Report for X" here on an incident and
     "Scheduled Maintenance Report for X" on a maintenance. The type label is
     worth keeping, the "Report for X" tail is not. */
  function subheader() {
    $$('.status-incident .page-title .subheader').forEach(function (el) {
      if (el.dataset.kDone) return;
      el.dataset.kDone = '1';

      var label = text(el).replace(/\s+/g, ' ')
                          .replace(/\s*report for.*$/i, '').trim();
      if (/^incident$/i.test(label) || !label) {
        el.classList.add('k-hide');
        return;
      }
      el.classList.remove('k-hide');
      el.textContent = label;
    });
  }

  /* ── Relative time on open incidents ──────────────────────── */
  var MONTHS = 'Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec'.split(' ');

  function parseStamp(str) {
    var m = str.replace(/\s+/g, ' ')
      .match(/([A-Z][a-z]{2}) (\d{1,2}) ,? ?(\d{4})? ?-? ?(\d{1,2}):(\d{2}) ?(UTC)?/);
    if (!m) return null;
    var mo = MONTHS.indexOf(m[1]);
    if (mo < 0) return null;
    var yr = m[3] ? +m[3] : new Date().getFullYear();
    return m[6] ? new Date(Date.UTC(yr, mo, +m[2], +m[4], +m[5]))
                : new Date(yr, mo, +m[2], +m[4], +m[5]);
  }

  function ago(then) {
    var mins = Math.floor((Date.now() - then) / 60000);
    if (mins < 1) return 'just now';
    if (mins < 60) return mins + 'm ago';
    if (mins < 1440) return Math.floor(mins / 60) + 'h ago';
    return Math.floor(mins / 1440) + 'd ago';
  }

  function stampAges() {
    $$('.unresolved-incident').forEach(function (card) {
      if ($('.k-meta', card)) return;
      var small = card.querySelector('.update small');
      var when = small ? parseStamp(text(small)) : null;
      if (!when) return;
      var meta = document.createElement('div');
      meta.className = 'k-meta';
      meta.textContent = 'Last update ' + ago(when);
      var title = $('.incident-title', card);
      if (title && title.parentNode) title.parentNode.insertBefore(meta, title.nextSibling);
    });
  }

  /* ── Collapse older updates ───────────────────────────────── */
  function collapseUpdates() {
    $$('.status-day .updates-container, .unresolved-incident .updates').forEach(function (wrap) {
      if (wrap.dataset.kDone) return;
      var updates = $$(':scope > .update', wrap);
      if (updates.length <= CFG.keepOpenUpdates + 1) return;
      wrap.dataset.kDone = '1';

      var hidden = updates.slice(CFG.keepOpenUpdates);

      // The hidden updates move into a wrapper so the reveal can animate.
      // display none to block cannot be transitioned, max-height can.
      var box = document.createElement('div');
      box.className = 'k-more-wrap';
      wrap.insertBefore(box, hidden[0]);
      hidden.forEach(function (u) { box.appendChild(u); });

      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'k-toggle';
      btn.setAttribute('aria-expanded', 'false');
      btn.textContent = 'Show ' + hidden.length + ' earlier updates';

      btn.addEventListener('click', function (e) {
        // Safari keeps a focus ring after a mouse click. detail is 0 when the
        // button was activated from the keyboard, so focus is only dropped
        // for pointer activation and keyboard users keep their place.
        if (e.detail > 0) btn.blur();

        var opening = !box.classList.contains('k-open');

        if (opening) {
          box.classList.add('k-open');
          box.style.maxHeight = box.scrollHeight + 'px';
        } else {
          // Two frames, so the pinned height is painted before the collapse.
          // Once open the wrapper computes to max-height none, and none to a
          // pixel value cannot be transitioned.
          box.style.maxHeight = box.scrollHeight + 'px';
          requestAnimationFrame(function () {
            requestAnimationFrame(function () {
              box.classList.remove('k-open');
              box.style.maxHeight = '0px';
            });
          });
        }

        btn.setAttribute('aria-expanded', opening ? 'true' : 'false');
        btn.textContent = opening
          ? 'Hide earlier updates'
          : 'Show ' + hidden.length + ' earlier updates';
      });

      // Let the content reflow freely once it is open, so a later update
      // being added does not get clipped by a stale pixel height
      box.addEventListener('transitionend', function (e) {
        if (e.propertyName !== 'max-height') return;
        if (box.classList.contains('k-open')) box.style.maxHeight = 'none';
      });

      wrap.appendChild(btn);
    });
  }

  /* ── Run ──────────────────────────────────────────────────── */
  var observer = null;

  function run() {
    if (observer) observer.disconnect();

    // Each step is isolated. A selector that misses on one Statuspage
    // template must not stop the rest of the page from being styled.
    [components, search, componentsHeading, hideUptimeLegend, hideUptimeTab, maintenance, clampMaintenance,
     metricsHeader, strip, loadIncidentMap, incidents, subheader, historyTitle, stampAges, collapseUpdates,
     historyCard, subscribe]
      .forEach(function (step) {
        try { step(); }
        catch (err) { if (window.console) console.warn('[kraken-status]', step.name, err); }
      });

    if (observer) observer.observe($('.layout-content') || document.body, { childList: true, subtree: true });
  }

  var pending = null;
  if (window.MutationObserver) {
    observer = new MutationObserver(function (records) {
      for (var i = 0; i < records.length; i++) {
        var rec = records[i];
        if (!rec.addedNodes.length) continue;
        // Highcharts redraws continuously. Ignore mutations inside the charts,
        // otherwise the script re-runs on every animation frame.
        if (rec.target && rec.target.closest &&
            rec.target.closest('.highcharts-container, .graph-container, ' +
                               '.metrics-display-graph, .metric, .metrics-container')) continue;
        // Applied immediately, in the same frame the cards are injected.
        // On the debounce they would already be painted, so you would see
        // them appear and then animate.
        try { revealNew(); } catch (err) {}

        clearTimeout(pending);
        // Longer settle on the history page: Show all injects the whole month
        // at once, and re-running mid animation is what makes it stutter
        pending = setTimeout(run, $('.status-full-history') ? 400 : 150);
        return;
      }
    });
  }

  revealNew();
  run();
})();</script>
