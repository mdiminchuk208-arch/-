  <div class="layout-content status status-index starter">
      <div class="custom-header-container">
    <script>
(function () {
  var saved = null;
  try { saved = localStorage.getItem('k-theme'); } catch (e) {}
  var dark = saved ? saved === 'dark'
    : window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
  document.documentElement.setAttribute('data-k-theme', dark ? 'dark' : 'light');

  // Bound here rather than in the footer script, using delegation so it works
  // even though the button does not exist yet at this point in the document.
  document.addEventListener('click', function (e) {
    var btn = e.target.closest && e.target.closest('#k-theme');
    if (!btn) return;
    var next = document.documentElement.getAttribute('data-k-theme') === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-k-theme', next);
    try { localStorage.setItem('k-theme', next); } catch (err) {}
  });
})();
</script>

