import (
	&quot;fmt&quot;
	&quot;net/http&quot;
	&quot;io&quot;
)

func main() {

	url := &quot;https://futures.kraken.com/derivatives/api/v3/orderbook&quot;

	req, _ := http.NewRequest(&quot;GET&quot;, url, nil)

	res, _ := http.DefaultClient.Do(req)

	defer res.Body.Close()
	body, _ := io.ReadAll(res.Body)

	fmt.Println(string(body))

}</code></pre></div></div></div></div><div class="code-block-fade-overlay print:hidden" data-fade-overlay="true" aria-hidden="true" style="--fade-color-light:#FFFFFF;--fade-color-dark:#0B0C0E"></div></div></div></div><div data-orientation="horizontal" data-activation-direction="none" class="code-group p-0.5 flex flex-col not-prose relative rounded-2xl border border-gray-950/10 dark:border-white/10 min-w-0 my-0 bg-gray-50 dark:bg-white/5 dark:codeblock-dark text-gray-950 dark:text-gray-50 codeblock-light"><div class="flex items-center justify-between gap-2 relative pr-2.5" data-component-part="code-group-tab-bar"><div role="presentation" style="position:relative;--scroll-area-corner-height:0px;--scroll-area-corner-width:0px" data-component-part="scroll-area" class="min-w-0 flex-1 w-0 rounded-tl-xl"><div role="presentation" data-id="base-ui-_R_mip5d9qnpfb39p7b9snpfiutb_-viewport" tabindex="-1" class="size-full rounded-[inherit] [--scroll-area-fade-size:32px] overflow-y-hidden! base-ui-disable-scrollbar" style="overflow:scroll" data-component-part="scroll-area-viewport"><div role="presentation" style="min-width:fit-content" data-component-part="scroll-area-content"><div data-orientation="horizontal" data-activation-direction="none" role="tablist" aria-label="Code examples" class="text-xs leading-6 gap-1 flex"><button type="button" data-active="" data-orientation="horizontal" data-activation-direction="none" aria-disabled="false" tabindex="-1" role="tab" aria-selected="true" id="base-ui-_R_2qmip5d9qnpfb39p7b9snpfiutb_" data-composite-item-active="" class="group flex items-center relative gap-1.5 my-1 mb-1.5 outline-0 whitespace-nowrap font-medium ml-0! first:ml-2.5! focus-visible:outline-hidden text-primary dark:text-primary-light"><div class="peer/title flex items-center gap-1.5 px-1.5 rounded-lg z-10 group-focus-visible:outline-1 group-focus-visible:outline-primary dark:group-focus-visible:outline-primary-light">200</div><div class="absolute -bottom-1.5 left-0 right-0