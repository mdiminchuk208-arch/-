\"/mintlify-assets/_next/static/chunks/3788d0413d447c7b.js?dpl=dpl_2yNSHZZSV2gyLWeGebQ5NBGpF6jQ\",\"/mintlify-assets/_next/static/chunks/8580190afe0e7452.js?dpl=dpl_2yNSHZZSV2gyLWeGebQ5NBGpF6jQ\",\"/mintlify-assets/_next/static/chunks/d9038181f2c2898b.js?dpl=dpl_2yNSHZZSV2gyLWeGebQ5NBGpF6jQ\",\"/mintlify-assets/_next/static/chunks/0a0a0ce2e4938fc9.js?dpl=dpl_2yNSHZZSV2gyLWeGebQ5NBGpF6jQ\",\"/mintlify-assets/_next/static/chunks/35bbdf6d88b2676d.js?dpl=dpl_2yNSHZZSV2gyLWeGebQ5NBGpF6jQ\",\"/mintlify-assets/_next/static/chunks/2dde4f69686a7528.js?dpl=dpl_2yNSHZZSV2gyLWeGebQ5NBGpF6jQ\",\"/mintlify-assets/_next/static/chunks/312e9c6f3342e700.js?dpl=dpl_2yNSHZZSV2gyLWeGebQ5NBGpF6jQ\",\"/mintlify-assets/_next/static/chunks/d926b7bfcc39c019.js?dpl=dpl_2yNSHZZSV2gyLWeGebQ5NBGpF6jQ\",\"/mintlify-assets/_next/static/chunks/e452a5c043e34035.js?dpl=dpl_2yNSHZZSV2gyLWeGebQ5NBGpF6jQ\",\"/mintlify-assets/_next/static/chunks/6cadf48bb7ae1a16.js?dpl=dpl_2yNSHZZSV2gyLWeGebQ5NBGpF6jQ\",\"/mintlify-assets/_next/static/chunks/6aa74f1cd21e5f42.js?dpl=dpl_2yNSHZZSV2gyLWeGebQ5NBGpF6jQ\",\"/mintlify-assets/_next/static/chunks/225f902a6f67538e.js?dpl=dpl_2yNSHZZSV2gyLWeGebQ5NBGpF6jQ\",\"/mintlify-assets/_next/static/chunks/70e04241df03d52b.js?dpl=dpl_2yNSHZZSV2gyLWeGebQ5NBGpF6jQ\"],\"ScopedNavProvider\"]\n"])</script><script>self.__next_f.push([1,"45:T428,"])</script><script>self.__next_f.push([1,"Retrieve all cash balances, net of pending withdrawals.\n\nPass `account_id` to retrieve balances for a specific wallet. Omit it to use the authenticated user's default wallet. Use [List Wallet Accounts](/api-reference/account-data/list-wallet-accounts) to obtain wallet account IDs.\n\n**Note on Staking/Earn assets:** We have begun to migrate assets from our legacy Staking system over to a new Earn system. As such, the following assets may appear in your balances and ledger. Please see our [Support article](https://support.kraken.com/hc/en-us/articles/360039879471-What-is-Asset-S-and-Asset-M-) for more details. Note that these assets are \"read-only\", to interact with your balances in them please use the base asset (e.g. `USDT` to transact with your `USDT` and `USDT.F` balances).\n\n**Symbol Extensions**:\n* `.B`: balances in new yield-bearing products, similar to `.S` (staked) and `.M` (opt-in rewards) balances\n* `.F`: balances earning automatically in Kraken Rewards\n* `.T`: tokenized assets.\n\n**API Key Permissions Required:** `Funds permissions - Query`\n"])</script><script>self.__next_f.push([1,"46:T409,"])</script><script>self.__next_f.push([1,"Retrieve all extended account balances, including credits and held amounts. Balance available for trading is calculated as: `available balance = balance + credit - credit_used - hold_trade`\n\nNote that held amounts only include spot non margin orders.\n\n**Note on Staking/Earn assets:** We have begun to migrate assets from our legacy Staking system over to a new Earn system. As such, the following assets may appear in your balances and ledger. Please see our [Support article](https://support.kraken.com/hc/en-us/articles/360039879471-What-is-Asset-S-and-Asset-M-) for more details. Note that these assets are \"read-only\", to interact with your balances in them please use the base asset (e.g. `USDT` to transact with your `USDT` and `USDT.F` balances).\n\n**Symbol Extensions**:\n* `.B`: balances in new yield-bearing products, similar to `.S` (staked) and `.M` (opt-in rewards) balances\n* `.F`: balances earning automatically in Kraken Rewards\n* `.T`: tokenized assets.\n\n**API Key Permissions Required:** `Funds permissions - Query`\n"])</script><script>self.__next_f.push([1,"47:T491,"])</script><script>self.__next_f.push([1,"Retrieve information about ledger entries. 50 results are returned at a time, the most recent by default. Set `with_cursor` to page through results with `cursor`.\n\nPass `account_id` to retrieve ledger entries for a specific wallet. Omit it to use the authenticated user's default wallet. Use [List Wallet Accounts](/api-reference/account-data/list-wallet-accounts) to obtain wallet account IDs.\n\n\u003e **Note on Staking/Earn assets:** We have begun to migrate assets from our legacy Staking system over to a new Earn system. As such, the following assets may appear in your balances and ledger. Please see our [Support article](https://support.kraken.com/hc/en-us/articles/360039879471-What-is-Asset-S-and-Asset-M-) for more details. Note that these assets are \"read-only\", to interact with your balances in them please use the base asset (e.g. `USDT` to transact with your `USDT` and `USDT.F` balances).\n\u003e * `.B`, which represents balances in new yield-bearing products, similar to `.S` (staked) and `.M` (opt-in rewards) balances\n\u003e * `.F`, which represents balances earning automatically in Kraken Rewards\n\n**API Key Permissions Required:** `Data - Query ledger entries`\n"])</script><script>self.__next_f.push([1,"48:T4b3,"])</script><script>self.__next_f.push([1,"CancelAllOrdersAfter provides a \"Dead Man's Switch\" mechanism to protect the client from network malfunction, extreme latency or unexpected matching engine downtime. The client can send a request with a timeout (in seconds), that will start a countdown timer which will cancel *all* client orders when the timer expires. The client has to keep sending new requests to push back the trigger time, or deactivate the mechanism by specifying a timeout of 0. If the timer expires, all orders are cancelled and then the timer remains disabled until the client provides a new (non-zero) timeout.\n\nThe recommended use is to make a call every 15 to 30 seconds, providing a timeout of 60 seconds. This allows the client to keep the orders in place in case of a brief disconnection or transient delay, while keeping them safe in case of a network breakdown. It is also recommended to disable the timer ahead of regularly scheduled trading engine maintenance (if the timer is enabled, all orders will be cancelled when the trading engine comes back from downtime - planned or otherwise).\n\n**API Key Permissions Required:** `Orders and trades - Create \u0026 modify orders` or `Orders and trades - Cancel \u0026 close orders`\n"])</script><script>self.__next_f.push([1,"49:T5ce,"])</script><script>self.__next_f.push([1,"List all allocations for the user.\n\nRequires the `Query Funds` API key permission.\n\nBy default all allocations are returned, even for strategies that have been\nused in the past and have zero balance now. That is so that the user can see\nhow much was earned with given strategy in the past.\n`hide_zero_allocations` parameter can be used to remove zero balance entries\nfrom the output.  Paging hasn't been implemented for this method as we don't\nexpect the result for a particular user to be overwhelmingly large.\n\nAll amounts in the output can be denominated in a currency of user's choice\n(the `converted_asset` parameter).\n\nInformation about when the next reward will be paid to the client is also\nprovided in the output.\n\nAllocated funds can be in up to 4 states:\n- bonding\n- allocated\n- exit_queue (ETH only)\n- unbonding\n\nAny funds in `total` not in `bonding`/`unbonding` are simply allocated and\nearning rewards. Depending on the strategy funds in the other 3 states can\nalso be earning rewards. Consult the output of `/Earn/Strategies` to know\nwhether `bonding`/`unbonding` earn rewards. `ETH` in `exit_queue` still\nearns rewards.\n\nNote that for `ETH`, when the funds are in the `exit_queue` state, the\n`expires` time given is the time when the funds will have finished\nunbonding, not when they go from exit queue to unbonding.\n\n(Un)bonding time estimate can be inaccurate right after having (de)allocated the\nfunds. Wait 1-2 minutes after (de)allocating to get an accurate result."])</script><script>self.__next_f.push([1,"4a:T4af,"])</script><script>self.__next_f.push([1,"Allocate funds to the Strategy.\n\nRequires the `Earn Funds` API key permission.\nThe amount must always be defined.\n\nThis method is asynchronous. A couple of preflight checks are\nperformed synchronously on behalf of the method before it is dispatched\nfurther. The client is required to poll\nthe result using the `/0/private/Earn/AllocateStatus` endpoint.\n\nThere can be only one (de)allocation request in progress for given user and\nstrategy at any time. While the operation is in progress:\n\n1. `pending` attribute in `/Earn/Allocations` response for the strategy\n  indicates that funds are being allocated,\n2. `pending` attribute in `/Earn/AllocateStatus` response will be true.\n\nFollowing specific errors within `Earnings` class can be returned by this\nmethod:\n- Minimum allocation: `EEarnings:Below min:(De)allocation operation amount less than minimum`\n- Allocation in progress: `EEarnings:Busy:Another (de)allocation for the same strategy is in progress`\n- Service temporarily unavailable: `EEarnings:Busy`. Try again in a few minutes.\n- User tier verification: `EEarnings:Permission denied:The user's tier is not high enough`\n- Strategy not found: `EGeneral:Invalid arguments:Invalid strategy ID`"])</script><script>self.__next_f.push([1,"4b:T42f,"])</script><script>self.__next_f.push([1,"Deallocate funds from a strategy.\n\nRequires the `Earn Funds` API key permission.\nThe amount must always be defined.\n\nThis method is asynchronous. A couple of preflight checks are\nperformed synchronously on behalf of the method before it is dispatched\nfurther. If the method returns HTTP 202 code, the client is required to poll\nthe result using the `/Earn/DeallocateStatus` endpoint.\n\nThere can be only one (de)allocation request in progress for given user and\nstrategy.  While the operation is in progress:\n\n1. `pending` attribute in `Allocations` response for the strategy will hold\n   the amount that is being deallocated (negative amount)\n2. `pending` attribute in `DeallocateStatus` response will be true.\n\nFollowing specific errors within `Earnings` class can be returned by this\nmethod:\n- Minimum allocation: `EEarnings:Below min:(De)allocation operation amount less than minimum`\n  allowed\n- Allocation in progress: `EEarnings:Busy:Another (de)allocation for the same strategy is in progress`\n- Strategy not found: `EGeneral:Invalid arguments:Invalid strategy ID`"])</script><script>self.__next_f.push([1,"4c:T44d,"])</script><script>self.__next_f.push([1,"Get the status of the last allocation request.\n\nRequires either the `Earn Funds` or `Query Funds` API key permission.\n\n(De)allocation operations are asynchronous and this endpoint allows client\nto retrieve the status of the last dispatched operation. There can be only\none (de)allocation request in progress for given user and strategy.\n\nThe `pending` attribute in the response indicates if the previously\ndispatched operation is still in progress (true) or has successfully\ncompleted (false).  If the dispatched request failed with an error, then\nHTTP error is returned to the client as if it belonged to the original\nrequest.\n\nFollowing specific errors within `Earnings` class can be returned by this\nmethod:\n- Insufficient funds: `EEarnings:Insufficient funds:Insufficient funds to complete the (de)allocation request`\n- User cap exceeded: `EEarnings:Above max:The allocation exceeds user limit for the strategy`\n- Total cap exceeded: `EEarnings:Above max:The allocation exceeds the total strategy limit`\n- Minimum allocation: `EEarnings:Below min:(De)allocation operation amount less than minimum`"])</script><script>self.__next_f.push([1,"4d:T1140,"])</script><script>self.__next_f.push([1,"Return one page of referred-user activity for the authenticated affiliate.\nThe API returns activity for the account that owns the key, under its\naffiliate plan eligible for this API.\n\nTwo ways to request activity (use one per request):\n\n* **Day** — `activity_date` (`YYYY-MM-DD`). One page of enrolled referred\n  users who had activity that UTC trade day and have not opted out, plus\n  quiet users who enrolled that day and day-wide `totals`. Even a user who\n  has never traded has an enrollment-day entry with `enrolled_at` and empty\n  `products`. Set `all_users=true` to include all still-enrolled users enrolled by that day, regardless of trading.\n  Opted-out users appear as existence stubs only with `all_users=true`; their\n  individual activity is excluded from `items` and `totals`. Unenrolled users\n  are omitted from `items` only; their activity stays in `totals`.\n* **History** — `iiban` (one to ten full Kraken account identifiers,\n  comma-delimited) with inclusive `start_date` and `end_date`. The same\n  per-day entries for those people only. An opted-out user still enrolled by\n  the end of the range returns one existence stub without `activity_date`.\n  Day-wide fields (`totals`, `active_users`, `revision`, `estimated`,\n  `opted_out`) are omitted.\n  Figures are never summed across days.\n\nSending both variants is a `400`. Dates must be today or one of the previous 89 UTC\ndays. A future date or a date older than that window is a `400`. An in-window day\nwith no activity or matching enrollments returns an empty page.\n\nMonetary figures are decimal strings in the top-level `currency` (always `USD`\ntoday): the reporting currency, not the payout asset. `volume` is omitted on\nfee-only products (`margin_rollover`). `maker` and `taker` appear only on\nexecution products (spot, margin, futures, tokenized spot). Instant buy/sell\n(`ptl_trading`, `tokenized_equity_ptl_trading`) and financing charges have no\nliquidity side. Absence of `maker`/`taker` means unclassified, not zero.\nWhen both are present they cover only the classified portion; the\ndifference from the product total is unclassified activity.\n\nThe `products` map is open-ended: ignore unknown keys. An absent key on a visible\nentry means no reported activity for that product. On an opted-out stub,\nempty or omitted products means withheld data, not zero activity.\nCurrent keys: `spot_trading`, `ptl_trading`,\n`margin_trading`, `margin_rollover`, `futures_order_fill`,\n`tokenized_equity_spot_trading`, `tokenized_equity_ptl_trading`. Options is not\nincluded.\n\nDay-wide `totals` include activity from referred users who have not opted out,\nincluding users omitted from `items` because they are not enrolled in your plan.\nActivity from people who opted out may appear under `opted_out` as `summary`;\nsmaller groups are `suppressed`. Daily figures may differ from weekly payments:\ntotals exclude activity that cannot earn commission, activity from blocked\nregions is shown separately, and this API groups by trade date while payments\ngroup by when activity was recorded.\n\nOpted-out stubs retain `referee_reference`, hour-truncated `enrolled_at`,\n`opted_out=true`, and the plan's `referral_code` with empty products.\nThey omit `iiban`, `masked_iiban`, and individual financial or plan-status details.\nStub presence is independent of trading; do not interpret a stub as zero activity.\n\nUse `referee_reference` to match a referred user across days. `masked_iiban` is\nthe last four characters of the IIBAN and is not unique. Visible entries\nalso include the full `iiban`, which you can use for history requests. `enrolled_at` is\ntruncated to the hour.\n\n`revision` (day variant, first page) is when this partner's figures for that UTC\nday were last written. Enrollments and opt-out changes do not advance it;\npoll the roster even when `revision` is unchanged. Re-check the trailing 35 days\nfor late events. `estimated` is `true` when amounts for that calendar day are still an estimate.\n\nExamples use synthetic identifiers, not customer account data. Replace\nexample dates with dates inside the current 90-day window. Empty collections\nand zero-valued fields may be omitted; treat missing items or products as empty.\n\nSuccessful responses are the object itself. Errors are a non-2xx\nstatus with a typed error body, not a wrapped `{ \"error\", \"result\" }`.\n\n**API Key Permissions Required:** select the **Query affiliate participants** checkbox."])</script><script>self.__next_f.push([1,"4e:T43e,"])</script><script>self.__next_f.push([1,"Return CPA qualification progress for one referred trader belonging to\nthe authenticated affiliate.\n\nPass the full `iiban` returned by Get Daily Activity. The response lists\neach CPA bounty separately with its reward, status, requirements, exact\nmeasurable values, and completion percentage. A measurable requirement\ncan remain at `100` percent while an additional non-numeric step, such\nas a hold period, is still incomplete.\n\nBounties that have qualified or paid remain visible. A bounty can also\nreport `expired`, `no_longer_eligible`, or `not_tracked`. When\n`progress_availability` is `unavailable`, condition measurements may be\nomitted.\n\nUnknown IIBANs, referrals belonging to another affiliate, and traders\nwho opted out of activity sharing return `404`.\n\nRegion-specific bounties that do not apply to the trader are omitted,\nso `bounties` can be empty.\n\nSuccessful responses are the object itself. Errors are a non-2xx\nstatus with a typed error body, not a wrapped `{ \"error\", \"result\" }`.\n\n**API Key Permissions Required:** select the **Query affiliate participants** checkbox."])</script><script>self.__next_f.push([1,"4f:T44b,"])</script><script>self.__next_f.push([1,"Sets the account-level off-book maximum leverage cap for the authenticated master account\nand returns the stored value.\n\nThe cap limits the effective leverage (gross open-position notional / margin equity) the\naccount is willing to reach through off-book fills — liquidation assignments and RFQ offer\nfills. Book (maker/taker) orders are never affected.\n\nSetting the cap to `0` leaves no leverage budget, so the account takes no\nexposure-increasing off-book fill at all: it is the single switch to opt out of assignments\nand RFQ fills without withdrawing each assignment preference individually. Fills that\nreduce the account's gross open-position notional still go through, so opting out never\ntraps the account in its existing exposure.\n\nOnly master accounts may call this endpoint. Calling it can result in the following error\ncodes:\n\n\n  invalidArgument: `maxLeverage` is missing or not a number\n\n\n  rfqAssignmentMaxLeverageOutOfBounds: `maxLeverage` is outside `[0, 100]`, or has more than 2 decimal places\n\n\n  rfqAssignmentMaxLeverageDisabled: the off-book max leverage feature is not enabled"])</script><script>self.__next_f.push([1,"1b:[\"$\",\"$L44\",null,{\"scopedNav\":{\"global\":{},\"products\":[{\"product\":\"Home\",\"pages\":[{\"title\":\"Home\",\"href\":\"\"}]},{\"product\":\"Exchange\",\"tabs\":[{\"tab\":\"Guides\",\"pages\":[{\"title\":\"Guides\",\"href\":\"/exchange/guides/overview\"}]},{\"tab\":\"API Reference\",\"dropdowns\":[{\"dropdown\":\"Overview\",\"icon\":\"compass\",\"pages\":[{\"title\":\"Exchange API reference\",\"sidebarTitle\":\"Overview\",\"description\":\"Choose a protocol — REST, WebSocket, or FIX — for Spot, Derivatives, or Affiliate\",\"public\":true,\"href\":\"/exchange/api-reference/overview\"}]},{\"dropdown\":\"Spot REST\",\"icon\":\"code\",\"groups\":[{\"group\":\"Market Data\",\"public\":true,\"pages\":[{\"title\":\"Get Server Time\",\"description\":\"Get the server's time.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml get /public/Time\",\"href\":\"/api-reference/market-data/get-server-time\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get System Status\",\"description\":\"Get the current system status or trading mode, along with any scheduled\\nmaintenance or ongoing emergency advisories.\\n\\nThe `upcoming_maintenance` and `emergency` fields are additive — clients that do not read them are unaffected. Both are arrays; empty or absent when no advisory is active.\\n\\n* `upcoming_maintenance` carries scheduled events that are within 72 hours. An event is removed once its maintenance window starts.\\n* `emergency` carries unresolved status page incidents. An incident is removed when it reaches `resolved`.\\n\\nThe top-level `status` field remains driven by the trading engine and is\\nindependent of both arrays: an advisory describes *why* a state is happening\\nor coming — it does not dictate engine state.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml get /public/SystemStatus\",\"href\":\"/api-reference/market-data/get-system-status\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Maintenance Schedule\",\"description\":\"Get all scheduled maintenance events in the next 7-day window, ordered by\\n`expected_start_utc` ascending.\\n\\nThis is the planning view. It differs from the `upcoming_maintenance` array\\non [Get System Status](/api/spot/rest/operation/operation-get-system-status),\\nwhich covers only the next 72 hours.\\n\\nEach entry carries the same fields as an `upcoming_maintenance` entry,\\nincluding the derived `phase` and the `order_submission` /\\n`recommended_action` guidance for that phase.\\n\\nEmergency incidents are not scheduled and therefore never appear here — read\\nthe `emergency` array on Get System Status instead.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml get /public/MaintenanceSchedule\",\"href\":\"/api-reference/market-data/get-maintenance-schedule\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Asset Info\",\"description\":\"Get information about the assets that are available for deposit, withdrawal, trading and earn.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml get /public/Assets\",\"href\":\"/api-reference/market-data/get-asset-info\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Tradable Asset Pairs\",\"description\":\"Get tradable asset pairs\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml get /public/AssetPairs\",\"href\":\"/api-reference/market-data/get-tradable-asset-pairs\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Ticker Information\",\"description\":\"Get ticker information for all or requested markets. To clarify usage, note that \\n* Today's prices start at midnight UTC\\n* Leaving the pair parameter blank will return tickers for all tradeable assets on Kraken\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml get /public/Ticker\",\"href\":\"/api-reference/market-data/get-ticker-information\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get OHLC Data\",\"description\":\"Retrieve OHLC market data.\\nThe last entry in the OHLC array is for the current, not-yet-committed timeframe, and will always be present, regardless of the value of `since`.\\nReturns up to 720 of the most recent entries (older data cannot be retrieved, regardless of the value of `since`).\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml get /public/OHLC\",\"href\":\"/api-reference/market-data/get-ohlc-data\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Order Book\",\"description\":\"Returns level 2 (L2) order book, which describes the individual price levels in the book with aggregated order quantities at each level.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml get /public/Depth\",\"href\":\"/api-reference/market-data/get-order-book\",\"autogeneratedByOpenApi\":true},{\"title\":\"Query L3 Order Book\",\"description\":\"Retrieve Level3 order book data, which provides individual order information at each price level.\\nThis includes order IDs and timestamps for each order in the book. \\n\\nThe Level3 endpoint requires authentication.\\n\\n**API Key Permissions Required:** `Orders and trades - Query open orders \u0026 trades`\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/Level3\",\"href\":\"/api-reference/market-data/query-l3-order-book\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Grouped Order Book\",\"description\":\"The GroupedBook endpoint aggregates the volume in the order book over a specified tick range. \\nIt provides a summary of liquidity deep into the book, useful for user interface display.\\n\\nBids and asks between grouped price levels are accumulated to the nearest passive level (asks rounded up, bids down).\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml get /public/GroupedBook\",\"href\":\"/api-reference/market-data/get-grouped-order-book\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Recent Trades\",\"description\":\"Returns the last 1000 trades by default\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml get /public/Trades\",\"href\":\"/api-reference/market-data/get-recent-trades\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Recent Spreads\",\"description\":\"Returns the last ~200 top-of-book spreads for a given pair\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml get /public/Spread\",\"href\":\"/api-reference/market-data/get-recent-spreads\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Account Data\",\"public\":true,\"pages\":[{\"title\":\"Get Account Balance\",\"description\":\"$45\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/Balance\",\"href\":\"/api-reference/account-data/get-account-balance\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Extended Balance\",\"description\":\"$46\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/BalanceEx\",\"href\":\"/api-reference/account-data/get-extended-balance\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Credit Lines\",\"description\":\"Retrieve all credit line details for VIPs with this functionality.\\n\\n**API Key Permissions Required:** `Funds permissions - Query`\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/CreditLines\",\"href\":\"/api-reference/account-data/get-credit-lines\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Trade Balance\",\"description\":\"Retrieve a summary of collateral balances, margin position valuations, equity and margin level.\\n\\n**API Key Permissions Required:** `Orders and trades - Query open orders \u0026 trades`\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/TradeBalance\",\"href\":\"/api-reference/account-data/get-trade-balance\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Open Orders\",\"description\":\"Retrieve information about currently open orders.\\n\\n**API Key Permissions Required:** `Orders and trades - Query open orders \u0026 trades`\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/OpenOrders\",\"href\":\"/api-reference/account-data/get-open-orders\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Closed Orders\",\"description\":\"Retrieve information about orders that have been closed (filled or cancelled). 50 results are returned at a time, the most recent by default.\\n\\n**Note:** If an order's tx ID is given for `start` or `end` time, the order's opening time (`opentm`) is used\\n\\n**API Key Permissions Required:** `Orders and trades - Query closed orders \u0026 trades`\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/ClosedOrders\",\"href\":\"/api-reference/account-data/get-closed-orders\",\"autogeneratedByOpenApi\":true},{\"title\":\"Query Orders Info\",\"description\":\"Retrieve information about specific orders.\\n\\n**API Key Permissions Required:** `Orders and trades - Query open orders \u0026 trades` or `Orders and trades - Query closed orders \u0026 trades`, depending on status of order\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/QueryOrders\",\"href\":\"/api-reference/account-data/query-orders-info\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Order Amends\",\"description\":\"Retrieves an audit trail of amend transactions on the specified order. The list is ordered by ascending amend timestamp.\\n\\n**API Key Permissions Required:** `Orders and trades - Query open orders \u0026 trades` or `Orders and trades - Query closed orders \u0026 trades`, depending on status of order.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/OrderAmends\",\"href\":\"/api-reference/account-data/get-order-amends\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Trades History\",\"description\":\"Retrieve information about trades/fills. By default, the most recent trades are returned.\\n* Unless otherwise stated, costs, fees, prices, and volumes are specified with the precision for the asset pair (`pair_decimals` and `lot_decimals`), not the individual assets' precision (`decimals`).\\n\\n**API Key Permissions Required:** `Orders and trades - Query closed orders \u0026 trades`\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/TradesHistory\",\"href\":\"/api-reference/account-data/get-trades-history\",\"autogeneratedByOpenApi\":true},{\"title\":\"Query Trades Info\",\"description\":\"Retrieve information about specific trades/fills.\\n\\n**API Key Permissions Required:** `Orders and trades - Query closed orders \u0026 trades`\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/QueryTrades\",\"href\":\"/api-reference/account-data/query-trades-info\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Open Positions\",\"description\":\"Get information about open margin positions.\\n\\n**API Key Permissions Required:** `Orders and trades - Query open orders \u0026 trades`\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/OpenPositions\",\"href\":\"/api-reference/account-data/get-open-positions\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Ledgers Info\",\"description\":\"$47\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/Ledgers\",\"href\":\"/api-reference/account-data/get-ledgers-info\",\"autogeneratedByOpenApi\":true},{\"title\":\"Query Ledgers\",\"description\":\"Retrieve information about specific ledger entries. \\n\\n\u003e **Note on Staking/Earn assets:** We have begun to migrate assets from our legacy Staking system over to a new Earn system. As such, the following assets may appear in your balances and ledger. Please see our [Support article](https://support.kraken.com/hc/en-us/articles/360039879471-What-is-Asset-S-and-Asset-M-) for more details. Note that these assets are \\\"read-only\\\", to interact with your balances in them please use the base asset (e.g. `USDT` to transact with your `USDT` and `USDT.F` balances).\\n\u003e * `.B`, which represents balances in new yield-bearing products, similar to `.S` (staked) and `.M` (opt-in rewards) balances\\n\u003e * `.F`, which represents balances earning automatically in Kraken Rewards\\n\\n**API Key Permissions Required:** `Data - Query ledger entries`\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/QueryLedgers\",\"href\":\"/api-reference/account-data/query-ledgers\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Trade Volume\",\"description\":\"Returns 30 day USD trading volume and resulting fee schedule for any asset pair(s) provided. Fees will not be included if `pair` is not specified as Kraken fees differ by asset pair.\\nNote: If an asset pair is on a maker/taker fee schedule, the taker side is given in `fees` and maker side in `fees_maker`. For pairs not on maker/taker, they will only be given in `fees`.\\n\\n`pair` accepts either a comma-delimited list of pair names or a list of `{ asset, aclass }` objects (the latter is required for non-forex classes such as `derivatives` or `equity_pair`). Set `fee_schedule` to `true` to additionally receive the full fee schedule per trading pair in the `schedules` field.\\n\\n**API Key Permissions Required:** `Funds permissions - Query`\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/TradeVolume\",\"href\":\"/api-reference/account-data/get-trade-volume\",\"autogeneratedByOpenApi\":true},{\"title\":\"Request Export Report\",\"description\":\"Request export of trades or ledgers.\\n\\n**API Key Permissions Required:** `Data - Export data`\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/AddExport\",\"href\":\"/api-reference/account-data/request-export-report\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Export Report Status\",\"description\":\"Get status of requested data exports.\\n\\n**API Key Permissions Required:** `Data - Export data`\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/ExportStatus\",\"href\":\"/api-reference/account-data/get-export-report-status\",\"autogeneratedByOpenApi\":true},{\"title\":\"Retrieve Data Export\",\"description\":\"Retrieve a processed data export \\n\\n**API Key Permissions Required:** `Data - Export data`\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/RetrieveExport\",\"href\":\"/api-reference/account-data/retrieve-data-export\",\"autogeneratedByOpenApi\":true},{\"title\":\"Delete Export Report\",\"description\":\"Delete exported trades/ledgers report\\n\\n**API Key Permissions Required:** `Data - Export data`\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/RemoveExport\",\"href\":\"/api-reference/account-data/delete-export-report\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get API Key Info\",\"description\":\"Retrieve information about the API key that is used to make the request, including its name, permissions, restrictions, and usage timestamps.\\n\\n**API Key Permissions Required:** `None`\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/GetApiKeyInfo\",\"href\":\"/api-reference/account-data/get-api-key-info\",\"autogeneratedByOpenApi\":true},{\"title\":\"List Wallet Accounts\",\"description\":\"Retrieve the wallet accounts associated with the authenticated user.\\n\\nEach wallet account includes a public `account_id` that identifies that wallet. Other endpoints that accept `account_id` (for example `Balance`, `Ledgers`, and Funding (Beta) requests) use this value to select a specific wallet.\\n\\n**API Key Permissions Required:** `None`\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/ListWalletAccounts\",\"href\":\"/api-reference/account-data/list-wallet-accounts\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Trading\",\"public\":true,\"pages\":[{\"title\":\"Add Order\",\"description\":\"Place a new order.\\n\\n**Note**: See the [AssetPairs](/docs/rest-api/get-tradable-asset-pairs) endpoint for details on the available trading pairs, their price and quantity precisions, order minimums, available leverage, etc.\\n\\n**API Key Permissions Required:** `Orders and trades - Create \u0026 modify orders`\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/AddOrder\",\"href\":\"/api-reference/trading/add-order\",\"autogeneratedByOpenApi\":true},{\"title\":\"Amend Order\",\"description\":\"The amend request enables clients to modify the order parameters in-place without the need to cancel the existing order and create a new one.\\n\\n* The order identifiers assigned by Kraken and/or client will stay the same.\\n* Queue priority in the order book will be maintained where possible. \\n* If an amend request will reduce the order quantity below the existing filled quantity, the remaining quantity will be cancelled.\\n\\nFor more detail, see [amend transaction guide](/docs/guides/spot-amends).\\n\\n**API Key Permissions Required:** `Orders and trades - Create \u0026 modify orders` or `Orders and trades - Cancel \u0026 close orders`\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/AmendOrder\",\"href\":\"/api-reference/trading/amend-order\",\"autogeneratedByOpenApi\":true},{\"title\":\"Edit Order\",\"description\":\"Sends a request to edit the order parameters of a live order. When an order has been successfully modified, the original order will be cancelled and a new order will be \\ncreated with the adjusted parameters a new `txid` will be returned in the response.\\n\\n**Note:** The new [AmendOrder](/exchange/guides/general/amends) endpoint resolves the caveats listed below and has additional performance gains.\\n\\nCaveats for `EditOrder`:\\n* Triggered stop loss or take profit orders are not supported.\\n* Orders with conditional close terms attached are not supported.\\n* Orders where the executed volume is greater than the newly supplied volume will be rejected.\\n* `cl_ord_id` is not supported.\\n* Existing executions are associated with the original order and not copied to the amended order.\\n* Queue position will not be maintained.\\n\\n**API Key Permissions Required:** `Orders and trades - Create \u0026 modify orders` and `Orders and trades - Cancel \u0026 close orders`\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/EditOrder\",\"href\":\"/api-reference/trading/edit-order\",\"autogeneratedByOpenApi\":true},{\"title\":\"Cancel Order\",\"description\":\"Cancel a particular open order (or set of open orders) by `txid`, `userref` or `cl_ord_id`\\n\\n**API Key Permissions Required:** `Orders and trades - Create \u0026 modify orders` or `Orders and trades - Cancel \u0026 close orders`\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/CancelOrder\",\"href\":\"/api-reference/trading/cancel-order\",\"autogeneratedByOpenApi\":true},{\"title\":\"Cancel All Orders\",\"description\":\"Cancel all open orders\\n\\n**API Key Permissions Required:** `Orders and trades - Create \u0026 modify orders` or `Orders and trades - Cancel \u0026 close orders`\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/CancelAll\",\"href\":\"/api-reference/trading/cancel-all-orders\",\"autogeneratedByOpenApi\":true},{\"title\":\"Cancel All Orders After X\",\"description\":\"$48\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/CancelAllOrdersAfter\",\"href\":\"/api-reference/trading/cancel-all-orders-after-x\",\"autogeneratedByOpenApi\":true},{\"title\":\"Add Order Batch\",\"description\":\"Sends a collection of orders (minimum of 2 and maximum 15): \\n* Validation is performed on the whole batch prior to submission to the engine. If an order fails validation, the whole batch will be rejected.\\n* On submission to the engine, if an order fails pre-match checks (i.e. funding), then the individual order will be rejected and remainder of the batch will be processed. \\n* All orders in batch are limited to a single pair.\\n\\n**Note**: See the [AssetPairs](/docs/rest-api/get-tradable-asset-pairs) endpoint for details on the available trading pairs, their price and quantity precisions, order minimums, available leverage, etc.\\n\\n**API Key Permissions Required:** `Orders and trades - Create \u0026 modify orders` and `Orders and trades - Cancel \u0026 close orders`\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/AddOrderBatch\",\"href\":\"/api-reference/trading/add-order-batch\",\"autogeneratedByOpenApi\":true},{\"title\":\"Cancel Order Batch\",\"description\":\"Cancel multiple open orders  by `txid`, `userref` or `cl_ord_id`(maximum 50 total unique IDs/references)\\n\\n**API Key Permissions Required:** `Orders and trades - Create \u0026 modify orders` or `Orders and trades - Cancel \u0026 close orders`\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/CancelOrderBatch\",\"href\":\"/api-reference/trading/cancel-order-batch\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Websockets Token\",\"description\":\"An authentication token must be requested via this REST API endpoint in order to connect to and authenticate with our [Websockets API](../guides/spot-ws-auth). The token should be used within 15 minutes of creation, but it does not expire once a successful Websockets connection and private subscription has been made and is maintained.\\n\\n**API Key Permissions Required:** `WebSocket interface - On`\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/GetWebSocketsToken\",\"href\":\"/api-reference/trading/get-websockets-token\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Funding (Beta)\",\"public\":true,\"pages\":[{\"title\":\"Calculate Funding Fees\",\"description\":\"Calculate the fee for a funding method and amount. For withdrawals, the response also includes a unique\\n`withdrawal_fee_token` that pins the quoted fee rate for later use with\\n[Create Funding Withdrawal](/api-reference/funding-beta/create-funding-withdrawal). The token expires after\\n5 minutes and can be used on multiple withdrawals.\\n\\n**API Key Permissions Required:** `Funds permissions - Query`\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml get /funding/v1/fees/{method_id}\",\"href\":\"/api-reference/funding-beta/calculate-funding-fees\",\"autogeneratedByOpenApi\":true},{\"title\":\"Claim Funding Deposit Address\",\"description\":\"Claim a deposit address for a funding method. This generates an address for receiving funds.\\n\\n**API Key Permissions Required:** `Funds permissions - Deposit`\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml put /funding/v1/deposit/address\",\"href\":\"/api-reference/funding-beta/claim-funding-deposit-address\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create Funding Address\",\"description\":\"Save a withdrawal address to the account for a funding method, network, or network group. See\\n[Adding a withdrawal address](/exchange/guides/rest/funding#section-1-adding-a-withdrawal-address) for how\\nthose scopes work.\\n\\n**API Key Permissions Required:** `Funds permissions - Add withdrawal addresses`\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /funding/v1/addresses\",\"href\":\"/api-reference/funding-beta/create-funding-address\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create Funding Withdrawal\",\"description\":\"Create a withdrawal to a saved address. Pass a `withdrawal_fee_token` from\\n[Calculate Funding Fees](/api-reference/funding-beta/calculate-funding-fees) to pin the quoted fee rate, or\\nomit it to use the current fee.\\n\\n**API Key Permissions Required:** `Funds permissions - Withdraw`\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /funding/v1/withdrawals\",\"href\":\"/api-reference/funding-beta/create-funding-withdrawal\",\"autogeneratedByOpenApi\":true},{\"title\":\"Delete Funding Address\",\"description\":\"Delete a saved withdrawal address.\\n\\n**API Key Permissions Required:** `Funds permissions - Add withdrawal addresses`\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml delete /funding/v1/addresses/{id}\",\"href\":\"/api-reference/funding-beta/delete-funding-address\",\"autogeneratedByOpenApi\":true},{\"title\":\"List Funding Addresses\",\"description\":\"Retrieve saved withdrawal addresses for your account. Results are paginated; use the `cursor` parameter to iterate through the list of addresses (page size equal to the value of `limit`).\\n\\n**API Key Permissions Required:** `Funds permissions - Query`\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml get /funding/v1/addresses\",\"href\":\"/api-reference/funding-beta/list-funding-addresses\",\"autogeneratedByOpenApi\":true},{\"title\":\"List Funding Assets\",\"description\":\"Retrieve assets available for the requested direction (deposit or withdraw).\\n\\n**API Key Permissions Required:** `Funds permissions - Query`\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml get /funding/v1/assets/{direction}\",\"href\":\"/api-reference/funding-beta/list-funding-assets\",\"autogeneratedByOpenApi\":true},{\"title\":\"List Funding Claimed Addresses (v2)\",\"description\":\"Retrieve claimed deposit addresses. Results are paginated; use the `cursor` parameter to iterate through the list of addresses (page size equal to the value of `limit`).\\n\\n**API Key Permissions Required:** `Funds permissions - Query`\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml get /funding/v2/deposit/addresses\",\"href\":\"/api-reference/funding-beta/list-funding-claimed-addresses-v2\",\"autogeneratedByOpenApi\":true},{\"title\":\"List Funding Deposit Limits\",\"description\":\"Retrieve deposit limits for an asset, including remaining and maximum amounts where applicable.\\n\\n**API Key Permissions Required:** `Funds permissions - Query`\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml get /funding/v1/limits/deposit/{asset_class}/{asset}\",\"href\":\"/api-reference/funding-beta/list-funding-deposit-limits\",\"autogeneratedByOpenApi\":true},{\"title\":\"List Funding Deposits\",\"description\":\"Retrieve information about deposits. Results are sorted by recency; use the `cursor` parameter to iterate through the list of deposits (page size equal to the value of `limit`) from newest to oldest.\\n\\n**API Key Permissions Required:** `Funds permissions - Query`\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml get /funding/v1/deposits\",\"href\":\"/api-reference/funding-beta/list-funding-deposits\",\"autogeneratedByOpenApi\":true},{\"title\":\"List Funding Methods\",\"description\":\"Retrieve funding methods for the requested direction (deposit or withdraw). Results are paginated; use the `cursor` parameter to iterate through the list of methods (page size equal to the value of `limit`).\\n\\n**API Key Permissions Required:** `Funds permissions - Query`\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml get /funding/v1/methods/{direction}\",\"href\":\"/api-reference/funding-beta/list-funding-methods\",\"autogeneratedByOpenApi\":true},{\"title\":\"List Funding Networks\",\"description\":\"Retrieve networks and network groups available for funding, including which networks share an address\\nformat.\\n\\n**API Key Permissions Required:** `Funds permissions - Query`\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml get /funding/v1/networks\",\"href\":\"/api-reference/funding-beta/list-funding-networks\",\"autogeneratedByOpenApi\":true},{\"title\":\"List Funding Withdrawal Limits\",\"description\":\"Retrieve withdrawal limits for an asset, including remaining and maximum amounts where applicable.\\n\\n**API Key Permissions Required:** `Funds permissions - Query`\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml get /funding/v1/limits/withdrawal/{asset_class}/{asset}\",\"href\":\"/api-reference/funding-beta/list-funding-withdrawal-limits\",\"autogeneratedByOpenApi\":true},{\"title\":\"List Funding Withdrawals\",\"description\":\"Retrieve information about withdrawals. Results are sorted by recency; use the `cursor` parameter to iterate through the list of withdrawals (page size equal to the value of `limit`) from newest to oldest.\\n\\n**API Key Permissions Required:** `Funds permissions - Query`\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml get /funding/v1/withdrawals\",\"href\":\"/api-reference/funding-beta/list-funding-withdrawals\",\"autogeneratedByOpenApi\":true},{\"title\":\"Update Funding Address\",\"description\":\"Update the name and/or description of a saved withdrawal address.\\n\\n**API Key Permissions Required:** `Funds permissions - Add withdrawal addresses`\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml put /funding/v1/addresses/{id}\",\"href\":\"/api-reference/funding-beta/update-funding-address\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Funding (Legacy)\",\"public\":true,\"pages\":[{\"title\":\"Get Deposit Methods\",\"description\":\"This endpoint will remain active but will no longer receive updates. It's highly recommended to migrate to the Funding (Beta) API — see the [Funding guide](/exchange/guides/rest/funding) and [API reference](/api-reference/funding-beta/list-funding-methods).\\n\\nRetrieve methods available for depositing a particular asset.\\n\\n**API Key Permissions Required:** `Funds permissions - Query` and `Funds permissions - Deposit`\\n\",\"deprecated\":true,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/DepositMethods\",\"href\":\"/api-reference/funding/get-deposit-methods\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Deposit Addresses\",\"description\":\"This endpoint will remain active but will no longer receive updates. It's highly recommended to migrate to the Funding (Beta) API — see the [Funding guide](/exchange/guides/rest/funding) and [API reference](/api-reference/funding-beta/list-funding-methods).\\n\\nRetrieve (or generate a new) deposit addresses for a particular asset and method.\\n\\n**API Key Permissions Required:** `Funds permissions - Query`\\n\",\"deprecated\":true,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/DepositAddresses\",\"href\":\"/api-reference/funding/get-deposit-addresses\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Status of Recent Deposits\",\"description\":\"This endpoint will remain active but will no longer receive updates. It's highly recommended to migrate to the Funding (Beta) API — see the [Funding guide](/exchange/guides/rest/funding) and [API reference](/api-reference/funding-beta/list-funding-methods).\\n\\nRetrieve information about recent deposits. Results are sorted by recency, use the `cursor` parameter to iterate through list of deposits (page size equal to value of `limit`) from newest to oldest.\\n**API Key Permissions Required:** `Funds permissions - Query`\\n\",\"deprecated\":true,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/DepositStatus\",\"href\":\"/api-reference/funding/get-status-of-recent-deposits\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Withdrawal Methods\",\"description\":\"This endpoint will remain active but will no longer receive updates. It's highly recommended to migrate to the Funding (Beta) API — see the [Funding guide](/exchange/guides/rest/funding) and [API reference](/api-reference/funding-beta/list-funding-methods).\\n\\nRetrieve a list of withdrawal methods available for the user.\\n\\n**API Key Permissions Required:** `Funds permissions - Query` and `Funds permissions - Withdraw`\\n\",\"deprecated\":true,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/WithdrawMethods\",\"href\":\"/api-reference/funding/get-withdrawal-methods\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Withdrawal Addresses\",\"description\":\"This endpoint will remain active but will no longer receive updates. It's highly recommended to migrate to the Funding (Beta) API — see the [Funding guide](/exchange/guides/rest/funding) and [API reference](/api-reference/funding-beta/list-funding-methods).\\n\\nRetrieve a list of withdrawal addresses available for the user.\\n\\n**API Key Permissions Required:** `Funds permissions - Query` and `Funds permissions - Withdraw`\\n\",\"deprecated\":true,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/WithdrawAddresses\",\"href\":\"/api-reference/funding/get-withdrawal-addresses\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Withdrawal Information\",\"description\":\"This endpoint will remain active but will no longer receive updates. It's highly recommended to migrate to the Funding (Beta) API — see the [Funding guide](/exchange/guides/rest/funding) and [API reference](/api-reference/funding-beta/list-funding-methods).\\n\\nRetrieve fee information about potential withdrawals for a particular asset, key and amount.\\n\\n**API Key Permissions Required:** `Funds permissions - Query` and `Funds permissions - Withdraw`\\n\",\"deprecated\":true,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/WithdrawInfo\",\"href\":\"/api-reference/funding/get-withdrawal-information\",\"autogeneratedByOpenApi\":true},{\"title\":\"Withdraw Funds\",\"description\":\"This endpoint will remain active but will no longer receive updates. It's highly recommended to migrate to the Funding (Beta) API — see the [Funding guide](/exchange/guides/rest/funding) and [API reference](/api-reference/funding-beta/list-funding-methods).\\n\\nMake a withdrawal request.    \\n\\n**API Key Permissions Required:** `Funds permissions - Withdraw`\\n\",\"deprecated\":true,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/Withdraw\",\"href\":\"/api-reference/funding/withdraw-funds\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Status of Recent Withdrawals\",\"description\":\"This endpoint will remain active but will no longer receive updates. It's highly recommended to migrate to the Funding (Beta) API — see the [Funding guide](/exchange/guides/rest/funding) and [API reference](/api-reference/funding-beta/list-funding-methods).\\n\\nRetrieve information about recent withdrawals. Results are sorted by recency, use the `cursor` parameter to iterate through list of withdrawals (page size equal to value of `limit`) from newest to oldest.\\n\\n**API Key Permissions Required:** `Funds permissions - Withdraw` or `Data - Query ledger entries`\\n\",\"deprecated\":true,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/WithdrawStatus\",\"href\":\"/api-reference/funding/get-status-of-recent-withdrawals\",\"autogeneratedByOpenApi\":true},{\"title\":\"Request Withdrawal Cancellation\",\"description\":\"This endpoint will remain active but will no longer receive updates. It's highly recommended to migrate to the Funding (Beta) API — see the [Funding guide](/exchange/guides/rest/funding) and [API reference](/api-reference/funding-beta/list-funding-methods).\\n\\nCancel a recently requested withdrawal, if it has not already been successfully processed.\\n\\n**API Key Permissions Required:** `Funds permissions - Withdraw`, unless withdrawal is a `WalletTransfer`, then no permissions are required.\\n\",\"deprecated\":true,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/WithdrawCancel\",\"href\":\"/api-reference/funding/request-withdrawal-cancellation\",\"autogeneratedByOpenApi\":true},{\"title\":\"Request Wallet Transfer\",\"description\":\"This endpoint will remain active but will no longer receive updates. It's highly recommended to migrate to the Funding (Beta) API — see the [Funding guide](/exchange/guides/rest/funding) and [API reference](/api-reference/funding-beta/list-funding-methods).\\n\\nTransfer from a Kraken spot wallet to a Kraken Futures wallet. Note that a transfer in the other direction must be requested via the Kraken Futures API endpoint for [withdrawals to Spot wallets](../futures-api/trading/withdrawal).\\n\\n**API Key Permissions Required:** `Funds permissions - Query`\\n\",\"deprecated\":true,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/WalletTransfer\",\"href\":\"/api-reference/funding/request-wallet-transfer\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Subaccounts\",\"public\":true,\"pages\":[{\"title\":\"Create Subaccount\",\"description\":\"Create a trading subaccount. **Note:** `CreateSubaccount` must be called using an API key from the master account.\\n\\n**API Key Permissions Required:** `Funds permissions - Withdraw`\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/CreateSubaccount\",\"href\":\"/api-reference/subaccounts/create-subaccount\",\"autogeneratedByOpenApi\":true},{\"title\":\"Account Transfer\",\"description\":\"Transfer funds to and from master and subaccounts. **Note:** `AccountTransfer` must be called using an API key from the master account.\\n\\n**API Key Permissions Required:** `Funds permissions - Withdraw`\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/AccountTransfer\",\"href\":\"/api-reference/subaccounts/account-transfer\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Earn\",\"public\":true,\"pages\":[{\"title\":\"List Earn Strategies\",\"description\":\"List earn strategies along with their parameters.\\n\\nRequires a valid API key but not specific permission is required.\\n\\nReturns only strategies that are available to the user\\nbased on geographic region.\\n\\nWhen the user does not meet the tier restriction, `can_allocate` will be\\nfalse and `allocation_restriction_info` indicates `Tier` as the restriction\\nreason. Earn products generally require Intermediate tier. Get your account verified\\nto access earn.\\n\\nA note about `lock_type`:\\n- `instant`: can be deallocated without an unbonding period. This is called flexible in the UI.\\n- `bonded`: has an unbonding period. Deallocation will not happen until this period has passed.\\n- `flex`: \\\"Kraken rewards\\\". This is earning on your spot balances where eligible. It's turned on account wide\\n  from the UI and you cannot manually allocate to these strategies.\\n\\nPaging isn't yet implemented, so the endpoint always returns all\\ndata in the first page.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/Earn/Strategies\",\"href\":\"/api-reference/earn/list-earn-strategies\",\"autogeneratedByOpenApi\":true},{\"title\":\"List Earn Allocations\",\"description\":\"$49\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/Earn/Allocations\",\"href\":\"/api-reference/earn/list-earn-allocations\",\"autogeneratedByOpenApi\":true},{\"title\":\"Allocate Earn Funds\",\"description\":\"$4a\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/Earn/Allocate\",\"href\":\"/api-reference/earn/allocate-earn-funds\",\"autogeneratedByOpenApi\":true},{\"title\":\"Deallocate Earn Funds\",\"description\":\"$4b\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/Earn/Deallocate\",\"href\":\"/api-reference/earn/deallocate-earn-funds\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Allocation Status\",\"description\":\"$4c\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/Earn/AllocateStatus\",\"href\":\"/api-reference/earn/get-allocation-status\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Deallocation Status\",\"description\":\"Get the status of the last deallocation request.\\n\\nRequires either the `Earn Funds` or `Query Funds` API key permission.\\n\\n(De)allocation operations are asynchronous and this endpoint allows client\\nto retrieve the status of the last dispatched operation. There can be only\\none (de)allocation request in progress for given user and strategy.\\n\\nThe `pending` attribute in the response indicates if the previously\\ndispatched operation is still in progress (true) or has successfully\\ncompleted (false).  If the dispatched request failed with an error, then\\nHTTP error is returned to the client as if it belonged to the original\\nrequest.\\n\\nFollowing specific errors within `Earnings` class can be returned by this\\nmethod:\\n- Insufficient funds: `EEarnings:Insufficient funds:Insufficient funds to complete the (de)allocation request`\\n- Minimum allocation: `EEarnings:Below min:(De)allocation operation amount less than minimum`\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml post /private/Earn/DeallocateStatus\",\"href\":\"/api-reference/earn/get-deallocation-status\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Transparency\",\"public\":true,\"pages\":[{\"title\":\"Pre-Trade Data\",\"description\":\"Returns the price levels in the order book with aggregated order quantities at each price level. \\nThe top 10 levels are returned for each trading pair.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml get /public/PreTrade\",\"href\":\"/api-reference/transparency/pre-trade-data\",\"autogeneratedByOpenApi\":true},{\"title\":\"Post-Trade Data\",\"description\":\"Returns a list of trades on the spot exchange. \\nIf no filter parameters are specified, the last 1000 trades for all pairs are received.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/spot-rest.yaml get /public/PostTrade\",\"href\":\"/api-reference/transparency/post-trade-data\",\"autogeneratedByOpenApi\":true}]}]},{\"dropdown\":\"Affiliate REST\",\"icon\":\"users\",\"groups\":[{\"group\":\"Affiliate reporting\",\"public\":true,\"pages\":[{\"title\":\"Get Daily Activity\",\"description\":\"$4d\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/affiliate-rest.yaml get /affiliate/v1/daily-activity\",\"href\":\"/api-reference/affiliate/get-daily-activity\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get CPA Progress\",\"description\":\"$4e\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/affiliate-rest.yaml get /affiliate/v1/cpa-progress\",\"href\":\"/api-reference/affiliate/get-cpa-progress\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Payout History\",\"description\":\"Return one page of the authenticated affiliate's payout history, newest\\nfirst. Rows can include RevShare, Prop, CPA, and Futures Accelerator\\nBonus payments. Retainer, sub-affiliate carve-out, and remediation\\npayments are not included.\\n\\nThe `summary` covers the whole history, not only the current page. Its\\ncombined totals include those four payout sources. Paid totals include\\nrows with public status `paid`; pending totals include rows with public\\nstatus `pending`. Rows with another status can appear in `items`, but do\\nnot contribute to the totals or Prop and CPA counts.\\n\\nAmounts are exact decimal strings. Combined totals add configured payout\\nassets, which are expected to be USD-pegged. `prop_purchase_id` is present\\nonly for Prop commissions.\\n\\nSuccessful responses are the object itself. Errors are a non-2xx\\nstatus with a typed error body, not a wrapped `{ \\\"error\\\", \\\"result\\\" }`.\\n\\n**API Key Permissions Required:** select the **Query affiliate participants** checkbox.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/affiliate-rest.yaml get /affiliate/v1/payout-history\",\"href\":\"/api-reference/affiliate/get-payout-history\",\"autogeneratedByOpenApi\":true}]}]},{\"dropdown\":\"Spot WebSocket v2\",\"icon\":\"bolt\",\"pages\":[{\"title\":\"Spot WebSocket\",\"sidebarTitle\":\"Spot WebSocket\",\"description\":\"Reference for the Spot WebSocket API — v2 (recommended) and v1 (maintained)\",\"public\":true,\"href\":\"/exchange/api-reference/spot-websocket\"},{\"group\":\"Public Channels\",\"public\":true,\"pages\":[{\"title\":\"Ticker\",\"tag\":\"WSS\",\"description\":\"Subscribe to level 1 market data (top of book and recent trades)\",\"href\":\"/exchange/api-reference/spot-websocket-v2/ticker\"},{\"title\":\"Book (Level 2)\",\"tag\":\"WSS\",\"description\":\"Subscribe to level 2 order book data with aggregated quantities at each price level\",\"href\":\"/exchange/api-reference/spot-websocket-v2/book\"},{\"title\":\"Candles (OHLC)\",\"tag\":\"WSS\",\"description\":\"Subscribe to Open, High, Low and Close (OHLC) candle data for specific interval periods\",\"href\":\"/exchange/api-reference/spot-websocket-v2/ohlc\"},{\"title\":\"Trades\",\"tag\":\"WSS\",\"description\":\"Subscribe to real-time trade events when orders are matched in the book\",\"href\":\"/exchange/api-reference/spot-websocket-v2/trade\"},{\"title\":\"Instruments\",\"tag\":\"WSS\",\"description\":\"Subscribe to reference data for all active assets and tradeable pairs\",\"href\":\"/exchange/api-reference/spot-websocket-v2/instrument\"},{\"title\":\"Orders (Level 3)\",\"tag\":\"WSS\",\"description\":\"Subscribe to individual order visibility in the order book\",\"href\":\"/exchange/api-reference/spot-websocket-v2/level3\"},{\"title\":\"Status\",\"tag\":\"WSS\",\"description\":\"Receive exchange status updates and connection verification\",\"href\":\"/exchange/api-reference/spot-websocket-v2/status\"},{\"title\":\"Heartbeat\",\"tag\":\"WSS\",\"description\":\"Automatic heartbeat messages to verify the connection is alive\",\"href\":\"/exchange/api-reference/spot-websocket-v2/heartbeat\"}]},{\"group\":\"Trading\",\"public\":true,\"pages\":[{\"title\":\"Add Order\",\"tag\":\"WSS\",\"description\":\"Send a new order into the exchange via WebSocket\",\"href\":\"/exchange/api-reference/spot-websocket-v2/add_order\"},{\"title\":\"Edit Order\",\"tag\":\"WSS\",\"description\":\"Edit the parameters of a live order\",\"href\":\"/exchange/api-reference/spot-websocket-v2/edit_order\"},{\"title\":\"Amend Order\",\"tag\":\"WSS\",\"description\":\"Amend the parameters of a live order in-place\",\"href\":\"/exchange/api-reference/spot-websocket-v2/amend_order\"},{\"title\":\"Cancel Order\",\"tag\":\"WSS\",\"description\":\"Cancel one or more open orders via WebSocket\",\"href\":\"/exchange/api-reference/spot-websocket-v2/cancel_order\"},{\"title\":\"Cancel All\",\"tag\":\"WSS\",\"description\":\"Cancel all open orders\",\"href\":\"/exchange/api-reference/spot-websocket-v2/cancel_all\"},{\"title\":\"Cancel on Disconnect\",\"tag\":\"WSS\",\"description\":\"Dead Man's Switch mechanism to cancel all orders after a timeout\",\"href\":\"/exchange/api-reference/spot-websocket-v2/cancel_after\"},{\"title\":\"Batch Add\",\"tag\":\"WSS\",\"description\":\"Submit a batch of orders in a single request\",\"href\":\"/exchange/api-reference/spot-websocket-v2/batch_add\"},{\"title\":\"Batch Cancel\",\"tag\":\"WSS\",\"description\":\"Cancel multiple orders in a single request\",\"href\":\"/exchange/api-reference/spot-websocket-v2/batch_cancel\"}]},{\"group\":\"Account\",\"public\":true,\"pages\":[{\"title\":\"Balances\",\"tag\":\"WSS\",\"description\":\"Subscribe to client asset balances and account ledger transactions\",\"href\":\"/exchange/api-reference/spot-websocket-v2/balances\"},{\"title\":\"Executions\",\"tag\":\"WSS\",\"description\":\"Subscribe to order status and execution events for your account\",\"href\":\"/exchange/api-reference/spot-websocket-v2/executions\"}]},{\"group\":\"System\",\"public\":true,\"pages\":[{\"title\":\"Ping\",\"tag\":\"WSS\",\"description\":\"Verify the WebSocket connection is alive with a ping/pong request\",\"href\":\"/exchange/api-reference/spot-websocket-v2/ping\"}]}]},{\"dropdown\":\"Unified WebSocket\",\"icon\":\"lock\",\"hidden\":true,\"groups\":[{\"group\":\"Public Channels\",\"public\":true,\"pages\":[{\"title\":\"Ticker\",\"tag\":\"UWS\",\"description\":\"Subscribe to level 1 market data (top of book and recent trades)\",\"href\":\"/exchange/api-reference/unified-ws/ticker\"},{\"title\":\"Book (Level 2)\",\"tag\":\"UWS\",\"description\":\"Subscribe to level 2 order book data with aggregated quantities at each price level\",\"href\":\"/exchange/api-reference/unified-ws/book\"},{\"title\":\"Candles (OHLC)\",\"tag\":\"UWS\",\"description\":\"Subscribe to Open, High, Low and Close (OHLC) candle data for specific interval periods\",\"href\":\"/exchange/api-reference/unified-ws/ohlc\"},{\"title\":\"Trades\",\"tag\":\"UWS\",\"description\":\"Subscribe to real-time trade events when orders are matched in the book\",\"href\":\"/exchange/api-reference/unified-ws/trade\"},{\"title\":\"Instruments\",\"tag\":\"UWS\",\"description\":\"Subscribe to reference data for all active assets and tradeable pairs\",\"href\":\"/exchange/api-reference/unified-ws/instrument\"},{\"title\":\"Orders (Level 3)\",\"tag\":\"UWS\",\"description\":\"Subscribe to individual order visibility in the order book\",\"href\":\"/exchange/api-reference/unified-ws/level3\"},{\"title\":\"Status\",\"tag\":\"UWS\",\"description\":\"Receive exchange status updates and connection verification\",\"href\":\"/exchange/api-reference/unified-ws/status\"},{\"title\":\"Heartbeat\",\"tag\":\"UWS\",\"description\":\"Automatic heartbeat messages to verify the connection is alive\",\"href\":\"/exchange/api-reference/unified-ws/heartbeat\"}]},{\"group\":\"Trading\",\"public\":true,\"pages\":[{\"title\":\"Add Order\",\"tag\":\"UWS\",\"description\":\"Send a new order into the exchange via WebSocket\",\"href\":\"/exchange/api-reference/unified-ws/add_order\"},{\"title\":\"Amend Order\",\"tag\":\"UWS\",\"description\":\"Amend the parameters of a live order in-place\",\"href\":\"/exchange/api-reference/unified-ws/amend_order\"},{\"title\":\"Cancel Order\",\"tag\":\"UWS\",\"description\":\"Cancel one or more open orders via WebSocket\",\"href\":\"/exchange/api-reference/unified-ws/cancel_order\"},{\"title\":\"Cancel All\",\"tag\":\"UWS\",\"description\":\"Cancel all open orders\",\"href\":\"/exchange/api-reference/unified-ws/cancel_all\"},{\"title\":\"Cancel on Disconnect\",\"tag\":\"UWS\",\"description\":\"Dead Man's Switch mechanism to cancel all orders after a timeout\",\"href\":\"/exchange/api-reference/unified-ws/cancel_after\"}]},{\"group\":\"Account\",\"public\":true,\"pages\":[{\"title\":\"Balances\",\"tag\":\"UWS\",\"description\":\"Subscribe to client asset balances and account ledger transactions\",\"href\":\"/exchange/api-reference/unified-ws/balances\"},{\"title\":\"Executions\",\"tag\":\"UWS\",\"description\":\"Subscribe to order status and execution events for your account\",\"href\":\"/exchange/api-reference/unified-ws/executions\"},{\"title\":\"Ledgers\",\"tag\":\"UWS\",\"description\":\"Subscribe to account ledger entries, with derivatives position and realization detail\",\"href\":\"/exchange/api-reference/unified-ws/ledgers\"},{\"title\":\"Margin\",\"tag\":\"UWS\",\"description\":\"Subscribe to derivatives wallet margin state\",\"href\":\"/exchange/api-reference/unified-ws/margin\"},{\"title\":\"Positions\",\"tag\":\"UWS\",\"description\":\"Subscribe to open derivatives positions for your account\",\"href\":\"/exchange/api-reference/unified-ws/positions\"}]},{\"group\":\"System\",\"public\":true,\"pages\":[{\"title\":\"Ping\",\"tag\":\"UWS\",\"description\":\"Verify the WebSocket connection is alive with a ping/pong request\",\"href\":\"/exchange/api-reference/unified-ws/ping\"}]}]},{\"dropdown\":\"Spot WebSocket v1\",\"icon\":\"bolt\",\"groups\":[{\"group\":\"Public Channels\",\"public\":true,\"pages\":[{\"title\":\"Ticker\",\"tag\":\"WSS\",\"description\":\"Subscribe to ticker information on currency pairs\",\"href\":\"/exchange/api-reference/spot-websocket-v1/ticker\"},{\"title\":\"Candles (OHLC)\",\"tag\":\"WSS\",\"description\":\"Subscribe to Open High Low Close candle feed for currency pairs\",\"href\":\"/exchange/api-reference/spot-websocket-v1/ohlc\"},{\"title\":\"Trade\",\"tag\":\"WSS\",\"description\":\"Subscribe to trade feed for currency pairs\",\"href\":\"/exchange/api-reference/spot-websocket-v1/trade\"},{\"title\":\"Spread\",\"tag\":\"WSS\",\"description\":\"Subscribe to spread feed for currency pairs\",\"href\":\"/exchange/api-reference/spot-websocket-v1/spread\"},{\"title\":\"Book\",\"tag\":\"WSS\",\"description\":\"Subscribe to order book levels (Level 2)\",\"href\":\"/exchange/api-reference/spot-websocket-v1/book\"}]},{\"group\":\"Trading\",\"public\":true,\"pages\":[{\"title\":\"Add Order\",\"tag\":\"WSS\",\"description\":\"Send a single new order into the exchange\",\"href\":\"/exchange/api-reference/spot-websocket-v1/addorder\"},{\"title\":\"Edit Order\",\"tag\":\"WSS\",\"description\":\"Edit the parameters of a live order by cancelling and recreating it\",\"href\":\"/exchange/api-reference/spot-websocket-v1/editorder\"},{\"title\":\"Amend Order\",\"tag\":\"WSS\",\"description\":\"Modify order parameters in-place without cancelling and recreating\",\"href\":\"/exchange/api-reference/spot-websocket-v1/amendorder\"},{\"title\":\"Cancel Order\",\"tag\":\"WSS\",\"description\":\"Cancel one or more open orders\",\"href\":\"/exchange/api-reference/spot-websocket-v1/cancelorder\"},{\"title\":\"Cancel All\",\"tag\":\"WSS\",\"description\":\"Cancel all open orders including partially-filled orders\",\"href\":\"/exchange/api-reference/spot-websocket-v1/cancelall\"},{\"title\":\"Cancel on Disconnect\",\"tag\":\"WSS\",\"description\":\"Dead Man's Switch mechanism to cancel all orders after a timeout\",\"href\":\"/exchange/api-reference/spot-websocket-v1/cancelallordersafter\"}]},{\"group\":\"Account\",\"public\":true,\"pages\":[{\"title\":\"Own Trades\",\"tag\":\"WSS\",\"description\":\"Subscribe to real-time trade execution updates for the authenticated user\",\"href\":\"/exchange/api-reference/spot-websocket-v1/owntrades\"},{\"title\":\"Open Orders\",\"tag\":\"WSS\",\"description\":\"Subscribe to real-time open order updates for the authenticated user\",\"href\":\"/exchange/api-reference/spot-websocket-v1/openorders\"}]},{\"group\":\"System\",\"public\":true,\"pages\":[{\"title\":\"Ping\",\"tag\":\"WSS\",\"description\":\"Client ping to determine whether the connection is alive\",\"href\":\"/exchange/api-reference/spot-websocket-v1/ping\"},{\"title\":\"Heartbeat\",\"tag\":\"WSS\",\"description\":\"Server heartbeat sent when no subscription traffic is detected\",\"href\":\"/exchange/api-reference/spot-websocket-v1/heartbeat\"},{\"title\":\"System Status\",\"tag\":\"WSS\",\"description\":\"Server-pushed system status on connection or status changes\",\"href\":\"/exchange/api-reference/spot-websocket-v1/systemstatus\"},{\"title\":\"Subscription Status\",\"tag\":\"WSS\",\"description\":\"Server-pushed subscription status response to subscribe, unsubscribe, or exchange-initiated unsubscribe\",\"href\":\"/exchange/api-reference/spot-websocket-v1/subscriptionstatus\"},{\"title\":\"Unsubscribe\",\"tag\":\"WSS\",\"description\":\"Unsubscribe from one or more WebSocket channels\",\"href\":\"/exchange/api-reference/spot-websocket-v1/unsubscribe\"}]}]},{\"dropdown\":\"Derivatives REST\",\"icon\":\"code\",\"groups\":[{\"group\":\"Market Data\",\"public\":true,\"pages\":[{\"title\":\"Get tickers\",\"description\":\"This endpoint returns current market data for all currently listed Futures contracts and\\nindices.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml get /tickers\",\"href\":\"/api-reference/market-data/get-tickers\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get ticker by symbol\",\"description\":\"Get market data for contract or index by symbol\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml get /tickers/{symbol}\",\"href\":\"/api-reference/market-data/get-ticker-by-symbol\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get orderbook\",\"description\":\"This endpoint returns the entire non-cumulative order book of currently listed Futures\\ncontracts.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml get /orderbook\",\"href\":\"/api-reference/market-data/get-orderbook\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get trade history\",\"description\":\"This endpoint returns the most recent 100 trades prior to the specified `lastTime` value up\\nto past 7 days or recent trading engine restart (whichever is sooner).\\n\\nIf no `lastTime` specified, it will return 100 most recent trades.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml get /history\",\"href\":\"/api-reference/market-data/get-trade-history\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Instruments\",\"public\":true,\"pages\":[{\"title\":\"Get instruments\",\"description\":\"Returns specifications for all currently listed markets and indices.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml get /instruments\",\"href\":\"/api-reference/instrument-details/get-instruments\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get trading instruments\",\"description\":\"Returns specifications for all currently accessible markets and indices.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml get /trading/instruments\",\"href\":\"/api-reference/instrument-details/get-trading-instruments\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get instrument status list\",\"description\":\"Returns price dislocation and volatility details for all markets.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml get /instruments/status\",\"href\":\"/api-reference/instrument-details/get-instrument-status-list\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get instrument status\",\"description\":\"Returns price dislocation and volatility details for given market.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml get /instruments/{symbol}/status\",\"href\":\"/api-reference/instrument-details/get-instrument-status\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Order Management\",\"public\":true,\"pages\":[{\"title\":\"Send order\",\"description\":\"This endpoint allows sending a limit, stop, take profit or immediate-or-cancel order for a\\ncurrently listed Futures contract.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml post /sendorder\",\"href\":\"/api-reference/order-management/send-order\",\"autogeneratedByOpenApi\":true},{\"title\":\"Edit order\",\"description\":\"This endpoint allows editing an existing order for a currently listed Futures contract.\\n\\nWhen editing an order, if the `trailingStopMaxDeviation` and `trailingStopDeviationUnit`\\nparameters are sent unchanged, the system will recalculate a new stop price upon successful\\norder modification.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml post /editorder\",\"href\":\"/api-reference/order-management/edit-order\",\"autogeneratedByOpenApi\":true},{\"title\":\"Cancel order\",\"description\":\"This endpoint allows cancelling an open order for a Futures contract.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml post /cancelorder\",\"href\":\"/api-reference/order-management/cancel-order\",\"autogeneratedByOpenApi\":true},{\"title\":\"Cancel all orders\",\"description\":\"This endpoint allows cancelling orders which are associated with a future's contract or a\\nmargin account. If no arguments are specified all open orders will be cancelled.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml post /cancelallorders\",\"href\":\"/api-reference/order-management/cancel-all-orders\",\"autogeneratedByOpenApi\":true},{\"title\":\"Dead man's switch\",\"description\":\"This endpoint provides a Dead Man's Switch mechanism to protect the user from network malfunctions. The user can send a request with a timeout in seconds which will trigger a countdown timer that will cancel all user orders when timeout expires. The user has to keep sending request to push back the timeout expiration or they can deactivate the mechanism by specifying a timeout of zero (0).\\n\\nThe recommended mechanism usage is making a call every 15 to 20 seconds and provide a timeout of 60 seconds. This allows the user to keep the orders in place on a brief network failure, while keeping them safe in case of a network breakdown.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml post /cancelallordersafter\",\"href\":\"/api-reference/order-management/dead-mans-switch\",\"autogeneratedByOpenApi\":true},{\"title\":\"Batch order management\",\"description\":\"This endpoint allows sending limit or stop order(s) and/or cancelling open order(s) and/or\\nediting open order(s) for a currently listed Futures contract in batch.\\n\\nWhen editing an order, if the `trailingStopMaxDeviation` and `trailingStopDeviationUnit`\\nparameters are sent unchanged, the system will recalculate a new stop price upon successful\\norder modification.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml post /batchorder\",\"href\":\"/api-reference/order-management/batch-order-management\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get open orders\",\"description\":\"This endpoint returns information on all open orders for all Futures contracts.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml get /openorders\",\"href\":\"/api-reference/order-management/get-open-orders\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Specific Orders' Status\",\"description\":\"Returns information on specified orders which are open or were filled/cancelled in the last\\n5 seconds.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml post /orders/status\",\"href\":\"/api-reference/order-management/get-specific-orders-status\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Account\",\"public\":true,\"pages\":[{\"title\":\"Get wallets\",\"description\":\"This endpoint returns key information relating to all your accounts which may either be\\ncash accounts or margin accounts. This includes digital asset balances, instrument balances,\\nmargin requirements, margin trigger estimates and auxiliary information such as available\\nfunds, PnL of open positions and portfolio value.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml get /accounts\",\"href\":\"/api-reference/account-information/get-wallets\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get open positions\",\"description\":\"This endpoint returns the size and average entry price of all open positions in Futures\\ncontracts. This includes Futures contracts that have matured but have not yet been settled.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml get /openpositions\",\"href\":\"/api-reference/account-information/get-open-positions\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get position percentile of unwind queue\",\"description\":\"This endpoint returns the percentile of the open position in case of unwinding.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml get /unwindqueue\",\"href\":\"/api-reference/account-information/get-position-percentile-of-unwind-queue\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get portfolio margin parameters\",\"description\":\"Retrieve current portfolio margin calculation parameters.\\n\\nAlso includes user specific limits related to options trading.\\n\\nNote: This is currently available exclusively in the Kraken pre-prod environments.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml get /portfolio-margining/parameters\",\"href\":\"/api-reference/account-information/get-portfolio-margin-parameters\",\"autogeneratedByOpenApi\":true},{\"title\":\"Calculate portfolio margin, pnl and greeks\",\"description\":\"For a given portfolio of balances and positions (futures and options), calculate the\\nmargin requirements, pnl and option greeks.\\n\\nNote: This is currently available exclusively in the Kraken pre-prod environments.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml post /portfolio-margining/simulate\",\"href\":\"/api-reference/account-information/calculate-portfolio-margin-pnl-and-greeks\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Multi-Collateral\",\"public\":true,\"pages\":[{\"title\":\"Get PNL currency preferences\",\"description\":\"The PNL currency preference is used to determine which currency to pay out when realizing\\nPNL gains.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml get /pnlpreferences\",\"href\":\"/api-reference/multi-collateral/get-pnl-currency-preferences\",\"autogeneratedByOpenApi\":true},{\"title\":\"Set PNL currency preference\",\"description\":\"The PNL currency preference is used to determine which currency to pay out when realizing\\nPNL gains. Calling this API can result in the following error codes:\\n\\n\\n  87: Contract does not exist\\n\\n  88: Contract not a multi-collateral futures contract\\n\\n  89: Currency does not exist\\n\\n  90: Currency is not enabled for multi-collateral futures\\n\\n  41: Would cause liquidation\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml put /pnlpreferences\",\"href\":\"/api-reference/multi-collateral/set-pnl-currency-preference\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get leverage settings\",\"description\":\"Returns list of configured leverage preferences.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml get /leveragepreferences\",\"href\":\"/api-reference/multi-collateral/get-leverage-settings\",\"autogeneratedByOpenApi\":true},{\"title\":\"Set leverage settings\",\"description\":\"Sets a contract's margin mode, either \\\"isolated\\\" or \\\"cross\\\" margin.\\n\\nWhen specifying a max leverage, the contract's margin mode will be isolated.\\n\\nCalling this endpoint can result in the following error codes:\\n- 87: Contract does not exist\\n- 88: Contract not a multi-collateral futures contract\\n- 41: Would cause liquidation\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml put /leveragepreferences\",\"href\":\"/api-reference/multi-collateral/set-leverage-settings\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Fee Schedules\",\"public\":true,\"pages\":[{\"title\":\"Get fee schedules\",\"description\":\"**DEPRECATED** — Effective 2026-06-22, the fee values returned by this\\nendpoint no longer reflect the fees actually charged on Futures trades.\\nFutures fee calculation has been migrated to a centralised Kraken fee\\nservice.\\n\\nTo determine the fee rate applied to your trades, use the Spot\\n[`GetTradeVolume`](https://docs.kraken.com/api/docs/rest-api/get-trade-volume)\\nendpoint authenticated with a Spot API key.\\n\\n---\\n\\nThis endpoint lists all fee schedules.\",\"deprecated\":true,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml get /feeschedules\",\"href\":\"/api-reference/fee-schedules/get-fee-schedules\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get fee schedule volumes\",\"description\":\"**DEPRECATED** — Effective 2026-06-22, the volumes and fee schedule\\nassociations returned by this endpoint no longer reflect the fees\\nactually charged on Futures trades. Futures fee calculation has been\\nmigrated to a centralised Kraken fee service.\\n\\nTo determine the fee rate applied to your trades, use the Spot\\n[`GetTradeVolume`](https://docs.kraken.com/api/docs/rest-api/get-trade-volume)\\nendpoint authenticated with a Spot API key.\\n\\n---\\n\\nReturns your fee schedule volumes for each fee schedule.\",\"deprecated\":true,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml get /feeschedules/volumes\",\"href\":\"/api-reference/fee-schedules/get-fee-schedule-volumes\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Historical Data\",\"public\":true,\"pages\":[{\"title\":\"Get your fills\",\"description\":\"This endpoint returns information on your filled orders for all futures contracts.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml get /fills\",\"href\":\"/api-reference/historical-data/get-your-fills\",\"autogeneratedByOpenApi\":true},{\"title\":\"Historical funding rates\",\"description\":\"Returns list of historical funding rates for given market.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml get /historical-funding-rates\",\"href\":\"/api-reference/historical-funding-rates/historical-funding-rates\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Trading Settings\",\"public\":true,\"pages\":[{\"title\":\"Get self trade strategy\",\"description\":\"Returns account-wide self-trade matching strategy.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml get /self-trade-strategy\",\"href\":\"/api-reference/trading-settings/get-self-trade-strategy\",\"autogeneratedByOpenApi\":true},{\"title\":\"Update self trade strategy\",\"description\":\"Updates account-wide self-trade matching behavior to given strategy.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml put /self-trade-strategy\",\"href\":\"/api-reference/trading-settings/update-self-trade-strategy\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get the off-book max leverage cap\",\"description\":\"Returns the account-level off-book maximum leverage cap, or `null` when no cap is\\nconfigured.\\n\\nThe cap limits the effective leverage (gross open-position notional / margin equity) the\\naccount is willing to reach through off-book fills — liquidation assignments and RFQ offer\\nfills. It is set per master account; book (maker/taker) orders are never affected.\\n\\nA cap of `0` means the account takes no exposure-increasing off-book fill at all, and is\\nthe way to opt out of assignments and RFQ fills without withdrawing each assignment\\npreference individually.\\n\\nOnly master accounts may call this endpoint.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml get /rfq-assignment/max-leverage\",\"href\":\"/api-reference/trading-settings/get-the-off-book-max-leverage-cap\",\"autogeneratedByOpenApi\":true},{\"title\":\"Set the off-book max leverage cap\",\"description\":\"$4f\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml put /rfq-assignment/max-leverage\",\"href\":\"/api-reference/trading-settings/set-the-off-book-max-leverage-cap\",\"autogeneratedByOpenApi\":true},{\"title\":\"Clear the off-book max leverage cap\",\"description\":\"Clears the account-level off-book maximum leverage cap for the authenticated master\\naccount. After clearing, off-book fills are no longer constrained by an account-level cap.\\n\\nClearing the cap is the opposite of setting it to `0`: clearing lifts the constraint\\nentirely, while `0` blocks all exposure-increasing off-book fills.\\n\\nOnly master accounts may call this endpoint.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml delete /rfq-assignment/max-leverage\",\"href\":\"/api-reference/trading-settings/clear-the-off-book-max-leverage-cap\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Subaccounts\",\"public\":true,\"pages\":[{\"title\":\"Get subaccounts\",\"description\":\"Return information about subaccounts, including balances and UIDs.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml get /subaccounts\",\"href\":\"/api-reference/subaccounts/get-subaccounts\",\"autogeneratedByOpenApi\":true},{\"title\":\"Check subaccount trading status\",\"description\":\"Returns trading capability info for given subaccount.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml get /subaccount/{subaccountUid}/trading-enabled\",\"href\":\"/api-reference/subaccounts/check-subaccount-trading-status\",\"autogeneratedByOpenApi\":true},{\"title\":\"Update subaccount trading status\",\"description\":\"Updates trading capabilities for given subaccount.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml put /subaccount/{subaccountUid}/trading-enabled\",\"href\":\"/api-reference/subaccounts/update-subaccount-trading-status\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Transfers\",\"public\":true,\"pages\":[{\"title\":\"Initiate wallet transfer\",\"description\":\"This endpoint allows you to transfer funds between two margin accounts with the same\\ncollateral currency, or between a margin account and your cash account.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml post /transfer\",\"href\":\"/api-reference/transfers/initiate-wallet-transfer\",\"autogeneratedByOpenApi\":true},{\"title\":\"Initiate sub account transfer\",\"description\":\"This endpoint allows you to transfer funds between the current account and a sub account,\\nbetween two margin accounts with the same collateral currency, or between a margin account\\nand your cash account.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml post /transfer/subaccount\",\"href\":\"/api-reference/transfers/initiate-sub-account-transfer\",\"autogeneratedByOpenApi\":true},{\"title\":\"Initiate withdrawal to Spot wallet\",\"description\":\"This endpoint allows you to request to withdraw digital assets to your Kraken Spot wallet.\\n\\nWallet names can be found in the 'accounts' structure in the Get Wallets /accounts response.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml post /withdrawal\",\"href\":\"/api-reference/transfers/initiate-withdrawal-to-spot-wallet\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Assignment Program\",\"public\":true,\"pages\":[{\"title\":\"List assignment programs\",\"description\":\"This endpoint returns information on currently active assignment programs\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml get /assignmentprogram/current\",\"href\":\"/api-reference/assignment-program/list-assignment-programs\",\"autogeneratedByOpenApi\":true},{\"title\":\"Add assignment preference\",\"description\":\"This endpoint adds an assignment program preference\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml post /assignmentprogram/add\",\"href\":\"/api-reference/assignment-program/add-assignment-preference\",\"autogeneratedByOpenApi\":true},{\"title\":\"Deletes assignment preference\",\"description\":\"This endpoint deletes an assignment program preference\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml post /assignmentprogram/delete\",\"href\":\"/api-reference/assignment-program/deletes-assignment-preference\",\"autogeneratedByOpenApi\":true},{\"title\":\"List assignment preferences history\",\"description\":\"This endpoint returns information on assignment program preferences change history\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml get /assignmentprogram/history\",\"href\":\"/api-reference/assignment-program/list-assignment-preferences-history\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"RFQs\",\"public\":true,\"pages\":[{\"title\":\"List all open RFQs\",\"description\":\"Retrieve all currently open RFQs\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml get /rfqs\",\"href\":\"/api-reference/rfqs/list-all-open-rfqs\",\"autogeneratedByOpenApi\":true},{\"title\":\"Retrieve a single RFQ (open or recently closed)\",\"description\":\"Retrieve a specific RFQ by its unique identifier. Returns currently open RFQs as well as\\nrecently closed RFQs that are still held in the in-memory closed-RFQ cache. The `status`\\nfield on the response distinguishes the lifecycle state (`open`, `expired`, `cancelled`,\\n`filled_bid_side`, or `filled_ask_side`).\\n\\nClosed RFQs are kept in memory only and are not persisted; entries may be evicted by the\\ncache eviction policy or wiped on service restart.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml get /rfqs/{rfqUid}\",\"href\":\"/api-reference/rfqs/retrieve-a-single-rfq-open-or-recently-closed\",\"autogeneratedByOpenApi\":true},{\"title\":\"List open offers on open RFQs\",\"description\":\"Retrieve all open offers for the account on currently open RFQs\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml get /rfqs/open-offers\",\"href\":\"/api-reference/rfqs/list-open-offers-on-open-rfqs\",\"autogeneratedByOpenApi\":true},{\"title\":\"List offers placed by the account on closed RFQs\",\"description\":\"Retrieve all offers the account placed on RFQs that have since closed. The `status` field\\non each offer indicates how the parent RFQ closed (`expired`, `cancelled`,\\n`filled_bid_side`, or `filled_ask_side`).\\n\\nClosed RFQs are tracked in an in-memory cache only and are not persisted; offers may be\\nevicted by the cache eviction policy or wiped on service restart.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml get /rfqs/closed-offers\",\"href\":\"/api-reference/rfqs/list-offers-placed-by-the-account-on-closed-rfqs\",\"autogeneratedByOpenApi\":true},{\"title\":\"Place new offer on an open RFQ\",\"description\":\"Place a new offer on the specified open RFQ. At least one of bid or ask must be provided.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml post /rfqs/place-offer/{rfqUid}\",\"href\":\"/api-reference/rfqs/place-new-offer-on-an-open-rfq\",\"autogeneratedByOpenApi\":true},{\"title\":\"Cancel open offer on open RFQ\",\"description\":\"Cancel the current open offer on the specified open RFQ.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml delete /rfqs/cancel-offer/{rfqUid}\",\"href\":\"/api-reference/rfqs/cancel-open-offer-on-open-rfq\",\"autogeneratedByOpenApi\":true},{\"title\":\"List open RFQs for account\",\"description\":\"Retrieve all currently open RFQs created by the authenticated account.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml get /rfqs/open-rfqs\",\"href\":\"/api-reference/rfqs/list-open-rfqs-for-account\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create a new RFQ\",\"description\":\"Create a new RFQ for the authenticated account.\\n\\nThe `json` query or form parameter is a JSON-encoded object with:\\n- `legs` (required): array of `{ \\\"tradeable\\\", \\\"size\\\" }` (max 100). Duplicate tradeables\\n  are rejected.\\n- `expiry` (optional): RFC 3339 datetime. The server applies a default duration if omitted.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml post /rfqs/open-rfqs\",\"href\":\"/api-reference/rfqs/create-a-new-rfq\",\"autogeneratedByOpenApi\":true},{\"title\":\"Cancel an open RFQ\",\"description\":\"Cancel a specific open RFQ created by the authenticated account.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml delete /rfqs/open-rfqs/{rfqUid}\",\"href\":\"/api-reference/rfqs/cancel-an-open-rfq\",\"autogeneratedByOpenApi\":true},{\"title\":\"Accept an offer on an open RFQ\",\"description\":\"Accept an offer on a specific open RFQ created by the authenticated account.\\nExactly one of `bidAccepted` or `askAccepted` must be provided.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml post /rfqs/open-rfqs/accept-offer/{rfqUid}\",\"href\":\"/api-reference/rfqs/accept-an-offer-on-an-open-rfq\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"General\",\"public\":true,\"pages\":[{\"title\":\"Get notifications\",\"description\":\"This endpoint provides the platform's notifications.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-rest.yaml get /notifications\",\"href\":\"/api-reference/general/get-notifications\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Account History\",\"public\":true,\"pages\":[{\"title\":\"Get execution events\",\"description\":\"Lists executions/trades for authenticated account.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-history-rest.yaml get /executions\",\"href\":\"/api-reference/account-history/get-execution-events\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get order events\",\"description\":\"Lists order events for authenticated account.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-history-rest.yaml get /orders\",\"href\":\"/api-reference/account-history/get-order-events\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get trigger events\",\"description\":\"Lists trigger events for authenticated account.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-history-rest.yaml get /triggers\",\"href\":\"/api-reference/account-history/get-trigger-events\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get position update events\",\"description\":\"Lists position events for authenticated account.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-history-rest.yaml get /positions\",\"href\":\"/api-reference/account-history/get-position-update-events\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get account log\",\"description\":\"Lists account log entries, paged by timestamp or by ID.\\n\\nTo request entries by time range, use the `since` and `before` parameters.\\nTo request entries by ID range, use the `from` and `to` parameters.\\nAny combination of `since`, `before`, `from` and `to` can be used to restrict the requested range of entries.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-history-rest.yaml get /account-log\",\"href\":\"/api-reference/account-history/get-account-log\",\"autogeneratedByOpenApi\":true},{\"title\":\"Account log (CSV)\",\"description\":\"Lists recent account log entries in CSV format.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-history-rest.yaml get /accountlogcsv\",\"href\":\"/api-reference/account-history/account-log-csv\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Market History\",\"public\":true,\"pages\":[{\"title\":\"Get public execution events\",\"description\":\"Lists trades for a market.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-history-rest.yaml get /market/{tradeable}/executions\",\"href\":\"/api-reference/market-history/get-public-execution-events\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get public order events\",\"description\":\"Lists order events for a market.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-history-rest.yaml get /market/{tradeable}/orders\",\"href\":\"/api-reference/market-history/get-public-order-events\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get public mark price events\",\"description\":\"Lists price events for a market.\\n\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-history-rest.yaml get /market/{tradeable}/price\",\"href\":\"/api-reference/market-history/get-public-mark-price-events\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Candles\",\"public\":true,\"pages\":[{\"title\":\"Tick Types\",\"description\":\"Returns all available tick types to use with the [markets](#operation/symbols) endpoint.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-charts-rest.yaml get /\",\"href\":\"/api-reference/candles/tick-types\",\"autogeneratedByOpenApi\":true},{\"title\":\"Markets\",\"description\":\"Markets available for specified tick type.\\n\\nList of available tick types can be fetched from the [tick types](#operation/tickTypes)\\nendpoint.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-charts-rest.yaml get /{tick_type}\",\"href\":\"/api-reference/candles/markets\",\"autogeneratedByOpenApi\":true},{\"title\":\"Resolutions\",\"description\":\"Candle resolutions available for specified tick type and market.\\n\\nList of available tick types can be fetched from the [tick types](#operation/tickTypes)\\nendpoint. List of available markets can be fetched from the [markets](#operation/symbols)\\nendpoint.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-charts-rest.yaml get /{tick_type}/{symbol}\",\"href\":\"/api-reference/candles/resolutions\",\"autogeneratedByOpenApi\":true},{\"title\":\"Market Candles\",\"description\":\"Candles for specified tick type, market, and resolution.\\n\\nList of available tick types can be fetched from the [tick types](#operation/tickTypes)\\nendpoint. List of available markets can be fetched from the [markets](#operation/symbols)\\nendpoint. List of available resolutions can be fetched from the\\n[resolutions](#operation/resolutions) endpoint.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-charts-rest.yaml get /{tick_type}/{symbol}/{resolution}\",\"href\":\"/api-reference/candles/market-candles\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Analytics\",\"public\":true,\"pages\":[{\"title\":\"Get liquidity pool statistic\",\"description\":\"Get liquidity pool statistic including usd value\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-charts-rest.yaml get /analytics/liquidity-pool\",\"href\":\"/api-reference/analytics/get-liquidity-pool-statistic\",\"autogeneratedByOpenApi\":true},{\"title\":\"Market Analytics\",\"description\":\"Analytics data divided into time buckets\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-charts-rest.yaml get /analytics/{symbol}/{analytics_type}\",\"href\":\"/api-reference/analytics/market-analytics\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"API Keys\",\"public\":true,\"pages\":[{\"title\":\"Check v3 API key\",\"description\":\"Verify API key access and return the authenticated key's details.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi/futures-auth-rest.yaml get /api-keys/v3/check\",\"href\":\"/api-reference/api-keys/check-v3-api-key\",\"autogeneratedByOpenApi\":true}]}]},{\"dropdown\":\"Derivatives WebSocket\",\"icon\":\"bolt\",\"pages\":[{\"title\":\"Derivatives WebSocket\",\"sidebarTitle\":\"Derivatives WebSocket\",\"description\":\"Real-time market data and account streaming for the Kraken Derivatives WebSocket API\",\"public\":true,\"href\":\"/exchange/api-reference/futures-websocket\"},{\"group\":\"Public Channels\",\"public\":true,\"pages\":[{\"title\":\"Ticker\",\"tag\":\"WSS\",\"description\":\"Subscribe to ticker information about listed products\",\"href\":\"/exchange/api-reference/futures-websocket/ticker\"},{\"title\":\"Ticker Lite\",\"tag\":\"WSS\",\"description\":\"Subscribe to lightweight ticker information about listed products\",\"href\":\"/exchange/api-reference/futures-websocket/ticker_lite\"},{\"title\":\"Trade\",\"tag\":\"WSS\",\"description\":\"Subscribe to information about executed trades\",\"href\":\"/exchange/api-reference/futures-websocket/trade\"},{\"title\":\"Book\",\"tag\":\"WSS\",\"description\":\"Subscribe to order book data\",\"href\":\"/exchange/api-reference/futures-websocket/book\"},{\"title\":\"Heartbeat\",\"tag\":\"WSS\",\"description\":\"Subscribe to heartbeat messages at timed intervals\",\"href\":\"/exchange/api-reference/futures-websocket/heartbeat\"}]},{\"group\":\"Private Channels\",\"public\":true,\"pages\":[{\"title\":\"Balances\",\"tag\":\"WSS\",\"description\":\"Subscribe to balance information for holding, single collateral, and multi-collateral wallets\",\"href\":\"/exchange/api-reference/futures-websocket/balances\"},{\"title\":\"Fills\",\"tag\":\"WSS\",\"description\":\"Subscribe to fills information for your account\",\"href\":\"/exchange/api-reference/futures-websocket/fills\"},{\"title\":\"Open Orders\",\"tag\":\"WSS\",\"description\":\"Subscribe to open orders information for your account\",\"href\":\"/exchange/api-reference/futures-websocket/open_orders\"},{\"title\":\"Open Orders (Verbose)\",\"tag\":\"WSS\",\"description\":\"Subscribe to verbose open orders information including failed post-only orders\",\"href\":\"/exchange/api-reference/futures-websocket/open_orders_verbose\"},{\"title\":\"Open Positions\",\"tag\":\"WSS\",\"description\":\"Subscribe to open positions for your account\",\"href\":\"/exchange/api-reference/futures-websocket/open_position\"},{\"title\":\"Account Log\",\"tag\":\"WSS\",\"description\":\"Subscribe to account log information\",\"href\":\"/exchange/api-reference/futures-websocket/account_log\"},{\"title\":\"Notifications\",\"tag\":\"WSS\",\"description\":\"Subscribe to notifications for your account\",\"href\":\"