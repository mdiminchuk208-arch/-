  try {
    if (window.__mintlifyInitialSidebarScrollDone) return;
    window.__mintlifyInitialSidebarScrollDone = true;

    var path = (window.location.pathname || '/').split('#')[0].split('?')[0];
    if (path.endsWith('/index')) path = path.slice(0, -6);
    else if (path === 'index') path = '';

    var candidates = [];
    if (path) candidates.push(path);
    if (path.startsWith('/')) candidates.push(path.slice(1));
    else candidates.push('/' + path);

    var item = null;
    for (var i = 0; i < candidates.length && !item; i++) {
      var matches = document.querySelectorAll('[id="' + candidates[i].replace(/"/g, '\\"') + '"]');
      for (var j = 0; j < matches.length; j++) {
        if (matches[j].closest('#sidebar, #sidebar-content')) {
          item = matches[j];
          break;
        }
      }
    }
    if (!item) return;

    var parent = item.closest('[data-component-part="scroll-area-viewport"]');
    if (!parent) {
      parent = item.parentElement;
      while (parent) {
        var style = getComputedStyle(parent);
        if (style.overflowY === 'auto' || style.overflowY === 'scroll') break;
        parent = parent.parentElement;
      }
    }
    if (!parent) return;

    var parentRect = parent.getBoundingClientRect();
    var itemRect = item.getBoundingClientRect();
    if (itemRect.top >= parentRect.top && itemRect.bottom <= parentRect.bottom) return;

    var itemTopRelative = itemRect.top - parentRect.top + parent.scrollTop;
    parent.scrollTop = itemTopRelative - parentRect.height / 2 + itemRect.height / 2;
  } catch (e) {}
})();</script></div></div></div></div></div></nav><main id="content-container" class="lg:flex-1 lg:min-w-0"><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://docs.kraken.com/#organization","name":"Kraken Developers","url":"https://docs.kraken.com","logo":{"@type":"ImageObject","url":"https://mintcdn.com/kraken/opwCJHYUnRFWd1O3/logo/light.svg?fit=max&auto=format&n=opwCJHYUnRFWd1O3&q=85&s=6be2f97a23f9a7aa6ef071ae334cc89c"}},{"@type":"WebSite","@id":"https://docs.kraken.com#website","name":"Kraken Developers","url":"https://docs.kraken.com","publisher":{"@id":"https://docs.kraken.com/#organization"}},{"@type":"WebPage","@id":"https://docs.kraken.com/api-reference/market-data/get-orderbook#webpage","url":"https://docs.kraken.com/api-reference/market-data/get-orderbook","name":"Get orderbook","description":"This endpoint returns the entire non-cumulative order book of currently listed Futures contracts.","dateModified":"2026-10-06T07:31:58.202Z","isPartOf":{"@id":"https://docs.kraken.com#website"},"breadcrumb":{"@id":"https://docs.kraken.com/api-reference/market-data/get-orderbook#breadcrumb"}},{"@type":"BreadcrumbList","@id":"https://docs.kraken.com/api-reference/market-data/get-orderbook#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Market Data","item":"https://docs.kraken.com/api-reference/market-data/get-tickers"},{"@type":"ListItem","position":2,"name":"Get orderbook","item":"https://docs.kraken.com/api-reference/market-data/get-orderbook"}]},{"@type":["TechArticle","APIReference"],"@id":"https://docs.kraken.com/api-reference/market-data/get-orderbook#apireference","headline":"Get orderbook","name":"Get orderbook","description":"This endpoint returns the entire non-cumulative order book of currently listed Futures contracts.","url":"https://docs.kraken.com/api-reference/market-data/get-orderbook","mainEntityOfPage":{"@id":"https://docs.kraken.com/api-reference/market-data/get-orderbook#webpage"},"dateModified":"2026-10-06T07:31:58.202Z","publisher":{"@id":"https://docs.kraken.com/#organization"},"isPartOf":{"@id":"https://docs.kraken.com#website"}}]}</script><script>document.documentElement.setAttribute('data-page-mode', "none");</script><span class="fixed inset-0 bg-background-light dark:bg-background-dark -z-10 pointer-events-none" id="background-color"></span><style data-custom-css-index="0" data-custom-css-path="custom.css">/* ── FONTS ────────────────────────────────────────────────────────────────
   Loaded from Kraken's public CDN. Font face URLs in these files are relative
   to the CDN origin so they resolve correctly via @import.
   ─────────────────────────────────────────────────────────────────────── */
@import url('https://assets.kraken.com/fonts/kraken.css');
@import url('https://assets.kraken.com/fonts/celias.css');


/* ── TYPOGRAPHY ───────────────────────────────────────────────────────── */
html, body, body * {
  font-family: var(--kp-font-sans) !important;
  -webkit-font-smoothing: antialiased;
}

h1, h2, h3, h4 {
  font-family: var(--kp-font-brand) !important;
}
.prose h1, .prose h2, .prose h3, .prose h4,
.prose h5, .prose h6 {
  font-family: var(--kp-font-brand) !important;
  font-weight: 500 !important;
}

body code, body pre, body kbd, body samp,
body code *, body pre *,
body [class*="code"], body [class*="Code"],
.kp-mono, .kp-mono * {
  font-family: var(--kp-font-mono) !important;
}


/* ── DESIGN TOKENS ────────────────────────────────────────────────────────
   Single source of truth for the API Centre theme. Only tokens actually
   referenced by snippets/* or rules below are defined here.
   ─────────────────────────────────────────────────────────────────────── */
:root {
  /* Primary — pro-fe (de-purpled): black/white as the primary action color */
  --kp-primary:            #101114;
  --kp-primary-hover:      #2a2c33;

  /* Brand accent — purple (focus rings, brand CTAs) */
  --kp-brand:              #7132f5;

  /* Typography */
  --kp-font-sans:          'Kraken-Product', system-ui, -apple-system, sans-serif;
  --kp-font-mono:          'Kraken-Mono', ui-monospace, monospace;
  --kp-font-brand:         'Kraken-Brand', 'Celias', system-ui, sans-serif;

  /* Surfaces */
  --kp-bg-page:            #f6f5f9;
  --kp-bg-card:            #ffffff;
  --kp-bg-subtle:          rgba(104, 107, 130, 0.12);

  /* Text */
  --kp-text-heading:       #101114;
  --kp-text-body:          #686b82;
  --kp-text-placeholder:   #9497a9;
  --kp-text-accent:        #101114;
  --kp-text-meta:          #9497a9;

  /* Borders */
  --kp-border:             rgba(104, 107, 130, 0.16);

  /* Terminal — CLI demo window (aliases that re-theme in dark mode) */
  --kp-terminal-bg:        transparent;
  --kp-terminal-text:      var(--kp-text-body);
  --kp-terminal-heading:   var(--kp-text-heading);
  --kp-terminal-muted:     var(--kp-text-placeholder);
}

html.dark {
  --kp-primary:            #ffffff;
  --kp-primary-hover:      #e7e7e7;
  --kp-brand:              #8a61ff;

  --kp-bg-page:            #0b0611;
  --kp-bg-card:            #16121f;
  --kp-bg-subtle:          rgba(255, 255, 255, 0.07);

  --kp-text-heading:       #ffffff;
  --kp-text-body:          #c6c7d2;
  --kp-text-placeholder:   #9497a9;
  --kp-text-accent:        #ffffff;
  --kp-text-meta:          rgba(255, 255, 255, 0.45);

  /* Match Mintlify's native dark card/table border (white/10) so custom
     landing-page cards align with native <Card> outlines. */
  --kp-border:             rgba(255, 255, 255, 0.1);
}


/* ── REDUCED MOTION ───────────────────────────────────────────────────── */
@media (prefers-reduced-motion: reduce) {
  .kp-terminal *,
  .kp-welcome-hero * {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}


/* ── MINTLIFY / MINT OVERRIDES ────────────────────────────────────────────
   Align Mintlify's built-in doc page styling with the Pro design system.
   WARNING: targets Mintlify internal elements; verify after upgrades. */

/* Page background */
body {
  background-color: var(--kp-bg-page) !important;
}
body #almond-background-color {
  background-color: var(--kp-bg-page) !important;
}

/* Doc content text — align with Pro typography colors */
.prose {
  --tw-prose-body: var(--kp-text-body) !important;
  --tw-prose-headings: var(--kp-text-heading) !important;
  --tw-prose-links: var(--kp-text-accent) !important;
  --tw-prose-bold: var(--kp-text-heading) !important;
  --tw-prose-code: var(--kp-text-heading) !important;
  --tw-prose-counters: var(--kp-text-body) !important;
  --tw-prose-bullets: var(--kp-text-placeholder) !important;
  --tw-prose-hr: var(--kp-border) !important;
  --tw-prose-quotes: var(--kp-text-body) !important;
  --tw-prose-quote-borders: var(--kp-border) !important;
  --tw-prose-th-borders: var(--kp-border) !important;
  --tw-prose-td-borders: var(--kp-border) !important;
}

/* Sidebar text */
nav a, nav button {
  color: var(--kp-text-body);
}
nav a:hover, nav button:hover {
  color: var(--kp-text-heading);
}

/* Navbar logo — render the wordmark at its true aspect ratio. Mintlify forces
   h-7 (28px height); capping only the width (the art is ~6.7:1) distorts the
   box to 150×28 and leaves vertical letterbox slack — the logo fills its width
   but floats short of its height, reading as slightly stretched and shifting
   sub-pixels between layouts. Fix the width and let the height follow so the
   box always matches the SVG's ratio. */
.nav-logo {
  width: 150px !important;
  height: auto !important;
}

/* Card-like containers — ResponseField, callouts, panels */
[data-component-part="field-root"] {
  border-color: var(--kp-border) !important;
}

/* Tab buttons */
[role="tablist"] button[data-state="active"] {
  color: var(--kp-text-heading) !important;
  border-color: var(--kp-primary) !important;
}
[role="tablist"] button[data-state="inactive"] {
  color: var(--kp-text-placeholder) !important;
}

/* ── LANDING PAGE COMPONENTS ──────────────────────────────────────────────
   Used by snippets/welcome-content.mdx, hero-actions.jsx,
   product-cards.jsx, and chat-demo.jsx (the CLI terminal demo).
   ─────────────────────────────────────────────────────────────────────── */

/* Welcome hero — 2-col layout (actions + copy on left, code panel on right).
   Suppresses Mintlify's auto-rendered eyebrow + h1 + description + page menu;
   we render our own h1 and description inline. Frontmatter `title` and
   `description` are kept for SEO/sidebar.
   WARNING: targets Mintlify internal structure — verify after upgrades. */
body:has(.kp-welcome-hero) #header {
  display: none !important;
}

@media (min-width: 1024px) {
  .kp-welcome-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: start;
    margin-bottom: 2.5rem;
  }
}

.prose .kp-welcome-title {
  font-size: 36px !important;
  line-height: 1.15 !important;
  letter-spacing: -0.01em;
  margin: 0 0 1rem !important;
}

.kp-welcome-hero-code .code-group {
  margin-top: 0 !important;
  margin-bottom: 0 !important;
}

/* Filled primary button — inverts to brand-dark on light theme, brand-light
   on dark theme. Used for the hero "Quickstart" CTA. */
.prose a.kp-hero-btn-primary {
  text-decoration: none !important;
  border: 1px solid var(--kp-primary) !important;
  background-color: var(--kp-primary);
  color: var(--kp-bg-card) !important;
}
.prose a.kp-hero-btn-primary:hover {
  background-color: var(--kp-primary-hover);
  border-color: var(--kp-primary-hover) !important;
}
html.dark .prose a.kp-hero-btn-primary {
  color: var(--kp-bg-page) !important;
}

/* Terminal demo — dark window styling with theme-aware tokens */
.kp-terminal {
  background: var(--kp-terminal-bg) !important;
  border-color: var(--kp-border) !important;
}
.kp-terminal.kp-terminal-card {
  background: var(--kp-bg-card) !important;
}
.kp-terminal .kp-term-output {
  color: var(--kp-terminal-text);
}
.kp-terminal .kp-term-prompt-text {
  color: var(--kp-terminal-heading) !important;
}
.kp-terminal .kp-term-cursor {
  background: var(--kp-terminal-heading) !important;
}
.kp-terminal span[aria-hidden="true"]:first-child {
  color: var(--kp-terminal-muted) !important;
}

/* Terminal demo + code blocks — hide scrollbar but keep scrollable */
.kp-term-output,
pre code {
  scrollbar-width: none;
}
.kp-term-output::-webkit-scrollbar,
pre code::-webkit-scrollbar {
  display: none;
}

/* Terminal — smaller font on narrow screens so table output fits */
@media (max-width: 480px) {
  .kp-term-output {
    font-size: 11px !important;
    padding: 12px 14px !important;
  }
}

/* CLI install command bar */
.kp-cli-install {
  scrollbar-width: none;
}
.kp-cli-install::-webkit-scrollbar {
  display: none;
}

.kp-cli-copy-btn {
  transition: color 0.15s ease;
}
.kp-cli-install:hover .kp-cli-copy-btn {
  color: var(--kp-text-heading) !important;
}
.kp-cli-install:focus-visible {
  outline: 2px solid var(--kp-brand);
  outline-offset: -2px;
}
.kp-cli-copy-btn svg {
  transition: transform 0.15s ease;
}
.kp-cli-install:hover .kp-cli-copy-btn svg {
  transform: scale(1.15);
}

/* Hide the auto-injected "Log In" button in the top navbar.
   Mintlify renders this when password auth is enabled. The button class
   is .login-link; the "Get API key" navbar.primary CTA is unaffected. */
.login-link {
  display: none !important;
}
</style><style data-custom-css-index="1" data-custom-css-path="global.css">/* Tighten vertical white space across docs pages */

/* Horizontal rule dividers */
hr {
  margin-top: 1rem !important;
  margin-bottom: 1rem !important;
}

/* Field description — reduce gap between param header and description */
[data-component-part="field-content"] {
  margin-top: 0.25rem !important;
}

/* Protocol banner — shared base for WS and FIX
   Colors use Pro foundation grey scale and semantic palette */
.api-banner {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  border: 1px solid light-dark(#e5e6ec, #353746);
  box-shadow: 0 0 0 5px light-dark(#ffffff, #0b0611), 0 0 0 6px light-dark(#e5e6ec, #353746);
  border-radius: 1rem;
  padding: 0.4rem;
  margin-bottom: 0.8rem;
}

.api-banner .api-protocol {
  color: white;
  font-weight: 800;
  font-size: 12px;
  padding: 0.1rem 0.5rem;
  border-radius: 1rem;
  text-transform: uppercase;
}

.api-banner .api-protocol.ws {
  background: light-dark(#0079b4, #004e75);
}

.api-banner .api-protocol.fix {
  background: light-dark(#a67c1d, #6f5000);
}

.api-banner .api-detail {
  font-family: var(--kp-font-mono);
  font-size: 14px;
  color: light-dark(#484b5e, #9497a9);
}

.api-banner .api-tag {
  margin-left: auto;
  font-family: var(--kp-font-mono);
  font-weight: 600;
  font-size: 12px;
  background: light-dark(#eeeff3, #292b38);
  color: light-dark(#484b5e, #c6c7d2);
  padding: 0.1rem 1.5rem;
  border-radius: 0.7rem;
}

/* Sidebar tag pills — reposition to left of label */
div:has(> .nav-tag-pill) {
  order: -1;
  margin-left: 0 !important;
  margin-right: 0.9rem !important;
}

/* Code blocks — smaller font, tighter line spacing */
pre code {
  font-size: 12px !important;
}

[data-component-part="code-block-root"],
[data-component-part="code-group-tab-content"] {
  line-height: 1.25rem !important;
}

/* Right-side panel — flow with content instead of sticking */
#content-side-layout {
  position: relative !important;
  top: auto !important;
  height: auto !important;
  max-height: none !important;
}

/* OpenAPI endpoint description — shrink to 16px */
#header .prose {
  font-size: 16px;
}

/* Metadata keyword labels inside ResponseField (One of, Default, Example, etc.) */
.field-attr {
  font-weight: 600;
  font-size: 12px;
  line-height: 16px;
  color: light-dark(#686b82, #9497a9);
}
</style><!--$--><!--/$--><div class="flex flex-row-reverse gap-12 box-border w-full pt-[calc(10rem+var(--banner-height,2.5rem))] lg:pt-10"><div data-api-example="" class="hidden xl:flex self-start sticky xl:flex-col max-w-[28rem] z-21 h-[calc(100vh-9.5rem)] top-[9.5rem] [[data-banner-state=visible]_&amp;]:h-[calc(100vh-12rem)] [[data-banner-state=visible]_&amp;]:top-[12rem]" id="content-side-layout"><div class="w-full relative print:print-color-exact xl:w-[28rem] max-h-[calc(100%-32px)] print:max-h-none gap-6 grid grid-rows-[repeat(auto-fit,minmax(0,min-content))] grid-rows min-h-[18rem]"><div data-orientation="horizontal" data-activation-direction="none" class="code-group p-0.5 flex flex-col not-prose relative rounded-2xl border border-gray-950/10 dark:border-white/10 min-w-0 my-0 bg-gray-50 dark:bg-white/5 dark:codeblock-dark text-gray-950 dark:text-gray-50 codeblock-light"><div class="flex items-center justify-between gap-2 relative px-2.5" data-component-part="code-group-tab-bar"><div class="flex items-center gap-1.5 text-xs font-medium min-w-0"><span class="truncate text-gray-950 dark:text-gray-50" title="Get orderbook">Get orderbook</span></div><div class="flex items-center justify-end shrink-0 gap-1.5"><button type="button" tabindex="0" aria-haspopup="menu" aria-expanded="false" id="base-ui-_R_qcmjd9qnpfb39p7b9snpfiutb_" aria-label="Select language" class="group disabled:pointer-events-none [&amp;&gt;span]:line-clamp-1 rounded-lg overflow-hidden group focus-visible:outline-2 focus-visible:outline-primary dark:focus-visible:outline-primary-light flex items-center py-0.5 gap-1 text-gray-950/50 dark:text-white/50 group-hover:text-gray-950/70 dark:group-hover:text-white/70 select-none bg-transparent dark:bg-transparent pb-1 text-xs font-medium cursor-default focus-visible:-outline-offset-2"><div class="flex gap-1 items-center pl-2.5 pr-1.5 py-[5px] rounded-[10px] border text-gray-500 dark:text-gray-400 cursor-pointer hover:bg-gray-200/50 dark:hover:bg-gray-700/70