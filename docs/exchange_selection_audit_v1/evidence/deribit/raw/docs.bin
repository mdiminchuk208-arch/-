r specific pages */\ntable th:nth-child(1),\ntable td:nth-child(1) {\n    width: 6% !important;\n    min-width: 50px;\n}\n\n[href*=\"/fix-api/\"] ~ * table th:nth-child(2),\n[href*=\"/fix-api/\"] ~ * table td:nth-child(2),\nmain:has([href*=\"/fix-api/\"]) table th:nth-child(2),\nmain:has([href*=\"/fix-api/\"]) table td:nth-child(2),\ntable th:nth-child(2),\ntable td:nth-child(2) {\n    width: 12% !important;\n    min-width: 90px;\n}\n\n[href*=\"/fix-api/\"] ~ * table th:nth-child(3),\n[href*=\"/fix-api/\"] ~ * table td:nth-child(3),\nmain:has([href*=\"/fix-api/\"]) table th:nth-child(3),\nmain:has([href*=\"/fix-api/\"]) table td:nth-child(3),\ntable th:nth-child(3),\ntable td:nth-child(3) {\n    width: 8% !important;\n    min-width: 70px;\n}\n\n[href*=\"/fix-api/\"] ~ * table th:nth-child(4),\n[href*=\"/fix-api/\"] ~ * table td:nth-child(4),\nmain:has([href*=\"/fix-api/\"]) table th:nth-child(4),\nmain:has([href*=\"/fix-api/\"]) table td:nth-child(4),\ntable th:nth-child(4),\ntable td:nth-child(4) {\n    width: 8% !important;\n    min-width: 70px;\n}\n\n[href*=\"/fix-api/\"] ~ * table th:nth-child(5),\n[href*=\"/fix-api/\"] ~ * table td:nth-child(5),\nmain:has([href*=\"/fix-api/\"]) table th:nth-child(5),\nmain:has([href*=\"/fix-api/\"]) table td:nth-child(5),\ntable th:nth-child(5),\ntable td:nth-child(5) {\n    width: 66% !important;\n    min-width: 350px;\n}\n\n/* Rate Limits table - override column widths for better distribution */\n.rate-limits-table table th:nth-child(1),\n.rate-limits-table table td:nth-child(1) {\n    width: 20% !important;\n    min-width: 120px;\n}\n\n.rate-limits-table table th:nth-child(2),\n.rate-limits-table table td:nth-child(2) {\n    width: 22% !important;\n    min-width: 140px;\n}\n\n.rate-limits-table table th:nth-child(3),\n.rate-limits-table table td:nth-child(3) {\n    width: 22% !important;\n    min-width: 140px;\n}\n\n.rate-limits-table table th:nth-child(4),\n.rate-limits-table table td:nth-child(4) {\n    width: 18% !important;\n    min-width: 120px;\n}\n\n.rate-limits-table table th:nth-child(5),\n.rate-limits-table table td:nth-child(5) {\n    width: 18% !important;\n    min-width: 120px;\n}\n"])</script><script>self.__next_f.push([1,"b2:[\"$\",\"$Lb7\",null,{\"cssFiles\":[{\"_id\":\"6914d9272754718b161408ea\",\"filePath\":\"public/style.css\",\"subdomain\":\"deribit\",\"__v\":0,\"content\":\"$b8\"}]}]\nba:Tb9a,"])</script><script>self.__next_f.push([1,"// Zamienia \"Query Parameters\" na \"Parameters\"\n(function() {\n    'use strict';\n    \n    function replaceQueryParameters() {\n        try {\n            const headings = document.querySelectorAll('h4.api-section-heading-title');\n            let replaced = 0;\n            \n            headings.forEach(function(heading) {\n                if (heading \u0026\u0026 heading.textContent \u0026\u0026 heading.textContent.trim() === 'Query Parameters') {\n                    heading.textContent = 'Parameters';\n                    replaced++;\n                }\n            });\n            \n            console.log('Replaced', replaced, 'Query Parameters headings');\n        } catch (e) {\n            console.error('Error replacing Query Parameters:', e);\n        }\n    }\n    \n    // Próbuj wielokrotnie\n    if (document.readyState === 'loading') {\n        document.addEventListener('DOMContentLoaded', replaceQueryParameters);\n    } else {\n        replaceQueryParameters();\n    }\n    \n    window.addEventListener('load', replaceQueryParameters);\n    setTimeout(replaceQueryParameters, 100);\n    setTimeout(replaceQueryParameters, 300);\n    setTimeout(replaceQueryParameters, 500);\n    setTimeout(replaceQueryParameters, 1000);\n    setTimeout(replaceQueryParameters, 2000);\n    \n    // Observer dla dynamicznych zmian\n    if (typeof MutationObserver !== 'undefined') {\n        var observer = new MutationObserver(function() {\n            replaceQueryParameters();\n        });\n        \n        if (document.body) {\n            observer.observe(document.body, {\n                childList: true,\n                subtree: true\n            });\n        } else {\n            setTimeout(function() {\n                if (document.body) {\n                    observer.observe(document.body, {\n                        childList: true,\n                        subtree: true\n                    });\n                }\n            }, 100);\n        }\n    }\n    \n    // Tag Body sections so CSS can hide them precisely\n    function tagBodySections() {\n        try {\n            var sections = document.querySelectorAll('.api-section');\n            sections.forEach(function(section) {\n                var heading = section.querySelector('h4.api-section-heading-title');\n                if (heading \u0026\u0026 heading.textContent \u0026\u0026 heading.textContent.trim().toLowerCase() === 'body') {\n                    section.setAttribute('data-section', 'body');\n                }\n            });\n        } catch (e) {\n            // no-op\n        }\n    }\n\n    if (document.readyState === 'loading') {\n        document.addEventListener('DOMContentLoaded', tagBodySections);\n    } else {\n        tagBodySections();\n    }\n\n    if (typeof MutationObserver !== 'undefined') {\n        var bodyObserver = new MutationObserver(function() {\n            tagBodySections();\n        });\n        if (document.documentElement) {\n            bodyObserver.observe(document.documentElement, { childList: true, subtree: true });\n        }\n    }\n})();\n\n"])</script><script>self.__next_f.push([1,"b3:[\"$\",\"$Lb9\",null,{\"customJsDisabled\":false,\"jsFiles\":[{\"_id\":\"6914d9272754718b161408dc\",\"filePath\":\"public/replace-query-params.js\",\"subdomain\":\"deribit\",\"__v\":0,\"content\":\"$ba\"}]}]\nbd:T1d7f,"])</script><script>self.__next_f.push([1,"\"use strict\";const{Fragment:_Fragment,jsx:_jsx,jsxs:_jsxs}=arguments[0];const{useMDXComponents:_provideComponents}=arguments[0];function _createMdxC