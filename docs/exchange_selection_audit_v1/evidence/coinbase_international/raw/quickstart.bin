  try {
    if (window.__mintlifyInitialSidebarScrollDone) return;
    window.__mintlifyInitialSidebarScrollDone = true;

    var path = (window.location.pathname || '/').split('#')[0].split('?')[0];
    if (path.endsWith('/index')) path = path.slice(0, -6);
    else if (path === 'index') path = '';

    var candidates = [];
    if (path) candidates.push(path);
    if (path.startsWith('/')) candidates.push(path.slice(1));
    else candidates.push('/' + path);

    var item = null;
    for (var i = 0; i < candidates.length && !item; i++) {
      var matches = document.querySelectorAll('[id="' + candidates[i].replace(/"/g, '\\"') + '"]');
      for (var j = 0; j < matches.length; j++) {
        if (matches[j].closest('#sidebar, #sidebar-content')) {
          item = matches[j];
          break;
        }
      }
    }
    if (!item) return;

    var parent = item.closest('[data-component-part="scroll-area-viewport"]');
    if (!parent) {
      parent = item.parentElement;
      while (parent) {
        var style = getComputedStyle(parent);
        if (style.overflowY === 'auto' || style.overflowY === 'scroll') break;
        parent = parent.parentElement;
      }
    }
    if (!parent) return;

    var parentRect = parent.getBoundingClientRect();
    var itemRect = item.getBoundingClientRect();
    if (itemRect.top >= parentRect.top && itemRect.bottom <= parentRect.bottom) return;

    var itemTopRelative = itemRect.top - parentRect.top + parent.scrollTop;
    parent.scrollTop = itemTopRelative - parentRect.height / 2 + itemRect.height / 2;
  } catch (e) {}
})();</script></div></div></div></div></nav><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://docs.cdp.coinbase.com/#organization","name":"Coinbase Developer Documentation","url":"https://docs.cdp.coinbase.com","logo":{"@type":"ImageObject","url":"https://mintcdn.com/coinbase-prod/B68gj-lD9xkJGij4/logos/wordmark-light.svg?fit=max&auto=format&n=B68gj-lD9xkJGij4&q=85&s=0eb5640aeec58541851e1cba9c6ccc8b"}},{"@type":"WebSite","@id":"https://docs.cdp.coinbase.com#website","name":"Coinbase Developer Documentation","url":"https://docs.cdp.coinbase.com","publisher":{"@id":"https://docs.cdp.coinbase.com/#organization"}},{"@type":"WebPage","@id":"https://docs.cdp.coinbase.com/international-exchange/introduction/quickstart#webpage","url":"https://docs.cdp.coinbase.com/international-exchange/introduction/quickstart","name":"Quickstart - Making Your First API Call","dateModified":"2026-10-12T20:58:55.824Z","isPartOf":{"@id":"https://docs.cdp.coinbase.com#website"},"breadcrumb":{"@id":"https://docs.cdp.coinbase.com/international-exchange/introduction/quickstart#breadcrumb"}},{"@type":"BreadcrumbList","@id":"https://docs.cdp.coinbase.com/international-exchange/introduction/quickstart#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"INSTITUTIONAL APIS","item":"https://docs.cdp.coinbase.com/institutional-apis/overview"},{"@type":"ListItem","position":2,"name":"Coinbase International Exchange","item":"https://docs.cdp.coinbase.com/international-exchange/introduction/welcome"},{"@type":"ListItem","position":3,"name":"Quickstart - Making Your First API Call","item":"https://docs.cdp.coinbase.com/international-exchange/introduction/quickstart"}]},{"@type":["Article","TechArticle"],"@id":"https://docs.cdp.coinbase.com/international-exchange/introduction/quickstart#article","headline":"Quickstart - Making Your First API Call","name":"Quickstart - Making Your First API Call","url":"https://docs.cdp.coi