on/welcome\"},{\"title\":\"Quickstart - Making Your First REST API Call\",\"sidebarTitle\":\"REST Quickstart\",\"description\":null,\"href\":\"/exchange/introduction/rest-quickstart\"},{\"title\":\"Exchange Sandbox\",\"sidebarTitle\":\"Sandbox\",\"description\":null,\"href\":\"/exchange/introduction/sandbox\"},{\"title\":\"Exchange Systems \u0026 Operations\",\"sidebarTitle\":\"Systems \u0026 Operations\",\"description\":null,\"href\":\"/exchange/introduction/systems-operations\"},{\"group\":\"Concepts\",\"pages\":[{\"title\":\"Concepts Overview\",\"description\":null,\"href\":\"/exchange/concepts/overview\"},{\"title\":\"Account Structure\",\"description\":null,\"href\":\"/exchange/concepts/structure\"},{\"title\":\"Portfolio Isolation and Cross Portfolio Access\",\"sidebarTitle\":\"Cross Portfolio Access\",\"description\":\"Lock each Coinbase Exchange API key to its own portfolio, and grant cross portfolio access only to the keys that need it.\",\"href\":\"/exchange/concepts/cross-portfolio-access\"},{\"title\":\"Trading\",\"description\":null,\"href\":\"/exchange/concepts/trading\"},{\"title\":\"Exchange Matching Engine\",\"sidebarTitle\":\"Matching Engine\",\"description\":null,\"href\":\"/exchange/concepts/matching-engine\"}]},{\"title\":\"REST API\",\"url\":\"/api-reference/exchange-api/rest-api/introduction\",\"description\":null,\"href\":\"/exchange/rest-api/api-reference\"},{\"title\":\"FIX API\",\"url\":\"/exchange/fix-api/connectivity\",\"description\":null,\"href\":\"/exchange/fix-api\"},{\"title\":\"Websocket Feed\",\"url\":\"/exchange/websocket-feed/overview\",\"description\":null,\"href\":\"/exchange/websocket-feed\"},{\"group\":\"Travel Rule\",\"pages\":[{\"title\":\"Travel Rule for Withdrawals\",\"sidebarTitle\":\"Withdrawals\",\"description\":null,\"href\":\"/exchange/travel-rule/withdrawals\"}]},{\"group\":\"Changes\",\"pages\":[{\"title\":\"Exchange Changelog\",\"sidebarTitle\":\"Changelog\",\"url\":\"/exchange/changes/changelog\",\"description\":null,\"href\":\"/exchange/changes/changelog-stub\"},{\"title\":\"Exchange Upcoming Changes\",\"sidebarTitle\":\"Upcoming Changes\",\"description\":null,\"href\":\"/exchange/changes/upcoming-changes\"}]}]},{\"group\":\"Coinbase International Exchange\",\"pages\":[{\"title\":\"Welcome to International Exchange APIs\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/international-exchange/introduction/welcome\"},{\"title\":\"Quickstart - Making Your First API Call\",\"sidebarTitle\":\"Quickstart\",\"description\":null,\"href\":\"/international-exchange/introduction/quickstart\"},{\"title\":\"International Exchange Sandbox\",\"sidebarTitle\":\"Sandbox\",\"description\":null,\"href\":\"/international-exchange/introduction/sandbox\"},{\"title\":\"International Exchange Rate Limits Overview\",\"sidebarTitle\":\"Rate Limits Overview\",\"description\":null,\"href\":\"/international-exchange/introduction/rate-limits-overview\"},{\"title\":\"International Exchange Systems \u0026 Operations\",\"sidebarTitle\":\"Systems \u0026 Operations\",\"description\":null,\"href\":\"/international-exchange/introduction/systems-operations\"},{\"group\":\"Concepts\",\"pages\":[{\"title\":\"Portfolios\",\"sidebarTitle\":\"Portfolios\",\"description\":null,\"href\":\"/international-exchange/concepts/portfolios\"},{\"title\":\"Instruments\",\"sidebarTitle\":\"Instruments\",\"description\":null,\"href\":\"/international-exchange/concepts/instruments\"},{\"title\":\"Trading\",\"sidebarTitle\":\"Trading\",\"description\":null,\"href\":\"/international-exchange/concepts/trading\"}]},{\"title\":\"REST API\",\"url\":\"/api-reference/international-exchange-api/rest-api/introduction\",\"description\":null,\"href\":\"/international-exchange/rest-api/api-reference\"},{\"title\":\"FIX API\",\"url\":\"/international-exchange/fix-api/fix-api-overview\",\"description\":null,\"href\":\"/international-exchange/fix-api\"},{\"url\":\"/international-exchange/websocket-feed/websocket-overview\",\"title\":\"Websocket Feed\",\"description\":null,\"href\":\"/international-exchange/websocket-feed\"},{\"group\":\"Changes\",\"pages\":[{\"title\":\"International Exchange Changelog\",\"sidebarTitle\":\"Changelog\",\"url\":\"/international-exchange/changes/changelog\",\"description\":null,\"href\":\"/international-exchange/changes/changelog-stub\"},{\"title\":\"INTX Upcoming Changes\",\"sidebarTitle\":\"Upcoming Changes\",\"description\":null,\"href\":\"/international-exchange/changes/upcoming-changes\"}]}]},{\"group\":\"Coinbase Prime\",\"pages\":[{\"title\":\"Welcome to Coinbase Prime APIs\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/prime/introduction/welcome\"},{\"title\":\"Quickstart - Getting Started with Prime\",\"sidebarTitle\":\"Quickstart\",\"description\":null,\"href\":\"/prime/introduction/quickstart\"},{\"title\":\"Prime Systems \u0026 Operations\",\"sidebarTitle\":\"Systems \u0026 Operations\",\"description\":null,\"href\":\"/prime/introduction/systems-operations\"},{\"group\":\"Concepts\",\"pages\":[{\"title\":\"Prime Overview\",\"description\":null,\"href\":\"/prime/concepts/overview\"},{\"title\":\"Prime Reference Applications\",\"sidebarTitle\":\"Reference Apps\",\"description\":null,\"href\":\"/prime/concepts/reference-apps\"},{\"group\":\"Platform Structure\",\"pages\":[{\"title\":\"Account Structure\",\"description\":null,\"href\":\"/prime/concepts/account-structure\"},{\"title\":\"Trading Balance\",\"description\":null,\"href\":\"/prime/concepts/trading-balance\"}]},{\"group\":\"Trading\",\"pages\":[{\"title\":\"Trading Basics\",\"sidebarTitle\":\"Trading Basics\",\"description\":null,\"href\":\"/prime/concepts/trading/trading\"},{\"title\":\"Order Types\",\"sidebarTitle\":\"Order Types\",\"description\":null,\"href\":\"/prime/concepts/trading/order-types\"},{\"title\":\"Market Data\",\"sidebarTitle\":\"Market Data\",\"description\":null,\"href\":\"/prime/concepts/trading/market-data\"},{\"title\":\"Trading Fees\",\"sidebarTitle\":\"Trading Fees\",\"description\":null,\"href\":\"/prime/concepts/trading/trading-fees\"},{\"title\":\"Trade Financing\",\"description\":null,\"href\":\"/prime/concepts/trading/trade-financing\"},{\"title\":\"FIX\",\"sidebarTitle\":\"FIX\",\"description\":null,\"href\":\"/prime/concepts/trading/fix\"},{\"title\":\"RFQ\",\"sidebarTitle\":\"RFQ\",\"description\":null,\"href\":\"/prime/concepts/trading/rfq\"}]},{\"group\":\"Wallets\",\"pages\":[{\"title\":\"Wallets Overview\",\"description\":null,\"href\":\"/prime/concepts/wallets/wallets-overview\"},{\"title\":\"Onchain Wallet\",\"description\":null,\"href\":\"/prime/concepts/wallets/onchain-wallet\"},{\"title\":\"Onchain Wallet Server-Signer Setup\",\"sodebarTitle\":\"Server-Signer Setup\",\"description\":null,\"href\":\"/prime/concepts/wallets/server-signup\"}]},{\"group\":\"Stablecoins\",\"pages\":[{\"title\":\"Conversions\",\"description\":null,\"href\":\"/prime/concepts/stablecoins/conversions\"},{\"title\":\"USDC Rewards\",\"description\":null,\"href\":\"/prime/concepts/stablecoins/usdc-rewards\"},{\"title\":\"USDC Settlement\",\"description\":null,\"href\":\"/prime/concepts/stablecoins/usdc-settlement\"}]},{\"title\":\"Balances\",\"description\":null,\"href\":\"/prime/concepts/balances\"},{\"group\":\"Transactions\",\"pages\":[{\"title\":\"Deposits\",\"description\":null,\"href\":\"/prime/concepts/transactions/deposits\"},{\"title\":\"Withdrawals\",\"description\":null,\"href\":\"/prime/concepts/transactions/withdrawals\"},{\"title\":\"Transfers\",\"description\":null,\"href\":\"/prime/concepts/transactions/transfers\"},{\"title\":\"Multi-Network\",\"description\":null,\"href\":\"/prime/concepts/transactions/multinetwork\"}]},{\"group\":\"Staking\",\"pages\":[{\"title\":\"Staking\",\"description\":null,\"href\":\"/prime/concepts/staking/staking\"},{\"title\":\"Staking Lifecycle\",\"description\":null,\"href\":\"/prime/concepts/staking/staking-lifecycle\"},{\"title\":\"Staking Rewards\",\"description\":null,\"href\":\"/prime/concepts/staking/staking-rewards\"}]},{\"title\":\"Activities\",\"description\":null,\"href\":\"/prime/concepts/activities\"}]},{\"title\":\"REST API\",\"url\":\"/api-reference/prime-api/rest-api/introduction\",\"description\":null,\"href\":\"/prime/rest-api/api-reference\"},{\"title\":\"FIX API\",\"url\":\"/prime/fix-api/connectivity\",\"description\":null,\"href\":\"/prime/fix-api\"},{\"title\":\"Websocket Feed\",\"url\":\"/prime/websocket-feed/overview\",\"description\":null,\"href\":\"/prime/websocket-feed\"},{\"group\":\"Changes\",\"pages\":[{\"title\":\"Prime Changelog\",\"sidebarTitle\":\"Changelog\",\"url\":\"/prime/changes/changelog\",\"description\":null,\"href\":\"/prime/changes/changelog-stub\"},{\"title\":\"Prime Upcoming Changes\",\"sidebarTitle\":\"Upcoming Changes\",\"description\":null,\"href\":\"/prime/changes/upcoming-changes\"}]}]},{\"group\":\"Coinbase Derivatives\",\"pages\":[{\"title\":\"Welcome to Coinbase Derivatives Exchange\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/derivatives/introduction/welcome\"},{\"title\":\"Derivatives Market Hours \u0026 24x7\",\"sidebarTitle\":\"Market Hours \u0026 24x7\",\"description\":null,\"href\":\"/derivatives/introduction/market-hours\"},{\"title\":\"Derivatives Runbook\",\"sidebarTitle\":\"Runbook\",\"description\":null,\"href\":\"/derivatives/introduction/runbook\"},{\"title\":\"Derivatives Connectivity\",\"sidebarTitle\":\"Connectivity\",\"description\":null,\"href\":\"/derivatives/introduction/connectivity\"},{\"title\":\"Derivatives Downloads\",\"sidebarTitle\":\"Downloads\",\"description\":null,\"href\":\"/derivatives/introduction/downloads\"},{\"title\":\"REST API\",\"url\":\"/api-reference/derivatives-api/rest-api/introduction\",\"description\":null,\"href\":\"/derivatives/rest/api-reference\"},{\"title\":\"FIX API\",\"url\":\"/derivatives/fix/overview\",\"description\":null,\"href\":\"/derivatives/fix/fix-api-reference\"},{\"title\":\"SBE API\",\"url\":\"/derivatives/sbe/overview\",\"description\":null,\"href\":\"/derivatives/sbe/sbe-api-reference\"},{\"title\":\"UDP API\",\"url\":\"/derivatives/udp/overview\",\"description\":null,\"href\":\"/derivatives/udp/udp-api-reference\"},{\"title\":\"Derivatives Changelog\",\"sidebarTitle\":\"Changelog\",\"url\":\"/derivatives/changes/changelog\",\"description\":null,\"href\":\"/derivatives/changes/changelog-stub\"}]}]}]},{\"tab\":\"API Reference\",\"dropdowns\":[{\"dropdown\":\"CDP API\",\"icon\":\"https://mintlify-assets.b-cdn.net/developerSDKNavigation-0.svg\",\"groups\":[{\"group\":\"CDP API\",\"pages\":[{\"title\":\"Welcome to CDP API\",\"sidebarTitle\":\"Overview\",\"description\":\"Trusted crypto infrastructure at scale\",\"href\":\"/api-reference/v2/introduction\"},{\"title\":\"API Authentication\",\"sidebarTitle\":\"Authentication\",\"description\":null,\"href\":\"/api-reference/v2/authentication\"},{\"title\":\"API Conventions\",\"sidebarTitle\":\"Conventions\",\"description\":\"Formatting standards and shared patterns used across the CDP API.\",\"href\":\"/api-reference/v2/conventions\"},{\"title\":\"Pagination\",\"description\":\"Cursor-based pagination for CDP API list endpoints.\",\"href\":\"/api-reference/v2/pagination\"},{\"title\":\"Idempotency\",\"description\":null,\"href\":\"/api-reference/v2/idempotency\"},{\"title\":\"Rate Limits\",\"description\":null,\"href\":\"/api-reference/v2/rate-limits\"},{\"title\":\"Errors\",\"description\":null,\"href\":\"/api-reference/v2/errors\"},{\"title\":\"OpenAPI Spec\",\"sidebarTitle\":\"OpenAPI Spec\",\"url\":\"https://docs.cdp.coinbase.com/api-reference/v2/cdp-api-v2.yaml\",\"description\":null,\"href\":\"/api-reference/v2/openapi-spec\"},{\"title\":\"Troubleshooting\",\"sidebarTitle\":\"Troubleshooting\",\"description\":\"Common issues integrating with the CDP API and how to resolve them.\",\"href\":\"/api-reference/v2/troubleshooting\"}]},{\"group\":\"REST API\",\"pages\":[{\"group\":\"Wallets\",\"pages\":[{\"group\":\"Custodial\",\"pages\":[{\"group\":\"Accounts\",\"tag\":\"Beta\",\"pages\":[{\"title\":\"Accounts\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/api-reference/v2/rest-api/accounts/accounts\"},{\"openapi\":\"get /v2/accounts/{accountId}\",\"title\":\"Get account\",\"description\":\"Get an account by its ID.\",\"href\":\"/api-reference/v2/rest-api/accounts/get-account\"},{\"openapi\":\"get /v2/accounts/{accountId}/balances/{asset}\",\"title\":\"Get balance for account\",\"description\":\"Get the balance for an account by asset.\",\"href\":\"/api-reference/v2/rest-api/accounts/get-balance-for-account\"},{\"openapi\":\"get /v2/accounts\",\"title\":\"List accounts\",\"description\":\"List all accounts. The API will return all accounts that the API Key has Permissions to access. You can filter the results by using query parameters, which will be treated as a single conjunction (i.e. AND). Results are sorted by creation date in descending order (newest first).\",\"href\":\"/api-reference/v2/rest-api/accounts/list-accounts\"},{\"openapi\":\"get /v2/accounts/{accountId}/balances\",\"title\":\"List balances for account\",\"description\":\"List the balances for an account. Results are sorted by native-fiat equivalent balance in descending order.\",\"href\":\"/api-reference/v2/rest-api/accounts/list-balances-for-account\"},{\"openapi\":\"post /v2/accounts\",\"title\":\"Create account\",\"description\":\"Create an account. Two ownership modes are supported:\\n\\n- **Entity-owned**: when `owner` is omitted, the account is owned by the\\n  Entity making the request. Returns an account with `owner: entity_\u003cuuid\u003e`.\\n  Omit `compliance`; it has no effect for Entity-owned accounts.\\n\\n- **Customer-owned**: pass a Customer ID as `owner`\\n  (e.g. `customer_af2937b0-9846-4fe7-bfe9-ccc22d935114`). The Customer\\n  must have the `custodyCrypto`, `custodyFiat`, and `custodyStablecoin`\\n  capabilities enabled, otherwise the request is rejected with\\n  `customer_not_authorized` (HTTP 403). `compliance.requesterIpAddress`\\n  is required; use the IP address of the end-customer who initiated the\\n  request (not the partner server's IP).\",\"href\":\"/api-reference/v2/rest-api/accounts/create-account\"}]}]},{\"group\":\"Non-custodial\",\"pages\":[{\"group\":\"User Wallets\",\"pages\":[{\"group\":\"End User Account Management\",\"pages\":[{\"title\":\"End User Account Management\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/api-reference/v2/rest-api/end-user-account-management/end-user-account-management\"},{\"openapi\":\"get /v2/end-users/{userId}\",\"title\":\"Get end user\",\"description\":\"Gets an end user by ID.\\n\\nThis API is intended to be used by the developer's own backend, and is authenticated using the developer's CDP API key.\",\"href\":\"/api-reference/v2/rest-api/end-user-account-management/get-end-user\"},{\"openapi\":\"get /v2/end-users\",\"title\":\"List end users\",\"description\":\"Lists the end users belonging to the developer's CDP Project.\\nBy default, the response is sorted by creation date in ascending order and paginated to 20 users per page.\",\"href\":\"/api-reference/v2/rest-api/end-user-account-management/list-end-users\"},{\"openapi\":\"get /v2/end-users/lookup\",\"title\":\"Look up end users by identity\",\"description\":\"Looks up end users. Exactly one lookup type must be provided per request:\\n\\n- **email**: searches across all email-based authentication methods\\n  (email, Google, Apple, GitHub). May return multiple end users if the\\n  same email address appears across different auth methods.\\n\\n- **oauthProvider + oauthSubject**: looks up a user by their OAuth\\n  provider and subject (the `sub` claim from the provider's ID token).\\n  Both params must be provided together.\\n\\n- **phoneNumber**: looks up a user by their SMS-verified phone number.\\n- **siweAddress**: looks up a user by the Ethereum address they authenticated\\n  with via Sign In With Ethereum (EIP-4361).\\n\\n\\nReturns all matching end users. If no end users match, an empty array is returned.\\n\\nThis API is intended to be used by the developer's own backend, and is authenticated using the developer's CDP API key.\",\"href\":\"/api-reference/v2/rest-api/end-user-account-management/look-up-end-users-by-identity\"},{\"openapi\":\"post /v2/end-users/{userId}/evm\",\"title\":\"Add EVM account to end user\",\"description\":\"Adds a new EVM EOA account to an existing end user. End users can have up to 10 EVM accounts.\\nThis API is intended to be used by the developer's own backend, and is authenticated using the developer's CDP API key.\",\"href\":\"/api-reference/v2/rest-api/end-user-account-management/add-evm-account-to-end-user\"},{\"openapi\":\"post /v2/end-users/{userId}/evm-smart-account\",\"title\":\"Add EVM smart account to end user\",\"description\":\"Creates an EVM smart account for an existing end user. The backend will create a new EVM EOA account to serve as the owner of the smart account.\\nThis API is intended to be used by the developer's own backend, and is authenticated using the developer's CDP API key.\",\"href\":\"/api-reference/v2/rest-api/end-user-account-management/add-evm-smart-account-to-end-user\"},{\"openapi\":\"post /v2/end-users/{userId}/solana\",\"title\":\"Add Solana account to end user\",\"description\":\"Adds a new Solana account to an existing end user. End users can have up to 10 Solana accounts.\\nThis API is intended to be used by the developer's own backend, and is authenticated using the developer's CDP API key.\",\"href\":\"/api-reference/v2/rest-api/end-user-account-management/add-solana-account-to-end-user\"},{\"openapi\":\"post /v2/end-users\",\"title\":\"Create end user\",\"description\":\"Creates an end user. An end user is an entity that can own CDP EVM accounts, EVM smart accounts, and/or Solana accounts. 1 or more authentication methods must be associated with an end user. By default, no accounts are created unless the optional `evmAccount` and/or `solanaAccount` fields are provided.\\nThis API is intended to be used by the developer's own backend, and is authenticated using the developer's CDP API key.\",\"href\":\"/api-reference/v2/rest-api/end-user-account-management/create-end-user\"},{\"openapi\":\"post /v2/end-users/import\",\"title\":\"Import end user private key\",\"description\":\"Imports an existing private key for an end user into the developer's CDP Project. The private key must be encrypted using the CDP SDK's encryption scheme before being sent to this endpoint. This API should be called from the [CDP SDK](https://github.com/coinbase/cdp-sdk) to ensure that the associated private key is properly encrypted.\\n\\nThis endpoint allows developers to import existing keys for their end users, supporting both EVM and Solana key types. The end user must have at least one authentication method configured.\",\"href\":\"/api-reference/v2/rest-api/end-user-account-management/import-end-user-private-key\"},{\"openapi\":\"post /v2/end-users/auth/validate-token\",\"title\":\"Validate end user access token\",\"description\":\"Validates the end user's access token and returns the end user's information. Returns an error if the access token is invalid or expired.\\n\\nThis API is intended to be used by the developer's own backend, and is authenticated using the developer's CDP API key.\",\"href\":\"/api-reference/v2/rest-api/end-user-account-management/validate-end-user-access-token\"}]},{\"group\":\"End User Accounts\",\"pages\":[{\"title\":\"End User Accounts\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/api-reference/v2/rest-api/end-user-accounts/end-user-accounts\"},{\"openapi\":\"get /v2/embedded-wallet-api/evm/borrow-products/{borrowProductId}\",\"title\":\"Get a borrow product\",\"description\":\"Gets a single borrow product by its ID.\\nThe ID is a stable identifier that uniquely identifies a single borrow product based on the product's onchain parameters. A borrow product is a protocol-native representation of a borrowable market, describing the venue that hosts it and the assets that participate in it together with their collateral and debt capabilities.\",\"href\":\"/api-reference/v2/rest-api/end-user-accounts/get-a-borrow-product\"},{\"openapi\":\"get /v2/embedded-wallet-api/end-users/{userId}/evm/smart-accounts/{address}/user-operations/{userOpHash}\",\"title\":\"Get a user operation for end user EVM Smart Account\",\"description\":\"Gets a user operation by its hash for an end user's EVM Smart Account.\",\"href\":\"/api-reference/v2/rest-api/end-user-accounts/get-a-user-operation-for-end-user-evm-smart-account\"},{\"openapi\":\"get /v2/embedded-wallet-api/end-users/{userId}/address/{address}/delegation\",\"title\":\"Get account-scoped delegation for end user\",\"description\":\"Returns the active account-scoped delegation for the specified end user account, if one exists. Useful for showing delegation status in a UI.\\nWhen the address corresponds to an EVM Smart Account, this returns the delegation for the Smart Account's owner EOA.\",\"href\":\"/api-reference/v2/rest-api/end-user-accounts/get-account-scoped-delegation-for-end-user\"},{\"openapi\":\"get /v2/embedded-wallet-api/end-users/{userId}/delegation\",\"title\":\"Get delegation for end user\",\"description\":\"Returns the active delegation for the specified end user, if one exists. This operation can be performed by the end user themselves or by a developer using their API key.\",\"href\":\"/api-reference/v2/rest-api/end-user-accounts/get-delegation-for-end-user\"},{\"openapi\":\"get /v2/embedded-wallet-api/end-users/{userId}/evm/smart-accounts/{address}/borrow-positions\",\"title\":\"List borrow positions for an end user smart account\",\"description\":\"Lists the borrow positions held by an end user smart account, with the live onchain state of each position read at a point-in-time snapshot.\\nA borrow position represents collateral posted and a loan borrowed against it in a borrow product, such as a Morpho Blue market that lends USDC against cbBTC. Each position reports its current collateral and debt balances, its health factor, and its health status. Returns an empty list if the smart account has no borrow positions.\",\"href\":\"/api-reference/v2/rest-api/end-user-accounts/list-borrow-positions-for-an-end-user-smart-account\"},{\"openapi\":\"get /v2/embedded-wallet-api/evm/borrow-products\",\"title\":\"List borrow products\",\"description\":\"Lists the borrow products available across all supported networks and protocols. If a network and/or protocol query parameter is supplied, then borrow products are filtered and returned accordingly.\\nA borrow product is a protocol-native representation of a borrowable market, describing the venue that hosts it, the assets that can be borrowed or posted as collateral, and their collateral and debt capabilities. For example, a Morpho Blue market that lends USDC against cbBTC.\",\"href\":\"/api-reference/v2/rest-api/end-user-accounts/list-borrow-products\"},{\"openapi\":\"post /v2/embedded-wallet-api/end-users/{userId}/evm/smart-accounts/{address}/borrow-positions/adjust\",\"title\":\"Adjust a borrow position for an end user smart account\",\"description\":\"$46\",\"href\":\"/api-reference/v2/rest-api/end-user-accounts/adjust-a-borrow-position-for-an-end-user-smart-account\"},{\"openapi\":\"post /v2/embedded-wallet-api/end-users/{userId}/evm/smart-accounts/{address}/borrow-positions/close\",\"title\":\"Close a borrow position for an end user smart account\",\"description\":\"Closes an end user smart account's borrow position by fully repaying its outstanding loan and withdrawing all remaining collateral back to the smart account, in a single user operation.\\nA borrow position is identified by the smart account `address` and the `borrowProductId` in the request body, since a smart account holds at most one position per borrow product. Closing repays the entire accrued debt and withdraws the full collateral balance; there is no partial close. To adjust a position without closing it, use `adjustBorrowPositionWithEndUserAccount` instead.\\nA user operation is broadcast to close the position onchain. Poll `getUserOperationWithEndUserAccount` with the returned `userOpHash` until it reaches a terminal state. Once the user operation succeeds onchain, the position is closed and no longer appears in the borrow positions list.\",\"href\":\"/api-reference/v2/rest-api/end-user-accounts/close-a-borrow-position-for-an-end-user-smart-account\"},{\"openapi\":\"post /v2/embedded-wallet-api/end-users/{userId}/evm/smart-accounts/{address}/borrow-positions\",\"title\":\"Create a borrow position for an end user smart account\",\"description\":\"Creates a borrow position for a specific borrow product, by posting collateral from an end user smart account and borrowing a loan against it. One position can be opened per borrow product for a given smart account.\\nA borrow product is a protocol-native representation of a borrowable market, such as a Morpho Blue market that lends USDC against cbBTC. The `borrowProductId` identifies the product to borrow against, and the `collateralAmount` and `loanAmount` specify the collateral to post and the loan to take, both expressed as decimal strings in standard unit denomination of their respective tokens.\\nA user operation is broadcast to open the position onchain. Poll `getUserOperationWithEndUserAccount` with the returned `userOpHash` until it reaches a terminal state. Once the user operation succeeds onchain, use the borrow positions list endpoint to view the user's active positions.\",\"href\":\"/api-reference/v2/rest-api/end-user-accounts/create-a-borrow-position-for-an-end-user-smart-account\"},{\"openapi\":\"post /v2/embedded-wallet-api/end-users/{userId}/address/{address}/delegation\",\"title\":\"Create account-scoped delegation for end user\",\"description\":\"Creates an account-scoped delegation that allows a developer to sign on behalf of an end user for a single blockchain account (identified by its address) for the specified duration. The end user must be authenticated to authorize this delegation.\\nMultiple account-scoped delegations may exist concurrently for a single end user (one per canonical account address). Account-scoped and user-scoped delegations cannot coexist for the same user.\\nWhen the address corresponds to an EVM Smart Account, the delegation is scoped to the Smart Account's owner EOA rather than the Smart Account address itself. This means `/address/{smartAccountAddress}/delegation` and `/address/{ownerEoaAddress}/delegation` resolve to the same delegation, and the 409 `account_scoped_delegation_active` error may be returned when creating via either address if one already exists for the canonical owner.\",\"href\":\"/api-reference/v2/rest-api/end-user-accounts/create-account-scoped-delegation-for-end-user\"},{\"openapi\":\"post /v2/embedded-wallet-api/end-users/{userId}/evm/eip7702/delegation\",\"title\":\"Create EIP-7702 delegation for end user EVM account\",\"description\":\"Creates an EIP-7702 delegation for an end user's EVM EOA account, upgrading it with smart account capabilities.\\n\\nThis endpoint:\\n- Retrieves delegation artifacts from onchain\\n- Signs the EIP-7702 authorization for delegation\\n- Assembles and submits a Type 4 transaction\\n- Creates an associated smart account object\\n\\nThe delegation allows the EVM EOA to be used as a smart account, which enables batched transactions and gas sponsorship via paymaster.\",\"href\":\"/api-reference/v2/rest-api/end-user-accounts/create-eip-7702-delegation-for-end-user-evm-account\"},{\"openapi\":\"post /v2/embedded-wallet-api/end-users/{userId}/address/{address}/delegation/revoke\",\"title\":\"Revoke account-scoped delegation for end user\",\"description\":\"Revokes the active account-scoped delegation for the specified end user account. Other account-scoped delegations for the same user are unaffected. This operation can be performed by the end user themselves or by a developer using their API key.\\nWhen the address corresponds to an EVM Smart Account, this revokes the delegation for the Smart Account's owner EOA.\",\"href\":\"/api-reference/v2/rest-api/end-user-accounts/revoke-account-scoped-delegation-for-end-user\"},{\"openapi\":\"post /v2/embedded-wallet-api/end-users/{userId}/delegation/revoke\",\"title\":\"Revoke delegation for end user\",\"description\":\"Revokes all active delegations for the specified end user. This operation can be performed by the end user themselves or by a developer using their API key.\",\"href\":\"/api-reference/v2/rest-api/end-user-accounts/revoke-delegation-for-end-user\"},{\"openapi\":\"post /v2/embedded-wallet-api/end-users/{userId}/evm/send/transaction\",\"title\":\"Send transaction via end user EVM account\",\"description\":\"$47\",\"href\":\"/api-reference/v2/rest-api/end-user-accounts/send-transaction-via-end-user-evm-account\"},{\"openapi\":\"post /v2/embedded-wallet-api/end-users/{userId}/solana/send/transaction\",\"title\":\"Send transaction via end user Solana account\",\"description\":\"$48\",\"href\":\"/api-reference/v2/rest-api/end-user-accounts/send-transaction-via-end-user-solana-account\"},{\"openapi\":\"post /v2/embedded-wallet-api/end-users/{userId}/evm/{address}/send/{asset}\",\"title\":\"Send USDC on EVM\",\"description\":\"Sends USDC from an end user's EVM account (EOA or Smart Account) to a recipient address on a supported EVM network. This endpoint simplifies USDC transfers by automatically handling contract resolution, decimal conversion, gas estimation, and transaction encoding.\\nThe `amount` field accepts human-readable amounts as decimal strings (e.g., \\\"1.5\\\", \\\"25.50\\\").\",\"href\":\"/api-reference/v2/rest-api/end-user-accounts/send-usdc-on-evm\"},{\"openapi\":\"post /v2/embedded-wallet-api/end-users/{userId}/solana/{address}/send/{asset}\",\"title\":\"Send USDC on Solana\",\"description\":\"Sends USDC from an end user's Solana account to a recipient address on the Solana network. This endpoint simplifies USDC transfers by automatically handling mint resolution, Associated Token Account (ATA) creation, decimal conversion, and transaction encoding.\\nThe `amount` field accepts human-readable amounts as decimal strings (e.g., \\\"1.5\\\", \\\"25.50\\\").\\nUse the optional `createRecipientAta` parameter to control whether the sender pays for creating the recipient's Associated Token Account if it doesn't exist.\",\"href\":\"/api-reference/v2/rest-api/end-user-accounts/send-usdc-on-solana\"},{\"openapi\":\"post /v2/embedded-wallet-api/end-users/{userId}/evm/smart-accounts/{address}/send\",\"title\":\"Send user operation for end user Smart Account\",\"description\":\"Prepares, signs, and sends a user operation for an end user's Smart Account.\",\"href\":\"/api-reference/v2/rest-api/end-user-accounts/send-user-operation-for-end-user-smart-account\"},{\"openapi\":\"post /v2/embedded-wallet-api/end-users/{userId}/solana/sign/message\",\"title\":\"Sign Base64-encoded message\",\"description\":\"Signs an arbitrary Base64 encoded message with the given Solana account.\\n**WARNING:**  Never sign a message that you didn't generate as it may put your funds at risk.\",\"href\":\"/api-reference/v2/rest-api/end-user-accounts/sign-base64-encoded-message\"},{\"openapi\":\"post /v2/embedded-wallet-api/end-users/{userId}/evm/sign/message\",\"title\":\"Sign EIP-191 message via end user EVM account\",\"description\":\"Signs an [EIP-191](https://eips.ethereum.org/EIPS/eip-191) message with the given end user EVM account.\\n\\nPer the specification, the message in the request body is prepended with `0x19 \u003c0x45 (E)\u003e \u003cthereum Signed Message:\\\\n\\\" + len(message)\u003e` before being signed.\",\"href\":\"/api-reference/v2/rest-api/end-user-accounts/sign-eip-191-message-via-end-user-evm-account\"},{\"openapi\":\"post /v2/embedded-wallet-api/end-users/{userId}/evm/sign/typed-data\",\"title\":\"Sign EIP-712 typed data via end user EVM account\",\"description\":\"Signs [EIP-712](https://eips.ethereum.org/EIPS/eip-712) typed data with the given end user EVM account.\",\"href\":\"/api-reference/v2/rest-api/end-user-accounts/sign-eip-712-typed-data-via-end-user-evm-account\"},{\"openapi\":\"post /v2/embedded-wallet-api/end-users/{userId}/evm/sign/transaction\",\"title\":\"Sign transaction via end user EVM account\",\"description\":\"Signs a transaction with the given end user EVM account.\\nThe transaction should be serialized as a hex string using [RLP](https://ethereum.org/en/developers/docs/data-structures-and-encoding/rlp/).\\n\\nThe transaction must be an [EIP-1559 dynamic fee transaction](https://github.com/ethereum/EIPs/blob/master/EIPS/eip-1559.md). The developer is responsible for ensuring that the unsigned transaction is valid, as the API will not validate the transaction.\",\"href\":\"/api-reference/v2/rest-api/end-user-accounts/sign-transaction-via-end-user-evm-account\"},{\"openapi\":\"post /v2/embedded-wallet-api/end-users/{userId}/solana/sign/transaction\",\"title\":\"Sign transaction via end user Solana account\",\"description\":\"Signs a transaction with the given end user Solana account.\\nThe unsigned transaction should be serialized into a byte array and then encoded as base64.\\n**Transaction types**\\nThe following transaction types are supported:\\n* [Legacy transactions](https://solana-labs.github.io/solana-web3.js/classes/Transaction.html)\\n* [Versioned transactions](https://solana-labs.github.io/solana-web3.js/classes/VersionedTransaction.html)\\nThe developer is responsible for ensuring that the unsigned transaction is valid, as the API will not validate the transaction.\",\"href\":\"/api-reference/v2/rest-api/end-user-accounts/sign-transaction-via-end-user-solana-account\"},{\"openapi\":\"post /v2/embedded-wallet-api/end-users/{userId}/solana/sign/x402-payment\",\"title\":\"Sign x402 payment via end user Solana account\",\"description\":\"Signs an x402 payment payload using the end user's given Solana account.\\nAccepts the full x402 payment required response body from a resource server plus an index into the accepts array selecting which payment option to sign. The paymentRequired envelope's x402Version, resource, and extensions are carried through into the signed payment payload; only the selected accept entry becomes paymentPayload.accepted.\\nReturns a signed payment payload that can be base64-encoded and sent in the PAYMENT-SIGNATURE header of the resource request.\\nIf acceptsIndex is out of range for paymentRequired.accepts, or the selected accept is not a Solana network payment option, the request fails with 422.\",\"href\":\"/api-reference/v2/rest-api/end-user-accounts/sign-x402-payment-via-end-user-solana-account\"},{\"openapi\":\"delete /v2/embedded-wallet-api/end-users/{userId}/address/{address}/delegation\",\"deprecated\":true,\"title\":\"Revoke account-scoped delegation for end user (deprecated)\",\"description\":\"\u003e **Deprecation Notice:** Prefer\\n\u003e [Revoke account-scoped delegation for end user](#operation/revokeDelegationForEndUserAccount)\\n\u003e (`POST /v2/embedded-wallet-api/end-users/{userId}/address/{address}/delegation/revoke`),\\n\u003e which takes the same request body. This `DELETE` path will be removed on **2026-10-22**.\\n\\nRevokes the active account-scoped delegation for the specified end user account.\\nOther account-scoped delegations for the same user are unaffected. This operation\\ncan be performed by the end user themselves or by a developer using their API key.\\n\\nWhen the address corresponds to an EVM Smart Account, this revokes the delegation for the\\nSmart Account's owner EOA.\",\"href\":\"/api-reference/v2/rest-api/end-user-accounts/revoke-account-scoped-delegation-for-end-user-deprecated\"},{\"openapi\":\"delete /v2/embedded-wallet-api/end-users/{userId}/delegation\",\"deprecated\":true,\"title\":\"Revoke delegation for end user (deprecated)\",\"description\":\"\u003e **Deprecation Notice:** Prefer\\n\u003e [Revoke delegation for end user](#operation/revokeDelegationForEndUser)\\n\u003e (`POST /v2/embedded-wallet-api/end-users/{userId}/delegation/revoke`), which takes the\\n\u003e same request body. This `DELETE` path will be removed on **2026-10-22**.\\n\\nRevokes all active delegations for the specified end user. This operation\\ncan be performed by the end user themselves or by a developer using their\\nAPI key.\",\"href\":\"/api-reference/v2/rest-api/end-user-accounts/revoke-delegation-for-end-user-deprecated\"}]}]},{\"group\":\"API Key Wallets\",\"pages\":[{\"group\":\"EVM Accounts\",\"pages\":[{\"title\":\"EVM Accounts\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/api-reference/v2/rest-api/evm-accounts/evm-accounts\"},{\"openapi\":\"get /v2/evm/eip7702/delegation-operations/{delegationOperationId}\",\"title\":\"Get EIP-7702 delegation operation by ID\",\"description\":\"Returns the EIP-7702 delegation operation. Use the delegationOperationId returned by the Create EIP-7702 delegation endpoint to poll for operation completion.\",\"href\":\"/api-reference/v2/rest-api/evm-accounts/get-eip-7702-delegation-operation-by-id\"},{\"openapi\":\"get /v2/evm/accounts/{address}\",\"title\":\"Get EVM account by address\",\"description\":\"Gets an EVM account by its address.\",\"href\":\"/api-reference/v2/rest-api/evm-accounts/get-evm-account-by-address\"},{\"openapi\":\"get /v2/evm/accounts/by-name/{name}\",\"title\":\"Get EVM account by name\",\"description\":\"Gets an EVM account by its name.\",\"href\":\"/api-reference/v2/rest-api/evm-accounts/get-evm-account-by-name\"},{\"openapi\":\"get /v2/evm/accounts\",\"title\":\"List EVM accounts\",\"description\":\"Lists the EVM accounts belonging to the developer's CDP Project.\\nThe response is paginated, and by default, returns 20 accounts per page.\",\"href\":\"/api-reference/v2/rest-api/evm-accounts/list-evm-accounts\"},{\"openapi\":\"post /v2/evm/accounts/{address}/eip7702/delegation\",\"title\":\"Create EIP-7702 delegation\",\"description\":\"Creates an EIP-7702 delegation for an EVM EOA account, upgrading it with smart account capabilities.\\n\\nThis endpoint:\\n- Retrieves delegation artifacts from onchain\\n- Signs the EIP-7702 authorization for delegation\\n- Assembles and submits a Type 4 transaction\\n- Creates an associated smart account object\\n\\nThe delegation allows the EVM EOA to be used as a smart account, which enables batched transactions and gas sponsorship via paymaster.\",\"href\":\"/api-reference/v2/rest-api/evm-accounts/create-eip-7702-delegation\"},{\"openapi\":\"post /v2/evm/accounts\",\"title\":\"Create EVM account\",\"description\":\"Creates a new EVM account.\",\"href\":\"/api-reference/v2/rest-api/evm-accounts/create-evm-account\"},{\"openapi\":\"post /v2/evm/accounts/{address}/export\",\"title\":\"Export EVM account\",\"description\":\"Export an existing EVM account's private key. It is important to store the private key in a secure place after it's exported.\",\"href\":\"/api-reference/v2/rest-api/evm-accounts/export-evm-account\"},{\"openapi\":\"post /v2/evm/accounts/export/by-name/{name}\",\"title\":\"Export EVM account by name\",\"description\":\"Export an existing EVM account's private key by its name. It is important to store the private key in a secure place after it's exported.\",\"href\":\"/api-reference/v2/rest-api/evm-accounts/export-evm-account-by-name\"},{\"openapi\":\"post /v2/evm/accounts/import\",\"title\":\"Import EVM account\",\"description\":\"Import an existing EVM account into the developer's CDP Project. This API should be called from the [CDP SDK](https://github.com/coinbase/cdp-sdk) to ensure that the associated private key is properly encrypted.\",\"href\":\"/api-reference/v2/rest-api/evm-accounts/import-evm-account\"},{\"openapi\":\"post /v2/evm/accounts/{address}/send/transaction\",\"title\":\"Send transaction\",\"description\":\"$49\",\"href\":\"/api-reference/v2/rest-api/evm-accounts/send-transaction\"},{\"openapi\":\"post /v2/evm/accounts/{address}/sign/message\",\"title\":\"Sign EIP-191 message\",\"description\":\"Signs an [EIP-191](https://eips.ethereum.org/EIPS/eip-191) message with the given EVM account.\\n\\nPer the specification, the message in the request body is prepended with `0x19 \u003c0x45 (E)\u003e \u003cthereum Signed Message:\\\\n\\\" + len(message)\u003e` before being signed.\",\"href\":\"/api-reference/v2/rest-api/evm-accounts/sign-eip-191-message\"},{\"openapi\":\"post /v2/evm/accounts/{address}/sign/typed-data\",\"title\":\"Sign EIP-712 typed data\",\"description\":\"Signs [EIP-712](https://eips.ethereum.org/EIPS/eip-712) typed data with the given EVM account.\",\"href\":\"/api-reference/v2/rest-api/evm-accounts/sign-eip-712-typed-data\"},{\"openapi\":\"post /v2/evm/accounts/{address}/sign\",\"title\":\"Sign hash\",\"description\":\"Signs an arbitrary 32 byte hash with the given EVM account.\",\"href\":\"/api-reference/v2/rest-api/evm-accounts/sign-hash\"},{\"openapi\":\"post /v2/evm/accounts/{address}/sign/transaction\",\"title\":\"Sign transaction\",\"description\":\"Signs a transaction with the given EVM account.\\nThe transaction should be serialized as a hex string using [RLP](https://ethereum.org/en/developers/docs/data-structures-and-encoding/rlp/).\\n\\nThe transaction must be an [EIP-1559 dynamic fee transaction](https://github.com/ethereum/EIPs/blob/master/EIPS/eip-1559.md). The developer is responsible for ensuring that the unsigned transaction is valid, as the API will not validate the transaction.\",\"href\":\"/api-reference/v2/rest-api/evm-accounts/sign-transaction\"},{\"openapi\":\"put /v2/evm/accounts/{address}\",\"title\":\"Update EVM account\",\"description\":\"Updates an existing EVM account. Use this to update the account's name or account-level policy.\",\"href\":\"/api-reference/v2/rest-api/evm-accounts/update-evm-account\"}]},{\"group\":\"EVM Smart Accounts\",\"pages\":[{\"title\":\"EVM Smart Accounts\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/api-reference/v2/rest-api/evm-smart-accounts/evm-smart-accounts\"},{\"openapi\":\"get /v2/evm/smart-accounts/{address}\",\"title\":\"Get Smart Account by address\",\"description\":\"Gets a Smart Account by its address.\",\"href\":\"/api-reference/v2/rest-api/evm-smart-accounts/get-smart-account-by-address\"},{\"openapi\":\"get /v2/evm/smart-accounts/by-name/{name}\",\"title\":\"Get Smart Account by name\",\"description\":\"Gets a Smart Account by its name.\",\"href\":\"/api-reference/v2/rest-api/evm-smart-accounts/get-smart-account-by-name\"},{\"openapi\":\"get /v2/evm/smart-accounts/{address}/user-operations/{userOpHash}\",\"title\":\"Get user operation\",\"description\":\"Gets a user operation by its hash.\",\"href\":\"/api-reference/v2/rest-api/evm-smart-accounts/get-user-operation\"},{\"openapi\":\"get /v2/evm/smart-accounts\",\"title\":\"List Smart Accounts\",\"description\":\"Lists the Smart Accounts belonging to the developer's CDP Project.\\nThe response is paginated, and by default, returns 20 accounts per page.\",\"href\":\"/api-reference/v2/rest-api/evm-smart-accounts/list-smart-accounts\"},{\"openapi\":\"get /v2/evm/smart-accounts/{address}/spend-permissions/list\",\"title\":\"List spend permissions\",\"description\":\"Lists spend permission for the given smart account address.\",\"href\":\"/api-reference/v2/rest-api/evm-smart-accounts/list-spend-permissions\"},{\"openapi\":\"post /v2/evm/smart-accounts\",\"title\":\"Create Smart Account\",\"description\":\"Creates a new Smart Account.\",\"href\":\"/api-reference/v2/rest-api/evm-smart-accounts/create-smart-account\"},{\"openapi\":\"post /v2/evm/smart-accounts/{address}/spend-permissions\",\"title\":\"Create spend permission\",\"description\":\"Creates a spend permission for the given smart account address.\",\"href\":\"/api-reference/v2/rest-api/evm-smart-accounts/create-spend-permission\"},{\"openapi\":\"post /v2/evm/smart-accounts/{address}/user-operations/prepare-and-send\",\"title\":\"Prepare and send user operation\",\"description\":\"Prepares, signs, and sends a user operation for an EVM Smart Account. This API can be used only if the owner on Smart Account is a CDP EVM Account.\",\"href\":\"/api-reference/v2/rest-api/evm-smart-accounts/prepare-and-send-user-operation\"},{\"openapi\":\"post /v2/evm/smart-accounts/{address}/user-operations\",\"title\":\"Prepare user operation\",\"description\":\"Prepares a new user operation on a Smart Account for a specific network.\",\"href\":\"/api-reference/v2/rest-api/evm-smart-accounts/prepare-user-operation\"},{\"openapi\":\"post /v2/evm/smart-accounts/{address}/spend-permissions/revoke\",\"title\":\"Revoke spend permission\",\"description\":\"Revokes an existing spend permission.\",\"href\":\"/api-reference/v2/rest-api/evm-smart-accounts/revoke-spend-permission\"},{\"openapi\":\"post /v2/evm/smart-accounts/{address}/user-operations/{userOpHash}/send\",\"title\":\"Send user operation\",\"description\":\"Sends a user operation with a signature.\\nThe payload to sign must be the `userOpHash` field of the user operation. This hash should be signed directly (not using `personal_sign` or EIP-191 message hashing).\\nThe signature must be 65 bytes in length, consisting of: - 32 bytes for the `r` value - 32 bytes for the `s` value - 1 byte for the `v` value (must be 27 or 28)\\nIf using the CDP Paymaster, the user operation must be signed and sent within 2 minutes of being prepared.\",\"href\":\"/api-reference/v2/rest-api/evm-smart-accounts/send-user-operation\"},{\"openapi\":\"put /v2/evm/smart-accounts/{address}\",\"title\":\"Update EVM Smart Account\",\"description\":\"Updates an existing EVM smart account. Use this to update the smart account's name.\",\"href\":\"/api-reference/v2/rest-api/evm-smart-accounts/update-evm-smart-account\"}]},{\"group\":\"Solana Accounts\",\"pages\":[{\"title\":\"Solana Accounts\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/api-reference/v2/rest-api/solana-accounts/solana-accounts\"},{\"openapi\":\"get /v2/solana/accounts/{address}\",\"title\":\"Get Solana account by address\",\"description\":\"Gets a Solana account by its address.\",\"href\":\"/api-reference/v2/rest-api/solana-accounts/get-solana-account-by-address\"},{\"openapi\":\"get /v2/solana/accounts/by-name/{name}\",\"title\":\"Get Solana account by name\",\"description\":\"Gets a Solana account by its name.\",\"href\":\"/api-reference/v2/rest-api/solana-accounts/get-solana-account-by-name\"},{\"openapi\":\"get /v2/solana/accounts\",\"title\":\"List Solana accounts\",\"description\":\"Lists the Solana accounts belonging to the developer.\\nThe response is paginated, and by default, returns 20 accounts per page.\\n\\nIf a name is provided, the response will contain only the account with that name.\",\"href\":\"/api-reference/v2/rest-api/solana-accounts/list-solana-accounts\"},{\"openapi\":\"post /v2/solana/accounts\",\"title\":\"Create Solana account\",\"description\":\"Creates a new Solana account.\",\"href\":\"/api-reference/v2/rest-api/solana-accounts/create-solana-account\"},{\"openapi\":\"post /v2/solana/accounts/{address}/export\",\"title\":\"Export Solana account\",\"description\":\"Export an existing Solana account's private key. It is important to store the private key in a secure place after it's exported.\",\"href\":\"/api-reference/v2/rest-api/solana-accounts/export-solana-account\"},{\"openapi\":\"post /v2/solana/accounts/export/by-name/{name}\",\"title\":\"Export Solana account by name\",\"description\":\"Export an existing Solana account's private key by its name. It is important to store the private key in a secure place after it's exported.\",\"href\":\"/api-reference/v2/rest-api/solana-accounts/export-solana-account-by-name\"},{\"openapi\":\"post /v2/solana/accounts/import\",\"title\":\"Import Solana account\",\"description\":\"Import an existing Solana account into the developer's CDP Project. This API should be called from the [CDP SDK](https://github.com/coinbase/cdp-sdk) to ensure that the associated private key is properly encrypted.\",\"href\":\"/api-reference/v2/rest-api/solana-accounts/import-solana-account\"},{\"openapi\":\"post /v2/solana/accounts/send/transaction\",\"title\":\"Send Solana transaction\",\"description\":\"$4a\",\"href\":\"/api-reference/v2/rest-api/solana-accounts/send-solana-transaction\"},{\"openapi\":\"post /v2/solana/accounts/{address}/sign/message\",\"title\":\"Sign message\",\"description\":\"Signs an arbitrary message with the given Solana account.\\n\\n**WARNING:** Never sign a message that you didn't generate, as it can be an arbitrary transaction. For example, it might send all of your funds to an attacker.\",\"href\":\"/api-reference/v2/rest-api/solana-accounts/sign-message\"},{\"openapi\":\"post /v2/solana/accounts/{address}/sign/transaction\",\"title\":\"Sign transaction\",\"description\":\"Signs a transaction with the given Solana account.\\nThe unsigned transaction should be serialized into a byte array and then encoded as base64.\\n\\n**Transaction types**\\n\\nThe following transaction types are supported:\\n* [Legacy transactions](https://solana-labs.github.io/solana-web3.js/classes/Transaction.html)\\n* [Versioned transactions](https://solana-labs.github.io/solana-web3.js/classes/VersionedTransaction.html)\\n\\nThe developer is responsible for ensuring that the unsigned transaction is valid, as the API will not validate the transaction.\",\"href\":\"/api-reference/v2/rest-api/solana-accounts/sign-transaction\"},{\"openapi\":\"put /v2/solana/accounts/{address}\",\"title\":\"Update Solana account\",\"description\":\"Updates an existing Solana account. Use this to update the account's name or account-level policy.\",\"href\":\"/api-reference/v2/rest-api/solana-accounts/update-solana-account\"}]}]},{\"group\":\"Policy Engine\",\"pages\":[{\"title\":\"Policy Engine\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/api-reference/v2/rest-api/policy-engine/policy-engine\"},{\"openapi\":\"get /v2/policy-engine/policies/{policyId}\",\"title\":\"Get policy by ID\",\"description\":\"Get a policy by its ID.\",\"href\":\"/api-reference/v2/rest-api/policy-engine/get-policy-by-id\"},{\"openapi\":\"get /v2/policy-engine/policies\",\"title\":\"List policies\",\"description\":\"Lists the policies belonging to the developer's CDP Project. Use the `scope` parameter to filter the policies by scope.\\nThe response is paginated, and by default, returns 20 policies per page.\",\"href\":\"/api-reference/v2/rest-api/policy-engine/list-policies\"},{\"openapi\":\"post /v2/policy-engine/policies\",\"title\":\"Create policy\",\"description\":\"Create a policy that can be used to govern the behavior of accounts.\",\"href\":\"/api-reference/v2/rest-api/policy-engine/create-policy\"},{\"openapi\":\"put /v2/policy-engine/policies/{policyId}\",\"title\":\"Update policy\",\"description\":\"Updates a policy by its ID. This will have the effect of applying the updated policy to all accounts that are currently using it.\",\"href\":\"/api-reference/v2/rest-api/policy-engine/update-policy\"},{\"openapi\":\"delete /v2/policy-engine/policies/{policyId}\",\"title\":\"Delete policy\",\"description\":\"Delete a policy by its ID. This will have the effect of removing the policy from all accounts that are currently using it.\",\"href\":\"/api-reference/v2/rest-api/policy-engine/delete-policy\"}]},{\"group\":\"Wallet Webhooks\",\"pages\":[{\"title\":\"Wallet Webhooks\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/api-reference/v2/rest-api/wallet-webhooks/wallet-webhooks\"},{\"openapi\":\"webhook walletDelegationCreated\",\"sidebarTitle\":\"Wallet delegation created\",\"title\":\"Wallet delegation created\",\"description\":\"Triggered when the `wallet.delegation.created` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-wallet-delegation-created\"},{\"openapi\":\"webhook walletDelegationRevoked\",\"sidebarTitle\":\"Wallet delegation revoked\",\"title\":\"Wallet delegation revoked\",\"description\":\"Triggered when the `wallet.delegation.revoked` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-wallet-delegation-revoked\"},{\"openapi\":\"webhook walletHashSigned\",\"sidebarTitle\":\"Wallet hash signed\",\"title\":\"Wallet hash signed\",\"description\":\"Triggered when the `wallet.hash.signed` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-wallet-hash-signed\"},{\"openapi\":\"webhook walletMessageSigned\",\"sidebarTitle\":\"Wallet message signed\",\"title\":\"Wallet message signed\",\"description\":\"Triggered when the `wallet.message.signed` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-wallet-message-signed\"},{\"openapi\":\"webhook walletTransactionBroadcast\",\"sidebarTitle\":\"Wallet transaction broadcast\",\"title\":\"Wallet transaction broadcast\",\"description\":\"Triggered when the `wallet.transaction.broadcast` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-wallet-transaction-broadcast\"},{\"openapi\":\"webhook walletTransactionConfirmed\",\"sidebarTitle\":\"Wallet transaction confirmed\",\"title\":\"Wallet transaction confirmed\",\"description\":\"Triggered when the `wallet.transaction.confirmed` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-wallet-transaction-confirmed\"},{\"openapi\":\"webhook walletTransactionCreated\",\"sidebarTitle\":\"Wallet transaction created\",\"title\":\"Wallet transaction created\",\"description\":\"Triggered when the `wallet.transaction.created` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-wallet-transaction-created\"},{\"openapi\":\"webhook walletTransactionFailed\",\"sidebarTitle\":\"Wallet transaction failed\",\"title\":\"Wallet transaction failed\",\"description\":\"Triggered when the `wallet.transaction.failed` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-wallet-transaction-failed\"},{\"openapi\":\"webhook walletTransactionPending\",\"sidebarTitle\":\"Wallet transaction pending\",\"title\":\"Wallet transaction pending\",\"description\":\"Triggered when the `wallet.transaction.pending` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-wallet-transaction-pending\"},{\"openapi\":\"webhook walletTransactionReplaced\",\"sidebarTitle\":\"Wallet transaction replaced\",\"title\":\"Wallet transaction replaced\",\"description\":\"Triggered when the `wallet.transaction.replaced` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-wallet-transaction-replaced\"},{\"openapi\":\"webhook walletTransactionSigned\",\"sidebarTitle\":\"Wallet transaction signed\",\"title\":\"Wallet transaction signed\",\"description\":\"Triggered when the `wallet.transaction.signed` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-wallet-transaction-signed\"},{\"openapi\":\"webhook walletTypedDataSigned\",\"sidebarTitle\":\"Wallet typed data signed\",\"title\":\"Wallet typed data signed\",\"description\":\"Triggered when the `wallet.typed_data.signed` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-wallet-typed-data-signed\"}]}]}]},{\"group\":\"Payments\",\"pages\":[{\"group\":\"Acceptance\",\"pages\":[{\"group\":\"Payment Sessions\",\"pages\":[{\"title\":\"Payment Sessions\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/api-reference/v2/rest-api/payment-sessions/payment-sessions\"},{\"openapi\":\"get /v2/payment-sessions/{paymentSessionId}\",\"title\":\"Get a payment session\",\"description\":\"Retrieves a single payment session by its ID, including its current status, balances, and associated metadata. The API key must have permission to access the requested session.\",\"href\":\"/api-reference/v2/rest-api/payment-sessions/get-a-payment-session\"},{\"openapi\":\"get /v2/payment-sessions/{paymentSessionId}/authorizations/{authorizationId}\",\"title\":\"Get a payment session authorization\",\"description\":\"Retrieves a single authorization by its ID, including its current status, amount, and any associated onchain transactions.\",\"href\":\"/api-reference/v2/rest-api/payment-sessions/get-a-payment-session-authorization\"},{\"openapi\":\"get /v2/payment-sessions/{paymentSessionId}/captures/{captureId}\",\"title\":\"Get a payment session capture\",\"description\":\"Retrieves a single capture by its ID, including status, captured amount, associated onchain transactions, and timestamps. Only returns the capture if the API key has permission to access it.\",\"href\":\"/api-reference/v2/rest-api/payment-sessions/get-a-payment-session-capture\"},{\"openapi\":\"get /v2/payment-sessions/{paymentSessionId}/refunds/{refundId}\",\"title\":\"Get a payment session refund\",\"description\":\"Retrieves a single refund by its ID, including status, refunded amount, reason, associated onchain transactions, and timestamps. Only returns the refund if the API key has permission to access it.\",\"href\":\"/api-reference/v2/rest-api/payment-sessions/get-a-payment-session-refund\"},{\"openapi\":\"get /v2/payment-sessions/{paymentSessionId}/voids/{voidId}\",\"title\":\"Get a payment session void\",\"description\":\"Retrieves a single void by its ID, including status, voided amount, associated onchain transactions, and timestamps. Only returns the void if the API key has permission to access it.\",\"href\":\"/api-reference/v2/rest-api/payment-sessions/get-a-payment-session-void\"},{\"openapi\":\"get /v2/payment-sessions/{paymentSessionId}/authorizations/wallet/options\",\"title\":\"Get wallet authorization options\",\"description\":\"Returns the available wallet authorization options for a payment session. The session must be in `created` status.\\n\\nProvide one or more payer wallet addresses as query parameters. Each option specifies the currency, amount, network, and payloads the payer must sign to authorize the payment. Present the options to the payer and let them choose one, then call **Authorize Wallet** with the selected option.\\n\\nThis is a stateless read operation — the session is not modified.\\n\\nIf a requested address has no eligible authorization options (e.g. insufficient funds), it appears in `ineligibleAddresses` with a `code` and `message` instead of being absent from `options`. When an address is ineligible because of `insufficient_funds`, its `fundsRequired` array lists, per enabled (network, asset) combination, the current balance and required balance the payer needs to become eligible.\",\"href\":\"/api-reference/v2/rest-api/payment-sessions/get-wallet-authorization-options\"},{\"openapi\":\"get /v2/payment-sessions/{paymentSessionId}/authorizations\",\"title\":\"List payment session authorizations\",\"description\":\"Returns a paginated list of authorizations for a payment session. Each authorization represents a hold on funds and includes its current status and amount.\",\"href\":\"/api-reference/v2/rest-api/payment-sessions/list-payment-session-authorizations\"},{\"openapi\":\"get /v2/payment-sessions/{paymentSessionId}/captures\",\"title\":\"List payment session captures\",\"description\":\"Returns a paginated list of captures for a payment session. Each capture includes its status, amount, associated onchain transactions, and timestamps. Only captures accessible by the current API key are returned.\",\"href\":\"/api-reference/v2/rest-api/payment-sessions/list-payment-session-captures\"},{\"openapi\":\"get /v2/payment-sessions/{paymentSessionId}/refunds\",\"title\":\"List payment session refunds\",\"description\":\"Returns a paginated list of refunds for a payment session. Each refund includes its status, amount, reason, associated onchain transactions, and timestamps. Only refunds accessible by the current API key are returned.\",\"href\":\"/api-reference/v2/rest-api/payment-sessions/list-payment-session-refunds\"},{\"openapi\":\"get /v2/payment-sessions/{paymentSessionId}/voids\",\"title\":\"List payment session voids\",\"description\":\"Returns a paginated list of voids for a payment session. Each void includes its status, amount, associated onchain transactions, and timestamps. Only voids accessible by the current API key are returned.\",\"href\":\"/api-reference/v2/rest-api/payment-sessions/list-payment-session-voids\"},{\"openapi\":\"get /v2/payment-sessions\",\"title\":\"List payment sessions\",\"description\":\"Returns a paginated list of payment sessions that the API key has permission to access.\",\"href\":\"/api-reference/v2/rest-api/payment-sessions/list-payment-sessions\"},{\"openapi\":\"post /v2/payment-sessions/{paymentSessionId}/authorizations/coinbase\",\"title\":\"Authorize a payment session with a Coinbase account\",\"description\":\"**Merchant-initiated.** The merchant charges the payer's Coinbase account using an OAuth grant the payer authorized earlier, so the payer does not need to be present at payment time. The session must be in `created` status.\\n\\n**Authentication:** Requires a Coinbase OAuth Bearer token with the `coinbase:stablecoins:payment-create` scope.\\n\\nOn authorization, a hold is placed on the payer's funds. The authorization is returned in `pending` status and transitions asynchronously to `succeeded` or `failed`.\\n\\nIf `autoCapture` is enabled on the session, a capture is automatically created after a successful authorization.\",\"href\":\"/api-reference/v2/rest-api/payment-sessions/authorize-a-payment-session-with-a-coinbase-account\"},{\"openapi\":\"post /v2/payment-sessions/{paymentSessionId}/authorizations/mandate\",\"title\":\"Authorize a payment session with a mandate\",\"description\":\"$4b\",\"href\":\"/api-reference/v2/rest-api/payment-sessions/authorize-a-payment-session-with-a-mandate\"},{\"openapi\":\"post /v2/payment-sessions/{paymentSessionId}/authorizations/wallet\",\"title\":\"Authorize a payment session with a wallet\",\"description\":\"**Customer-initiated.** Authorizes a payment session using the payer's wallet. The payer signs the payloads themselves, so this call is unauthenticated. The session must be in `created` status.\\n\\nThe `optionId` must match one of the options returned by the **Get Wallet Authorization Options** endpoint. Include the signed payloads for the selected option.\\n\\nOn authorization, a hold is placed on the payer's funds. The authorization is returned in `pending` status and transitions asynchronously to `succeeded` or `failed`.\\n\\nIf `autoCapture` is enabled on the session, a capture is automatically created after a successful authorization.\",\"href\":\"/api-reference/v2/rest-api/payment-sessions/authorize-a-payment-session-with-a-wallet\"},{\"openapi\":\"post /v2/payment-sessions/{paymentSessionId}/authorizations/x402\",\"title\":\"Authorize a payment session with x402\",\"description\":\"**Customer-initiated.** Authorizes a payment session using x402. The payer supplies the payment payload, so this call is unauthenticated. The session must be in `created` status.\\n\\nThe client sends no request body. You may supply the base64-encoded x402-compliant payment payload in the optional **`PAYMENT-SIGNATURE`** header.\\n\\nOn authorization, a hold is placed on the payer's funds. The authorization is returned in `pending` status and transitions asynchronously to `succeeded` or `failed`.\\n\\n**402 Payment Required** may be returned when payment must be supplied before authorization can proceed. The **402** response uses the standard CDP **`Error`** JSON body and may include a **`PAYMENT-REQUIRED`** header (see the **402** response) describing accepted networks, assets, and amounts.\\n\\nIf `autoCapture` is enabled on the session, a capture is automatically created after a successful authorization.\",\"href\":\"/api-reference/v2/rest-api/payment-sessions/authorize-a-payment-session-with-x402\"},{\"openapi\":\"post /v2/payment-sessions/{paymentSessionId}/cancel\",\"title\":\"Cancel a payment session\",\"description\":\"Cancels a payment session before any funds have been authorized or captured. The session must be in `created` status. Cancel is blocked while any authorization action is pending.\\n\\nOnce canceled, no further actions can be performed on the session. This is the only way to terminate a pre-authorization session — expiry deadlines block actions but do not automatically transition the session to a terminal state.\",\"href\":\"/api-reference/v2/rest-api/payment-sessions/cancel-a-payment-session\"},{\"openapi\":\"post /v2/payment-sessions/{paymentSessionId}/captures\",\"title\":\"Capture a payment session\",\"description\":\"Captures authorized funds. The session must have a positive `capturable` balance and the `captureExpiresAt` deadline must not have passed.\\n\\nThis is an asynchronous operation. The capture is returned in `pending` status and transitions to `succeeded` or `failed`.\\n\\nMultiple partial captures are allowed. If `amount` is omitted, the full remaining capturable amount is captured.\",\"href\":\"/api-reference/v2/rest-api/payment-sessions/capture-a-payment-session\"},{\"openapi\":\"post /v2/payment-sessions\",\"title\":\"Create a payment session\",\"description\":\"Creates a payment session that defines what is being paid — amount, asset, and target. Optionally configure execution behavior, expiry deadlines, redirect URLs, and metadata.\\n\\nIf expiry deadlines are omitted, sensible defaults are applied (1 day for authorization, 7 days for capture, 30 days for refund). Expiries must be in ascending order — see the `expiries` object for details and constraints.\\n\\nReturns the session in `created` status. Next step: call one of the authorization endpoints (wallet or Coinbase) to authorize the payment.\",\"href\":\"/api-reference/v2/rest-api/payment-sessions/create-a-payment-session\"},{\"openapi\":\"post /v2/payment-sessions/{paymentSessionId}/refunds\",\"title\":\"Refund a payment session\",\"description\":\"Returns captured funds to the payer. The session must have a positive `refundable` balance and the `refundExpiresAt` deadline must not have passed.\\n\\nThis is an asynchronous operation. The refund is returned in `pending` status and transitions to `succeeded` or `failed`.\\n\\nIf `amount` is omitted, the full remaining refundable amount is refunded. Multiple partial refunds are supported.\",\"href\":\"/api-reference/v2/rest-api/payment-sessions/refund-a-payment-session\"},{\"openapi\":\"post /v2/payment-sessions/{paymentSessionId}/voids\",\"title\":\"Void a payment session\",\"description\":\"Releases all remaining capturable funds back to the payer. The session must have a positive `capturable` balance.\\n\\nThis is an asynchronous operation. The void is returned in `pending` status and transitions to `succeeded` or `failed`.\\n\\nAfter voiding, no further captures can be made. Unlike **Cancel**, which works before authorization, void works after authorization.\",\"href\":\"/api-reference/v2/rest-api/payment-sessions/void-a-payment-session\"},{\"group\":\"Webhooks\",\"pages\":[{\"openapi\":\"webhook acceptancePaymentSessionAuthorizationFailed\",\"sidebarTitle\":\"Payment session authorization failed\",\"title\":\"Payment session authorization failed\",\"description\":\"Triggered when the `acceptance.payment_session.authorization_failed` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-acceptance-payment-session-authorization-failed\"},{\"openapi\":\"webhook acceptancePaymentSessionAuthorizationPending\",\"sidebarTitle\":\"Payment session authorization pending\",\"title\":\"Payment session authorization pending\",\"description\":\"Triggered when the `acceptance.payment_session.authorization_pending` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-acceptance-payment-session-authorization-pending\"},{\"openapi\":\"webhook acceptancePaymentSessionAuthorizationSucceeded\",\"sidebarTitle\":\"Payment session authorization succeeded\",\"title\":\"Payment session authorization succeeded\",\"description\":\"Triggered when the `acceptance.payment_session.authorization_succeeded` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-acceptance-payment-session-authorization-succeeded\"},{\"openapi\":\"webhook acceptancePaymentSessionCanceled\",\"sidebarTitle\":\"Payment session canceled\",\"title\":\"Payment session canceled\",\"description\":\"Triggered when the `acceptance.payment_session.canceled` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-acceptance-payment-session-canceled\"},{\"openapi\":\"webhook acceptancePaymentSessionCaptureFailed\",\"sidebarTitle\":\"Payment session capture failed\",\"title\":\"Payment session capture failed\",\"description\":\"Triggered when the `acceptance.payment_session.capture_failed` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-acceptance-payment-session-capture-failed\"},{\"openapi\":\"webhook acceptancePaymentSessionCapturePending\",\"sidebarTitle\":\"Payment session capture pending\",\"title\":\"Payment session capture pending\",\"description\":\"Triggered when the `acceptance.payment_session.capture_pending` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-acceptance-payment-session-capture-pending\"},{\"openapi\":\"webhook acceptancePaymentSessionCaptureSucceeded\",\"sidebarTitle\":\"Payment session capture succeeded\",\"title\":\"Payment session capture succeeded\",\"description\":\"Triggered when the `acceptance.payment_session.capture_succeeded` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-acceptance-payment-session-capture-succeeded\"},{\"openapi\":\"webhook acceptancePaymentSessionCreated\",\"sidebarTitle\":\"Payment session created\",\"title\":\"Payment session created\",\"description\":\"Triggered when the `acceptance.payment_session.created` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-acceptance-payment-session-created\"},{\"openapi\":\"webhook acceptancePaymentSessionRefundFailed\",\"sidebarTitle\":\"Payment session refund failed\",\"title\":\"Payment session refund failed\",\"description\":\"Triggered when the `acceptance.payment_session.refund_failed` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-acceptance-payment-session-refund-failed\"},{\"openapi\":\"webhook acceptancePaymentSessionRefundPending\",\"sidebarTitle\":\"Payment session refund pending\",\"title\":\"Payment session refund pending\",\"description\":\"Triggered when the `acceptance.payment_session.refund_pending` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-acceptance-payment-session-refund-pending\"},{\"openapi\":\"webhook acceptancePaymentSessionRefundSucceeded\",\"sidebarTitle\":\"Payment session refund succeeded\",\"title\":\"Payment session refund succeeded\",\"description\":\"Triggered when the `acceptance.payment_session.refund_succeeded` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-acceptance-payment-session-refund-succeeded\"},{\"openapi\":\"webhook acceptancePaymentSessionVoidFailed\",\"sidebarTitle\":\"Payment session void failed\",\"title\":\"Payment session void failed\",\"description\":\"Triggered when the `acceptance.payment_session.void_failed` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-acceptance-payment-session-void-failed\"},{\"openapi\":\"webhook acceptancePaymentSessionVoidPending\",\"sidebarTitle\":\"Payment session void pending\",\"title\":\"Payment session void pending\",\"description\":\"Triggered when the `acceptance.payment_session.void_pending` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-acceptance-payment-session-void-pending\"},{\"openapi\":\"webhook acceptancePaymentSessionVoidSucceeded\",\"sidebarTitle\":\"Payment session void succeeded\",\"title\":\"Payment session void succeeded\",\"description\":\"Triggered when the `acceptance.payment_session.void_succeeded` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-acceptance-payment-session-void-succeeded\"}]}]},{\"group\":\"Disbursements\",\"pages\":[{\"title\":\"Disbursements\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/api-reference/v2/rest-api/disbursements/disbursements\"},{\"openapi\":\"get /v2/disbursements/{disbursementId}\",\"title\":\"Get a disbursement\",\"description\":\"Returns the disbursement identified by `disbursementId`. Your API key must have permission to access the disbursement.\",\"href\":\"/api-reference/v2/rest-api/disbursements/get-a-disbursement\"},{\"openapi\":\"get /v2/disbursements\",\"title\":\"List disbursements\",\"description\":\"Returns a paginated list of disbursements accessible to your API key. Filter by `status`, `sourceAccountId`, or `externalReferenceId`.\",\"href\":\"/api-reference/v2/rest-api/disbursements/list-disbursements\"},{\"openapi\":\"post /v2/disbursements\",\"title\":\"Create a disbursement\",\"description\":\"Creates a disbursement from a CDP account you own to a Coinbase user account or an onchain address. Returns the disbursement with `pending` status while processing continues asynchronously.\",\"href\":\"/api-reference/v2/rest-api/disbursements/create-a-disbursement\"},{\"group\":\"Webhooks\",\"pages\":[{\"openapi\":\"webhook acceptanceDisbursementFailed\",\"sidebarTitle\":\"Disbursement failed\",\"title\":\"Disbursement failed\",\"description\":\"Sends an `acceptance.disbursement.failed` event to your configured webhook URL when a disbursement fails.\",\"href\":\"/api-reference/v2/webhooks/webhook-acceptance-disbursement-failed\"},{\"openapi\":\"webhook acceptanceDisbursementPending\",\"sidebarTitle\":\"Disbursement pending\",\"title\":\"Disbursement pending\",\"description\":\"Sends an `acceptance.disbursement.pending` event to your configured webhook URL when a disbursement is created with `pending` status.\",\"href\":\"/api-reference/v2/webhooks/webhook-acceptance-disbursement-pending\"},{\"openapi\":\"webhook acceptanceDisbursementSucceeded\",\"sidebarTitle\":\"Disbursement succeeded\",\"title\":\"Disbursement succeeded\",\"description\":\"Sends an `acceptance.disbursement.succeeded` event to your configured webhook URL when a disbursement succeeds.\",\"href\":\"/api-reference/v2/webhooks/webhook-acceptance-disbursement-succeeded\"}]}]},{\"group\":\"Mandates\",\"tag\":\"Beta\",\"pages\":[{\"title\":\"Mandates\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/api-reference/v2/rest-api/mandates/mandates\"},{\"openapi\":\"get /v2/mandates/{mandateId}\",\"title\":\"Get a mandate\",\"description\":\"Retrieves a single mandate by its ID, including its current `status`, `policy`, and `source`.\",\"href\":\"/api-reference/v2/rest-api/mandates/get-a-mandate\"},{\"openapi\":\"get /v2/mandates/{mandateId}/approvals/{approvalId}\",\"title\":\"Get a mandate approval\",\"description\":\"Retrieves a single approval by its ID, including its current `status`, its `onchainTransactions` once submitted, and, when it failed, its `error`. Poll this after **Approve a mandate with a wallet** to follow a `pending` approval to `succeeded` or `failed`, or consume the mandate webhooks instead.\",\"href\":\"/api-reference/v2/rest-api/mandates/get-a-mandate-approval\"},{\"openapi\":\"get /v2/mandates/{mandateId}/revocations/{revocationId}\",\"title\":\"Get a mandate revocation\",\"description\":\"Retrieves a single revocation by ID.\",\"href\":\"/api-reference/v2/rest-api/mandates/get-a-mandate-revocation\"},{\"openapi\":\"get /v2/mandates/{mandateId}/approvals/wallet/options\",\"title\":\"Get wallet approval options\",\"description\":\"Returns the available wallet approval options for a mandate. The mandate must be in `created` or `approval_failed` status, not expired, and have no approval or revocation in flight.\\n\\nProvide one or more customer wallet addresses as query parameters. Each option specifies the network, asset, and payloads the customer must sign to approve the mandate. Present the options to the customer and let them choose one, then call **Approve a mandate with a wallet** with the selected option and its signed payloads.\\n\\nThis is a stateless read operation and does not modify the mandate. The payloads embed fresh on-chain signing data such as a `nonce` and `deadline`, so sign and submit the payloads from a single response rather than caching them.\\n\\nIf a requested address has no eligible approval options, it appears in `ineligibleAddresses` with a `code` and `message` instead of being absent from `options`.\",\"href\":\"/api-reference/v2/rest-api/mandates/get-wallet-approval-options\"},{\"openapi\":\"get /v2/mandates/{mandateId}/revocations/wallet/options\",\"title\":\"Get wallet revocation options\",\"description\":\"Returns the payloads the customer must sign to remove the mandate's spending allowance on-chain. The mandate must have an active allowance (approval succeeded, not yet revoked) and no approval or revocation in flight. A canceled mandate can still be revoked while its allowance is live.\\n\\nPresent the payloads to the customer to sign, then call **Revoke a mandate with a wallet** with the signed payloads.\\n\\nThis is a stateless read operation and does not modify the mandate. The payloads embed fresh signing data on each call, so sign and submit the payloads from a single response rather than caching them.\",\"href\":\"/api-reference/v2/rest-api/mandates/get-wallet-revocation-options\"},{\"openapi\":\"get /v2/mandates/{mandateId}/approvals\",\"title\":\"List mandate approvals\",\"description\":\"Returns the approvals for a mandate, most recent first. Each approval is an attempt to attach a funding `source`; inspect them to see why a mandate is not yet `approval_succeeded`: a `pending` attempt is still in progress, a `failed` one carries an `error`.\",\"href\":\"/api-reference/v2/rest-api/mandates/list-mandate-approvals\"},{\"openapi\":\"get /v2/mandates/{mandateId}/revocations\",\"title\":\"List mandate revocations\",\"description\":\"Returns all wallet revocations for the mandate, newest first. Each records an attempt to remove the spending allowance on-chain. A `succeeded` entry means the allowance has been removed.\",\"href\":\"/api-reference/v2/rest-api/mandates/list-mandate-revocations\"},{\"openapi\":\"get /v2/mandates\",\"title\":\"List mandates\",\"description\":\"Returns a paginated list of mandates that the API key has permission to access. Filter by `address` (the funding `source`), `network`, and `status`.\",\"href\":\"/api-reference/v2/rest-api/mandates/list-mandates\"},{\"openapi\":\"post /v2/mandates/{mandateId}/approvals/wallet\",\"title\":\"Approve a mandate with a wallet\",\"description\":\"**Customer-initiated.** Approves a mandate on a wallet source using the customer's signed payloads from **Get wallet approval options**. The customer signs the payloads themselves, so this call is unauthenticated. The mandate must be in `created` or `approval_failed` status, not expired, and have no approval or revocation in flight.\\n\\nReturns a `pending` approval and moves the mandate to `approval_pending`. On success the mandate's `source` is set and `status` becomes `approval_succeeded`; it can then be used by **Authorize a payment session with a mandate**. On failure `status` becomes `approval_failed` and a new approval can be submitted. Follow progress with **Get a mandate approval** or the `acceptance.mandate.approval_*` webhooks.\",\"href\":\"/api-reference/v2/rest-api/mandates/approve-a-mandate-with-a-wallet\"},{\"openapi\":\"post /v2/mandates/{mandateId}/cancel\",\"title\":\"Cancel a mandate\",\"description\":\"Ends the mandate off-chain. `status` becomes `canceled`, `canceledAt` is set, and new authorizations are blocked immediately; authorizations already in progress are not affected. Cancel can be called from any status except a fully revoked one (`revokedAt` set); canceling an already canceled mandate is a no-op that returns the mandate unchanged.\\n\\nCanceling does not touch the on-chain spending allowance, which may still be live afterward. The customer removes it separately with **Revoke a mandate with a wallet**; that later revocation sets `revokedAt` while `canceledAt` remains set.\",\"href\":\"/api-reference/v2/rest-api/mandates/cancel-a-mandate\"},{\"openapi\":\"post /v2/mandates\",\"title\":\"Create a mandate\",\"description\":\"Creates a mandate denominated in `asset`. Optionally set `policy` to cap debits; if omitted, a Coinbase-configured monthly max applies. The response always includes the resolved `policy`.\\n\\nReturns the mandate in `created` status with no `source`; it is not yet usable. Next step: have the customer approve it with **Get wallet approval options** then **Approve a mandate with a wallet**, which attaches the `source` and moves the mandate to `approval_succeeded`.\\n\\nA mandate's terms can't be modified once created. To change them, cancel the mandate and create a new one.\",\"href\":\"/api-reference/v2/rest-api/mandates/create-a-mandate\"},{\"openapi\":\"post /v2/mandates/{mandateId}/revocations/wallet\",\"title\":\"Revoke a mandate with a wallet\",\"description\":\"**Customer-initiated.** Removes the mandate's spending allowance on-chain using the customer's signed payloads from **Get wallet revocation options**. The customer signs the payloads themselves, so this call is unauthenticated. The mandate must have an active allowance and no approval or revocation in flight.\\n\\nReturns a `pending` revocation and moves the mandate to `revocation_pending`. When the network transaction confirms, `revokedAt` is set and `status` becomes `revocation_succeeded`; if it does not complete, `status` becomes `revocation_failed` and a new revocation can be submitted. Follow progress with **Get a mandate revocation** or the `acceptance.mandate.revocation_*` webhooks.\\n\\nA canceled mandate can still be revoked: the revocation sets `revokedAt` while `canceledAt` remains set.\",\"href\":\"/api-reference/v2/rest-api/mandates/revoke-a-mandate-with-a-wallet\"},{\"group\":\"Webhooks\",\"pages\":[{\"openapi\":\"webhook acceptanceMandateApprovalFailed\",\"sidebarTitle\":\"Mandate approval failed\",\"title\":\"Mandate approval failed\",\"description\":\"Triggered when a mandate approval fails. The mandate's `status` becomes `approval_failed` and it is not usable. Inspect `data.approval.error` and retry by submitting a new approval.\",\"href\":\"/api-reference/v2/webhooks/webhook-acceptance-mandate-approval-failed\"},{\"openapi\":\"webhook acceptanceMandateApprovalInitiated\",\"sidebarTitle\":\"Mandate approval initiated\",\"title\":\"Mandate approval initiated\",\"description\":\"Triggered when a customer submits a mandate approval. The mandate's `status` is `approval_pending` and it is not yet usable. No action is required while the approval is processing; wait for the `approval_succeeded` or `approval_failed` event.\",\"href\":\"/api-reference/v2/webhooks/webhook-acceptance-mandate-approval-initiated\"},{\"openapi\":\"webhook acceptanceMandateApprovalSucceeded\",\"sidebarTitle\":\"Mandate approval succeeded\",\"title\":\"Mandate approval succeeded\",\"description\":\"Triggered when a mandate approval succeeds. The mandate's `status` becomes `approval_succeeded`, its `source` is set, and it is now usable.\",\"href\":\"/api-reference/v2/webhooks/webhook-acceptance-mandate-approval-succeeded\"},{\"openapi\":\"webhook acceptanceMandateCanceled\",\"sidebarTitle\":\"Mandate canceled\",\"title\":\"Mandate canceled\",\"description\":\"Triggered when the merchant cancels a mandate. The mandate's `status` becomes `canceled` and `canceledAt` is set. The on-chain spending allowance is unaffected; it is removed only when a wallet revocation sets `mandate.revokedAt`.\",\"href\":\"/api-reference/v2/webhooks/webhook-acceptance-mandate-canceled\"},{\"openapi\":\"webhook acceptanceMandateCreated\",\"sidebarTitle\":\"Mandate created\",\"title\":\"Mandate created\",\"description\":\"Triggered when a mandate is created and enters `created` status. It is not yet usable; the customer must complete approval before it can be debited.\",\"href\":\"/api-reference/v2/webhooks/webhook-acceptance-mandate-created\"},{\"openapi\":\"webhook acceptanceMandateRevocationFailed\",\"sidebarTitle\":\"Mandate revocation failed\",\"title\":\"Mandate revocation failed\",\"description\":\"Triggered when a wallet revocation fails. `mandate.status` becomes `revocation_failed`. The spending allowance was not removed, so the mandate remains usable if it was usable before the attempt (`revokedAt` stays unset). Inspect `revocation.error` for the reason, then retry with a new wallet revocation.\",\"href\":\"/api-reference/v2/webhooks/webhook-acceptance-mandate-revocation-failed\"},{\"openapi\":\"webhook acceptanceMandateRevocationInitiated\",\"sidebarTitle\":\"Mandate revocation initiated\",\"title\":\"Mandate revocation initiated\",\"description\":\"Triggered when a wallet revocation is submitted. `mandate.status` becomes `revocation_pending`. This happens regardless of whether the mandate was previously canceled. New authorizations are blocked while in `revocation_pending`. Wait for `revocation_succeeded` or `revocation_failed` before acting.\",\"href\":\"/api-reference/v2/webhooks/webhook-acceptance-mandate-revocation-initiated\"},{\"openapi\":\"webhook acceptanceMandateRevocationSucceeded\",\"sidebarTitle\":\"Mandate revocation succeeded\",\"title\":\"Mandate revocation succeeded\",\"description\":\"Triggered when a wallet revocation completes. The spending allowance has been removed on-chain, `mandate.revokedAt` is set, and `mandate.status` becomes `revocation_succeeded`. This is terminal: the allowance is gone and the mandate can no longer be authorized against. It applies regardless of whether the mandate was previously canceled (`canceledAt` remains set).\",\"href\":\"/api-reference/v2/webhooks/webhook-acceptance-mandate-revocation-succeeded\"}]}]},{\"group\":\"Top-Up Links\",\"tag\":\"Beta\",\"pages\":[{\"title\":\"Top-Up Links\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/api-reference/v2/rest-api/top-up-links/top-up-links\"},{\"openapi\":\"post /v2/top-up-links\",\"title\":\"Create a Top-Up Link\",\"description\":\"$4c\",\"href\":\"/api-reference/v2/rest-api/top-up-links/create-a-top-up-link\"},{\"group\":\"Webhooks\",\"pages\":[{\"openapi\":\"webhook acceptanceTopUpLinkCreated\",\"sidebarTitle\":\"Top-Up Link created\",\"title\":\"Top-Up Link created\",\"description\":\"Triggered when the `acceptance.top_up_link.created` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured. `data.topUpLink` carries the complete immutable Top-Up Link resource as created. The link expires 24 hours after creation, funds a single purchase, and is not bound to a specific payer. `data.topUpLink.customerDisplay.merchantName` contains the resolved name stored at creation, including the entity's profile-name fallback. `orderTotalAmount` and `redirectUrl` are omitted when they were not supplied at creation.\",\"href\":\"/api-reference/v2/webhooks/webhook-acceptance-top-up-link-created\"},{\"openapi\":\"webhook acceptanceTopUpLinkFundsAdded\",\"sidebarTitle\":\"Top-Up Link funds added\",\"title\":\"Top-Up Link funds added\",\"description\":\"Triggered when the `acceptance.top_up_link.funds_added` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured. The event reports the purchase that spent the link. Because a link funds a single purchase, it produces at most one funds-added event; deliveries can repeat, so deduplicate on `eventId`. `toppedUpAmount` is the actual net amount credited by that purchase, denominated in `asset`; it is never cumulative and independent of the link's suggested amounts.\",\"href\":\"/api-reference/v2/webhooks/webhook-acceptance-top-up-link-funds-added\"}]}]}]},{\"group\":\"Deposit Destinations\",\"tag\":\"Beta\",\"pages\":[{\"title\":\"Deposit Destinations\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/api-reference/v2/rest-api/deposit-destinations/deposit-destinations\"},{\"openapi\":\"get /v2/deposit-destinations/{depositDestinationId}\",\"title\":\"Get deposit destination\",\"description\":\"Get a specific deposit destination by its ID.\",\"href\":\"/api-reference/v2/rest-api/deposit-destinations/get-deposit-destination\"},{\"openapi\":\"get /v2/deposit-destinations\",\"title\":\"List deposit destinations\",\"description\":\"List deposit destinations. You can optionally filter the results by type, account ID, network, cryptocurrency address, or status. Results are sorted by creation date in descending order (newest first).\",\"href\":\"/api-reference/v2/rest-api/deposit-destinations/list-deposit-destinations\"},{\"openapi\":\"post /v2/deposit-destinations\",\"title\":\"Create deposit destination\",\"description\":\"$4d\",\"href\":\"/api-reference/v2/rest-api/deposit-destinations/create-deposit-destination\"}]},{\"group\":\"Payment Methods\",\"tag\":\"Beta\",\"pages\":[{\"title\":\"Payment Methods\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/api-reference/v2/rest-api/payment-methods/payment-methods\"},{\"openapi\":\"get /v2/payment-methods/{paymentMethodId}\",\"title\":\"Get payment method\",\"description\":\"Get details of a specific payment method by its ID. Returns 404 if the payment method is not found or not owned by the requesting entity.\",\"href\":\"/api-reference/v2/rest-api/payment-methods/get-payment-method\"},{\"openapi\":\"get /v2/payment-methods\",\"title\":\"List payment methods\",\"description\":\"List payment methods linked to your entity. Payment methods represent external financial instruments that can be used as a target for transfers. The list will not include disabled or deleted payment methods.\\n\\n**Currently Supported Types:**\\n- `fedwire`: Domestic USD wire transfers\\n- `swift`: International wire transfers\\n- `sepa`: SEPA EUR transfers\\n\\n**Note:** Payment methods are created and verified through your linked CDP entity. Currently, fetching payment methods is only supported for Prime investment vehicles linked to CDP.\",\"href\":\"/api-reference/v2/rest-api/payment-methods/list-payment-methods\"}]},{\"group\":\"Transfers\",\"tag\":\"Beta\",\"pages\":[{\"title\":\"Transfers\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/api-reference/v2/rest-api/transfers/transfers\"},{\"openapi\":\"get /v2/transfers/{transferId}\",\"title\":\"Get transfer\",\"description\":\"Get a transfer by its ID.\",\"href\":\"/api-reference/v2/rest-api/transfers/get-transfer\"},{\"openapi\":\"get /v2/transfers\",\"title\":\"List transfers\",\"description\":\"$4e\",\"href\":\"/api-reference/v2/rest-api/transfers/list-transfers\"},{\"openapi\":\"post /v2/transfers\",\"title\":\"Create transfer\",\"description\":\"Create a new transfer to move funds from a source to a target.\\nAll transfers first transition to `quoted`. If `execute: false`, the transfer stays quoted until you call `/v2/transfers/{transferId}/execute`.\\nIf `execute: true`, quoted status emits momentarily before the transfer moves to `processing`, where execution proceeds. Subscribe to the transfers webhook to  follow progress in real time instead of polling.\",\"href\":\"/api-reference/v2/rest-api/transfers/create-transfer\"},{\"openapi\":\"post /v2/transfers/{transferId}/execute\",\"title\":\"Execute transfer\",\"description\":\"Executes a transfer which was created using the Create a transfer endpoint.\",\"href\":\"/api-reference/v2/rest-api/transfers/execute-transfer\"},{\"openapi\":\"post /v2/transfers/{transferId}/travel-rule\",\"title\":\"Submit deposit travel rule information\",\"description\":\"Submit travel rule information for a deposit transfer held pending compliance review.\\n\\nRequired fields vary by jurisdiction and may include originator name, address, date of birth, personal ID, and VASP information.\\n\\nIf the submitted information satisfies all jurisdictional requirements, `status` will be `completed` and the transfer will proceed. Otherwise, `status` will be `incomplete` and `missingFields` will indicate which fields still need to be provided.\",\"href\":\"/api-reference/v2/rest-api/transfers/submit-deposit-travel-rule-information\"},{\"group\":\"Webhooks\",\"pages\":[{\"openapi\":\"webhook paymentsTransfersCompleted\",\"sidebarTitle\":\"Payments transfers completed\",\"title\":\"Payments transfers completed\",\"description\":\"Triggered when the `payments.transfers.completed` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-payments-transfers-completed\"},{\"openapi\":\"webhook paymentsTransfersExpired\",\"sidebarTitle\":\"Payments transfers expired\",\"title\":\"Payments transfers expired\",\"description\":\"Triggered when the `payments.transfers.expired` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-payments-transfers-expired\"},{\"openapi\":\"webhook paymentsTransfersFailed\",\"sidebarTitle\":\"Payments transfers failed\",\"title\":\"Payments transfers failed\",\"description\":\"Triggered when the `payments.transfers.failed` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-payments-transfers-failed\"},{\"openapi\":\"webhook paymentsTransfersProcessing\",\"sidebarTitle\":\"Payments transfers processing\",\"title\":\"Payments transfers processing\",\"description\":\"Triggered when the `payments.transfers.processing` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-payments-transfers-processing\"},{\"openapi\":\"webhook paymentsTransfersQuoted\",\"sidebarTitle\":\"Payments transfers quoted\",\"title\":\"Payments transfers quoted\",\"description\":\"Triggered when the `payments.transfers.quoted` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-payments-transfers-quoted\"},{\"openapi\":\"webhook paymentsTransfersTravelRuleCompleted\",\"sidebarTitle\":\"Payments transfers travel rule completed\",\"title\":\"Payments transfers travel rule completed\",\"description\":\"Triggered when the `payments.transfers.travel_rule_completed` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-payments-transfers-travel-rule-completed\"},{\"openapi\":\"webhook paymentsTransfersTravelRuleIncomplete\",\"sidebarTitle\":\"Payments transfers travel rule incomplete\",\"title\":\"Payments transfers travel rule incomplete\",\"description\":\"Triggered when the `payments.transfers.travel_rule_incomplete` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-payments-transfers-travel-rule-incomplete\"}]}]},{\"group\":\"Onramp\",\"pages\":[{\"title\":\"Onramp\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/api-reference/v2/rest-api/onramp/onramp\"},{\"openapi\":\"get /v2/onramp/orders/{orderId}\",\"title\":\"Get an onramp order by ID\",\"description\":\"Get an onramp order by ID.\",\"href\":\"/api-reference/v2/rest-api/onramp/get-an-onramp-order-by-id\"},{\"openapi\":\"post /v2/onramp/orders\",\"title\":\"Create an onramp order\",\"description\":\"$4f\",\"href\":\"/api-reference/v2/rest-api/onramp/create-an-onramp-order\"},{\"openapi\":\"post /v2/onramp/sessions\",\"title\":\"Create an onramp session\",\"description\":\"$50\",\"href\":\"/api-reference/v2/rest-api/onramp/create-an-onramp-session\"},{\"openapi\":\"post /v2/onramp/limits\",\"title\":\"Get onramp user limits\",\"description\":\"Returns the transaction limits for an onramp user based on their payment method and user identifier. Use this API to show users their remaining purchase capacity before initiating an onramp transaction.\\nCurrently supports `GUEST_CHECKOUT_APPLE_PAY` payment method with phone number identification. The phone number must have been previously verified via OTP.\",\"href\":\"/api-reference/v2/rest-api/onramp/get-onramp-user-limits\"},{\"openapi\":\"post /v2/onramp/verifications\",\"title\":\"Initiate onramp verification\",\"description\":\"Initiates OTP verification by sending a 6-digit code to the user via the specified channel (SMS or email). Returns a `verificationId` that must be passed to the Submit Onramp Verification endpoint along with the OTP code within 10 minutes.\\n\\n**Access to this API requires allowlisting.** During Onramp Headless API onboarding, contact the Onramp team to enable Onramp-managed verification for your application.\",\"href\":\"/api-reference/v2/rest-api/onramp/initiate-onramp-verification\"},{\"openapi\":\"post /v2/onramp/limits/upgrade\",\"title\":\"Request limit upgrade\",\"description\":\"Requests a limit upgrade for an onramp user. Only phone number is currently supported as a userId.\\n\\nThe default API mode submits identity information directly and returns HTTP 202 when the request is accepted. Embedded mode (`interactionMode: embedded`) returns a Coinbase-hosted `upgradeUrl` where the user enters identity information.\\n\\nThe verification process is asynchronous. After calling this endpoint, use the [Get Onramp User Limits](https://docs.cdp.coinbase.com/api-reference/v2/rest-api/onramp/get-onramp-user-limits) endpoint to check the status in the `limitUpgradeOptions` array.\\n\\n**Prerequisites:**\\n- The phone number must have been previously verified by your app via OTP. - Upgrades may not be available until a certain number of successful transactions by the user.\\n\\n**Supported fields:**\\n- `ssnLast4`: Last 4 digits of the Social Security Number (no dashes or spaces).\\n- `dateOfBirth`: Date of birth (day, month, year as zero-padded strings).\",\"href\":\"/api-reference/v2/rest-api/onramp/request-limit-upgrade\"},{\"openapi\":\"post /v2/onramp/verifications/{verificationId}/submit\",\"title\":\"Submit onramp verification\",\"description\":\"Submits the OTP code to complete verification. On success, marks the verification as verified and returns the same `verificationId`. The destination does not need to be re-sent. Onramp uses the value captured at initiation time.\\n\\nThe returned `verificationId` should be stored on the user's device and passed to the Create Onramp Order endpoint. It is valid for 60 days.\\n\\n**Access to this API requires allowlisting.** During Onramp Headless API onboarding, contact the Onramp team to enable Onramp-managed verification for your application.\",\"href\":\"/api-reference/v2/rest-api/onramp/submit-onramp-verification\"},{\"group\":\"Webhooks\",\"pages\":[{\"openapi\":\"webhook offrampTransactionCreated\",\"sidebarTitle\":\"Offramp transaction created\",\"title\":\"Offramp transaction created\",\"description\":\"Triggered when the `offramp.transaction.created` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-offramp-transaction-created\"},{\"openapi\":\"webhook offrampTransactionFailed\",\"sidebarTitle\":\"Offramp transaction failed\",\"title\":\"Offramp transaction failed\",\"description\":\"Triggered when the `offramp.transaction.failed` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-offramp-transaction-failed\"},{\"openapi\":\"webhook offrampTransactionSuccess\",\"sidebarTitle\":\"Offramp transaction succeeded\",\"title\":\"Offramp transaction succeeded\",\"description\":\"Triggered when the `offramp.transaction.success` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-offramp-transaction-success\"},{\"openapi\":\"webhook offrampTransactionUpdated\",\"sidebarTitle\":\"Offramp transaction updated\",\"title\":\"Offramp transaction updated\",\"description\":\"Triggered when the `offramp.transaction.updated` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-offramp-transaction-updated\"},{\"openapi\":\"webhook onrampTransactionCreated\",\"sidebarTitle\":\"Onramp transaction created\",\"title\":\"Onramp transaction created\",\"description\":\"Triggered when the `onramp.transaction.created` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-onramp-transaction-created\"},{\"openapi\":\"webhook onrampTransactionFailed\",\"sidebarTitle\":\"Onramp transaction failed\",\"title\":\"Onramp transaction failed\",\"description\":\"Triggered when the `onramp.transaction.failed` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-onramp-transaction-failed\"},{\"openapi\":\"webhook onrampTransactionSuccess\",\"sidebarTitle\":\"Onramp transaction succeeded\",\"title\":\"Onramp transaction succeeded\",\"description\":\"Triggered when the `onramp.transaction.success` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-onramp-transaction-success\"},{\"openapi\":\"webhook onrampTransactionUpdated\",\"sidebarTitle\":\"Onramp transaction updated\",\"title\":\"Onramp transaction updated\",\"description\":\"Triggered when the `onramp.transaction.updated` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-onramp-transaction-updated\"}]}]},{\"group\":\"x402 Facilitator\",\"tag\":\"Beta\",\"pages\":[{\"title\":\"x402 Facilitator\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/api-reference/v2/rest-api/x402-facilitator/x402-facilitator\"},{\"openapi\":\"get /v2/x402/discovery/bundles/{bundleSlug}\",\"title\":\"Get an x402 bundle\",\"description\":\"Gets a single curated x402 workflow bundle by its bundle slug, including the bundle metadata and its ordered member resources joined to their full discovery metadata.\",\"href\":\"/api-reference/v2/rest-api/x402-facilitator/get-an-x402-bundle\"},{\"openapi\":\"get /v2/x402/supported\",\"title\":\"Get supported payment schemes and networks\",\"description\":\"Get the supported x402 protocol payment schemes and networks that the facilitator is able to verify and settle payments for.\",\"href\":\"/api-reference/v2/rest-api/x402-facilitator/get-supported-payment-schemes-and-networks\"},{\"openapi\":\"get /v2/x402/discovery/merchant\",\"title\":\"List merchant discovery info\",\"description\":\"Gets x402 merchant discovery information for a given merchant payment address.\\nThis endpoint returns all active x402 resources associated with the specified `payTo` address, allowing clients to discover what payment-gated resources a merchant exposes and their corresponding payment requirements.\\nIf no active resources are found for the `payTo` address, the endpoint returns an empty `resources` list.\\nThe response is paginated, and by default, returns 20 items per page.\",\"href\":\"/api-reference/v2/rest-api/x402-facilitator/list-merchant-discovery-info\"},{\"openapi\":\"get /v2/x402/discovery/bundles\",\"title\":\"List x402 bundles\",\"description\":\"Lists the available curated x402 workflow bundles. A bundle is an ordered, named grouping of curated x402 resources that together cover a common agent workflow.\\nThe result set is small and server-controlled, so this endpoint is not paginated.\",\"href\":\"/api-reference/v2/rest-api/x402-facilitator/list-x402-bundles\"},{\"openapi\":\"get /v2/x402/discovery/resources\",\"title\":\"List x402 resources\",\"description\":\"Lists all active discovered x402 resources.\\nThis endpoint returns resources that have been discovered and cached by the x402 facilitator, including their payment requirements and metadata.\\nThe response is paginated, and by default, returns 100 items per page.\",\"href\":\"/api-reference/v2/rest-api/x402-facilitator/list-x402-resources\"},{\"openapi\":\"get /v2/x402/discovery/search\",\"title\":\"Search x402 resources\",\"description\":\"Searches for active x402 resources using a text query and optional filters.\\nSupports both text-based and vector-based search depending on availability. Results are sorted by relevance and quality score.\\nLegacy network names (e.g., `base`, `base-sepolia`, `solana`) are automatically normalized to their CAIP-2 equivalents.\\nThe response is limited to 20 items per request. If more results exist, `partialResults` will be `true`.\",\"href\":\"/api-reference/v2/rest-api/x402-facilitator/search-x402-resources\"},{\"openapi\":\"post /v2/x402/discovery/mcp\",\"title\":\"Handle MCP JSON-RPC request\",\"description\":\"Handles JSON-RPC requests for the Model Context Protocol (MCP). Supports MCP methods for discovering x402 payment resources and tools.\",\"href\":\"/api-reference/v2/rest-api/x402-facilitator/handle-mcp-json-rpc-request\"},{\"openapi\":\"post /v2/x402/settle\",\"title\":\"Settle payment\",\"description\":\"Settle an x402 protocol payment with a specific scheme and network.\",\"href\":\"/api-reference/v2/rest-api/x402-facilitator/settle-payment\"},{\"openapi\":\"post /v2/x402/validate\",\"title\":\"Validate x402 endpoint\",\"description\":\"Validates an x402 endpoint's bazaar-discovery configuration by probing the seller's URL live.\\nReturns a uniform array of preflight check results (reachable, returns402, hasBazaarExtension, parse) and a simulated facilitator accept/reject decision so sellers and agents can confirm their endpoint is ready to be discovered before going live.\\nThis operation is read-only: it performs no payment and does not index the resource.\",\"href\":\"/api-reference/v2/rest-api/x402-facilitator/validate-x402-endpoint\"},{\"openapi\":\"post /v2/x402/verify\",\"title\":\"Verify payment\",\"description\":\"Verify an x402 protocol payment with a specific scheme and network.\",\"href\":\"/api-reference/v2/rest-api/x402-facilitator/verify-payment\"}]}]},{\"group\":\"Trading\",\"pages\":[{\"group\":\"EVM Swaps\",\"tag\":\"Beta\",\"pages\":[{\"title\":\"EVM Swaps\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/api-reference/v2/rest-api/evm-swaps/evm-swaps\"},{\"openapi\":\"get /v2/evm/swaps/quote\",\"title\":\"Get swap price estimate\",\"description\":\"Get a price estimate for a swap between two tokens on an EVM network.\",\"href\":\"/api-reference/v2/rest-api/evm-swaps/get-swap-price-estimate\"},{\"openapi\":\"post /v2/evm/swaps\",\"title\":\"Create swap quote\",\"description\":\"Create a swap quote, which includes the payload to sign as well as the transaction data needed to execute the swap. The developer is responsible for signing the payload and submitting the transaction to the network in order to execute the swap.\",\"href\":\"/api-reference/v2/rest-api/evm-swaps/create-swap-quote\"}]}]},{\"group\":\"Onchain Tools\",\"pages\":[{\"group\":\"EVM Token Balances\",\"pages\":[{\"title\":\"EVM Token Balances\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/api-reference/v2/rest-api/evm-token-balances/evm-token-balances\"},{\"openapi\":\"get /v2/evm/token-balances/{network}/{address}\",\"title\":\"List EVM token balances\",\"description\":\"Lists the token balances of an EVM address on a given network. The balances include ERC-20 tokens and the native gas token (usually ETH). The response is paginated, and by default, returns 20 balances per page.\\n\\nCalls to the `base` and `base-sepolia` networks offer:\\n  * 99.5% \u003c 2 second freshness from chain tip for new tokens on an address.\\n  * 99.5% \u003c 2 second freshness from chain tip for balance data.\\n\\nCalls to the `ethereum` network offer:\\n  * 99% \u003c 30 second freshness from chain tip for new tokens on an address.\\n  * 99% \u003c 2 second freshness from chain tip for balance data.\",\"href\":\"/api-reference/v2/rest-api/evm-token-balances/list-evm-token-balances\"}]},{\"group\":\"Faucets\",\"pages\":[{\"title\":\"Faucets\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/api-reference/v2/rest-api/faucets/faucets\"},{\"openapi\":\"post /v2/evm/faucet\",\"title\":\"Request funds on EVM test networks\",\"description\":\"Request funds from the CDP Faucet on supported EVM test networks.\\n\\nFaucets are available for ETH, USDC, EURC, and cbBTC on Base Sepolia and Ethereum Sepolia, and for ETH only on Ethereum Hoodi.\\n\\nTo prevent abuse, we enforce rate limits within a rolling 24-hour window to control the amount of funds that can be requested.\\nThese limits are applied at both the CDP User level and the blockchain address level.\\nA single blockchain address cannot exceed the specified limits, even if multiple users submit requests to the same address.\\n\\n| Token | Amount per Faucet Request |Rolling 24-hour window Rate Limits|\\n|:-----:|:-------------------------:|:--------------------------------:|\\n| ETH   | 0.0001 ETH                | 0.1 ETH                          |\\n| USDC  | 1 USDC                    | 10 USDC                          |\\n| EURC  | 1 EURC                    | 10 EURC                          |\\n| cbBTC | 0.0001 cbBTC              | 0.001 cbBTC                      |\\n\",\"href\":\"/api-reference/v2/rest-api/faucets/request-funds-on-evm-test-networks\"},{\"openapi\":\"post /v2/solana/faucet\",\"title\":\"Request funds on Solana devnet\",\"description\":\"Request funds from the CDP Faucet on Solana devnet.\\n\\nFaucets are available for SOL, USDC, and CBTUSD.\\n\\nTo prevent abuse, we enforce rate limits within a rolling 24-hour window to control the amount of funds that can be requested.\\nThese limits are applied at both the CDP Project level and the blockchain address level.\\nA single blockchain address cannot exceed the specified limits, even if multiple users submit requests to the same address.\\n\\n| Token  | Amount per Faucet Request |Rolling 24-hour window Rate Limits|\\n|:-----: |:-------------------------:|:--------------------------------:|\\n| SOL    | 0.00125 SOL               | 0.0125 SOL                       |\\n| USDC   | 1 USDC                    | 10 USDC                          |\\n| CBTUSD | 1 CBTUSD                  | 10 CBTUSD                        |\\n\",\"href\":\"/api-reference/v2/rest-api/faucets/request-funds-on-solana-devnet\"}]},{\"group\":\"Onchain Data\",\"pages\":[{\"title\":\"Onchain Data\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/api-reference/v2/rest-api/onchain-data/onchain-data\"},{\"openapi\":\"get /v2/data/evm/token-balances/{network}/{address}\",\"title\":\"List EVM token balances\",\"description\":\"Lists the token balances of an EVM address on a given network. The balances include ERC-20 tokens and the native gas token (usually ETH). The response is paginated, and by default, returns 20 balances per page.\\n\\nCalls to the `base` and `base-sepolia` networks offer:\\n  * 99.5% \u003c 2 second freshness from chain tip for new tokens on an address.\\n  * 99.5% \u003c 2 second freshness from chain tip for balance data.\\n\\nCalls to the `ethereum` network offer:\\n  * 99% \u003c 30 second freshness from chain tip for new tokens on an address.\\n  * 99% \u003c 2 second freshness from chain tip for balance data.\",\"href\":\"/api-reference/v2/rest-api/onchain-data/list-evm-token-balances\"},{\"openapi\":\"get /v2/data/evm/token-ownership/{network}/{address}\",\"title\":\"List token addresses for account\",\"description\":\"Retrieve all ERC-20 token contract addresses that an account has ever received tokens from.\\nAnalyzes transaction history to discover token interactions.\\n\",\"href\":\"/api-reference/v2/rest-api/onchain-data/list-token-addresses-for-account\"},{\"group\":\"Webhooks\",\"pages\":[{\"openapi\":\"webhook onchainActivityDetected\",\"sidebarTitle\":\"Onchain activity detected\",\"title\":\"Onchain activity detected\",\"description\":\"Triggered when onchain activity matching your subscription filters is detected. Your API will receive a POST request at the webhook URL you configured. Use `labels` on your webhook subscription to filter which onchain events are delivered (see the Create Webhook Subscription endpoint for allowed labels).\",\"href\":\"/api-reference/v2/webhooks/webhook-onchain-activity-detected\"},{\"openapi\":\"webhook walletActivityDetected\",\"sidebarTitle\":\"Wallet activity detected\",\"title\":\"Wallet activity detected\",\"description\":\"Triggered when the `wallet.activity.detected` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-wallet-activity-detected\"},{\"openapi\":\"webhook walletActivityMulti\",\"sidebarTitle\":\"Wallet activity multi\",\"title\":\"Wallet activity multi\",\"description\":\"Triggered when the `wallet.activity.multi` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-wallet-activity-multi\"}]}]},{\"group\":\"Solana Token Balances\",\"pages\":[{\"title\":\"Solana Token Balances\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/api-reference/v2/rest-api/solana-token-balances/solana-token-balances\"},{\"openapi\":\"get /v2/solana/token-balances/{network}/{address}\",\"title\":\"List Solana token balances\",\"description\":\"Lists the token balances of a Solana address on a given network. The balances include SPL tokens and the native SOL token. The response is paginated, and by default, returns 20 balances per page.\\n\\n**Note:** This endpoint is still under development and does not yet provide strong availability or freshness guarantees. Freshness and availability of new token balances will improve over the coming weeks.\",\"href\":\"/api-reference/v2/rest-api/solana-token-balances/list-solana-token-balances\"}]},{\"group\":\"SQL API\",\"pages\":[{\"title\":\"SQL API\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/api-reference/v2/rest-api/sql-api/sql-api\"},{\"openapi\":\"get /v2/data/query/schema\",\"title\":\"Get schema details\",\"description\":\"Retrieve the schema information for the available tables in the SQL API's indexed data.\\n\\nThis includes table names, column definitions, data types, and indexed fields.\\n\",\"href\":\"/api-reference/v2/rest-api/sql-api/get-schema-details\"},{\"openapi\":\"get /v2/data/query/grammar\",\"title\":\"Get SQL grammar\",\"description\":\"Retrieve the SQL grammar for the SQL API.\\n\\nThe SQL queries that are supported by the SQL API are defined in ANTLR4 grammar which is evaluated by server before executing the query. This ensures the safety and soundness of the SQL query before execution.\\n\\nThis endpoint returns the ANTLR4 grammar that is used to evaluate the SQL queries so that developers can understand the SQL API and build SQL queries with high confidence and correctness.\\n\\nLLMs interact well with ANTLR4 grammar. You can feed the grammar directly into the LLMs to help generate SQL queries.\\n\",\"href\":\"/api-reference/v2/rest-api/sql-api/get-sql-grammar\"},{\"openapi\":\"post /v2/data/query/run\",\"title\":\"Run SQL Query\",\"description\":\"$51\",\"href\":\"/api-reference/v2/rest-api/sql-api/run-sql-query\"}]}]},{\"group\":\"Customers\",\"tag\":\"Beta\",\"pages\":[{\"title\":\"Customers\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/api-reference/v2/rest-api/customers/customers\"},{\"openapi\":\"get /v2/customers/{customerId}\",\"title\":\"Get a customer\",\"description\":\"Get a customer by their ID. Returns the full customer object.\\n\",\"href\":\"/api-reference/v2/rest-api/customers/get-a-customer\"},{\"openapi\":\"get /v2/customers/requirements\",\"title\":\"Get customer requirements\",\"description\":\"Preview the requirements a hypothetical customer of the given\\n`customerType` and jurisdiction would need to satisfy to enable the\\nrequested `capabilities`, without creating a customer record.\\nPartner onboarding UIs can use this to render the collection flow\\nbefore any customer state exists.\\n\\nToday this endpoint only previews the Terms of Service requirement:\\nthe response's `RequirementsMap` will only ever contain a `tos` key.\\nOther requirement families (PII / CDD inputs) are not yet available\\nthrough this endpoint; use `POST /v2/customers` or\\n`PUT /v2/customers/{customerId}` to discover those via\\n`Customer.requirements`.\\n\\nOnly `customerType: individual` customers resident in or citizens\\nof the US are currently supported; every other combination returns\\n`400 invalid_request`.\\n\",\"href\":\"/api-reference/v2/rest-api/customers/get-customer-requirements\"},{\"openapi\":\"get /v2/customers\",\"title\":\"List customers\",\"description\":\"List all customers. The API will return all customers that the API Key has\\npermissions to access. Results are not returned in any guaranteed order.\\n\",\"href\":\"/api-reference/v2/rest-api/customers/list-customers\"},{\"openapi\":\"post /v2/customers\",\"title\":\"Create a customer\",\"description\":\"Create a new customer record. You can optionally request capabilities\\nand submit verification requirements in the same request.\\n\\nThis endpoint supports creating a customer with:\\n- Minimal data (customer type only)\\n- Capability requests\\n- KYC data submission\\n- Combined request for capability and required info for verification\\n\",\"href\":\"/api-reference/v2/rest-api/customers/create-a-customer\"},{\"openapi\":\"put /v2/customers/{customerId}\",\"title\":\"Update a customer\",\"description\":\"Update customer information and/or request capability changes.\\nThis endpoint supports partial updates. Provide only the fields you wish to change.\\n\",\"href\":\"/api-reference/v2/rest-api/customers/update-a-customer\"},{\"openapi\":\"delete /v2/customers/{customerId}\",\"title\":\"Delete a customer\",\"description\":\"Initiates deletion of the customer and all associated data. This operation\\nis idempotent — repeated calls for an already-deleted customer return 204.\\nA 404 is returned only when no customer with the given ID exists for the\\ncaller's entity.\\n\",\"href\":\"/api-reference/v2/rest-api/customers/delete-a-customer\"},{\"group\":\"Webhooks\",\"pages\":[{\"openapi\":\"webhook customersCustomerDeleted\",\"sidebarTitle\":\"Customer deleted\",\"title\":\"Customer deleted\",\"description\":\"Triggered when the `customers.customer.deleted` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-customers-customer-deleted\"},{\"openapi\":\"webhook customersCapabilityChanged\",\"sidebarTitle\":\"Customers capability changed\",\"title\":\"Customers capability changed\",\"description\":\"Triggered when the `customers.capability.changed` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-customers-capability-changed\"},{\"openapi\":\"webhook customersRequirementChanged\",\"sidebarTitle\":\"Customers requirement changed\",\"title\":\"Customers requirement changed\",\"description\":\"Triggered when the `customers.requirement.changed` webhook event is emitted. Your API will receive a POST request at the webhook URL you configured.\",\"href\":\"/api-reference/v2/webhooks/webhook-customers-requirement-changed\"}]}]},{\"group\":\"Health\",\"tag\":\"Beta\",\"pages\":[{\"title\":\"Health\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/api-reference/v2/rest-api/health/health\"},{\"openapi\":\"webhook healthMaintenanceCanceled\",\"sidebarTitle\":\"Maintenance canceled\",\"title\":\"Maintenance canceled\",\"description\":\"Fires when a previously scheduled maintenance window is canceled before it starts.\",\"href\":\"/api-reference/v2/webhooks/webhook-health-maintenance-canceled\"},{\"openapi\":\"webhook healthMaintenanceCompleted\",\"sidebarTitle\":\"Maintenance completed\",\"title\":\"Maintenance completed\",\"description\":\"Fires when a maintenance window ends normally; the affected service's or operation's effective status is recomputed and returns to `operational`, unless an organic outage remains in progress, which continues to take priority.\",\"href\":\"/api-reference/v2/webhooks/webhook-health-maintenance-completed\"},{\"openapi\":\"webhook healthMaintenanceScheduled\",\"sidebarTitle\":\"Maintenance scheduled\",\"title\":\"Maintenance scheduled\",\"description\":\"Fires when a maintenance window is scheduled for a CDP service or operation, ahead of it starting. Subscribe for advance notice to plan around planned downtime.\",\"href\":\"/api-reference/v2/webhooks/webhook-health-maintenance-scheduled\"},{\"openapi\":\"webhook healthMaintenanceStarted\",\"sidebarTitle\":\"Maintenance started\",\"title\":\"Maintenance started\",\"description\":\"Fires when a previously scheduled maintenance window begins; the affected service's or operation's effective status is recomputed and reports `under_maintenance`, unless an organic outage is already in progress, which continues to take priority. Subscribe to react in real time when a dependency enters maintenance.\",\"href\":\"/api-reference/v2/webhooks/webhook-health-maintenance-started\"},{\"openapi\":\"webhook healthStatusUpdated\",\"sidebarTitle\":\"Service health updated\",\"title\":\"Service health updated\",\"description\":\"Fires whenever the operational status of a CDP service or operation changes — an outage begins, its severity changes, or it recovers to `operational`. Subscribe to react to CDP disruptions in real time.\",\"href\":\"/api-reference/v2/webhooks/webhook-health-status-updated\"}]},{\"group\":\"Webhooks\",\"pages\":[{\"title\":\"Webhooks\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/api-reference/v2/rest-api/webhooks/webhooks\"},{\"openapi\":\"get /v2/data/webhooks/subscriptions/{subscriptionId}\",\"title\":\"Get webhook subscription\",\"description\":\"Retrieve detailed information about a specific webhook subscription including\\nconfiguration, status, creation timestamp, and webhook signature secret.\\n\\n### Response Includes\\n- Subscription configuration and filters\\n- Target URL and custom headers\\n- Webhook signature secret for verification\\n- Creation timestamp and status\\n\",\"href\":\"/api-reference/v2/rest-api/webhooks/get-webhook-subscription\"},{\"openapi\":\"get /v2/data/webhooks/subscriptions/{subscriptionId}/events\",\"title\":\"List webhook subscription events\",\"description\":\"Retrieve webhook event delivery attempts for a specific subscription.\\nReturns event deliveries in descending order by creation time (newest first),\\nincluding delivery status, retry count, and response details.\\n\\n### Use Cases\\n- Debug webhook delivery failures and inspect response codes\\n- Monitor delivery status and retry counts\\n- Audit event delivery history for a subscription\\n- Verify that expected events were sent to webhook URLs\\n\\n### Filtering\\nUse optional query parameters to narrow results:\\n- `eventId` — find a specific event by ID\\n- `minCreatedAt` / `maxCreatedAt` — filter by time range\\n- `eventTypeNames` — filter by event type (comma-separated)\\n\\n**Note:** Results are limited to the 50 most recent events (newest first). No pagination is supported.\\n\",\"href\":\"/api-reference/v2/rest-api/webhooks/list-webhook-subscription-events\"},{\"openapi\":\"get /v2/data/webhooks/subscriptions\",\"title\":\"List webhook subscriptions\",\"description\":\"Retrieve a paginated list of webhook subscriptions for the authenticated project.\\nReturns subscriptions for all CDP product events (onchain, onramp/offramp, wallet, etc.)\\nin descending order by creation time.\\n\\n### Use Cases\\n- Monitor all active webhook subscriptions across CDP products\\n- Audit webhook configurations\\n- Manage subscription lifecycle\\n\",\"href\":\"/api-reference/v2/rest-api/webhooks/list-webhook-subscriptions\"},{\"openapi\":\"post /v2/data/webhooks/subscriptions\",\"title\":\"Create webhook subscription\",\"description\":\"Subscribe to real-time events across CDP products. A webhook subscription provides a `targetURL` and other relevant endpoint configuration to enable receiving webhooks when events occur.\\n\\nAn entity can have up to 100 webhook subscriptions. Once this limit is reached, new webhook subscription creation requests return a `400` error with `errorType: subscription_limit_exceeded`.\\n\\n### Webhook Signature Verification\\n\\nAll webhooks include an HMAC-SHA256 signed header for security. The signature is signed with the secret that is returned in the `secret` field when creating a subscription.\\n\\nDo not lose the secret, as you will not be able to recreate it. If you lose the secret, you will need to create a new subscription.\\n\\nSee the [verification guide](https://docs.cdp.coinbase.com/onramp-\u0026-offramp/webhooks#webhook-signature-verification) for implementation details.\\n\",\"href\":\"/api-reference/v2/rest-api/webhooks/create-webhook-subscription\"},{\"openapi\":\"put /v2/data/webhooks/subscriptions/{subscriptionId}\",\"title\":\"Update webhook subscription\",\"description\":\"Update an existing webhook subscription's configuration including\\nevent types, target URL, filtering criteria, and enabled status.\\nAll required fields must be provided, even if they are not being changed.\\n\\n### Common Updates\\n- Change target URL or headers\\n- Add/remove event type filters\\n- Update multi-label filtering criteria\\n- Enable/disable subscription\\n\",\"href\":\"/api-reference/v2/rest-api/webhooks/update-webhook-subscription\"},{\"openapi\":\"delete /v2/data/webhooks/subscriptions/{subscriptionId}\",\"title\":\"Delete webhook subscription\",\"description\":\"Permanently delete a webhook subscription and stop all event deliveries.\\nThis action cannot be undone.\\n\\n### Important Notes\\n- All webhook deliveries will cease immediately\\n- Subscription cannot be recovered after deletion\\n- Consider disabling instead of deleting for temporary pauses\\n\",\"href\":\"/api-reference/v2/rest-api/webhooks/delete-webhook-subscription\"}]}]}]},{\"dropdown\":\"Coinbase Advanced Trade API\",\"icon\":\"https://mintlify-assets.b-cdn.net/advancedTradeProduct-1.svg\",\"groups\":[{\"group\":\"Get Started\",\"pages\":[{\"title\":\"Coinbase Advanced Trade API\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/api-reference/advanced-trade-api/rest-api/introduction\"}]},{\"group\":\"Spot \u0026 US Derivatives - REST\",\"pages\":[{\"group\":\"Accounts\",\"pages\":[{\"title\":\"Get Account\",\"openapi\":\"GET /api/v3/brokerage/accounts/{account_uuid}\",\"description\":\"Get a list of information about an account, given an account UUID.\",\"href\":\"/api-reference/advanced-trade-api/rest-api/accounts/get-account\"},{\"title\":\"List Accounts\",\"openapi\":\"GET /api/v3/brokerage/accounts\",\"description\":\"Get a list of authenticated accounts for the current user.\",\"href\":\"/api-reference/advanced-trade-api/rest-api/accounts/list-accounts\"}]},{\"group\":\"Convert\",\"pages\":[{\"title\":\"Commit Convert Trade\",\"openapi\":\"POST /api/v3/brokerage/convert/trade/{trade_id}\",\"description\":\"Commits a convert trade with a specified trade id, source account, and target account\",\"href\":\"/api-reference/advanced-trade-api/rest-api/convert/commit-convert-trade\"},{\"title\":\"Create Convert Quote\",\"openapi\":\"POST /api/v3/brokerage/convert/quote\",\"description\":\"Create a convert quote with a specified source account, target account, and amount. Convert is applicable for USDC-USD, PYUSD-USD, EURC-EUR conversion, and PYUSD-USDC conversion\",\"href\":\"/api-reference/advanced-trade-api/rest-api/convert/create-convert-quote\"},{\"title\":\"Get Convert Trade\",\"openapi\":\"GET  /api/v3/brokerage/convert/trade/{trade_id}\",\"description\":\"Gets a list of information about a convert trade with a specified trade id, source account, and target account\",\"href\":\"/api-reference/advanced-trade-api/rest-api/convert/get-convert-trade\"}]},{\"group\":\"Data API\",\"pages\":[{\"title\":\"Get API Key Permissions\",\"openapi\":\"GET /api/v3/brokerage/key_permissions\",\"description\":\"Get information about your CDP API key permissions\",\"href\":\"/api-reference/advanced-trade-api/rest-api/data-api/get-api-key-permissions\"}]},{\"group\":\"Fees\",\"pages\":[{\"title\":\"Get Transaction Summary\",\"openapi\":\"GET /api/v3/brokerage/transaction_summary\",\"description\":\"Get a summary of transactions with fee tiers, total volume, and fees.\",\"href\":\"/api-reference/advanced-trade-api/rest-api/fees/get-transaction-summary\"}]},{\"group\":\"US Derivatives\",\"pages\":[{\"title\":\"Cancel Pending US Derivatives Sweep\",\"openapi\":\"DELETE /api/v3/brokerage/cfm/sweeps\",\"description\":\"Cancel the pending sweep of funds from FCM wallet to USD Spot wallet\",\"href\":\"/api-reference/advanced-trade-api/rest-api/futures/cancel-pending-futures-sweep\"},{\"title\":\"Get Current Margin Window\",\"openapi\":\"GET /api/v3/brokerage/cfm/intraday/current_margin_window\",\"description\":\"Get the futures current margin window\",\"href\":\"/api-reference/advanced-trade-api/rest-api/futures/get-current-margin-window\"},{\"title\":\"Get US Derivatives Balance Summary\",\"openapi\":\"GET /api/v3/brokerage/cfm/balance_summary\",\"description\":\"Get a summary of balances for CFM trading\",\"href\":\"/api-reference/advanced-trade-api/rest-api/futures/get-futures-balance-summary\"},{\"title\":\"Get US Derivatives Position\",\"openapi\":\"GET  /api/v3/brokerage/cfm/positions/{product_id}\",\"description\":\"Get positions for a specific CFM product\",\"href\":\"/api-reference/advanced-trade-api/rest-api/futures/get-futures-position\"},{\"title\":\"Get Intraday Margin Setting\",\"openapi\":\"GET /api/v3/brokerage/cfm/intraday/margin_setting\",\"description\":\"Get the futures intraday margin setting\",\"href\":\"/api-reference/advanced-trade-api/rest-api/futures/get-intraday-margin-setting\"},{\"title\":\"List US Derivatives Positions\",\"openapi\":\"GET  /api/v3/brokerage/cfm/positions\",\"description\":\"Get a list of positions in CFM products\",\"href\":\"/api-reference/advanced-trade-api/rest-api/futures/list-futures-positions\"},{\"title\":\"List US Derivatives Sweeps\",\"openapi\":\"GET /api/v3/brokerage/cfm/sweeps\",\"description\":\"Get pending and processing sweeps of funds from FCM wallet to USD Spot wallet\",\"href\":\"/api-reference/advanced-trade-api/rest-api/futures/list-futures-sweeps\"},{\"title\":\"Schedule US Derivatives Sweep\",\"openapi\":\"POST /api/v3/brokerage/cfm/sweeps/schedule\",\"description\":\"Schedules a sweep of funds from FCM wallet to USD Spot wallet\",\"href\":\"/api-reference/advanced-trade-api/rest-api/futures/schedule-futures-sweep\"},{\"title\":\"Set Intraday Margin Setting\",\"openapi\":\"POST /api/v3/brokerage/cfm/intraday/margin_setting\",\"description\":\"Set the futures intraday margin setting\",\"href\":\"/api-reference/advanced-trade-api/rest-api/futures/set-intraday-margin-settings\"}]},{\"group\":\"Orders\",\"pages\":[{\"title\":\"Cancel Orders\",\"openapi\":\"POST  /api/v3/brokerage/orders/batch_cancel\",\"description\":\"Initiate cancel requests for one or more orders.\\n\\n**Equities:** Equity orders use the same `order_ids` request and per-order result format as other products. Do not include `equity_order_metadata` when canceling an order.\",\"href\":\"/api-reference/advanced-trade-api/rest-api/orders/cancel-order\"},{\"title\":\"Close Position\",\"openapi\":\"POST /api/v3/brokerage/orders/close_position\",\"description\":\"Places an order to close any open positions for a specified `product_id`.\",\"href\":\"/api-reference/advanced-trade-api/rest-api/orders/close-position\"},{\"title\":\"Create Order\",\"openapi\":\"POST /api/v3/brokerage/orders\",\"description\":\"Create an order with a specified `product_id`, `side`, and `order_configuration`.\\n\\n**Equities:** Use the canonical `product_id` returned by the Products API, not the display ticker. Include `equity_order_metadata` to select the trading session and time in force. Use `market_market_ioc` with `MARKET_GFD` for market orders, which are supported only during the normal session. Use `limit_limit_gtc` with `LIMIT_GFD` or `LIMIT_GTC` for limit orders. In pre-market, after-hours, overnight, or multi-session trading, specify a positive whole-share `base_size`; `quote_size` and fractional sizing are not supported. Attached orders are not supported for equities.\",\"href\":\"/api-reference/advanced-trade-api/rest-api/orders/create-order\"},{\"title\":\"Edit Order\",\"openapi\":\"POST /api/v3/brokerage/orders/edit\",\"description\":\"Edit an order with a specified new `size`, or new `price`.\",\"href\":\"/api-reference/advanced-trade-api/rest-api/orders/edit-order\"},{\"title\":\"Edit Order Preview\",\"openapi\":\"POST /api/v3/brokerage/orders/edit_preview\",\"description\":\"Preview an edit order request with a specified new `size`, or new `price`.\",\"href\":\"/api-reference/advanced-trade-api/rest-api/orders/edit-order-preview\"},{\"title\":\"Get Order\",\"openapi\":\"GET  /api/v3/brokerage/orders/historical/{order_id}\",\"description\":\"Get a single order by order ID.\\n\\n**Equities:** The response identifies equity orders with `product_type: EQUITY`. Use `displayed_order_config` for the equity time in force and `equity_trading_session` for the session in which the order is eligible to execute.\",\"href\":\"/api-reference/advanced-trade-api/rest-api/orders/get-order\"},{\"title\":\"List Fills\",\"openapi\":\"GET /api/v3/brokerage/orders/historical/fills\",\"description\":\"Get a list of fills filtered by optional query parameters (`product_ids`, `order_ids`, etc.).\\n\\n**Equities:** Pass `EQUITY` in `product_types` to return only equity fills. When filtering by product, use the canonical `product_id` rather than the display ticker.\",\"href\":\"/api-reference/advanced-trade-api/rest-api/orders/list-fills\"},{\"title\":\"List Orders\",\"openapi\":\"GET /api/v3/brokerage/orders/historical/batch\",\"description\":\"Get a list of orders filtered by optional query parameters (`product_ids`, `order_status`, etc.).\\n\\n**Equities:** Set `product_type` to `EQUITY` to return only equity orders. Each equity order includes its time in force in `displayed_order_config` and execution session in `equity_trading_session`.\",\"href\":\"/api-reference/advanced-trade-api/rest-api/orders/list-orders\"},{\"title\":\"Preview Order\",\"openapi\":\"POST /api/v3/brokerage/orders/preview\",\"description\":\"Preview an order.\",\"href\":\"/api-reference/advanced-trade-api/rest-api/orders/preview-orders\"}]},{\"group\":\"Payment Methods\",\"pages\":[{\"title\":\"Get Payment Method\",\"openapi\":\"GET /api/v3/brokerage/payment_methods/{payment_method_id}\",\"description\":\"Get information about a payment method for the current user.\",\"href\":\"/api-reference/advanced-trade-api/rest-api/payment-methods/get-payment-method\"},{\"title\":\"List Payment Methods\",\"openapi\":\"GET /api/v3/brokerage/payment_methods\",\"description\":\"Get a list of payment methods for the current user.\",\"href\":\"/api-reference/advanced-trade-api/rest-api/payment-methods/list-payment-methods\"}]},{\"group\":\"INTX (deprecated)\",\"pages\":[{\"title\":\"Allocate Portfolio\",\"openapi\":\"POST  /api/v3/brokerage/intx/allocate\",\"description\":\"Allocate portfolio funds to a sub-portfolio on Intx Portfolio\",\"href\":\"/api-reference/advanced-trade-api/rest-api/perpetuals/allocate-portfolio\"},{\"title\":\"Get Perpetuals Portfolio Summary\",\"openapi\":\"GET  /api/v3/brokerage/intx/portfolio/{portfolio_uuid}\",\"description\":\"Get a summary of your Perpetuals portfolio\",\"href\":\"/api-reference/advanced-trade-api/rest-api/perpetuals/get-perpetuals-portfolio-summary\"},{\"title\":\"Get Perpetuals Position\",\"openapi\":\"GET /api/v3/brokerage/intx/positions/{portfolio_uuid}/{symbol}\",\"description\":\"Get a specific open position on Intx\",\"href\":\"/api-reference/advanced-trade-api/rest-api/perpetuals/get-perpetuals-position\"},{\"title\":\"Get Portfolios Balances\",\"openapi\":\"GET  /api/v3/brokerage/intx/balances/{portfolio_uuid}\",\"description\":\"Get a list of asset balances on Intx for a given Portfolio\",\"href\":\"/api-reference/advanced-trade-api/rest-api/perpetuals/get-portfolio-balances\"},{\"title\":\"List Perpetuals Positions\",\"openapi\":\"GET /api/v3/brokerage/intx/positions/{portfolio_uuid}\",\"description\":\"Get a list of open positions in your Perpetuals portfolio\",\"href\":\"/api-reference/advanced-trade-api/rest-api/perpetuals/list-perpetuals-positions\"},{\"title\":\"Opt In or Out of Multi Asset Collateral\",\"openapi\":\"POST /api/v3/brokerage/intx/multi_asset_collateral\",\"description\":\"Enable or Disable Multi Asset Collateral for a given Portfolio\",\"href\":\"/api-reference/advanced-trade-api/rest-api/perpetuals/opt-in-or-out\"}]},{\"group\":\"Portfolios\",\"pages\":[{\"title\":\"Create Portfolio\",\"openapi\":\"POST /api/v3/brokerage/portfolios\",\"description\":\"Create a portfolio.\",\"href\":\"/api-reference/advanced-trade-api/rest-api/portfolios/create-portfolio\"},{\"title\":\"Delete Portfolio\",\"openapi\":\"DELETE /api/v3/brokerage/portfolios/{portfolio_uuid}\",\"description\":\"Delete portfolio.\",\"href\":\"/api-reference/advanced-trade-api/rest-api/portfolios/delete-portfolio\"},{\"title\":\"Edit Portfolio\",\"openapi\":\"PUT  /api/v3/brokerage/portfolios/{portfolio_uuid}\",\"description\":\"Edit a portfolio.\",\"href\":\"/api-reference/advanced-trade-api/rest-api/portfolios/edit-portfolio\"},{\"title\":\"Get Portfolio Breakdown\",\"openapi\":\"GET  /api/v3/brokerage/portfolios/{portfolio_uuid}\",\"description\":\"Get the breakdown of a portfolio.\",\"href\":\"/api-reference/advanced-trade-api/rest-api/portfolios/get-portfolio-breakdown\"},{\"title\":\"List Portfolios\",\"openapi\":\"GET /api/v3/brokerage/portfolios\",\"description\":\"Get all portfolios of a user.\",\"href\":\"/api-reference/advanced-trade-api/rest-api/portfolios/list-portfolios\"},{\"title\":\"Move Portfolio Funds\",\"openapi\":\"POST /api/v3/brokerage/portfolios/move_funds\",\"description\":\"Move funds between portfolios.\",\"href\":\"/api-reference/advanced-trade-api/rest-api/portfolios/move-portfolios-funds\"}]},{\"group\":\"Products\",\"pages\":[{\"title\":\"Get Best Bid/Ask\",\"openapi\":\"GET /api/v3/brokerage/best_bid_ask\",\"description\":\"Get the best bid/ask for all products. A subset of all products can be returned instead by using the product_ids input.\",\"href\":\"/api-reference/advanced-trade-api/rest-api/products/get-best-bid-ask\"},{\"title\":\"Get Market Trades\",\"openapi\":\"GET  /api/v3/brokerage/products/{product_id}/ticker\",\"description\":\"Get snapshot information by product ID about the last trades (ticks) and best bid/ask.\",\"href\":\"/api-reference/advanced-trade-api/rest-api/products/get-market-trades\"},{\"title\":\"Get Product\",\"openapi\":\"GET /api/v3/brokerage/products/{product_id}\",\"description\":\"Get information on a single product by product ID.\\n\\n**Equities:** Use the canonical `product_id` returned by the Products API, not the display ticker. Equity responses include `equity_product_details`, which describes the security, current trading session, order-size permissions, and halt or liquidate-only state.\",\"href\":\"/api-reference/advanced-trade-api/rest-api/products/get-product\"},{\"title\":\"Get Product Book\",\"openapi\":\"GET /api/v3/brokerage/product_book\",\"description\":\"Get a list of bids/asks for a single product. The amount of detail shown can be customized with the limit parameter.\",\"href\":\"/api-reference/advanced-trade-api/rest-api/products/get-product-book\"},{\"title\":\"Get Product Candles\",\"openapi\":\"GET /api/v3/brokerage/products/{product_id}/candles\",\"description\":\"Get rates for a single product by product ID, grouped in buckets.\",\"href\":\"/api-reference/advanced-trade-api/rest-api/products/get-product-candles\"},{\"title\":\"List Products\",\"openapi\":\"GET /api/v3/brokerage/products\",\"description\":\"Get a list of the available currency pairs for trading.\",\"href\":\"/api-reference/advanced-trade-api/rest-api/products/list-products\"}]},{\"group\":\"Public\",\"pages\":[{\"title\":\"Get Public Market Trades\",\"openapi\":\"GET /api/v3/brokerage/market/products/{product_id}/ticker\",\"description\":\"Get snapshot information by product ID about the last trades (ticks) and best bid/ask.\",\"href\":\"/api-reference/advanced-trade-api/rest-api/public/get-public-market-trades\"},{\"title\":\"Get Public Product\",\"openapi\":\"GET /api/v3/brokerage/market/products/{product_id}\",\"description\":\"Get information on a single product by product ID.\",\"href\":\"/api-reference/advanced-trade-api/rest-api/public/get-public-product\"},{\"title\":\"Get Public Product Book\",\"openapi\":\"GET /api/v3/brokerage/market/product_book\",\"description\":\"Get a list of bids/asks for a single product. The amount of detail shown can be customized with the limit parameter.\",\"href\":\"/api-reference/advanced-trade-api/rest-api/public/get-public-product-book\"},{\"title\":\"Get Public Product Candles\",\"openapi\":\"GET /api/v3/brokerage/market/products/{product_id}/candles\",\"description\":\"Get rates for a single product by product ID, grouped in buckets.\",\"href\":\"/api-reference/advanced-trade-api/rest-api/public/get-public-product-candles\"},{\"title\":\"Get Server Time\",\"openapi\":\"GET /api/v3/brokerage/time\",\"description\":\"Get the current time from the Coinbase Advanced API.\",\"href\":\"/api-reference/advanced-trade-api/rest-api/public/get-server-time\"},{\"title\":\"List Public Products\",\"openapi\":\"GET /api/v3/brokerage/market/products\",\"description\":\"Get a list of the available currency pairs for trading.\",\"href\":\"/api-reference/advanced-trade-api/rest-api/public/list-public-products\"}]}]},{\"group\":\"Spot \u0026 US Derivatives - WS Streams\",\"pages\":[{\"group\":\"Market Data\",\"pages\":[{\"title\":\"Heartbeats\",\"asyncapi\":\"api-reference/advanced-trade-api/advanced-trade-asyncapi.json heartbeats\",\"description\":\"Real-time server pings (every second) to keep all connections open. Each\\nmessage carries a heartbeat_counter so clients can detect missed messages.\\nNo products or authentication required.\\n\",\"href\":\"/api-reference/advanced-trade-api/websocket/heartbeats\"},{\"title\":\"Candles\",\"asyncapi\":\"api-reference/advanced-trade-api/advanced-trade-asyncapi.json candles\",\"description\":\"Real-time updates on product candles, grouped into five-minute buckets,\\nwith updates every second.\\n\",\"href\":\"/api-reference/advanced-trade-api/websocket/candles\"},{\"title\":\"Product status\",\"asyncapi\":\"api-reference/advanced-trade-api/advanced-trade-asyncapi.json status\",\"description\":\"Sends all products and currencies on a preset interval. Provide the\\nproduct_ids you want status for.\\n\",\"href\":\"/api-reference/advanced-trade-api/websocket/product-status\"},{\"title\":\"Ticker\",\"asyncapi\":\"api-reference/advanced-trade-api/advanced-trade-asyncapi.json ticker\",\"description\":\"Real-time price updates every time a match happens. Batches updates during\\ncascading matches to reduce bandwidth.\\n\",\"href\":\"/api-reference/advanced-trade-api/websocket/ticker\"},{\"title\":\"Ticker (batched)\",\"asyncapi\":\"api-reference/advanced-trade-api/advanced-trade-asyncapi.json ticker_batch\",\"description\":\"Latest price updates every 5000 milliseconds (5 seconds) when there is a\\nchange. Same schema as the ticker channel except the envelope channel is\\nticker_batch and best bid / best ask fields are not provided.\\n\",\"href\":\"/api-reference/advanced-trade-api/websocket/ticker-batch\"},{\"title\":\"Level 2 order book\",\"asyncapi\":\"api-reference/advanced-trade-api/advanced-trade-asyncapi.json level2\",\"description\":\"Guarantees delivery of all updates and is the easiest way to keep an order\\nbook snapshot in sync. Subscribe with channel level2; received messages\\ncarry channel l2_data. new_quantity is the updated size at a price level\\n(not a delta); a value of \\\"0\\\" means the level can be removed.\\n\",\"href\":\"/api-reference/advanced-trade-api/websocket/level2\"},{\"title\":\"Market trades\",\"asyncapi\":\"api-reference/advanced-trade-api/advanced-trade-asyncapi.json market_trades\",\"description\":\"Real-time trades for the subscribed products. Updates are collected over\\nthe last 250 ms and sent together, so an update may contain one or many\\ntrades.\\n\",\"href\":\"/api-reference/advanced-trade-api/websocket/market-trades\"}]},{\"group\":\"Private\",\"pages\":[{\"title\":\"User orders and positions\",\"asyncapi\":\"api-reference/advanced-trade-api/advanced-trade-asyncapi.json user\",\"description\":\"Authenticated. Sends updates on a user's open orders and current\\npositions, including all subsequent updates. This is the only channel that\\naccepts `-USDC` product IDs.\\n\\nOne connection per user. `product_ids` is optional; omit it for all products.\\nTo add products, unsubscribe and open a new connection with the expanded list.\\n\\nOpen orders arrive in the snapshot batched by 50. The first message with fewer\\nthan 50 orders is the last of that snapshot.\\n\",\"href\":\"/api-reference/advanced-trade-api/websocket/user\"},{\"title\":\"Futures balance summary\",\"asyncapi\":\"api-reference/advanced-trade-api/advanced-trade-asyncapi.json futures_balance_summary\",\"description\":\"Authenticated. Sends updates on all of a user's US futures balances,\\nincluding subsequent updates. No products required.\\n\",\"href\":\"/api-reference/advanced-trade-api/websocket/futures-balance-summary\"}]}]},{\"group\":\"Global Derivatives - REST / WS\",\"pages\":[{\"group\":\"Trading\",\"pages\":[{\"title\":\"private/buy\",\"description\":\"Places a buy order for an instrument. Supports various order types including limit, market, stop, and advanced order types (stop-limit, take-profit, take-profit-limit, trailing-stop, etc.).\\n\\nYou can specify order parameters such as price, quantity, time-in-force, post-only, reduce-only, and trigger conditions. Orders can be labeled for easier management and tracking.\\n\\n**Note:** For spot orders routed to Coinbase Exchange, fills come back asynchronously. It is recommended to receive fills from the `user.trades` channel.\\n\\n**📖 Related Article:** [Order Management Best Practices](https://docs.deribit.com/articles/order-management-best-practices)\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fbuy)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/buy\",\"instrument_name\",\"amount\",\"contracts\",\"type\",\"label\",\"price\",\"time_in_force\",\"display_amount\",\"post_only\",\"reject_post_only\",\"reduce_only\",\"trigger_price\",\"trigger_offset\",\"trigger\",\"advanced\",\"mmp\",\"valid_until\",\"linked_order_type\",\"trigger_fill_condition\",\"otoco_config\",\"order\",\"trades\",\"order_id\",\"order_state\",\"order_type\",\"original_order_type\",\"is_rebalance\",\"is_liquidation\",\"creation_timestamp\",\"last_update_timestamp\",\"starbase_last_update_timestamp\",\"starbase_client_order_id\",\"direction\",\"api\",\"web\",\"mobile\",\"refresh_amount\",\"filled_amount\",\"average_price\",\"implv\",\"usd\",\"triggered\",\"trigger_reference_price\",\"block_trade\",\"risk_reducing\",\"replaced\",\"auto_replaced\",\"quote\",\"mmp_group\",\"quote_set_id\",\"quote_id\",\"trigger_order_id\",\"combo_order_id\",\"starbase_order_id\",\"app_name\",\"mmp_cancelled\",\"cancel_reason\",\"oto_order_ids\",\"oco_ref\",\"primary_order_id\",\"is_secondary_oto\",\"is_primary_otoco\",\"trade_id\",\"trade_seq\",\"timestamp\",\"starbase_timestamp\",\"matching_id\",\"tick_direction\",\"index_price\",\"iv\",\"underlying_price\",\"liquidation\",\"liquidity\",\"fee\",\"fee_currency\",\"state\",\"block_trade_id\",\"block_trade_leg_count\",\"block_rfq_id\",\"block_rfq_quote_id\",\"profit_loss\",\"mark_price\",\"legs\",\"combo_id\",\"combo_trade_id\",\"starbase_match_id\",\"trade_allocations\",\"user_id\",\"client_info\",\"client_id\",\"client_link_id\",\"name\"],\"og:title\":\"private/buy\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/buy\",\"href\":\"/api-reference/trading/private-buy\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/cancel\",\"description\":\"Cancels a specific order identified by its order ID. The order must be open (not yet filled or cancelled) to be cancelled successfully.\\n\\nOnce cancelled, the order is removed from the order book and cannot be restored. Any unfilled portion of the order will be cancelled.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fcancel)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/cancel\",\"order_id\",\"order_state\",\"order_type\",\"original_order_type\",\"time_in_force\",\"is_rebalance\",\"is_liquidation\",\"instrument_name\",\"creation_timestamp\",\"last_update_timestamp\",\"starbase_last_update_timestamp\",\"starbase_client_order_id\",\"direction\",\"price\",\"label\",\"post_only\",\"reject_post_only\",\"reduce_only\",\"api\",\"web\",\"mobile\",\"refresh_amount\",\"display_amount\",\"amount\",\"contracts\",\"filled_amount\",\"average_price\",\"advanced\",\"implv\",\"usd\",\"triggered\",\"trigger\",\"trigger_price\",\"trigger_offset\",\"trigger_reference_price\",\"block_trade\",\"mmp\",\"risk_reducing\",\"replaced\",\"auto_replaced\",\"quote\",\"mmp_group\",\"quote_set_id\",\"quote_id\",\"trigger_order_id\",\"combo_order_id\",\"starbase_order_id\",\"app_name\",\"mmp_cancelled\",\"cancel_reason\",\"oto_order_ids\",\"trigger_fill_condition\",\"oco_ref\",\"primary_order_id\",\"is_secondary_oto\",\"is_primary_otoco\"],\"og:title\":\"private/cancel\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/cancel\",\"href\":\"/api-reference/trading/private-cancel\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/cancel_all\",\"description\":\"Cancels all open orders and trigger orders for the authenticated account across all currencies and instrument kinds. This is a bulk cancellation operation useful for quickly clearing all active orders.\\n\\nUse the `detailed` parameter to receive a list of all cancelled orders. The `freeze_quotes` parameter can be used to freeze quotes instead of cancelling them.\\n\\n**Note:** This operation cannot be undone. All open orders will be permanently cancelled.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fcancel_all)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/cancel_all\",\"detailed\",\"freeze_quotes\"],\"og:title\":\"private/cancel_all\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/cancel_all\",\"href\":\"/api-reference/trading/private-cancel_all\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/cancel_all_by_currency\",\"description\":\"Cancels all open orders for a specific currency. This is useful for quickly clearing all orders across multiple instruments in a currency.\\n\\nOrders can be optionally filtered by instrument kind (future, option, etc.) and/or order type (limit, market, stop, etc.). Use the `detailed` parameter to receive a list of all cancelled orders.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fcancel_all_by_currency)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/cancel_all_by_currency\",\"currency\",\"kind\",\"type\",\"detailed\",\"freeze_quotes\"],\"og:title\":\"private/cancel_all_by_currency\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/cancel_all_by_currency\",\"href\":\"/api-reference/trading/private-cancel_all_by_currency\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/cancel_all_by_currency_pair\",\"description\":\"Cancels all open orders for a specific currency pair. This is useful for quickly clearing all orders across instruments in a currency pair.\\n\\nOrders can be optionally filtered by instrument kind (future, option, etc.) and/or order type (limit, market, stop, etc.). Use the `detailed` parameter to receive a list of all cancelled orders.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fcancel_all_by_currency_pair)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/cancel_all_by_currency_pair\",\"currency_pair\",\"kind\",\"type\",\"detailed\",\"freeze_quotes\"],\"og:title\":\"private/cancel_all_by_currency_pair\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/cancel_all_by_currency_pair\",\"href\":\"/api-reference/trading/private-cancel_all_by_currency_pair\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/cancel_all_by_instrument\",\"description\":\"Cancels all open orders for a specific instrument. This is useful for quickly clearing all orders for a single instrument.\\n\\nOrders can be optionally filtered by order type (limit, market, stop, etc.). Use the `detailed` parameter to receive a list of all cancelled orders. The `include_combos` parameter can be used to include combo orders in the cancellation.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fcancel_all_by_instrument)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/cancel_all_by_instrument\",\"instrument_name\",\"type\",\"detailed\",\"include_combos\",\"freeze_quotes\"],\"og:title\":\"private/cancel_all_by_instrument\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/cancel_all_by_instrument\",\"href\":\"/api-reference/trading/private-cancel_all_by_instrument\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/cancel_all_by_kind_or_type\",\"description\":\"Cancels all open orders in one or more currencies, optionally filtered by instrument kind and/or order type. This provides flexible bulk cancellation across multiple currencies.\\n\\nSpecify one or more currencies, and optionally filter by instrument kind (future, option, etc.) and/or order type (limit, market, stop, etc.). Use the `detailed` parameter to receive a list of all cancelled orders.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fcancel_all_by_kind_or_type)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/cancel_all_by_kind_or_type\",\"currency\",\"kind\",\"type\",\"detailed\",\"freeze_quotes\"],\"og:title\":\"private/cancel_all_by_kind_or_type\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/cancel_all_by_kind_or_type\",\"href\":\"/api-reference/trading/private-cancel_all_by_kind_or_type\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/cancel_by_label\",\"description\":\"Cancels all orders (including trigger orders) that have a specific label. This is useful for managing groups of related orders that share the same label.\\n\\nOrders can be cancelled across all currencies or filtered to a specific currency. When cancelling by currency, the currency queue is used for processing.\\n\\n**Rate Limits:** When called without the `currency` parameter, this method is subject to `cancel_all` rate limits. Different rate limit values may apply for per-currency cancels versus calls without providing the currency parameter.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fcancel_by_label)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/cancel_by_label\",\"label\",\"currency\"],\"og:title\":\"private/cancel_by_label\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/cancel_by_label\",\"href\":\"/api-reference/trading/private-cancel_by_label\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/close_position\",\"description\":\"Places a reduce-only order to close an existing position. Reduce-only orders can only reduce or close a position; they cannot open a new position or increase an existing one.\\n\\nYou can specify whether to use a market or limit order. If using a limit order, provide the price. The order will automatically be set to reduce-only to ensure it only closes the position.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fclose_position)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/close_position\",\"instrument_name\",\"type\",\"price\",\"order\",\"trades\",\"order_id\",\"order_state\",\"order_type\",\"original_order_type\",\"time_in_force\",\"is_rebalance\",\"is_liquidation\",\"creation_timestamp\",\"last_update_timestamp\",\"starbase_last_update_timestamp\",\"starbase_client_order_id\",\"direction\",\"label\",\"post_only\",\"reject_post_only\",\"reduce_only\",\"api\",\"web\",\"mobile\",\"refresh_amount\",\"display_amount\",\"amount\",\"contracts\",\"filled_amount\",\"average_price\",\"advanced\",\"implv\",\"usd\",\"triggered\",\"trigger\",\"trigger_price\",\"trigger_offset\",\"trigger_reference_price\",\"block_trade\",\"mmp\",\"risk_reducing\",\"replaced\",\"auto_replaced\",\"quote\",\"mmp_group\",\"quote_set_id\",\"quote_id\",\"trigger_order_id\",\"combo_order_id\",\"starbase_order_id\",\"app_name\",\"mmp_cancelled\",\"cancel_reason\",\"oto_order_ids\",\"trigger_fill_condition\",\"oco_ref\",\"primary_order_id\",\"is_secondary_oto\",\"is_primary_otoco\",\"trade_id\",\"trade_seq\",\"timestamp\",\"starbase_timestamp\",\"matching_id\",\"tick_direction\",\"index_price\",\"iv\",\"underlying_price\",\"liquidation\",\"liquidity\",\"fee\",\"fee_currency\",\"state\",\"block_trade_id\",\"block_trade_leg_count\",\"block_rfq_id\",\"block_rfq_quote_id\",\"profit_loss\",\"mark_price\",\"legs\",\"combo_id\",\"combo_trade_id\",\"starbase_match_id\",\"trade_allocations\",\"user_id\",\"client_info\",\"client_id\",\"client_link_id\",\"name\"],\"og:title\":\"private/close_position\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/close_position\",\"href\":\"/api-reference/trading/private-close_position\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/edit\",\"description\":\"Modifies an existing order by changing its price, amount, and/or other properties such as time-in-force, post-only, reduce-only, trigger conditions, or advanced order type.\\n\\nThe order is identified by its order ID. Only open orders can be edited. Changes take effect immediately and may result in the order being filled if the new price matches the market.\\n\\n**Note:** For spot orders routed to Coinbase Exchange, fills come back asynchronously. It is recommended to receive fills from the `user.trades` channel.\\n\\n**📖 Related Article:** [Order Management Best Practices](https://docs.deribit.com/articles/order-management-best-practices)\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fedit)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/edit\",\"order_id\",\"amount\",\"contracts\",\"price\",\"post_only\",\"reduce_only\",\"reject_post_only\",\"advanced\",\"trigger_price\",\"trigger_offset\",\"mmp\",\"valid_until\",\"display_amount\",\"order\",\"trades\",\"order_state\",\"order_type\",\"original_order_type\",\"time_in_force\",\"is_rebalance\",\"is_liquidation\",\"instrument_name\",\"creation_timestamp\",\"last_update_timestamp\",\"starbase_last_update_timestamp\",\"starbase_client_order_id\",\"direction\",\"label\",\"api\",\"web\",\"mobile\",\"refresh_amount\",\"filled_amount\",\"average_price\",\"implv\",\"usd\",\"triggered\",\"trigger\",\"trigger_reference_price\",\"block_trade\",\"risk_reducing\",\"replaced\",\"auto_replaced\",\"quote\",\"mmp_group\",\"quote_set_id\",\"quote_id\",\"trigger_order_id\",\"combo_order_id\",\"starbase_order_id\",\"app_name\",\"mmp_cancelled\",\"cancel_reason\",\"oto_order_ids\",\"trigger_fill_condition\",\"oco_ref\",\"primary_order_id\",\"is_secondary_oto\",\"is_primary_otoco\",\"trade_id\",\"trade_seq\",\"timestamp\",\"starbase_timestamp\",\"matching_id\",\"tick_direction\",\"index_price\",\"iv\",\"underlying_price\",\"liquidation\",\"liquidity\",\"fee\",\"fee_currency\",\"state\",\"block_trade_id\",\"block_trade_leg_count\",\"block_rfq_id\",\"block_rfq_quote_id\",\"profit_loss\",\"mark_price\",\"legs\",\"combo_id\",\"combo_trade_id\",\"starbase_match_id\",\"trade_allocations\",\"user_id\",\"client_info\",\"client_id\",\"client_link_id\",\"name\"],\"og:title\":\"private/edit\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/edit\",\"href\":\"/api-reference/trading/private-edit\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/edit_by_label\",\"description\":\"Modifies an order identified by its label. This method works only when there is exactly one open order with the specified label.\\n\\nYou can change the order's price, amount, and/or other properties such as time-in-force, post-only, reduce-only, trigger conditions, or advanced order type. Changes take effect immediately.\\n\\n**Note:** For spot orders routed to Coinbase Exchange, fills come back asynchronously. It is recommended to receive fills from the `user.trades` channel.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fedit_by_label)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/edit_by_label\",\"label\",\"instrument_name\",\"amount\",\"contracts\",\"price\",\"post_only\",\"reduce_only\",\"reject_post_only\",\"advanced\",\"trigger_price\",\"mmp\",\"valid_until\",\"order\",\"trades\",\"order_id\",\"order_state\",\"order_type\",\"original_order_type\",\"time_in_force\",\"is_rebalance\",\"is_liquidation\",\"creation_timestamp\",\"last_update_timestamp\",\"starbase_last_update_timestamp\",\"starbase_client_order_id\",\"direction\",\"api\",\"web\",\"mobile\",\"refresh_amount\",\"display_amount\",\"filled_amount\",\"average_price\",\"implv\",\"usd\",\"triggered\",\"trigger\",\"trigger_offset\",\"trigger_reference_price\",\"block_trade\",\"risk_reducing\",\"replaced\",\"auto_replaced\",\"quote\",\"mmp_group\",\"quote_set_id\",\"quote_id\",\"trigger_order_id\",\"combo_order_id\",\"starbase_order_id\",\"app_name\",\"mmp_cancelled\",\"cancel_reason\",\"oto_order_ids\",\"trigger_fill_condition\",\"oco_ref\",\"primary_order_id\",\"is_secondary_oto\",\"is_primary_otoco\",\"trade_id\",\"trade_seq\",\"timestamp\",\"starbase_timestamp\",\"matching_id\",\"tick_direction\",\"index_price\",\"iv\",\"underlying_price\",\"liquidation\",\"liquidity\",\"fee\",\"fee_currency\",\"state\",\"block_trade_id\",\"block_trade_leg_count\",\"block_rfq_id\",\"block_rfq_quote_id\",\"profit_loss\",\"mark_price\",\"legs\",\"combo_id\",\"combo_trade_id\",\"starbase_match_id\",\"trade_allocations\",\"user_id\",\"client_info\",\"client_id\",\"client_link_id\",\"name\"],\"og:title\":\"private/edit_by_label\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/edit_by_label\",\"href\":\"/api-reference/trading/private-edit_by_label\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/get_margins\",\"description\":\"Calculates margin requirements for a hypothetical order on a given instrument. Returns initial margin and maintenance margin for the specified instrument, quantity, and price.\\n\\nThis method is useful for estimating margin requirements before placing an order, helping to ensure sufficient funds are available and understanding the margin impact of potential trades.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fget_margins)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/get_margins\",\"instrument_name\",\"amount\",\"price\",\"buy\",\"sell\",\"buy_taker_fee\",\"buy_maker_fee\",\"sell_taker_fee\",\"sell_maker_fee\",\"min_price\",\"max_price\"],\"og:title\":\"private/get_margins\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/get_margins\",\"href\":\"/api-reference/trading/private-get_margins\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/get_max_order_size\",\"description\":\"Calculates maximum tradable order sizes (buy, sell, and reduce-only) for a future instrument based on current account available funds, position, and open orders.\\n\\nSupports hypothetical parameters (`leverage`, `price`, `taker_fee_rate`) to simulate order size capacity under target trading conditions. Requires Standard Margin model.\\n\\n \\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fget_max_order_size)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/get_max_order_size\",\"instrument_name\",\"subaccount_id\",\"isolated\",\"leverage\",\"taker_fee_rate\",\"price\"],\"og:title\":\"private/get_max_order_size\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/get_max_order_size\",\"href\":\"/api-reference/trading/private-get_max_order_size\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/get_open_orders\",\"description\":\"Retrieves a list of all open orders for the authenticated account across all currencies. Open orders are orders that have been placed but not yet filled or cancelled.\\n\\nResults can be filtered by instrument kind and order type. This method provides a comprehensive view of all active orders.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fget_open_orders)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/get_open_orders\",\"kind\",\"type\",\"order_id\",\"order_state\",\"order_type\",\"original_order_type\",\"time_in_force\",\"is_rebalance\",\"is_liquidation\",\"instrument_name\",\"creation_timestamp\",\"last_update_timestamp\",\"starbase_last_update_timestamp\",\"starbase_client_order_id\",\"direction\",\"price\",\"label\",\"post_only\",\"reject_post_only\",\"reduce_only\",\"api\",\"web\",\"mobile\",\"refresh_amount\",\"display_amount\",\"amount\",\"contracts\",\"filled_amount\",\"average_price\",\"advanced\",\"implv\",\"usd\",\"triggered\",\"trigger\",\"trigger_price\",\"trigger_offset\",\"trigger_reference_price\",\"block_trade\",\"mmp\",\"risk_reducing\",\"replaced\",\"auto_replaced\",\"quote\",\"mmp_group\",\"quote_set_id\",\"quote_id\",\"trigger_order_id\",\"combo_order_id\",\"starbase_order_id\",\"app_name\",\"mmp_cancelled\",\"cancel_reason\",\"oto_order_ids\",\"trigger_fill_condition\",\"oco_ref\",\"primary_order_id\",\"is_secondary_oto\",\"is_primary_otoco\"],\"og:title\":\"private/get_open_orders\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/get_open_orders\",\"href\":\"/api-reference/trading/private-get_open_orders\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/get_open_orders_by_currency\",\"description\":\"Retrieves a list of all open orders for a specific currency. Open orders are orders that have been placed but not yet filled or cancelled.\\n\\nResults can be filtered by instrument kind and order type. This method provides a view of all active orders within a currency.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fget_open_orders_by_currency)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/get_open_orders_by_currency\",\"currency\",\"kind\",\"type\",\"order_id\",\"order_state\",\"order_type\",\"original_order_type\",\"time_in_force\",\"is_rebalance\",\"is_liquidation\",\"instrument_name\",\"creation_timestamp\",\"last_update_timestamp\",\"starbase_last_update_timestamp\",\"starbase_client_order_id\",\"direction\",\"price\",\"label\",\"post_only\",\"reject_post_only\",\"reduce_only\",\"api\",\"web\",\"mobile\",\"refresh_amount\",\"display_amount\",\"amount\",\"contracts\",\"filled_amount\",\"average_price\",\"advanced\",\"implv\",\"usd\",\"triggered\",\"trigger\",\"trigger_price\",\"trigger_offset\",\"trigger_reference_price\",\"block_trade\",\"mmp\",\"risk_reducing\",\"replaced\",\"auto_replaced\",\"quote\",\"mmp_group\",\"quote_set_id\",\"quote_id\",\"trigger_order_id\",\"combo_order_id\",\"starbase_order_id\",\"app_name\",\"mmp_cancelled\",\"cancel_reason\",\"oto_order_ids\",\"trigger_fill_condition\",\"oco_ref\",\"primary_order_id\",\"is_secondary_oto\",\"is_primary_otoco\"],\"og:title\":\"private/get_open_orders_by_currency\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/get_open_orders_by_currency\",\"href\":\"/api-reference/trading/private-get_open_orders_by_currency\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/get_open_orders_by_instrument\",\"description\":\"Retrieves a list of all open orders for a specific instrument. Open orders are orders that have been placed but not yet filled or cancelled.\\n\\nResults can be filtered by order type. This method is useful for checking active orders for a particular instrument.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fget_open_orders_by_instrument)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/get_open_orders_by_instrument\",\"instrument_name\",\"type\",\"order_id\",\"order_state\",\"order_type\",\"original_order_type\",\"time_in_force\",\"is_rebalance\",\"is_liquidation\",\"creation_timestamp\",\"last_update_timestamp\",\"starbase_last_update_timestamp\",\"starbase_client_order_id\",\"direction\",\"price\",\"label\",\"post_only\",\"reject_post_only\",\"reduce_only\",\"api\",\"web\",\"mobile\",\"refresh_amount\",\"display_amount\",\"amount\",\"contracts\",\"filled_amount\",\"average_price\",\"advanced\",\"implv\",\"usd\",\"triggered\",\"trigger\",\"trigger_price\",\"trigger_offset\",\"trigger_reference_price\",\"block_trade\",\"mmp\",\"risk_reducing\",\"replaced\",\"auto_replaced\",\"quote\",\"mmp_group\",\"quote_set_id\",\"quote_id\",\"trigger_order_id\",\"combo_order_id\",\"starbase_order_id\",\"app_name\",\"mmp_cancelled\",\"cancel_reason\",\"oto_order_ids\",\"trigger_fill_condition\",\"oco_ref\",\"primary_order_id\",\"is_secondary_oto\",\"is_primary_otoco\"],\"og:title\":\"private/get_open_orders_by_instrument\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/get_open_orders_by_instrument\",\"href\":\"/api-reference/trading/private-get_open_orders_by_instrument\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/get_open_orders_by_label\",\"description\":\"Retrieves a list of all open orders that have a specific label within a given currency. This is useful for tracking and managing groups of related orders that share the same label.\\n\\nOpen orders are orders that have been placed but not yet filled or cancelled. The label helps organize and identify related orders.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fget_open_orders_by_label)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/get_open_orders_by_label\",\"currency\",\"label\",\"order_id\",\"order_state\",\"order_type\",\"original_order_type\",\"time_in_force\",\"is_rebalance\",\"is_liquidation\",\"instrument_name\",\"creation_timestamp\",\"last_update_timestamp\",\"starbase_last_update_timestamp\",\"starbase_client_order_id\",\"direction\",\"price\",\"post_only\",\"reject_post_only\",\"reduce_only\",\"api\",\"web\",\"mobile\",\"refresh_amount\",\"display_amount\",\"amount\",\"contracts\",\"filled_amount\",\"average_price\",\"advanced\",\"implv\",\"usd\",\"triggered\",\"trigger\",\"trigger_price\",\"trigger_offset\",\"trigger_reference_price\",\"block_trade\",\"mmp\",\"risk_reducing\",\"replaced\",\"auto_replaced\",\"quote\",\"mmp_group\",\"quote_set_id\",\"quote_id\",\"trigger_order_id\",\"combo_order_id\",\"starbase_order_id\",\"app_name\",\"mmp_cancelled\",\"cancel_reason\",\"oto_order_ids\",\"trigger_fill_condition\",\"oco_ref\",\"primary_order_id\",\"is_secondary_oto\",\"is_primary_otoco\"],\"og:title\":\"private/get_open_orders_by_label\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/get_open_orders_by_label\",\"href\":\"/api-reference/trading/private-get_open_orders_by_label\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/get_order_history_by_currency\",\"description\":\"Retrieves the order history for a specific currency. The history includes orders that have been partially or fully filled, as well as cancelled orders (if `include_unfilled_orders` is set to true).\\n\\nResults can be filtered by instrument kind and paginated using `offset` and `count` parameters, or using continuation tokens. Use `include_old_orders` to include orders from before a certain date, and `historical` to retrieve historical order data.\\n\\n**📖 Related Article:** [Accessing Historical Trades and Orders Using API](https://docs.deribit.com/articles/accessing-historical-trades-orders)\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fget_order_history_by_currency)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/get_order_history_by_currency\",\"currency\",\"kind\",\"count\",\"offset\",\"include_old\",\"include_unfilled\",\"with_continuation\",\"continuation\",\"historical\",\"order_id\",\"order_state\",\"order_type\",\"original_order_type\",\"time_in_force\",\"is_rebalance\",\"is_liquidation\",\"instrument_name\",\"creation_timestamp\",\"last_update_timestamp\",\"starbase_last_update_timestamp\",\"starbase_client_order_id\",\"direction\",\"price\",\"label\",\"post_only\",\"reject_post_only\",\"reduce_only\",\"api\",\"web\",\"mobile\",\"refresh_amount\",\"display_amount\",\"amount\",\"contracts\",\"filled_amount\",\"average_price\",\"advanced\",\"implv\",\"usd\",\"triggered\",\"trigger\",\"trigger_price\",\"trigger_offset\",\"trigger_reference_price\",\"block_trade\",\"mmp\",\"risk_reducing\",\"replaced\",\"auto_replaced\",\"quote\",\"mmp_group\",\"quote_set_id\",\"quote_id\",\"trigger_order_id\",\"combo_order_id\",\"starbase_order_id\",\"app_name\",\"mmp_cancelled\",\"cancel_reason\",\"oto_order_ids\",\"trigger_fill_condition\",\"oco_ref\",\"primary_order_id\",\"is_secondary_oto\",\"is_primary_otoco\"],\"og:title\":\"private/get_order_history_by_currency\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/get_order_history_by_currency\",\"href\":\"/api-reference/trading/private-get_order_history_by_currency\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/get_order_history_by_instrument\",\"description\":\"Retrieves the order history for a specific instrument. The history includes orders that have been partially or fully filled, as well as cancelled orders (if `include_unfilled_orders` is set to true).\\n\\nResults can be paginated using `offset` and `count` parameters, or using continuation tokens. Use `include_old_orders` to include orders from before a certain date, and `historical` to retrieve historical order data.\\n\\n**📖 Related Article:** [Accessing Historical Trades and Orders Using API](https://docs.deribit.com/articles/accessing-historical-trades-orders)\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fget_order_history_by_instrument)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/get_order_history_by_instrument\",\"instrument_name\",\"count\",\"offset\",\"include_old\",\"include_unfilled\",\"with_continuation\",\"continuation\",\"historical\",\"order_id\",\"order_state\",\"order_type\",\"original_order_type\",\"time_in_force\",\"is_rebalance\",\"is_liquidation\",\"creation_timestamp\",\"last_update_timestamp\",\"starbase_last_update_timestamp\",\"starbase_client_order_id\",\"direction\",\"price\",\"label\",\"post_only\",\"reject_post_only\",\"reduce_only\",\"api\",\"web\",\"mobile\",\"refresh_amount\",\"display_amount\",\"amount\",\"contracts\",\"filled_amount\",\"average_price\",\"advanced\",\"implv\",\"usd\",\"triggered\",\"trigger\",\"trigger_price\",\"trigger_offset\",\"trigger_reference_price\",\"block_trade\",\"mmp\",\"risk_reducing\",\"replaced\",\"auto_replaced\",\"quote\",\"mmp_group\",\"quote_set_id\",\"quote_id\",\"trigger_order_id\",\"combo_order_id\",\"starbase_order_id\",\"app_name\",\"mmp_cancelled\",\"cancel_reason\",\"oto_order_ids\",\"trigger_fill_condition\",\"oco_ref\",\"primary_order_id\",\"is_secondary_oto\",\"is_primary_otoco\"],\"og:title\":\"private/get_order_history_by_instrument\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/get_order_history_by_instrument\",\"href\":\"/api-reference/trading/private-get_order_history_by_instrument\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/get_order_margin_by_ids\",\"description\":\"Retrieves the initial margin requirements for one or more orders identified by their order IDs. Initial margin is the amount of funds required to open a position with these orders.\\n\\nThis method is useful for calculating margin requirements before placing orders, helping to ensure sufficient funds are available.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fget_order_margin_by_ids)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/get_order_margin_by_ids\",\"ids\",\"order_id\",\"initial_margin\",\"initial_margin_currency\"],\"og:title\":\"private/get_order_margin_by_ids\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/get_order_margin_by_ids\",\"href\":\"/api-reference/trading/private-get_order_margin_by_ids\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/get_order_state\",\"description\":\"$52\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/get_order_state\",\"order_id\",\"order_state\",\"order_type\",\"original_order_type\",\"time_in_force\",\"is_rebalance\",\"is_liquidation\",\"instrument_name\",\"creation_timestamp\",\"last_update_timestamp\",\"starbase_last_update_timestamp\",\"starbase_client_order_id\",\"direction\",\"price\",\"label\",\"post_only\",\"reject_post_only\",\"reduce_only\",\"api\",\"web\",\"mobile\",\"refresh_amount\",\"display_amount\",\"amount\",\"contracts\",\"filled_amount\",\"average_price\",\"advanced\",\"implv\",\"usd\",\"triggered\",\"trigger\",\"trigger_price\",\"trigger_offset\",\"trigger_reference_price\",\"block_trade\",\"mmp\",\"risk_reducing\",\"replaced\",\"auto_replaced\",\"quote\",\"mmp_group\",\"quote_set_id\",\"quote_id\",\"trigger_order_id\",\"combo_order_id\",\"starbase_order_id\",\"app_name\",\"mmp_cancelled\",\"cancel_reason\",\"oto_order_ids\",\"trigger_fill_condition\",\"oco_ref\",\"primary_order_id\",\"is_secondary_oto\",\"is_primary_otoco\"],\"og:title\":\"private/get_order_state\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/get_order_state\",\"href\":\"/api-reference/trading/private-get_order_state\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/get_order_state_by_label\",\"description\":\"$53\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/get_order_state_by_label\",\"currency\",\"label\",\"order_id\",\"order_state\",\"order_type\",\"original_order_type\",\"time_in_force\",\"is_rebalance\",\"is_liquidation\",\"instrument_name\",\"creation_timestamp\",\"last_update_timestamp\",\"starbase_last_update_timestamp\",\"starbase_client_order_id\",\"direction\",\"price\",\"post_only\",\"reject_post_only\",\"reduce_only\",\"api\",\"web\",\"mobile\",\"refresh_amount\",\"display_amount\",\"amount\",\"contracts\",\"filled_amount\",\"average_price\",\"advanced\",\"implv\",\"usd\",\"triggered\",\"trigger\",\"trigger_price\",\"trigger_offset\",\"trigger_reference_price\",\"block_trade\",\"mmp\",\"risk_reducing\",\"replaced\",\"auto_replaced\",\"quote\",\"mmp_group\",\"quote_set_id\",\"quote_id\",\"trigger_order_id\",\"combo_order_id\",\"starbase_order_id\",\"app_name\",\"mmp_cancelled\",\"cancel_reason\",\"oto_order_ids\",\"trigger_fill_condition\",\"oco_ref\",\"primary_order_id\",\"is_secondary_oto\",\"is_primary_otoco\"],\"og:title\":\"private/get_order_state_by_label\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/get_order_state_by_label\",\"href\":\"/api-reference/trading/private-get_order_state_by_label\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/get_settlement_history_by_currency\",\"description\":\"Retrieves settlement, delivery, and bankruptcy events that have affected your account for a specific currency.\\n\\n**Settlement vs. delivery:** Settlement is a daily event (at 08:00 UTC) for futures and perpetual positions that converts unrealized profit and loss into realized profit and loss. Option positions do not settle. Delivery is a one-time event that occurs when a futures or options contract expires — any remaining open position is closed at the delivery price. Delivery does not apply to perpetual or spot instruments. Both events take place at 08:00 UTC, which is why they are sometimes conflated.\\n\\nResults can be filtered by settlement type and timestamp. Use pagination parameters (`count` and `continuation`) to retrieve large settlement histories. This data is useful for tracking account-affecting settlement events and understanding how contract expirations impact your account.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fget_settlement_history_by_currency)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/get_settlement_history_by_currency\",\"currency\",\"type\",\"count\",\"continuation\",\"search_start_timestamp\",\"settlements\",\"funding\",\"funded\",\"index_price\",\"instrument_name\",\"mark_price\",\"position\",\"profit_loss\",\"session_bankruptcy\",\"session_profit_loss\",\"session_tax\",\"session_tax_rate\",\"socialized\",\"timestamp\"],\"og:title\":\"private/get_settlement_history_by_currency\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/get_settlement_history_by_currency\",\"href\":\"/api-reference/trading/private-get_settlement_history_by_currency\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/get_settlement_history_by_instrument\",\"description\":\"Retrieves settlement, delivery, and bankruptcy events for a specific instrument that have affected your account.\\n\\n**Settlement vs. delivery:** Settlement is a daily event (at 08:00 UTC) for futures and perpetual positions that converts unrealized profit and loss into realized profit and loss. Option positions do not settle. Delivery is a one-time event that occurs when a futures or options contract expires — any remaining open position is closed at the delivery price. Delivery does not apply to perpetual or spot instruments. Both events take place at 08:00 UTC, which is why they are sometimes conflated.\\n\\nResults can be filtered by settlement type and timestamp. Use pagination parameters (`count` and `continuation`) to retrieve large settlement histories. This method is useful for tracking settlement events for a specific instrument.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fget_settlement_history_by_instrument)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/get_settlement_history_by_instrument\",\"instrument_name\",\"type\",\"count\",\"continuation\",\"search_start_timestamp\",\"settlements\",\"funding\",\"funded\",\"index_price\",\"mark_price\",\"position\",\"profit_loss\",\"session_bankruptcy\",\"session_profit_loss\",\"session_tax\",\"session_tax_rate\",\"socialized\",\"timestamp\"],\"og:title\":\"private/get_settlement_history_by_instrument\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/get_settlement_history_by_instrument\",\"href\":\"/api-reference/trading/private-get_settlement_history_by_instrument\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/get_trigger_order_history\",\"description\":\"Retrieves a detailed log of all trigger orders (stop orders, take-profit orders, etc.) for the authenticated account. The log includes trigger order creation, activation, execution, and cancellation events.\\n\\nResults can be filtered by currency and instrument name. Use pagination parameters (`count` and `continuation`) to retrieve large trigger order histories. This is useful for tracking trigger order activity and debugging trigger order behavior.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fget_trigger_order_history)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/get_trigger_order_history\",\"currency\",\"instrument_name\",\"count\",\"continuation\",\"entries\",\"timestamp\",\"trigger\",\"trigger_price\",\"trigger_offset\",\"trigger_order_id\",\"order_id\",\"order_state\",\"request\",\"direction\",\"price\",\"amount\",\"last_update_timestamp\",\"reduce_only\",\"post_only\",\"order_type\",\"label\",\"is_secondary_oto\",\"oco_ref\",\"source\"],\"og:title\":\"private/get_trigger_order_history\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/get_trigger_order_history\",\"href\":\"/api-reference/trading/private-get_trigger_order_history\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/get_user_trades_by_currency\",\"description\":\"Retrieves the latest user trades that have occurred for instruments in a specific currency. Returns trade details including price, amount, direction, timestamp, trade ID, and order ID for all instruments in the currency.\\n\\nResults can be filtered by instrument kind, trade ID range, or timestamp range. Use the `count` parameter to limit the number of trades returned, and `sorting` to control the order. To retrieve trades for a specific subaccount, use the `subaccount_id` parameter. Use `historical` to retrieve historical trade data.\\n\\n**📖 Related Article:** [Accessing Historical Trades and Orders Using API](https://docs.deribit.com/articles/accessing-historical-trades-orders)\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fget_user_trades_by_currency)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/get_user_trades_by_currency\",\"currency\",\"kind\",\"start_id\",\"end_id\",\"count\",\"start_timestamp\",\"end_timestamp\",\"sorting\",\"historical\",\"subaccount_id\",\"trades\",\"has_more\",\"trade_id\",\"trade_seq\",\"instrument_name\",\"timestamp\",\"starbase_timestamp\",\"starbase_order_id\",\"starbase_client_order_id\",\"order_type\",\"original_order_type\",\"advanced\",\"order_id\",\"matching_id\",\"direction\",\"tick_direction\",\"index_price\",\"price\",\"amount\",\"contracts\",\"iv\",\"underlying_price\",\"liquidation\",\"liquidity\",\"fee\",\"fee_currency\",\"label\",\"state\",\"block_trade_id\",\"block_trade_leg_count\",\"block_rfq_id\",\"block_rfq_quote_id\",\"reduce_only\",\"post_only\",\"mmp\",\"risk_reducing\",\"api\",\"profit_loss\",\"mark_price\",\"legs\",\"combo_id\",\"combo_trade_id\",\"starbase_match_id\",\"quote_set_id\",\"quote_id\",\"trade_allocations\",\"user_id\",\"client_info\",\"client_id\",\"client_link_id\",\"name\"],\"og:title\":\"private/get_user_trades_by_currency\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/get_user_trades_by_currency\",\"href\":\"/api-reference/trading/private-get_user_trades_by_currency\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/get_user_trades_by_currency_and_time\",\"description\":\"Retrieves the latest user trades that have occurred for instruments in a specific currency within a specified time range. Returns trade details including price, amount, direction, timestamp, trade ID, and order ID for all instruments in the currency.\\n\\nResults can be filtered by instrument kind. Use the `count` parameter to limit the number of trades returned, and `sorting` to control the order. Use `historical` to retrieve historical trade data. This method is useful for analyzing trading activity across a currency over specific time periods.\\n\\nMain accounts may use the `subaccount_id` parameter to retrieve trade data for a specific subaccount (requires `mainaccount` scope).\\n\\n**📖 Related Article:** [Accessing Historical Trades and Orders Using API](https://docs.deribit.com/articles/accessing-historical-trades-orders)\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fget_user_trades_by_currency_and_time)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/get_user_trades_by_currency_and_time\",\"currency\",\"kind\",\"start_timestamp\",\"end_timestamp\",\"count\",\"sorting\",\"historical\",\"subaccount_id\",\"trades\",\"has_more\",\"trade_id\",\"trade_seq\",\"instrument_name\",\"timestamp\",\"starbase_timestamp\",\"starbase_order_id\",\"starbase_client_order_id\",\"order_type\",\"original_order_type\",\"advanced\",\"order_id\",\"matching_id\",\"direction\",\"tick_direction\",\"index_price\",\"price\",\"amount\",\"contracts\",\"iv\",\"underlying_price\",\"liquidation\",\"liquidity\",\"fee\",\"fee_currency\",\"label\",\"state\",\"block_trade_id\",\"block_trade_leg_count\",\"block_rfq_id\",\"block_rfq_quote_id\",\"reduce_only\",\"post_only\",\"mmp\",\"risk_reducing\",\"api\",\"profit_loss\",\"mark_price\",\"legs\",\"combo_id\",\"combo_trade_id\",\"starbase_match_id\",\"quote_set_id\",\"quote_id\",\"trade_allocations\",\"user_id\",\"client_info\",\"client_id\",\"client_link_id\",\"name\"],\"og:title\":\"private/get_user_trades_by_currency_and_time\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/get_user_trades_by_currency_and_time\",\"href\":\"/api-reference/trading/private-get_user_trades_by_currency_and_time\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/get_user_trades_by_instrument\",\"description\":\"Retrieves the latest user trades that have occurred for a specific instrument. Returns trade details including price, amount, direction, timestamp, trade ID, and order ID.\\n\\nResults can be filtered by sequence number range or timestamp range. Use the `count` parameter to limit the number of trades returned, and `sorting` to control the order (ascending or descending by trade ID). Use `historical` to retrieve historical trade data.\\n\\nMain accounts may use the `subaccount_id` parameter to retrieve trade data for a specific subaccount (requires `mainaccount` scope).\\n\\n**📖 Related Article:** [Accessing Historical Trades and Orders Using API](https://docs.deribit.com/articles/accessing-historical-trades-orders)\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fget_user_trades_by_instrument)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/get_user_trades_by_instrument\",\"instrument_name\",\"start_seq\",\"end_seq\",\"count\",\"start_timestamp\",\"end_timestamp\",\"historical\",\"sorting\",\"subaccount_id\",\"trades\",\"has_more\",\"trade_id\",\"trade_seq\",\"timestamp\",\"starbase_timestamp\",\"starbase_order_id\",\"starbase_client_order_id\",\"order_type\",\"original_order_type\",\"advanced\",\"order_id\",\"matching_id\",\"direction\",\"tick_direction\",\"index_price\",\"price\",\"amount\",\"contracts\",\"iv\",\"underlying_price\",\"liquidation\",\"liquidity\",\"fee\",\"fee_currency\",\"label\",\"state\",\"block_trade_id\",\"block_trade_leg_count\",\"block_rfq_id\",\"block_rfq_quote_id\",\"reduce_only\",\"post_only\",\"mmp\",\"risk_reducing\",\"api\",\"profit_loss\",\"mark_price\",\"legs\",\"combo_id\",\"combo_trade_id\",\"starbase_match_id\",\"quote_set_id\",\"quote_id\",\"trade_allocations\",\"user_id\",\"client_info\",\"client_id\",\"client_link_id\",\"name\"],\"og:title\":\"private/get_user_trades_by_instrument\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/get_user_trades_by_instrument\",\"href\":\"/api-reference/trading/private-get_user_trades_by_instrument\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/get_user_trades_by_instrument_and_time\",\"description\":\"Retrieves the latest user trades that have occurred for a specific instrument within a specified time range. Returns trade details including price, amount, direction, timestamp, trade ID, and order ID.\\n\\nUse the `count` parameter to limit the number of trades returned, and `sorting` to control the order (ascending or descending by trade ID). Use `historical` to retrieve historical trade data. This method is useful for analyzing trading activity over specific time periods.\\n\\nMain accounts may use the `subaccount_id` parameter to retrieve trade data for a specific subaccount (requires `mainaccount` scope).\\n\\n**📖 Related Article:** [Accessing Historical Trades and Orders Using API](https://docs.deribit.com/articles/accessing-historical-trades-orders)\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fget_user_trades_by_instrument_and_time)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/get_user_trades_by_instrument_and_time\",\"instrument_name\",\"start_timestamp\",\"end_timestamp\",\"count\",\"sorting\",\"historical\",\"subaccount_id\",\"trades\",\"has_more\",\"trade_id\",\"trade_seq\",\"timestamp\",\"starbase_timestamp\",\"starbase_order_id\",\"starbase_client_order_id\",\"order_type\",\"original_order_type\",\"advanced\",\"order_id\",\"matching_id\",\"direction\",\"tick_direction\",\"index_price\",\"price\",\"amount\",\"contracts\",\"iv\",\"underlying_price\",\"liquidation\",\"liquidity\",\"fee\",\"fee_currency\",\"label\",\"state\",\"block_trade_id\",\"block_trade_leg_count\",\"block_rfq_id\",\"block_rfq_quote_id\",\"reduce_only\",\"post_only\",\"mmp\",\"risk_reducing\",\"api\",\"profit_loss\",\"mark_price\",\"legs\",\"combo_id\",\"combo_trade_id\",\"starbase_match_id\",\"quote_set_id\",\"quote_id\",\"trade_allocations\",\"user_id\",\"client_info\",\"client_id\",\"client_link_id\",\"name\"],\"og:title\":\"private/get_user_trades_by_instrument_and_time\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/get_user_trades_by_instrument_and_time\",\"href\":\"/api-reference/trading/private-get_user_trades_by_instrument_and_time\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/get_user_trades_by_order\",\"description\":\"Retrieves all trades that were executed from a specific order. When an order is filled, it may result in multiple trades (partial fills). This method returns all trades associated with a given order ID.\\n\\nResults can be sorted in ascending or descending order by trade ID. Use `historical` to retrieve historical trade data. This is useful for tracking how an order was filled and analyzing execution quality.\\n\\nMain accounts may use the `subaccount_id` parameter to retrieve trade data for a specific subaccount (requires `mainaccount` scope).\\n\\n**📖 Related Article:** [Accessing Historical Trades and Orders Using API](https://docs.deribit.com/articles/accessing-historical-trades-orders)\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fget_user_trades_by_order)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/get_user_trades_by_order\",\"order_id\",\"sorting\",\"historical\",\"subaccount_id\",\"trade_id\",\"trade_seq\",\"instrument_name\",\"timestamp\",\"starbase_timestamp\",\"starbase_order_id\",\"starbase_client_order_id\",\"order_type\",\"original_order_type\",\"advanced\",\"matching_id\",\"direction\",\"tick_direction\",\"index_price\",\"price\",\"amount\",\"contracts\",\"iv\",\"underlying_price\",\"liquidation\",\"liquidity\",\"fee\",\"fee_currency\",\"label\",\"state\",\"block_trade_id\",\"block_trade_leg_count\",\"block_rfq_id\",\"block_rfq_quote_id\",\"reduce_only\",\"post_only\",\"mmp\",\"risk_reducing\",\"api\",\"profit_loss\",\"mark_price\",\"legs\",\"combo_id\",\"combo_trade_id\",\"starbase_match_id\",\"quote_set_id\",\"quote_id\",\"trade_allocations\",\"user_id\",\"client_info\",\"client_id\",\"client_link_id\",\"name\"],\"og:title\":\"private/get_user_trades_by_order\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/get_user_trades_by_order\",\"href\":\"/api-reference/trading/private-get_user_trades_by_order\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/sell\",\"description\":\"Places a sell order for an instrument. Supports various order types including limit, market, stop, and advanced order types (stop-limit, take-profit, take-profit-limit, trailing-stop, etc.).\\n\\nYou can specify order parameters such as price, quantity, time-in-force, post-only, reduce-only, and trigger conditions. Orders can be labeled for easier management and tracking. Market Maker Protection (MMP) can be enabled to prevent excessive quoting.\\n\\n**Note:** For spot orders routed to Coinbase Exchange, fills come back asynchronously. It is recommended to receive fills from the `user.trades` channel.\\n\\n**📖 Related Article:** [Order Management Best Practices](https://docs.deribit.com/articles/order-management-best-practices)\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fsell)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/sell\",\"instrument_name\",\"amount\",\"contracts\",\"type\",\"label\",\"price\",\"time_in_force\",\"display_amount\",\"post_only\",\"reject_post_only\",\"reduce_only\",\"trigger_price\",\"trigger_offset\",\"trigger\",\"advanced\",\"mmp\",\"valid_until\",\"linked_order_type\",\"trigger_fill_condition\",\"otoco_config\",\"order\",\"trades\",\"order_id\",\"order_state\",\"order_type\",\"original_order_type\",\"is_rebalance\",\"is_liquidation\",\"creation_timestamp\",\"last_update_timestamp\",\"starbase_last_update_timestamp\",\"starbase_client_order_id\",\"direction\",\"api\",\"web\",\"mobile\",\"refresh_amount\",\"filled_amount\",\"average_price\",\"implv\",\"usd\",\"triggered\",\"trigger_reference_price\",\"block_trade\",\"risk_reducing\",\"replaced\",\"auto_replaced\",\"quote\",\"mmp_group\",\"quote_set_id\",\"quote_id\",\"trigger_order_id\",\"combo_order_id\",\"starbase_order_id\",\"app_name\",\"mmp_cancelled\",\"cancel_reason\",\"oto_order_ids\",\"oco_ref\",\"primary_order_id\",\"is_secondary_oto\",\"is_primary_otoco\",\"trade_id\",\"trade_seq\",\"timestamp\",\"starbase_timestamp\",\"matching_id\",\"tick_direction\",\"index_price\",\"iv\",\"underlying_price\",\"liquidation\",\"liquidity\",\"fee\",\"fee_currency\",\"state\",\"block_trade_id\",\"block_trade_leg_count\",\"block_rfq_id\",\"block_rfq_quote_id\",\"profit_loss\",\"mark_price\",\"legs\",\"combo_id\",\"combo_trade_id\",\"starbase_match_id\",\"trade_allocations\",\"user_id\",\"client_info\",\"client_id\",\"client_link_id\",\"name\"],\"og:title\":\"private/sell\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/sell\",\"href\":\"/api-reference/trading/private-sell\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/set_leverage\",\"description\":\"Sets a custom leverage multiplier for a specified future instrument.\\n\\nCustom leverage cannot exceed the effective `max_leverage` allowed by the account's risk profile. Passing `null` as the leverage value removes the custom leverage setting and restores the default leverage.\\n\\nCustom leverage setting is disabled for isolated subaccounts. Setting leverage in isolated margin mode is restricted to main accounts.\\n\\n \\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fset_leverage)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/set_leverage\",\"instrument_name\",\"leverage\",\"subaccount_id\",\"isolated\"],\"og:title\":\"private/set_leverage\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/set_leverage\",\"href\":\"/api-reference/trading/private-set_leverage\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Account Management\",\"pages\":[{\"title\":\"private/change_margin_model\",\"description\":\"Changes the margin model for the authenticated account or a specified subaccount. Margin models determine how margin requirements are calculated (e.g., Standard Margin vs. Portfolio Margin).\\n\\nChanging the margin model may affect margin requirements, available funds, and trading capabilities. Use the `dry_run` parameter to preview the impact of the change before applying it.\\n\\n**📖 Related Article:** [Margin types and usage](https://support.deribit.com/hc/en-us/articles/25944811317149-Margin-types-and-usage)\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fchange_margin_model)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/change_margin_model\",\"user_id\",\"margin_model\",\"dry_run\",\"old_state\",\"new_state\",\"currency\",\"maintenance_margin_rate\",\"initial_margin_rate\",\"available_balance\"],\"og:title\":\"private/change_margin_model\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/change_margin_model\",\"href\":\"/api-reference/account-management/private-change_margin_model\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/get_access_log\",\"description\":\"Retrieves a log of API access attempts and authentication events for the authenticated account. The log includes information such as IP addresses, timestamps, API methods called, and authentication status.\\n\\nUse this method to monitor account security, review API usage patterns, and identify unauthorized access attempts. Results can be paginated using the `offset` and `count` parameters.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fget_access_log)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/get_access_log\",\"offset\",\"count\",\"ip\",\"timestamp\",\"country\",\"city\",\"log\",\"data\"],\"og:title\":\"private/get_access_log\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/get_access_log\",\"href\":\"/api-reference/account-management/private-get_access_log\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/get_account_summaries\",\"description\":\"Retrieves a per-currency list of account summaries for the authenticated user. Each summary includes balance, equity, available funds, and margin information for each currency.\\n\\nTo retrieve summaries for a specific subaccount, use the `subaccount_id` parameter. When the `extended` parameter is set to `true`, additional account details such as account ID, username, email, and account type are included.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fget_account_summaries)\\n\\n\\n\\nNote: This method does not accept a singular `currency` parameter; summaries for all portfolio currencies are always returned for both main and isolated subaccounts.\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/get_account_summaries\",\"subaccount_id\",\"extended\",\"system_name\",\"username\",\"type\",\"login_enabled\",\"email\",\"security_keys_enabled\",\"mmp_enabled\",\"interuser_transfers_enabled\",\"referrer_id\",\"creation_timestamp\",\"self_trading_reject_mode\",\"self_trading_extended_to_subaccounts\",\"block_rfq_self_match_prevention\",\"affiliate_promotion_fee\",\"trading_products_details\",\"receive_notifications\",\"summaries\",\"total_pl\",\"session_rpl\",\"session_upl\",\"available_funds\",\"available_withdrawal_funds\",\"margin_balance\",\"balance\",\"spot_reserve\",\"locked_balance\",\"additional_reserve\",\"fee_balance\",\"fee_group\",\"currency\",\"delta_total\",\"projected_delta_total\",\"delta_total_map\",\"deposit_address\",\"equity\",\"futures_pl\",\"futures_session_rpl\",\"futures_session_upl\",\"initial_margin\",\"maintenance_margin\",\"options_delta\",\"options_gamma\",\"options_pl\",\"options_session_rpl\",\"options_session_upl\",\"options_theta\",\"options_value\",\"options_vega\",\"options_gamma_map\",\"options_theta_map\",\"options_vega_map\",\"projected_initial_margin\",\"projected_maintenance_margin\",\"close_out_margin\",\"projected_close_out_margin\",\"portfolio_margining_enabled\",\"cross_collateral_enabled\",\"margin_model\",\"total_equity_usd\",\"total_initial_margin_usd\",\"total_maintenance_margin_usd\",\"total_margin_balance_usd\",\"total_delta_total_usd\",\"limits\",\"has_non_block_chain_equity\",\"fees\"],\"og:title\":\"private/get_account_summaries\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/get_account_summaries\",\"href\":\"/api-reference/account-management/private-get_account_summaries\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/get_account_summary\",\"description\":\"Retrieves the account summary for a specific currency. The summary includes cash `balance`, `equity`, `margin_balance`, `available_funds`, `available_withdrawal_funds`, initial/maintenance margin, session and total PnL, options greeks, and related fields.\\n\\nKey relationships (standard margin): `equity = balance + futures session PnL + options_value`, `margin_balance = equity - options_value`, `available_funds = max(0, margin_balance - initial_margin)`. Under portfolio margin, `margin_balance` equals `equity`. Session PnL fields reset at daily settlement; `total_pl` does not.\\n\\nTo retrieve the summary for a specific subaccount, use the `subaccount_id` parameter. When the `extended` parameter is set to `true`, additional account details such as account ID, username, email, and account type are included.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fget_account_summary)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/get_account_summary\",\"currency\",\"subaccount_id\",\"extended\",\"total_pl\",\"session_rpl\",\"session_upl\",\"available_funds\",\"available_withdrawal_funds\",\"margin_balance\",\"balance\",\"spot_reserve\",\"locked_balance\",\"additional_reserve\",\"fee_balance\",\"fee_group\",\"delta_total\",\"projected_delta_total\",\"delta_total_map\",\"deposit_address\",\"email\",\"equity\",\"futures_pl\",\"futures_session_rpl\",\"futures_session_upl\",\"initial_margin\",\"maintenance_margin\",\"system_name\",\"options_delta\",\"options_gamma\",\"options_pl\",\"options_session_rpl\",\"options_session_upl\",\"options_theta\",\"options_value\",\"options_vega\",\"options_gamma_map\",\"options_theta_map\",\"options_vega_map\",\"security_keys_enabled\",\"mmp_enabled\",\"projected_initial_margin\",\"projected_maintenance_margin\",\"close_out_margin\",\"projected_close_out_margin\",\"username\",\"type\",\"login_enabled\",\"portfolio_margining_enabled\",\"cross_collateral_enabled\",\"margin_model\",\"total_equity_usd\",\"total_initial_margin_usd\",\"total_maintenance_margin_usd\",\"total_margin_balance_usd\",\"total_delta_total_usd\",\"interuser_transfers_enabled\",\"referrer_id\",\"limits\",\"creation_timestamp\",\"has_non_block_chain_equity\",\"self_trading_reject_mode\",\"self_trading_extended_to_subaccounts\",\"block_rfq_self_match_prevention\",\"fees\",\"affiliate_promotion_fee\",\"trading_products_details\",\"receive_notifications\",\"is_direct_access_allowed\"],\"og:title\":\"private/get_account_summary\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/get_account_summary\",\"href\":\"/api-reference/account-management/private-get_account_summary\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/get_leverage\",\"description\":\"Retrieves the current user-configured custom leverage and effective maximum leverage for a specified active future instrument.\\n\\nWhen `instrument_name` is supplied, returns a single leverage details object. When omitted, returns leverage details only for futures with a stored custom leverage override; instruments using the default maximum leverage are omitted. For `isolated=true`, regular subaccounts receive an empty object or array because isolated leverage configuration is visible only to the main account.\\n\\n \\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fget_leverage)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/get_leverage\",\"instrument_name\",\"subaccount_id\",\"isolated\"],\"og:title\":\"private/get_leverage\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/get_leverage\",\"href\":\"/api-reference/account-management/private-get_leverage\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/get_pme_params\",\"description\":\"Retrieves Portfolio Margin (PM) open-order restrictions and risk limits for the specified currency.\\n\\nWhen Portfolio Margin is enabled, the response includes maximum order counts, aggregate futures and options order sizes, and the risk-reducing order limit. When Portfolio Margin is disabled, the response contains only `enabled: false`.\\n\\n**📖 Related Article:** [Portfolio Margin](https://support.deribit.com/hc/en-us/articles/25944756247837-Portfolio-Margin)\\n\\n \\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fget_pme_params)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/get_pme_params\",\"currency\"],\"og:title\":\"private/get_pme_params\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/get_pme_params\",\"href\":\"/api-reference/account-management/private-get_pme_params\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/get_position\",\"description\":\"Retrieves the open position for a specific instrument. Returns detailed position information including size, average entry price, mark price, unrealized P\u0026L, initial margin, maintenance margin, and other position-related metrics.\\n\\nIf no position exists for the specified instrument, the response will indicate a zero position.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fget_position)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/get_position\",\"instrument_name\",\"kind\",\"user_id\",\"average_price\",\"direction\",\"mark_price\",\"delta\",\"gamma\",\"vega\",\"theta\",\"index_price\",\"initial_margin\",\"maintenance_margin\",\"settlement_price\",\"total_profit_loss\",\"floating_profit_loss\",\"realized_profit_loss\",\"size\",\"size_currency\",\"average_price_usd\",\"floating_profit_loss_usd\",\"leverage\",\"realized_funding\",\"interest_value\",\"estimated_liquidation_price\",\"open_orders_margin\"],\"og:title\":\"private/get_position\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/get_position\",\"href\":\"/api-reference/account-management/private-get_position\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/get_positions\",\"description\":\"Retrieves all open positions for the authenticated account. Returns position details including size, average entry price, mark price, unrealized P\u0026L, initial margin, maintenance margin, and other position-related information.\\n\\nResults can be filtered by currency and instrument kind (future, option, etc.). To retrieve positions for a specific subaccount, use the `subaccount_id` parameter.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fget_positions)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/get_positions\",\"currency\",\"kind\",\"subaccount_id\",\"instrument_name\",\"user_id\",\"average_price\",\"direction\",\"mark_price\",\"delta\",\"gamma\",\"vega\",\"theta\",\"index_price\",\"initial_margin\",\"maintenance_margin\",\"settlement_price\",\"total_profit_loss\",\"floating_profit_loss\",\"realized_profit_loss\",\"size\",\"size_currency\",\"average_price_usd\",\"floating_profit_loss_usd\",\"leverage\",\"realized_funding\",\"interest_value\",\"estimated_liquidation_price\",\"open_orders_margin\"],\"og:title\":\"private/get_positions\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/get_positions\",\"href\":\"/api-reference/account-management/private-get_positions\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/get_risk_profile\",\"description\":\"Retrieves risk profile permissions and constraints assigned to the authenticated user account.\\n\\nIncludes flags for Portfolio Margining eligibility, short option trading authorization, and maximum risk-profile leverage ceiling.\\n\\n \\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fget_risk_profile)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/get_risk_profile\",\"portfolio_margining_allowed\",\"short_option_allowed\",\"max_leverage\"],\"og:title\":\"private/get_risk_profile\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/get_risk_profile\",\"href\":\"/api-reference/account-management/private-get_risk_profile\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/get_subaccounts\",\"description\":\"Retrieves information about all subaccounts associated with the main account. Returns details such as subaccount IDs, names, and status.\\n\\nWhen called from a subaccount, the response includes limited details for the main account and full details for the subaccount initiating the request.\\n\\nSet the `with_portfolio` parameter to `true` to include portfolio information (balances, positions, etc.) in the response. By default, only subaccount metadata is returned.\\n\\n**📖 Related Article:** [Managing Subaccounts](https://docs.deribit.com/articles/managing-subaccounts-api)\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fget_subaccounts)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/get_subaccounts\",\"with_portfolio\",\"username\",\"type\",\"email\",\"not_confirmed_email\",\"security_keys_enabled\",\"security_keys_assignments\",\"system_name\",\"receive_notifications\",\"is_password\",\"margin_model\",\"proof_id\",\"proof_id_signature\",\"login_enabled\",\"portfolio\",\"btc(example)\",\"margin_balance\",\"currency\",\"maintenance_margin\",\"initial_margin\",\"equity\",\"balance\",\"available_withdrawal_funds\",\"available_funds\",\"additional_reserve\",\"spot_reserve\"],\"og:title\":\"private/get_subaccounts\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/get_subaccounts\",\"href\":\"/api-reference/account-management/private-get_subaccounts\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/get_subaccounts_details\",\"description\":\"Retrieves position details for all subaccounts for a specific currency. Returns positions aggregated across all subaccounts, including size, average entry price, mark price, and P\u0026L information.\\n\\nOptionally include open orders for each subaccount by setting the `with_open_orders` parameter to `true`.\\n\\n**📖 Related Article:** [Managing Subaccounts](https://docs.deribit.com/articles/managing-subaccounts-api)\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fget_subaccounts_details)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/get_subaccounts_details\",\"currency\",\"with_open_orders\",\"uid\",\"positions\",\"open_orders\",\"instrument_name\",\"kind\",\"user_id\",\"average_price\",\"direction\",\"mark_price\",\"delta\",\"gamma\",\"vega\",\"theta\",\"index_price\",\"initial_margin\",\"maintenance_margin\",\"settlement_price\",\"total_profit_loss\",\"floating_profit_loss\",\"realized_profit_loss\",\"size\",\"size_currency\",\"average_price_usd\",\"floating_profit_loss_usd\",\"leverage\",\"realized_funding\",\"interest_value\",\"order_id\",\"order_state\",\"order_type\",\"original_order_type\",\"time_in_force\",\"is_rebalance\",\"is_liquidation\",\"creation_timestamp\",\"last_update_timestamp\",\"starbase_last_update_timestamp\",\"starbase_client_order_id\",\"price\",\"label\",\"post_only\",\"reject_post_only\",\"reduce_only\",\"api\",\"web\",\"mobile\",\"refresh_amount\",\"display_amount\",\"amount\",\"contracts\",\"filled_amount\",\"advanced\",\"implv\",\"usd\",\"triggered\",\"trigger\",\"trigger_price\",\"trigger_offset\",\"trigger_reference_price\",\"block_trade\",\"mmp\",\"risk_reducing\",\"replaced\",\"auto_replaced\",\"quote\",\"mmp_group\",\"quote_set_id\",\"quote_id\",\"trigger_order_id\",\"combo_order_id\",\"starbase_order_id\",\"app_name\",\"mmp_cancelled\",\"cancel_reason\",\"oto_order_ids\",\"trigger_fill_condition\",\"oco_ref\",\"primary_order_id\",\"is_secondary_oto\",\"is_primary_otoco\"],\"og:title\":\"private/get_subaccounts_details\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/get_subaccounts_details\",\"href\":\"/api-reference/account-management/private-get_subaccounts_details\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/get_trading_limits\",\"description\":\"Retrieves trading limits and open order thresholds for a given currency and margin model.\\n\\nReturns limits on open order count per instrument, total open order count, maximum future position sizes, and options constraints.\\n\\n \\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fget_trading_limits)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/get_trading_limits\",\"currency\"],\"og:title\":\"private/get_trading_limits\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/get_trading_limits\",\"href\":\"/api-reference/account-management/private-get_trading_limits\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/get_transaction_log\",\"description\":\"$54\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/get_transaction_log\",\"currency\",\"start_timestamp\",\"end_timestamp\",\"query\",\"count\",\"subaccount_id\",\"continuation\",\"logs\",\"timestamp\",\"user_id\",\"username\",\"commission\",\"cashflow\",\"balance\",\"change\",\"user_seq\",\"type\",\"role\",\"info\",\"equity\",\"mark_price\",\"settlement_price\",\"index_price\",\"instrument_name\",\"position\",\"side\",\"amount\",\"price\",\"price_currency\",\"trade_id\",\"order_id\",\"user_role\",\"fee_role\",\"profit_as_cashflow\",\"interest_pl\",\"block_rfq_id\",\"ip\",\"starbase_match_id\",\"starbase_order_id\",\"starbase_timestamp\",\"session_rpl\",\"session_upl\",\"total_interest_pl\",\"contracts\"],\"og:title\":\"private/get_transaction_log\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/get_transaction_log\",\"href\":\"/api-reference/account-management/private-get_transaction_log\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/get_user_locks\",\"description\":\"Retrieves information about any account locks or restrictions currently active on the authenticated account. Account locks may be applied for security reasons, compliance requirements, or administrative purposes.\\n\\nThe response includes details about the type of lock, reason, and duration (if applicable). Some locks may prevent trading, withdrawals, or other account operations.\\n\\n**📖 Related Support Article:** [Emergency locking an account](https://support.deribit.com/hc/en-us/articles/25944602715805-Emergency-locking-an-account)\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fget_user_locks)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/get_user_locks\",\"currency\",\"enabled\",\"message\"],\"og:title\":\"private/get_user_locks\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/get_user_locks\",\"href\":\"/api-reference/account-management/private-get_user_locks\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/pme/simulate\",\"description\":\"Calculates the Extended Risk Matrix (ERM) and detailed margin information for Portfolio Margin accounts. The ERM provides a comprehensive view of portfolio risk across different scenarios and market conditions.\\n\\nYou can calculate the ERM for a specific currency or for the entire Cross-Collateral portfolio. The response includes margin requirements, risk metrics, and scenario analysis that helps assess portfolio risk under various market conditions.\\n\\nUse this method to understand margin requirements and risk exposure before making trading decisions in a Portfolio Margin account.\\n\\n**📖 Related Article:** [Portfolio Margin](https://support.deribit.com/hc/en-us/articles/25944756247837-Portfolio-Margin)\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fpme%2Fsimulate)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/pme/simulate\",\"currency\",\"add_positions\",\"simulated_positions\"],\"og:title\":\"private/pme/simulate\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/pme/simulate\",\"href\":\"/api-reference/account-management/private-simulate\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/simulate_portfolio\",\"description\":\"Calculates portfolio margin requirements and risk metrics for simulated positions or the current portfolio. This method helps you understand margin requirements before opening new positions or assess the impact of potential trades.\\n\\nYou can simulate adding new positions to the current portfolio or calculate margin for a completely simulated portfolio. The response includes initial margin, maintenance margin, available funds, and other risk metrics.\\n\\n**Note:** This method has a restricted rate limit of not more than once per second due to the computational complexity of portfolio margin calculations.\\n\\n**📖 Related Article:** [Portfolio Margin](https://support.deribit.com/hc/en-us/articles/25944756247837-Portfolio-Margin)\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fsimulate_portfolio)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/simulate_portfolio\",\"currency\",\"add_positions\",\"simulated_positions\",\"equity\",\"balance\",\"margin_balance\",\"initial_margin\",\"maintenance_margin\",\"projected_initial_margin\",\"projected_maintenance_margin\",\"available_funds\",\"available_withdrawal_funds\",\"available_subaccount_transfer_funds\",\"total_pl\",\"session_rpl\",\"session_upl\",\"futures_pl\",\"futures_session_rpl\",\"futures_session_upl\",\"options_pl\",\"options_session_rpl\",\"options_session_upl\",\"options_value\",\"options_delta\",\"options_gamma\",\"options_theta\",\"options_vega\",\"options_gamma_map\",\"options_theta_map\",\"options_vega_map\",\"delta_total\",\"delta_total_map\",\"projected_delta_total\",\"additional_reserve\",\"spot_reserve\",\"fee_balance\",\"locked_balance\",\"margin_model\",\"portfolio_margining_enabled\",\"cross_collateral_enabled\",\"total_equity_usd\",\"total_initial_margin_usd\",\"total_maintenance_margin_usd\",\"total_margin_balance_usd\",\"total_delta_total_usd\"],\"og:title\":\"private/simulate_portfolio\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/simulate_portfolio\",\"href\":\"/api-reference/account-management/private-simulate_portfolio\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/get_announcements\",\"description\":\"Retrieves platform announcements and important notices. Announcements include system updates, maintenance schedules, new features, policy changes, and other important information.\\n\\nResults are returned in reverse chronological order (newest first). The default `start_timestamp` is the current time, and the `count` parameter must be between 1 and 50 (default is 5).\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Fget_announcements)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/get_announcements\",\"start_timestamp\",\"count\",\"body\",\"publication_timestamp\",\"important\",\"confirmation\",\"title\"],\"og:title\":\"public/get_announcements\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/get_announcements\",\"href\":\"/api-reference/account-management/public-get_announcements\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Combo Books\",\"pages\":[{\"title\":\"private/create_combo\",\"description\":\"Verifies and creates a combo book or returns an existing combo matching the given trades. Combos allow trading on multiple instruments (futures and options) simultaneously as a single strategy.\\n\\nIf a combo matching the provided trades already exists, this method returns the existing combo. Otherwise, it creates a new combo book with the specified leg structure.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fcreate_combo)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/create_combo\",\"trades\",\"instrument_id\",\"state\",\"state_timestamp\",\"creation_timestamp\",\"legs\",\"instrument_name\",\"amount\"],\"og:title\":\"private/create_combo\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/create_combo\",\"href\":\"/api-reference/combo-books/private-create_combo\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/get_leg_prices\",\"description\":\"Returns individual leg prices for a given combo structure based on an aggregated price of the strategy and the mark prices of the individual legs.\\n\\n**Note:** Leg prices change dynamically with mark price fluctuations, and the algorithm is calibrated only for conventional option structures and future spreads. This method supports both inverse strategies and known linear structures within a single currency pair.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fget_leg_prices)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/get_leg_prices\",\"legs\",\"price\",\"amount\",\"ratio\",\"instrument_name\",\"direction\"],\"og:title\":\"private/get_leg_prices\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/get_leg_prices\",\"href\":\"/api-reference/combo-books/private-get_leg_prices\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/get_combo_details\",\"description\":\"Retrieves detailed information about a specific combo, including its leg structure, state, and other properties.\\n\\nUse [public/get_combo_ids](https://docs.deribit.com/api-reference/combo-books/public-get_combo_ids) to get a list of available combo IDs.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Fget_combo_details)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/get_combo_details\",\"combo_id\",\"instrument_id\",\"state\",\"state_timestamp\",\"creation_timestamp\",\"legs\",\"instrument_name\",\"amount\"],\"og:title\":\"public/get_combo_details\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/get_combo_details\",\"href\":\"/api-reference/combo-books/public-get_combo_details\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/get_combo_ids\",\"description\":\"Retrieves available combo IDs. This method can be used to get the list of all combos, or only the list of combos in the given state.\\n\\nUse [public/get_combo_details](https://docs.deribit.com/api-reference/combo-books/public-get_combo_details) to retrieve detailed information about a specific combo.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Fget_combo_ids)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/get_combo_ids\",\"currency\",\"state\"],\"og:title\":\"public/get_combo_ids\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/get_combo_ids\",\"href\":\"/api-reference/combo-books/public-get_combo_ids\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/get_combos\",\"description\":\"Retrieves information about active combos for the specified currency. Returns detailed information including leg structures and combo properties.\\n\\nFor a list of combo IDs only, use [public/get_combo_ids](https://docs.deribit.com/api-reference/combo-books/public-get_combo_ids). For details about a specific combo, use [public/get_combo_details](https://docs.deribit.com/api-reference/combo-books/public-get_combo_details).\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Fget_combos)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/get_combos\",\"currency\",\"instrument_id\",\"state\",\"state_timestamp\",\"creation_timestamp\",\"legs\",\"instrument_name\",\"amount\"],\"og:title\":\"public/get_combos\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/get_combos\",\"href\":\"/api-reference/combo-books/public-get_combos\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Session Management\",\"pages\":[{\"title\":\"private/disable_cancel_on_disconnect\",\"description\":\"Disable Cancel On Disconnect for the connection.\\n\\nWhen change is applied for the account, then every newly opened connection will start with **inactive** Cancel on Disconnect.\\n\\n**WebSocket Only:** This method is designed exclusively for WebSocket connections. Attempting to use it via REST/HTTP will result in an error response.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fdisable_cancel_on_disconnect)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/disable_cancel_on_disconnect\",\"scope\"],\"og:title\":\"private/disable_cancel_on_disconnect\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/disable_cancel_on_disconnect\",\"href\":\"/api-reference/session-management/private-disable_cancel_on_disconnect\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/enable_cancel_on_disconnect\",\"description\":\"$55\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/enable_cancel_on_disconnect\",\"scope\"],\"og:title\":\"private/enable_cancel_on_disconnect\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/enable_cancel_on_disconnect\",\"href\":\"/api-reference/session-management/private-enable_cancel_on_disconnect\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/get_cancel_on_disconnect\",\"description\":\"Read current Cancel On Disconnect configuration for the account.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fget_cancel_on_disconnect)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/get_cancel_on_disconnect\",\"scope\",\"enabled\"],\"og:title\":\"private/get_cancel_on_disconnect\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/get_cancel_on_disconnect\",\"href\":\"/api-reference/session-management/private-get_cancel_on_disconnect\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/disable_heartbeat\",\"description\":\"Stop sending heartbeat messages. This method takes no parameters.\\n\\n**WebSocket Only:** This method is designed exclusively for WebSocket connections. Attempting to use it via REST/HTTP will result in an error response.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Fdisable_heartbeat)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/disable_heartbeat\"],\"og:title\":\"public/disable_heartbeat\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/disable_heartbeat\",\"href\":\"/api-reference/session-management/public-disable_heartbeat\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/set_heartbeat\",\"description\":\"Signals the WebSocket connection to send and request heartbeats. Heartbeats can be used to detect stale connections.\\n\\nWhen heartbeats have been set up, the API server will send `heartbeat` messages and `test_request` messages. Your software should respond to `test_request` messages by sending a `/api/v2/public/test` request. If your software fails to do so, the API server will immediately close the connection. If your account is configured to cancel on disconnect, any orders opened over the connection will be cancelled.\\n\\n**WebSocket Only:** This method is designed exclusively for WebSocket connections. Attempting to use it via REST/HTTP will result in an error response.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Fset_heartbeat)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/set_heartbeat\",\"interval\"],\"og:title\":\"public/set_heartbeat\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/set_heartbeat\",\"href\":\"/api-reference/session-management/public-set_heartbeat\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Authentication\",\"pages\":[{\"title\":\"private/logout\",\"description\":\"$56\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/logout\",\"invalidate_token\"],\"og:title\":\"private/logout\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/logout\",\"href\":\"/api-reference/authentication/private-logout\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/auth\",\"description\":\"Authenticate using a Coinbase-issued credential.\\n\\n**Only `POST` is supported.** Send the JSON-RPC request in the request body; query-string credentials are not accepted.\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/auth\",\"grant_type\",\"token\"],\"og:title\":\"public/auth\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json post /public/auth\",\"href\":\"/api-reference/coinbase-deribit-app-api/rest-api/authentication/post-publicauth\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Wallet\",\"pages\":[{\"title\":\"private/submit_transfer_between_subaccounts\",\"description\":\"Transfer funds between two subaccounts or between a subaccount and the main account.\\n\\n**📖 Related Article:** [Managing Transfers](https://docs.deribit.com/articles/managing-transfers-api)\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fsubmit_transfer_between_subaccounts)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/submit_transfer_between_subaccounts\",\"currency\",\"amount\",\"destination\",\"source\",\"nonce\",\"created_timestamp\",\"type\",\"other_side\",\"state\",\"direction\",\"updated_timestamp\"],\"og:title\":\"private/submit_transfer_between_subaccounts\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/submit_transfer_between_subaccounts\",\"href\":\"/api-reference/wallet/private-submit_transfer_between_subaccounts\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Subscription Management\",\"pages\":[{\"title\":\"private/subscribe\",\"description\":\"Subscribe to one or more channels. The name of the channel determines what information will be provided, and in what form.\\n\\nFor a complete list of available subscription channels and their notification formats, see [Notifications and Subscriptions](https://docs.deribit.com/articles/notifications).\\n\\n**Note - This method has distinct API rate limiting requirements:** Sustained rate: ~3.3 requests/second. For more information, see [Rate Limits](https://docs.deribit.com/articles/rate-limits).\\n\\n**📖 Related Article:** [Market Data Collection Best Practices](https://docs.deribit.com/articles/market-data-collection-best-practices)\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Fsubscribe)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/subscribe\",\"channels\",\"label\"],\"og:title\":\"private/subscribe\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/subscribe\",\"href\":\"/api-reference/subscription-management/private-subscribe\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/unsubscribe\",\"description\":\"Unsubscribe from one or more channels. The response contains only the channels that were successfully unsubscribed in this request.\\n\\nFor a complete list of available subscription channels and their notification formats, see [Notifications and Subscriptions](https://docs.deribit.com/articles/notifications).\\n\\n**Note:** The `result` field in the response contains only the channels that were successfully processed and unsubscribed from this specific request. It does not include all previously subscribed topics. If a channel in the request is invalid, not subscribed, or fails validation, it will not appear in the result.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Funsubscribe)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/unsubscribe\",\"channels\"],\"og:title\":\"private/unsubscribe\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/unsubscribe\",\"href\":\"/api-reference/subscription-management/private-unsubscribe\",\"autogeneratedByOpenApi\":true},{\"title\":\"private/unsubscribe_all\",\"description\":\"Unsubscribe from all the channels subscribed so far. This method takes no parameters.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fprivate%2Funsubscribe_all)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"private/unsubscribe_all\"],\"og:title\":\"private/unsubscribe_all\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /private/unsubscribe_all\",\"href\":\"/api-reference/subscription-management/private-unsubscribe_all\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/subscribe\",\"description\":\"Subscribe to one or more channels. This is the same method as `/private/subscribe`, but it can only be used for 'public' channels.\\n\\nFor a complete list of available subscription channels and their notification formats, see [Notifications and Subscriptions](https://docs.deribit.com/articles/notifications).\\n\\n**Note - This method has distinct API rate limiting requirements:** Sustained rate: ~3.3 requests/second. For more information, see [Rate Limits](https://docs.deribit.com/articles/rate-limits).\\n\\n**📖 Related Article:** [Market Data Collection Best Practices](https://docs.deribit.com/articles/market-data-collection-best-practices)\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Fsubscribe)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/subscribe\",\"channels\"],\"og:title\":\"public/subscribe\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/subscribe\",\"href\":\"/api-reference/subscription-management/public-subscribe\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/unsubscribe\",\"description\":\"Unsubscribe from one or more channels. The response contains only the channels that were successfully unsubscribed in this request.\\n\\nFor a complete list of available subscription channels and their notification formats, see [Notifications and Subscriptions](https://docs.deribit.com/articles/notifications).\\n\\n**Note:** The `result` field in the response contains only the channels that were successfully processed and unsubscribed from this specific request. It does not include all previously subscribed topics. If a channel in the request is invalid, not subscribed, or fails validation, it will not appear in the result.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Funsubscribe)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/unsubscribe\",\"channels\"],\"og:title\":\"public/unsubscribe\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/unsubscribe\",\"href\":\"/api-reference/subscription-management/public-unsubscribe\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/unsubscribe_all\",\"description\":\"Unsubscribe from all the channels subscribed so far. This method takes no parameters.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Funsubscribe_all)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/unsubscribe_all\"],\"og:title\":\"public/unsubscribe_all\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/unsubscribe_all\",\"href\":\"/api-reference/subscription-management/public-unsubscribe_all\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Market Data\",\"pages\":[{\"title\":\"public/get_book_summary_by_currency\",\"description\":\"Retrieves summary information such as open interest, 24-hour volume, best bid/ask prices, last trade price, and other market statistics for all instruments in a given currency.\\n\\nResults can be filtered by instrument kind (future, option, etc.). This method provides a quick overview of market activity across all instruments for a currency.\\n\\n**Note:** For real-time updates, we recommend using the WebSocket subscription to `ticker.{instrument_name}.{interval}` instead of polling this endpoint.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Fget_book_summary_by_currency)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/get_book_summary_by_currency\",\"currency\",\"kind\",\"instrument_name\",\"high\",\"low\",\"base_currency\",\"quote_currency\",\"volume\",\"bid_price\",\"ask_price\",\"mid_price\",\"mark_price\",\"last\",\"open_interest\",\"creation_timestamp\",\"estimated_delivery_price\",\"volume_usd\",\"volume_notional\",\"current_funding\",\"funding_8h\",\"mark_iv\",\"interest_rate\",\"underlying_index\",\"underlying_price\",\"price_change\"],\"og:title\":\"public/get_book_summary_by_currency\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/get_book_summary_by_currency\",\"href\":\"/api-reference/market-data/public-get_book_summary_by_currency\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/get_book_summary_by_instrument\",\"description\":\"Retrieves summary information such as open interest, 24-hour volume, best bid/ask prices, last trade price, mark price, and other market statistics for a specific instrument.\\n\\nThis method provides a quick overview of current market activity and liquidity for a single instrument.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Fget_book_summary_by_instrument)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/get_book_summary_by_instrument\",\"instrument_name\",\"high\",\"low\",\"base_currency\",\"quote_currency\",\"volume\",\"bid_price\",\"ask_price\",\"mid_price\",\"mark_price\",\"last\",\"open_interest\",\"creation_timestamp\",\"estimated_delivery_price\",\"volume_usd\",\"volume_notional\",\"current_funding\",\"funding_8h\",\"mark_iv\",\"interest_rate\",\"underlying_index\",\"underlying_price\",\"price_change\"],\"og:title\":\"public/get_book_summary_by_instrument\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/get_book_summary_by_instrument\",\"href\":\"/api-reference/market-data/public-get_book_summary_by_instrument\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/get_contract_size\",\"description\":\"Retrieves the contract size (also known as contract multiplier) for a given instrument. The contract size is the value of one contract, expressed in the same unit as the order amount: USD for inverse (reversed) futures and perpetuals, and the base currency coin for options, spots, and linear futures and perpetuals.\\n\\nThis value is essential for calculating position values, margin requirements, and P\u0026L calculations. Different instruments may have different contract sizes.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Fget_contract_size)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/get_contract_size\",\"instrument_name\",\"contract_size\"],\"og:title\":\"public/get_contract_size\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/get_contract_size\",\"href\":\"/api-reference/market-data/public-get_contract_size\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/get_currencies\",\"description\":\"Retrieves all cryptocurrencies supported by the Deribit API. Returns a list of available currencies with their codes and basic information.\\n\\nThis method takes no parameters and is useful for discovering which currencies are available for trading on the platform.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Fget_currencies)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/get_currencies\",\"withdrawal_fee\",\"withdrawal_priorities\",\"min_withdrawal_fee\",\"currency\",\"currency_long\",\"min_confirmations\",\"coin_type\",\"in_cross_collateral_pool\",\"apr\",\"network_fee\",\"network_currency\",\"decimals\",\"currency_uuid\",\"name\",\"value\"],\"og:title\":\"public/get_currencies\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/get_currencies\",\"href\":\"/api-reference/market-data/public-get_currencies\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/get_delivery_prices\",\"description\":\"Retrieves historical delivery prices for a given index. Delivery prices are the settlement prices used when futures or options contracts expire and are settled.\\n\\nResults can be paginated using the `offset` and `count` parameters. This method is useful for analyzing historical settlement prices and understanding how contracts have been settled over time.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Fget_delivery_prices)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/get_delivery_prices\",\"index_name\",\"offset\",\"count\",\"records_total\",\"data\",\"date\",\"delivery_price\"],\"og:title\":\"public/get_delivery_prices\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/get_delivery_prices\",\"href\":\"/api-reference/market-data/public-get_delivery_prices\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/get_expirations\",\"description\":\"Retrieves all available expiration timestamps for instruments. This method can be used to discover which expiration dates are available for trading, which is useful for finding instruments with specific expiration dates.\\n\\nResults can be filtered by settlement currency, instrument kind (future or option), and currency pair. The response includes expiration timestamps in milliseconds since the UNIX epoch.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Fget_expirations)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/get_expirations\",\"currency\",\"kind\",\"currency_pair\"],\"og:title\":\"public/get_expirations\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/get_expirations\",\"href\":\"/api-reference/market-data/public-get_expirations\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/get_funding_chart_data\",\"description\":\"Retrieves funding rate chart data points for a PERPETUAL instrument within a given time period. The data is formatted for use in charting applications and includes funding rate values at regular intervals.\\n\\nUse the `length` parameter to specify the time period for which to retrieve chart data. This method is useful for visualizing funding rate trends over time.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Fget_funding_chart_data)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/get_funding_chart_data\",\"instrument_name\",\"length\",\"current_interest\",\"interest_8h\",\"data\",\"timestamp\",\"index_price\"],\"og:title\":\"public/get_funding_chart_data\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/get_funding_chart_data\",\"href\":\"/api-reference/market-data/public-get_funding_chart_data\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/get_funding_rate_history\",\"description\":\"Retrieves hourly historical funding rate (interest rate) data for a PERPETUAL instrument over a specified time period. Funding rates are periodic payments exchanged between long and short positions in perpetual contracts.\\n\\nThe response includes hourly funding rate values, which can be used to analyze funding rate trends and calculate historical funding costs. This method is applicable only for PERPETUAL instruments.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Fget_funding_rate_history)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/get_funding_rate_history\",\"instrument_name\",\"start_timestamp\",\"end_timestamp\",\"timestamp\",\"prev_index_price\",\"index_price\",\"interest_1h\",\"interest_8h\"],\"og:title\":\"public/get_funding_rate_history\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/get_funding_rate_history\",\"href\":\"/api-reference/market-data/public-get_funding_rate_history\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/get_funding_rate_value\",\"description\":\"Retrieves the funding rate (interest rate) value for a perpetual instrument over a specified time period. Funding rates are periodic payments exchanged between long and short positions in perpetual contracts.\\n\\nThis method is applicable only for PERPETUAL instruments. The funding rate is typically expressed as a percentage and is used to keep the perpetual contract price aligned with the underlying index price.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Fget_funding_rate_value)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/get_funding_rate_value\",\"instrument_name\",\"start_timestamp\",\"end_timestamp\"],\"og:title\":\"public/get_funding_rate_value\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/get_funding_rate_value\",\"href\":\"/api-reference/market-data/public-get_funding_rate_value\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/get_historical_volatility\",\"description\":\"Provides historical volatility data for a given cryptocurrency. Historical volatility measures the degree of price variation over a past period and is useful for risk assessment and option pricing.\\n\\nThe response includes volatility statistics calculated from historical price movements. This data can be used for portfolio risk analysis and understanding market conditions.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Fget_historical_volatility)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/get_historical_volatility\",\"currency\",\"timestamp\",\"value\"],\"og:title\":\"public/get_historical_volatility\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/get_historical_volatility\",\"href\":\"/api-reference/market-data/public-get_historical_volatility\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/get_index_chart_data\",\"description\":\"Returns historical price index chart data for the specified index name and time range. The data is formatted for use in charting applications and shows price index values over time.\\n\\nUse the `range` parameter to specify the time period for which to retrieve chart data. This method is useful for visualizing price index trends and historical movements.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Fget_index_chart_data)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/get_index_chart_data\",\"index_name\",\"range\"],\"og:title\":\"public/get_index_chart_data\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/get_index_chart_data\",\"href\":\"/api-reference/market-data/public-get_index_chart_data\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/get_index_price\",\"description\":\"Retrieves the current index price value for a given index name. Index prices are used as reference prices for mark price calculations and settlement.\\n\\nUse `get_index_price_names` or `get_supported_index_names` to retrieve available index names.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Fget_index_price)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/get_index_price\",\"index_name\",\"index_price\",\"estimated_delivery_price\"],\"og:title\":\"public/get_index_price\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/get_index_price\",\"href\":\"/api-reference/market-data/public-get_index_price\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/get_index_price_names\",\"description\":\"Retrieves the identifiers (names) of all supported price indexes. Price indexes are reference prices used for mark price calculations, settlement, and other market operations.\\n\\nWhen the `extended` parameter is set to `true`, the response includes additional information such as whether future combo creation and option combo creation are enabled for each index.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Fget_index_price_names)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/get_index_price_names\",\"extended\",\"name\",\"future_combo_creation_enabled\",\"option_combo_creation_enabled\"],\"og:title\":\"public/get_index_price_names\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/get_index_price_names\",\"href\":\"/api-reference/market-data/public-get_index_price_names\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/get_instrument\",\"description\":\"Retrieves detailed information about a specific instrument, including instrument specifications, contract details, tick size, settlement currency, expiration date (for futures and options), strike price (for options), underlying type, and other instrument parameters.\\n\\nThis method is useful for obtaining instrument metadata needed for trading operations and calculations.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Fget_instrument)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/get_instrument\",\"instrument_name\",\"kind\",\"settlement_currency\",\"counter_currency\",\"base_currency\",\"quote_currency\",\"min_trade_amount\",\"instrument_id\",\"is_active\",\"settlement_period\",\"creation_timestamp\",\"tick_size\",\"tick_size_steps\",\"expiration_timestamp\",\"strike\",\"option_type\",\"future_type\",\"instrument_type\",\"contract_size\",\"lot_size\",\"maker_commission\",\"taker_commission\",\"max_liquidation_commission\",\"block_trade_commission\",\"block_trade_tick_size\",\"block_trade_min_trade_amount\",\"max_leverage\",\"price_index\",\"underlying_type\",\"state\",\"base_currency_uuid\",\"quote_currency_uuid\",\"qty_tick_size\",\"index_id\",\"product_group\",\"is_csr\",\"is_cbe_routed\",\"above_price\"],\"og:title\":\"public/get_instrument\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/get_instrument\",\"href\":\"/api-reference/market-data/public-get_instrument\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/get_instruments\",\"description\":\"$57\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/get_instruments\",\"currency\",\"kind\",\"expired\",\"settlement_currency\",\"counter_currency\",\"base_currency\",\"quote_currency\",\"min_trade_amount\",\"instrument_name\",\"instrument_id\",\"is_active\",\"settlement_period\",\"creation_timestamp\",\"tick_size\",\"tick_size_steps\",\"expiration_timestamp\",\"strike\",\"option_type\",\"future_type\",\"instrument_type\",\"contract_size\",\"lot_size\",\"maker_commission\",\"taker_commission\",\"max_liquidation_commission\",\"block_trade_commission\",\"block_trade_tick_size\",\"block_trade_min_trade_amount\",\"max_leverage\",\"price_index\",\"underlying_type\",\"state\",\"base_currency_uuid\",\"quote_currency_uuid\",\"qty_tick_size\",\"index_id\",\"product_group\",\"is_csr\",\"is_cbe_routed\",\"above_price\"],\"og:title\":\"public/get_instruments\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/get_instruments\",\"href\":\"/api-reference/market-data/public-get_instruments\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/get_last_settlements_by_currency\",\"description\":\"$58\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/get_last_settlements_by_currency\",\"currency\",\"type\",\"count\",\"continuation\",\"search_start_timestamp\",\"settlements\",\"funding\",\"funded\",\"index_price\",\"instrument_name\",\"mark_price\",\"position\",\"profit_loss\",\"session_bankruptcy\",\"session_profit_loss\",\"session_tax\",\"session_tax_rate\",\"socialized\",\"timestamp\"],\"og:title\":\"public/get_last_settlements_by_currency\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/get_last_settlements_by_currency\",\"href\":\"/api-reference/market-data/public-get_last_settlements_by_currency\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/get_last_settlements_by_instrument\",\"description\":\"$59\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/get_last_settlements_by_instrument\",\"instrument_name\",\"type\",\"count\",\"continuation\",\"search_start_timestamp\",\"settlements\",\"funding\",\"funded\",\"index_price\",\"mark_price\",\"position\",\"profit_loss\",\"session_bankruptcy\",\"session_profit_loss\",\"session_tax\",\"session_tax_rate\",\"socialized\",\"timestamp\"],\"og:title\":\"public/get_last_settlements_by_instrument\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/get_last_settlements_by_instrument\",\"href\":\"/api-reference/market-data/public-get_last_settlements_by_instrument\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/get_last_trades_by_currency\",\"description\":\"Retrieves the latest trades that have occurred for instruments in a specific currency. Returns trade details including price, amount, direction, timestamp, and trade ID for all instruments in the currency.\\n\\nResults can be filtered by instrument kind and trade ID range or timestamp range. Use the `count` parameter to limit the number of trades returned, and `sorting` to control the order (ascending or descending by trade ID).\\n\\n**Note:** For currencies with spot instruments routed to Coinbase Exchange, this call is not supported when `kind` is `spot` or `any` — and `any` is the default when `kind` is omitted. A currency counts as routed when it is the base or the quote of a routed pair. Other kinds are unaffected. Use [Get product trades](https://docs.cdp.coinbase.com/api-reference/exchange-api/rest-api/products/get-product-trades) directly for full trade history by instrument.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Fget_last_trades_by_currency)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/get_last_trades_by_currency\",\"currency\",\"kind\",\"start_id\",\"end_id\",\"start_timestamp\",\"end_timestamp\",\"count\",\"sorting\",\"trades\",\"has_more\",\"trade_id\",\"trade_seq\",\"instrument_name\",\"timestamp\",\"starbase_timestamp\",\"direction\",\"tick_direction\",\"index_price\",\"price\",\"amount\",\"contracts\",\"iv\",\"liquidation\",\"mark_price\",\"block_trade_id\",\"block_trade_leg_count\",\"combo_id\",\"combo_trade_id\",\"starbase_match_id\",\"block_rfq_id\"],\"og:title\":\"public/get_last_trades_by_currency\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/get_last_trades_by_currency\",\"href\":\"/api-reference/market-data/public-get_last_trades_by_currency\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/get_last_trades_by_currency_and_time\",\"description\":\"Retrieves the latest trades that have occurred for instruments in a specific currency within a specified time range. Returns trade details including price, amount, direction, timestamp, and trade ID.\\n\\nResults can be filtered by instrument kind. Use the `count` parameter to limit the number of trades returned, and `sorting` to control the order (ascending or descending by trade ID).\\n\\n**Note:** For currencies with spot instruments routed to Coinbase Exchange, this call is not supported when `kind` is `spot` or `any` — and `any` is the default when `kind` is omitted. A currency counts as routed when it is the base or the quote of a routed pair. Other kinds are unaffected. Use [Get product trades](https://docs.cdp.coinbase.com/api-reference/exchange-api/rest-api/products/get-product-trades) directly for full trade history by instrument.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Fget_last_trades_by_currency_and_time)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/get_last_trades_by_currency_and_time\",\"currency\",\"kind\",\"start_timestamp\",\"end_timestamp\",\"count\",\"sorting\",\"trades\",\"has_more\",\"trade_id\",\"trade_seq\",\"instrument_name\",\"timestamp\",\"starbase_timestamp\",\"direction\",\"tick_direction\",\"index_price\",\"price\",\"amount\",\"contracts\",\"iv\",\"liquidation\",\"mark_price\",\"block_trade_id\",\"block_trade_leg_count\",\"combo_id\",\"combo_trade_id\",\"starbase_match_id\",\"block_rfq_id\"],\"og:title\":\"public/get_last_trades_by_currency_and_time\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/get_last_trades_by_currency_and_time\",\"href\":\"/api-reference/market-data/public-get_last_trades_by_currency_and_time\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/get_last_trades_by_instrument\",\"description\":\"Retrieves the latest trades that have occurred for a specific instrument. Returns trade details including price, amount, direction, timestamp, and trade ID.\\n\\nResults can be filtered by sequence number range or timestamp range. Use the `count` parameter to limit the number of trades returned, and `sorting` to control the order (ascending or descending by trade ID).\\n\\n**Note:** For spot instruments routed to Coinbase Exchange, this call is not supported. Use [Get product trades](https://docs.cdp.coinbase.com/api-reference/exchange-api/rest-api/products/get-product-trades) directly for full trade history.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Fget_last_trades_by_instrument)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/get_last_trades_by_instrument\",\"instrument_name\",\"start_seq\",\"end_seq\",\"start_timestamp\",\"end_timestamp\",\"count\",\"sorting\",\"trades\",\"has_more\",\"trade_id\",\"trade_seq\",\"timestamp\",\"starbase_timestamp\",\"direction\",\"tick_direction\",\"index_price\",\"price\",\"amount\",\"contracts\",\"iv\",\"liquidation\",\"mark_price\",\"block_trade_id\",\"block_trade_leg_count\",\"combo_id\",\"combo_trade_id\",\"starbase_match_id\",\"block_rfq_id\"],\"og:title\":\"public/get_last_trades_by_instrument\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/get_last_trades_by_instrument\",\"href\":\"/api-reference/market-data/public-get_last_trades_by_instrument\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/get_last_trades_by_instrument_and_time\",\"description\":\"Retrieves the latest trades that have occurred for a specific instrument within a specified time range. Returns trade details including price, amount, direction, timestamp, and trade ID.\\n\\nUse the `count` parameter to limit the number of trades returned, and `sorting` to control the order (ascending or descending by trade ID). This method is useful for analyzing trading activity over specific time periods.\\n\\n**Note:** For spot instruments routed to Coinbase Exchange, this call is not supported. Use [Get product trades](https://docs.cdp.coinbase.com/api-reference/exchange-api/rest-api/products/get-product-trades) directly for full trade history.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Fget_last_trades_by_instrument_and_time)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/get_last_trades_by_instrument_and_time\",\"instrument_name\",\"start_timestamp\",\"end_timestamp\",\"count\",\"sorting\",\"trades\",\"has_more\",\"trade_id\",\"trade_seq\",\"timestamp\",\"starbase_timestamp\",\"direction\",\"tick_direction\",\"index_price\",\"price\",\"amount\",\"contracts\",\"iv\",\"liquidation\",\"mark_price\",\"block_trade_id\",\"block_trade_leg_count\",\"combo_id\",\"combo_trade_id\",\"starbase_match_id\",\"block_rfq_id\"],\"og:title\":\"public/get_last_trades_by_instrument_and_time\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/get_last_trades_by_instrument_and_time\",\"href\":\"/api-reference/market-data/public-get_last_trades_by_instrument_and_time\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/get_mark_price_history\",\"description\":\"Retrieves 5-minute historical mark price data for an instrument. Mark prices are used for margin calculations and position valuations.\\n\\n**Note:** Currently, mark price history is available only for a subset of options that participate in volatility index calculations. All other instruments, including futures and perpetuals, will return an empty list.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Fget_mark_price_history)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/get_mark_price_history\",\"instrument_name\",\"start_timestamp\",\"end_timestamp\"],\"og:title\":\"public/get_mark_price_history\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/get_mark_price_history\",\"href\":\"/api-reference/market-data/public-get_mark_price_history\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/get_order_book\",\"description\":\"Retrieves the order book (bids and asks) for a given instrument, along with other market values such as best bid/ask prices, last trade price, mark price, and index price.\\n\\nThe order book depth can be controlled using the `depth` parameter, which accepts values from 1 to 10000. The response includes price levels sorted by price (bids descending, asks ascending).\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Fget_order_book)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/get_order_book\",\"instrument_name\",\"depth\",\"timestamp\",\"state\",\"stats\",\"open_interest\",\"best_bid_price\",\"best_bid_amount\",\"best_ask_price\",\"best_ask_amount\",\"index_price\",\"min_price\",\"max_price\",\"mark_price\",\"last_price\",\"underlying_price\",\"underlying_index\",\"interest_rate\",\"bid_iv\",\"ask_iv\",\"mark_iv\",\"greeks\",\"funding_8h\",\"current_funding\",\"delivery_price\",\"settlement_price\",\"bids\",\"asks\",\"volume\",\"low\",\"high\",\"price_change\",\"volume_usd\",\"delta\",\"gamma\",\"rho\",\"theta\",\"vega\"],\"og:title\":\"public/get_order_book\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/get_order_book\",\"href\":\"/api-reference/market-data/public-get_order_book\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/get_order_book_by_instrument_id\",\"description\":\"Retrieves the order book (bids and asks) for a given instrument ID, along with other market values such as best bid/ask prices, last trade price, mark price, and index price.\\n\\nThis method is similar to `get_order_book` but uses instrument ID instead of instrument name. The order book depth can be controlled using the `depth` parameter, which accepts values from 1 to 10000.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Fget_order_book_by_instrument_id)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/get_order_book_by_instrument_id\",\"instrument_id\",\"depth\",\"instrument_name\",\"timestamp\",\"state\",\"stats\",\"open_interest\",\"best_bid_price\",\"best_bid_amount\",\"best_ask_price\",\"best_ask_amount\",\"index_price\",\"min_price\",\"max_price\",\"mark_price\",\"last_price\",\"underlying_price\",\"underlying_index\",\"interest_rate\",\"bid_iv\",\"ask_iv\",\"mark_iv\",\"greeks\",\"funding_8h\",\"current_funding\",\"delivery_price\",\"settlement_price\",\"bids\",\"asks\",\"volume\",\"low\",\"high\",\"price_change\",\"volume_usd\",\"delta\",\"gamma\",\"rho\",\"theta\",\"vega\"],\"og:title\":\"public/get_order_book_by_instrument_id\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/get_order_book_by_instrument_id\",\"href\":\"/api-reference/market-data/public-get_order_book_by_instrument_id\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/get_supported_index_names\",\"description\":\"Retrieves the identifiers (names) of all supported price indexes, optionally filtered by index type. Price indexes are reference prices used for mark price calculations, settlement, and other market operations.\\n\\nUse the `type` parameter to filter indexes by type (e.g., spot, futures, etc.). This method helps discover available indexes for use with other API methods.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Fget_supported_index_names)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/get_supported_index_names\",\"type\",\"name\",\"future_combo_creation_enabled\",\"option_combo_creation_enabled\"],\"og:title\":\"public/get_supported_index_names\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/get_supported_index_names\",\"href\":\"/api-reference/market-data/public-get_supported_index_names\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/get_trade_volumes\",\"description\":\"Retrieves aggregated 24-hour trade volumes for different instrument types and currencies. The volume statistics include all executed trades across the platform.\\n\\n**Note:** Position moves are not included in this volume. Block trades and Block RFQ trades are included in the volume calculations.\\n\\nUse the `extended` parameter to include additional volume statistics and breakdowns.\\n\\n**Note:** For currencies with spot instruments routed to Coinbase Exchange, `spot_volume` is omitted, as are `spot_volume_7d` and `spot_volume_30d` when `extended` is used. Use [Get all product volume](https://docs.cdp.coinbase.com/api-reference/exchange-api/rest-api/products/get-all-product-volume) for venue spot volume.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Fget_trade_volumes)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/get_trade_volumes\",\"extended\",\"currency\",\"calls_volume\",\"puts_volume\",\"futures_volume\",\"spot_volume\",\"calls_volume_7d\",\"puts_volume_7d\",\"futures_volume_7d\",\"spot_volume_7d\",\"calls_volume_30d\",\"puts_volume_30d\",\"futures_volume_30d\",\"spot_volume_30d\"],\"og:title\":\"public/get_trade_volumes\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/get_trade_volumes\",\"href\":\"/api-reference/market-data/public-get_trade_volumes\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/get_tradingview_chart_data\",\"description\":\"Retrieves publicly available market data formatted for generating TradingView-compatible candle charts. The data includes open, high, low, close (OHLC) prices and volume for specified time intervals.\\n\\nUse the `chart_resolution` parameter to specify the candle interval (e.g., 1m, 5m, 1h, 1d). This method provides the standard format used by TradingView and other charting platforms.\\n\\n**Note:** For spot instruments routed to Coinbase Exchange, this call is not supported. Use [Get product candles](https://docs.cdp.coinbase.com/api-reference/exchange-api/rest-api/products/get-product-candles) instead.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Fget_tradingview_chart_data)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/get_tradingview_chart_data\",\"instrument_name\",\"start_timestamp\",\"end_timestamp\",\"resolution\",\"status\",\"ticks\",\"volume\",\"cost\",\"open\",\"close\",\"high\",\"low\"],\"og:title\":\"public/get_tradingview_chart_data\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/get_tradingview_chart_data\",\"href\":\"/api-reference/market-data/public-get_tradingview_chart_data\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/get_volatility_index_data\",\"description\":\"Retrieves volatility index (VIX) chart data formatted as candles. Volatility indexes measure market expectations of future volatility and are useful for risk assessment and trading strategies.\\n\\nUse the `vix_resolution` parameter to specify the candle interval. The data shows historical volatility index values over time and is formatted for use in charting applications.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Fget_volatility_index_data)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/get_volatility_index_data\",\"currency\",\"start_timestamp\",\"end_timestamp\",\"resolution\",\"data\",\"continuation\"],\"og:title\":\"public/get_volatility_index_data\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/get_volatility_index_data\",\"href\":\"/api-reference/market-data/public-get_volatility_index_data\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/ticker\",\"description\":\"Retrieves the ticker (24-hour statistics) for a specific instrument. The ticker includes the last trade price, best bid/ask prices, 24-hour high/low, 24-hour volume, open interest, mark price, and other market statistics.\\n\\nThis is a lightweight method for getting current market data for a single instrument. For real-time updates, consider using WebSocket subscriptions to ticker channels.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Fticker)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/ticker\",\"instrument_name\",\"timestamp\",\"state\",\"stats\",\"open_interest\",\"best_bid_price\",\"best_bid_amount\",\"best_ask_price\",\"best_ask_amount\",\"index_price\",\"min_price\",\"max_price\",\"mark_price\",\"last_price\",\"underlying_price\",\"underlying_index\",\"interest_rate\",\"bid_iv\",\"ask_iv\",\"mark_iv\",\"greeks\",\"funding_8h\",\"current_funding\",\"interest_value\",\"delivery_price\",\"settlement_price\",\"estimated_delivery_price\",\"is_anchor_breached\",\"anchor_min_price\",\"anchor_max_price\",\"volume\",\"low\",\"high\",\"price_change\",\"volume_usd\",\"delta\",\"gamma\",\"rho\",\"theta\",\"vega\"],\"og:title\":\"public/ticker\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/ticker\",\"href\":\"/api-reference/market-data/public-ticker\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/tickers_by_currency\",\"description\":\"Retrieves tickers (24-hour statistics) for all open instruments of a given currency.\\n\\nOptionally filter by instrument kind (future, option, spot) and specify orderbook depth (1, 3, or 10).\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Ftickers_by_currency)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/tickers_by_currency\",\"currency\",\"kind\",\"depth\"],\"og:title\":\"public/tickers_by_currency\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/tickers_by_currency\",\"href\":\"/api-reference/market-data/public-tickers_by_currency\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Supporting\",\"pages\":[{\"title\":\"public/get_time\",\"description\":\"Retrieves the current time (in milliseconds). This API endpoint can be used to check the clock skew between your software and Deribit's systems.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Fget_time)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/get_time\"],\"og:title\":\"public/get_time\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/get_time\",\"href\":\"/api-reference/supporting/public-get_time\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/hello\",\"description\":\"Method used to introduce the client software connected to Deribit platform over websocket. Provided data may have an impact on the maintained connection and will be collected for internal statistical purposes. In response, Deribit will also introduce itself.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Fhello)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/hello\",\"client_name\",\"client_version\",\"version\"],\"og:title\":\"public/hello\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/hello\",\"href\":\"/api-reference/supporting/public-hello\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/status\",\"description\":\"Method used to get information about locked currencies\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Fstatus)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/status\",\"locked\",\"locked_indices\"],\"og:title\":\"public/status\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/status\",\"href\":\"/api-reference/supporting/public-status\",\"autogeneratedByOpenApi\":true},{\"title\":\"public/test\",\"description\":\"Tests the connection to the API server, and returns its version. You can use this to make sure the API is reachable, and matches the expected version.\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Ftest)\\n\\n\",\"deprecated\":null,\"version\":null,\"keywords\":[\"public/test\",\"expected_result\",\"version\"],\"og:title\":\"public/test\",\"openapi\":\"/api-reference/coinbase-deribit-app-api/adv-starbase-openapi.json get /public/test\",\"href\":\"/api-reference/supporting/public-test\",\"autogeneratedByOpenApi\":true}]}]},{\"group\":\"Global Derivatives - WS Streams\",\"pages\":[{\"group\":\"Announcements\",\"pages\":[{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json announcements\",\"title\":\"announcements \",\"description\":\"General announcements concerning the Deribit platform.\\n\\nSubscribe to receive operational messages such as maintenance notices, incidents, and important platform updates.\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/announcements/announcements\"}]},{\"group\":\"Orderbook\",\"pages\":[{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json book.(instrument_name).(group).(depth).(interval)\",\"title\":\"book.(instrument_name).(group).(depth).(interval) \",\"description\":\"Aggregated order book updates for a specific instrument.\\n\\nNotifications are sent once per specified `interval`, with prices grouped (rounded) according to `group`, and the book truncated to the specified `depth` (number of price levels).\\n\\nThe `asks` and `bids` fields are both lists of `[price, amount]` pairs.\\n\\n- `price`: price level, rounded according to `group` (USD per BTC)\\n- `amount`: total amount at that price level\\n\\nFor Starbase-routed instruments, the published price levels include accepted mass-quote liquidity.\\n\\n**Units:** For perpetual and inverse futures the amount is in USD units. For options and linear futures it is in the underlying base currency coin.\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/orderbook/bookinstrument_namegroupdepthinterval\"},{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json book.(instrument_name).(interval)\",\"title\":\"book.(instrument_name).(interval) \",\"description\":\"$5a\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/orderbook/bookinstrument_nameinterval\"}]},{\"group\":\"Market Data\",\"pages\":[{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json chart.trades.(instrument_name).(resolution)\",\"title\":\"chart.trades.(instrument_name).(resolution) \",\"description\":\"Publicly available market data used to generate a TradingView trade candle chart.\\n\\nDuring a single resolution period, many events can be sent, each with updated values for the recent period.\\n\\n**Notice:** When there is no trade during the requested resolution period (e.g. 1 minute), a filling sample is generated which uses data from the last available trade candle (open and close values).\\n\\n**Note:** For spot instruments routed to Coinbase Exchange, this channel is not supported. Use [Get product candles](https://docs.cdp.coinbase.com/api-reference/exchange-api/rest-api/products/get-product-candles) instead.\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/market-data/charttradesinstrument_nameresolution\"},{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json deribit_price_index.(index_name)\",\"title\":\"deribit_price_index.(index_name) \",\"description\":\"Deribit index price updates for the given `index_name` (current index value).\\n\\nUse this channel to track the real-time value of a Deribit index (e.g., `btc_usd`), which is used across pricing, margining, and settlement-related calculations.\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/market-data/deribit_price_indexindex_name\"},{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json deribit_price_ranking.(index_name)\",\"title\":\"deribit_price_ranking.(index_name) \",\"description\":\"Price ranking updates for the component exchanges used to calculate the Deribit index.\\n\\nUse this channel to see per-exchange price contributions that feed into the index calculation for the given `index_name`.\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/market-data/deribit_price_rankingindex_name\"},{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json deribit_price_statistics.(index_name)\",\"title\":\"deribit_price_statistics.(index_name) \",\"description\":\"Basic statistics for the Deribit index.\\n\\nProvides statistical information related to the given `index_name` (e.g., aggregated stats derived from index updates). Useful for monitoring index behavior over time.\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/market-data/deribit_price_statisticsindex_name\"},{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json deribit_volatility_index.(index_name)\",\"title\":\"deribit_volatility_index.(index_name) \",\"description\":\"Volatility index updates for the given `index_name`.\\n\\nUse this channel to receive volatility index values (e.g., DVOL-like measures) as they update.\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/market-data/deribit_volatility_indexindex_name\"},{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json estimated_expiration_price.(index_name)\",\"title\":\"estimated_expiration_price.(index_name) \",\"description\":\"Estimated expiration (delivery) price updates for the given `index_name`.\\n\\nProvides calculated estimates of the ending price used around expirations/settlement. Useful for monitoring expected settlement levels.\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/market-data/estimated_expiration_priceindex_name\"},{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json incremental_ticker.(instrument_name)\",\"title\":\"incremental_ticker.(instrument_name) \",\"description\":\"Real-time ticker updates for an instrument, delivered as a snapshot followed by incremental updates.\\n\\n- The first notification contains the full ticker snapshot.\\n- Subsequent notifications contain only fields that changed since the previous update.\\n\\nThis event is sent at most once per second.\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/market-data/incremental_tickerinstrument_name\"},{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json instrument.creation.(kind).(currency)\",\"title\":\"instrument.creation.(kind).(currency) \",\"description\":\"Notification published once when an instrument is created, carrying full instrument data in the same format as `public/get_instruments`.\\n\\nThe notification fires exactly once at creation time, regardless of the instrument's initial state.\\n\\n**Subscription examples:**\\n\\n| Channel | Description |\\n|---|---|\\n| `instrument.creation.any.any` | All instruments |\\n| `instrument.creation.future.BTC` | BTC futures only |\\n| `instrument.creation.option.any` | All options |\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/market-data/instrumentcreationkindcurrency\"},{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json instrument.state.(kind).(currency)\",\"title\":\"instrument.state.(kind).(currency) \",\"description\":\"Notifications about new or terminated instruments of a given kind in a given currency.\\n\\nUse this channel to track instrument lifecycle events (new listings, expirations/terminations) without polling.\\n\\n**Note:** Our system does not send notifications when currencies are locked. Users are advised to subscribe to the [platform_state](https://docs.deribit.com/subscriptions/platform/platform_state) channel to monitor the state of currencies actively.\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/market-data/instrumentstatekindcurrency\"},{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json markprice.options.(index_name)\",\"title\":\"markprice.options.(index_name) \",\"description\":\"Options mark price updates for the given `index_name`.\\n\\nUse this channel to receive mark prices for options under the given index, useful for valuation, risk monitoring, and P\u0026L calculations.\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/market-data/markpriceoptionsindex_name\"},{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json perpetual.(instrument_name).(interval)\",\"title\":\"perpetual.(instrument_name).(interval) \",\"description\":\"Provide current interest rate - but only for **perpetual** instruments. Other types won't generate any notification.\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/market-data/perpetualinstrument_nameinterval\"},{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json quote.(instrument_name)\",\"title\":\"quote.(instrument_name) \",\"description\":\"Best bid/ask price and size for a specific instrument.\\n\\nThis subscription provides top-of-book updates (best bid and best ask) without the full depth of the order book. Use it when you only need the current spread and top sizes.\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/market-data/quoteinstrument_name\"},{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json ticker.(instrument_name).(interval)\",\"title\":\"ticker.(instrument_name).(interval) \",\"description\":\"$5b\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/market-data/tickerinstrument_nameinterval\"}]},{\"group\":\"Platform\",\"pages\":[{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json platform_state\",\"title\":\"platform_state \",\"description\":\"Platform state notifications.\\n\\nUse this channel to monitor whether the Deribit platform is operational and to detect maintenance periods or partial outages that may affect trading, authentication, or market data.\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/platform/platform_state\"},{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json platform_state.public_methods_state\",\"title\":\"platform_state.public_methods_state \",\"description\":\"Notifications indicating whether unauthenticated (public) requests are currently allowed.\\n\\nThis is useful for monitoring service availability for public endpoints (e.g., market data) without authentication.\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/platform/platform_statepublic_methods_state\"}]},{\"group\":\"Trades\",\"pages\":[{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json trades.(instrument_name).(interval)\",\"title\":\"trades.(instrument_name).(interval) \",\"description\":\"Trade notifications for a specific instrument.\\n\\nUse this channel to receive executed trades as they happen for the given instrument. The `interval` controls how frequently trade events are aggregated.\\n\\n**Note:** For spot instruments routed to Coinbase Exchange, this channel is not supported. Use the [`matches` channel](https://docs.cdp.coinbase.com/exchange/websocket-feed/channels) for the full trade tape. For user trades, orders and changes, use the `user` channels.\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/trades/tradesinstrument_nameinterval\"},{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json trades.(kind).(currency).(interval)\",\"title\":\"trades.(kind).(currency).(interval) \",\"description\":\"Trade notifications across all instruments for a given kind and currency.\\n\\nUse this channel when you want a consolidated stream of trades across all instruments of a specific `kind` (e.g., futures, options) and `currency`. The `interval` controls aggregation frequency.\\n\\n**Note:** For spot instruments routed to Coinbase Exchange, this channel is not supported with `kind` = `spot`: the subscription is rejected for any currency that is the base or the quote of a routed pair, and for `currency` = `any` whenever any pair is routed. Other kinds are unaffected. Use the [`matches` channel](https://docs.cdp.coinbase.com/exchange/websocket-feed/channels) for the full trade tape.\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/trades/tradeskindcurrencyinterval\"}]},{\"group\":\"User\",\"pages\":[{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json user.access_log\",\"title\":\"user.access_log \",\"description\":\"Security event notifications for the account.\\n\\nUse this channel to monitor account-related security events (e.g., access log entries) and build alerting around suspicious activity.\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/user/useraccess_log\"},{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json user.changes.(instrument_name).(interval)\",\"title\":\"user.changes.(instrument_name).(interval) \",\"description\":\"User change stream (orders, trades, and related updates) for a specific instrument.\\n\\nThis channel provides a consolidated private update stream for your account for the given instrument. Use it when you want a single feed instead of subscribing to orders and trades separately.\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/user/userchangesinstrument_nameinterval\"},{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json user.changes.(kind).(currency).(interval)\",\"title\":\"user.changes.(kind).(currency).(interval) \",\"description\":\"User change stream (orders, trades, and related updates) across all instruments for a given kind and currency.\\n\\nThis channel provides a consolidated private update stream for your account across all matching instruments. Use it when you want a single feed instead of subscribing to orders and trades separately.\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/user/userchangeskindcurrencyinterval\"},{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json user.combo_trades.(instrument_name).(interval)\",\"title\":\"user.combo_trades.(instrument_name).(interval) \",\"description\":\"User trade notifications for a specific combo instrument.\\n\\nTrades include a `legs` field describing the underlying legs of the combo. The `interval` controls aggregation frequency.\\n\\n**Block RFQ trades:** Block RFQ does not support combo instruments. RFQ-executed trades do not appear in this channel.\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/user/usercombo_tradesinstrument_nameinterval\"},{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json user.combo_trades.(kind).(currency).(interval)\",\"title\":\"user.combo_trades.(kind).(currency).(interval) \",\"description\":\"User trade notifications across all combo instruments for a given kind and currency.\\n\\nTrades include a `legs` field describing the underlying legs. The `interval` controls aggregation frequency.\\n\\n**Block RFQ trades:** Block RFQ does not support combo instruments. RFQ-executed trades do not appear in this channel.\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/user/usercombo_tradeskindcurrencyinterval\"},{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json user.isolated.changes.(instrument_name).(interval)\",\"title\":\"user.isolated.changes.(instrument_name).(interval) \",\"description\":\"Lets a **main** account observe position, order, and trade state changes across all of its **isolated-margin subaccounts** for a specific instrument.\\n\\nDelivers combined notifications of state changes across all isolated-margin subaccounts bound to the specified instrument. Requires the `trade:read` scope on an API key belonging to the **main account**.\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/user/userisolatedchangesinstrument_nameinterval\"},{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json user.isolated.changes.(kind).(currency).(interval)\",\"title\":\"user.isolated.changes.(kind).(currency).(interval) \",\"description\":\"Lets a **main** account observe position, order, and trade state changes across all of its **isolated-margin subaccounts** for a given instrument kind and currency.\\n\\nDelivers combined notifications of state changes across all isolated-margin subaccounts. Isolated margin supports futures trading only. Requires the `trade:read` scope on an API key belonging to the **main account**.\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/user/userisolatedchangeskindcurrencyinterval\"},{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json user.isolated.liquidation\",\"title\":\"user.isolated.liquidation \",\"description\":\"Lets a **main** account observe the liquidation, ADL, and LSP activity of all of its **isolated-margin subaccounts**, without subscribing to each subaccount's own `user.liquidation` channel individually.\\n\\nEvery event on this channel is a fan-out copy of an event also delivered on the affected subaccount's own `user.liquidation` channel — the payload is identical, including `isolated: true` and the subaccount's `user_id`. The main account's *own* liquidation activity is never delivered here; it stays on the main account's regular `user.liquidation` channel.\\n\\nRequires the `account:read` scope on an API key belonging to the **main account**, and is only available while isolated margin is enabled on the platform.\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/user/userisolatedliquidation\"},{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json user.isolated.orders.(instrument_name).(interval)\",\"title\":\"user.isolated.orders.(instrument_name).(interval) \",\"description\":\"Lets a **main** account observe order updates across all of its **isolated-margin subaccounts** for a specific instrument, without subscribing to each subaccount individually.\\n\\nDelivers real-time order state changes (placement, fill, edit, cancellation) for isolated-margin subaccounts bound to the specified instrument. Requires the `trade:read` scope on an API key belonging to the **main account**.\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/user/userisolatedordersinstrument_nameinterval\"},{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json user.isolated.orders.(kind).(currency).(interval)\",\"title\":\"user.isolated.orders.(kind).(currency).(interval) \",\"description\":\"Lets a **main** account observe order updates across all of its **isolated-margin subaccounts** for a given instrument kind and currency, without subscribing to each subaccount individually.\\n\\nDelivers real-time order state changes for isolated-margin subaccounts. Isolated margin supports futures trading only. Requires the `trade:read` scope on an API key belonging to the **main account**.\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/user/userisolatedorderskindcurrencyinterval\"},{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json user.isolated.portfolio.(currency)\",\"title\":\"user.isolated.portfolio.(currency) \",\"description\":\"Lets a **main** account observe portfolio balance and risk updates across all of its active **isolated-margin subaccounts** for a specified currency (or `any`).\\n\\nDelivers real-time account and portfolio notifications for active isolated-margin subaccounts. Requires the `trade:read` or `account:read` scope on an API key belonging to the **main account**.\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/user/userisolatedportfoliocurrency\"},{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json user.isolated.trades.(instrument_name).(interval)\",\"title\":\"user.isolated.trades.(instrument_name).(interval) \",\"description\":\"Lets a **main** account observe trade executions across all of its **isolated-margin subaccounts** for a specific instrument, without subscribing to each subaccount individually.\\n\\nDelivers real-time trade execution notifications for isolated-margin subaccounts bound to the specified instrument. Requires the `trade:read` scope on an API key belonging to the **main account**.\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/user/userisolatedtradesinstrument_nameinterval\"},{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json user.isolated.trades.(kind).(currency).(interval)\",\"title\":\"user.isolated.trades.(kind).(currency).(interval) \",\"description\":\"Lets a **main** account observe trade executions across all of its **isolated-margin subaccounts** for a given instrument kind and currency, without subscribing to each subaccount individually.\\n\\nDelivers real-time trade execution notifications for isolated-margin subaccounts. Isolated margin supports futures trading only. Requires the `trade:read` scope on an API key belonging to the **main account**.\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/user/userisolatedtradeskindcurrencyinterval\"},{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json user.lock\",\"title\":\"user.lock \",\"description\":\"Notifications when the account is locked or unlocked.\\n\\nUse this channel to react to account lock events (e.g., pause trading workflows) and to detect when access is restored.\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/user/userlock\"},{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json user.orders.(instrument_name).(interval)\",\"title\":\"user.orders.(instrument_name).(interval) \",\"description\":\"User order updates for a specific instrument (aggregated).\\n\\nUse this channel to receive private order updates for the given instrument, aggregated according to `interval`.\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/user/userordersinstrument_nameinterval\"},{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json user.orders.(instrument_name).raw\",\"title\":\"user.orders.(instrument_name).raw \",\"description\":\"User order updates for a specific instrument (raw stream).\\n\\nUse this channel to receive private order updates for the given instrument with the highest granularity (raw). Prefer this for real-time order state tracking.\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/user/userordersinstrument_nameraw\"},{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json user.orders.(kind).(currency).(interval)\",\"title\":\"user.orders.(kind).(currency).(interval) \",\"description\":\"User order updates across all instruments for a given kind and currency (aggregated).\\n\\nUse this channel to receive private order updates across all matching instruments, aggregated according to `interval`.\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/user/userorderskindcurrencyinterval\"},{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json user.orders.(kind).(currency).raw\",\"title\":\"user.orders.(kind).(currency).raw \",\"description\":\"User order updates across all instruments for a given kind and currency (raw stream).\\n\\nUse this channel to receive private order updates across all matching instruments with the highest granularity (raw).\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/user/userorderskindcurrencyraw\"},{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json user.portfolio.(currency)\",\"title\":\"user.portfolio.(currency) \",\"description\":\"$5c\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/user/userportfoliocurrency\"},{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json user.position_lock\",\"title\":\"user.position_lock \",\"description\":\"Notifications when position lock state is enabled or disabled for the user.\\n\\nUse this channel to monitor risk-control position lock events (which restrict opening or expanding positions) and react immediately when restrictions are updated.\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/user/userposition_lock\"},{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json user.trades.(instrument_name).(interval)\",\"title\":\"user.trades.(instrument_name).(interval) \",\"description\":\"User trade notifications for a specific instrument.\\n\\nReceive private trade events for your account for the given instrument. The `interval` controls how frequently events are aggregated.\\n\\n**Block RFQ trades:** Trades resulting from Block RFQ execution are included in this channel. These trades carry the following additional fields:\\n- `block_rfq_id` — ID of the Block RFQ.\\n- `block_trade_id` — ID of the resulting block trade.\\n- `block_rfq_quote_id` — ID of the accepted quote (present on the **maker** side only).\\n- `order_id` — always present for direct trade participants (makers and takers).\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/user/usertradesinstrument_nameinterval\"},{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json user.trades.(kind).(currency).(interval)\",\"title\":\"user.trades.(kind).(currency).(interval) \",\"description\":\"User trade notifications across all instruments for a given kind and currency.\\n\\nReceive a consolidated stream of your private trades across all instruments matching the specified `kind` and `currency`. The `interval` controls aggregation frequency.\\n\\n**Block RFQ trades:** Trades resulting from Block RFQ execution are included in this channel. See `user.trades.{instrument_name}.{interval}` for the complete list of Block RFQ-specific fields.\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/user/usertradeskindcurrencyinterval\"},{\"asyncapi\":\"api-reference/coinbase-deribit-app-api/adv-starbase-asyncapi.json user.trailing_orders.trigger_price.(currency)\",\"title\":\"user.trailing_orders.trigger_price.(currency) \",\"description\":\"Real-time notifications for active trailing order trigger prices in the specified currency.\\n\\nUse this channel to track updated trigger prices for active trailing stop orders as market index or mark prices move.\\n\",\"href\":\"/api-reference/coinbase-deribit-app-api/websocket/user/usertrailing_orderstrigger_pricecurrency\"}]}]}]},{\"dropdown\":\"Coinbase Business API\",\"icon\":\"https://mintlify-assets.b-cdn.net/coinbase-0.svg\",\"groups\":[{\"group\":\"REST API\",\"pages\":[{\"title\":\"Welcome to Coinbase Business API\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/api-reference/business-api/rest-api/introduction\"},{\"group\":\"Checkouts\",\"pages\":[{\"title\":\"Checkouts API Reference\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/api-reference/business-api/rest-api/checkouts/introduction\"},{\"openapi\":\"post /api/v1/checkouts\",\"playground\":\"simple\",\"title\":\"Create Checkout\",\"description\":\"Creates a new checkout. Returns a payment URL to redirect your customer to. Each checkout is single-use.\",\"href\":\"/api-reference/business-api/rest-api/checkouts/create-checkout\"},{\"openapi\":\"get /api/v1/checkouts\",\"playground\":\"simple\",\"title\":\"List Checkouts\",\"description\":\"Retrieves a paginated list of checkouts.\",\"href\":\"/api-reference/business-api/rest-api/checkouts/list-checkouts\"},{\"openapi\":\"get /api/v1/checkouts/{id}\",\"playground\":\"simple\",\"title\":\"Get Checkout\",\"description\":\"Retrieves details of a specific checkout by ID.\",\"href\":\"/api-reference/business-api/rest-api/checkouts/get-checkout\"},{\"openapi\":\"post /api/v1/checkouts/{id}/deactivate\",\"playground\":\"simple\",\"title\":\"Deactivate Checkout\",\"description\":\"Deactivates a checkout, preventing it from accepting further payments. Only `ACTIVE` checkouts can be deactivated.\",\"href\":\"/api-reference/business-api/rest-api/checkouts/deactivate-checkout\"},{\"openapi\":\"post /api/v1/checkouts/{id}/refund\",\"playground\":\"simple\",\"title\":\"Refund Checkout\",\"description\":\"Initiates a refund for a completed checkout. Only `COMPLETED` or `PARTIALLY_REFUNDED` checkouts can be refunded.\",\"href\":\"/api-reference/business-api/rest-api/checkouts/refund-checkout\"}]},{\"group\":\"Invoicing\",\"pages\":[{\"title\":\"Invoicing API Reference\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/api-reference/business-api/rest-api/invoicing/introduction\"},{\"openapi\":\"get /api/v1/invoices\",\"playground\":\"simple\",\"title\":\"List Invoices\",\"description\":\"Retrieves a paginated list of invoices for the authenticated user's entity.\",\"href\":\"/api-reference/business-api/rest-api/invoicing/list-invoices\"},{\"openapi\":\"get /api/v1/invoices/{invoiceUuid}\",\"playground\":\"simple\",\"title\":\"Get Invoice\",\"description\":\"Retrieves details of a specific invoice by UUID.\",\"href\":\"/api-reference/business-api/rest-api/invoicing/get-invoice\"}]},{\"group\":\"Advanced Trade APIs\",\"pages\":[{\"title\":\"API Reference\",\"url\":\"/api-reference/advanced-trade-api/rest-api/introduction\",\"description\":null,\"href\":\"/coinbase-business/advanced-trade-apis/api-reference\"}]},{\"group\":\"Transfer APIs\",\"pages\":[{\"title\":\"Send Crypto\",\"description\":null,\"href\":\"/coinbase-business/transfer-apis/send-crypto\"},{\"title\":\"Onchain Addresses\",\"description\":null,\"href\":\"/coinbase-business/transfer-apis/onchain-addresses\"},{\"title\":\"Fiat Deposits\",\"sidebarTitle\":\"Deposits Fiat\",\"description\":null,\"href\":\"/coinbase-business/transfer-apis/deposit-fiat\"},{\"title\":\"Fiat Withdrawals\",\"sidebarTitle\":\"Withdrawals Fiat\",\"description\":null,\"href\":\"/coinbase-business/transfer-apis/withdraw-fiat\"},{\"title\":\"Travel Rule Fields for Crypto Sends Guide\",\"sidebarTitle\":\"Travel Rule\",\"description\":null,\"href\":\"/coinbase-business/transfer-apis/travel-rule\"},{\"title\":\"Supported Virtual Asset Service Provider (VASP) Tables\",\"sidebarTitle\":\"VASPs\",\"description\":null,\"href\":\"/coinbase-business/transfer-apis/vasps\"}]},{\"group\":\"Track APIs\",\"pages\":[{\"title\":\"Accounts\",\"description\":null,\"href\":\"/coinbase-business/track-apis/accounts\"},{\"title\":\"Transactions\",\"description\":null,\"href\":\"/coinbase-business/track-apis/transactions\"},{\"title\":\"Data API - Currencies\",\"sidebarTitle\":\"Currencies\",\"description\":null,\"href\":\"/coinbase-business/track-apis/currencies\"},{\"title\":\"Data API- Exchange Rates\",\"sidebarTitle\":\"Exchange Rates\",\"description\":null,\"href\":\"/coinbase-business/track-apis/exchange-rates\"},{\"title\":\"Data API- Prices\",\"sidebarTitle\":\"Prices\",\"description\":null,\"href\":\"/coinbase-business/track-apis/prices\"},{\"title\":\"Data API- Time\",\"sidebarTitle\":\"Time\",\"description\":null,\"href\":\"/coinbase-business/track-apis/time\"}]}]}]},{\"dropdown\":\"Coinbase Exchange API\",\"icon\":\"https://mintlify-assets.b-cdn.net/exchangeProduct-1.svg\",\"groups\":[{\"group\":\"REST API\",\"pages\":[{\"title\":\"Welcome to Coinbase Exchange API\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/api-reference/exchange-api/rest-api/introduction\"},{\"title\":\"Exchange REST API Requests\",\"sidebarTitle\":\"Requests\",\"description\":null,\"href\":\"/exchange/rest-api/requests\"},{\"title\":\"Exchange REST API Authentication\",\"sidebarTitle\":\"Authentication\",\"description\":null,\"href\":\"/exchange/rest-api/authentication\"},{\"title\":\"REST Rate Limits Overview\",\"sidebarTitle\":\"Rate Limits\",\"description\":null,\"href\":\"/exchange/rest-api/rate-limits\"},{\"title\":\"Exchange REST API Pagination\",\"sidebarTitle\":\"Pagination\",\"description\":null,\"href\":\"/exchange/rest-api/pagination\"},{\"title\":\"Exchange REST API SDKs\",\"sidebarTitle\":\"SDKs\",\"description\":null,\"href\":\"/exchange/rest-api/sdks\"},{\"title\":\"Exchange Types\",\"sidebarTitle\":\"Types\",\"description\":null,\"href\":\"/exchange/rest-api/types\"},{\"group\":\"Accounts\",\"pages\":[{\"title\":\"Get a single account by id\",\"openapi\":\"GET  /accounts/{account_id}\",\"playground\":\"simple\",\"description\":\"Information for a single account. Use this endpoint when you know the account_id. API key must belong to the same profile as the account.\",\"href\":\"/api-reference/exchange-api/rest-api/accounts/get-single-account-by-id\"},{\"title\":\"Get a single account's holds\",\"openapi\":\"GET /accounts/{account_id}/holds\",\"playground\":\"simple\",\"description\":\"List the holds of an account that belong to the same profile as the API key. Holds are placed on an account for any active orders or pending withdraw requests. As an order is filled, the hold amount is updated. If an order is canceled, any remaining hold is removed. For withdrawals, the hold is removed after it is completed.\",\"href\":\"/api-reference/exchange-api/rest-api/accounts/get-single-account-hold\"},{\"title\":\"Get a single account's ledger\",\"openapi\":\"GET /accounts/{account_id}/ledger\",\"playground\":\"simple\",\"description\":\"Lists ledger activity for an account. This includes anything that would affect the accounts balance - transfers, trades, fees, etc.\",\"href\":\"/api-reference/exchange-api/rest-api/accounts/get-single-account-ledger\"},{\"title\":\"Get a single account's transfers\",\"openapi\":\"GET /accounts/{account_id}/transfers\",\"playground\":\"simple\",\"description\":\"Lists past withdrawals and deposits for an account.\",\"href\":\"/api-reference/exchange-api/rest-api/accounts/get-single-account-transfer\"},{\"title\":\"Get all accounts for a profile\",\"openapi\":\"GET /accounts\",\"playground\":\"simple\",\"description\":\"Get a list of trading accounts from the profile of the API key.\",\"href\":\"/api-reference/exchange-api/rest-api/accounts/get-all-account-profile\"}]},{\"group\":\"Address Book\",\"pages\":[{\"title\":\"Add addresses\",\"openapi\":\"POST /address-book\",\"playground\":\"simple\",\"description\":\"Add new addresses to address book\",\"href\":\"/api-reference/exchange-api/rest-api/address-book/add-addresses\"},{\"title\":\"Delete address\",\"openapi\":\"DELETE  /address-book/{id}\",\"playground\":\"simple\",\"description\":\"Delete address from address book\",\"href\":\"/api-reference/exchange-api/rest-api/address-book/delete-address\"},{\"title\":\"Get address book\",\"openapi\":\"GET /address-book\",\"playground\":\"simple\",\"description\":\"Get all addresses stored in the address book.\",\"href\":\"/api-reference/exchange-api/rest-api/address-book/get-address-book\"},{\"title\":\"Get counterparty address book\",\"openapi\":\"get /address-book/counterparty\",\"playground\":\"simple\",\"description\":\"Get all counterparty addresses stored in the address book\",\"href\":\"/api-reference/exchange-api/rest-api/address-book/get-counterparty-address-book\"},{\"openapi\":\"put /address-book/{id}\",\"playground\":\"simple\",\"title\":\"Update address book\",\"description\":\"Update an address book entry\",\"href\":\"/api-reference/exchange-api/rest-api/address-book/update-address-book\"}]},{\"group\":\"Coinbase Accounts\",\"pages\":[{\"title\":\"Generate crypto address\",\"openapi\":\"POST /coinbase-accounts/{account_id}/addresses\",\"playground\":\"simple\",\"description\":\"Generates a one-time crypto address for depositing crypto.\",\"href\":\"/api-reference/exchange-api/rest-api/coinbase-accounts/generate-crypto-address\"},{\"title\":\"Get all Coinbase wallets\",\"openapi\":\"GET /coinbase-accounts\",\"playground\":\"simple\",\"description\":\"Gets all the user's available Coinbase wallets (These are the wallets/accounts that are used for buying and selling on www.coinbase.com)\",\"href\":\"/api-reference/exchange-api/rest-api/coinbase-accounts/get-all-coinbase-wallets\"}]},{\"group\":\"Conversions\",\"pages\":[{\"title\":\"Convert currency\",\"openapi\":\"POST /conversions\",\"playground\":\"simple\",\"description\":\"Converts funds from `from` currency to `to` currency. Funds are converted on the `from` account in the `profile_id` profile.\",\"href\":\"/api-reference/exchange-api/rest-api/conversions/convert-currency\"},{\"title\":\"Get a conversion\",\"openapi\":\"GET /conversions/{conversion_id}\",\"playground\":\"simple\",\"description\":\"Gets a currency conversion by id (i.e. USD -\u003e USDC).\",\"href\":\"/api-reference/exchange-api/rest-api/conversions/get-a-conversion\"},{\"title\":\"Get all conversions\",\"openapi\":\"GET /conversions\",\"playground\":\"simple\",\"description\":\"Gets all currency conversions (i.e. USD -\u003e USDC) for a given profile\",\"href\":\"/api-reference/exchange-api/rest-api/conversions/get-all-conversions\"},{\"title\":\"Get conversion fee rates\",\"openapi\":\"GET /conversions/fees\",\"playground\":\"simple\",\"description\":\"Gets a list of current conversion fee rates and trailing 30 day volume by currency pair\",\"href\":\"/api-reference/exchange-api/rest-api/conversions/get-conversion-fee-rates\"}]},{\"group\":\"Currencies\",\"pages\":[{\"title\":\"Get a currency\",\"openapi\":\"GET /currencies/{currency_id}\",\"playground\":\"simple\",\"description\":\"Gets a single currency by id.\",\"href\":\"/api-reference/exchange-api/rest-api/currencies/get-a-currency\"},{\"title\":\"Get all known currencies\",\"openapi\":\"GET /currencies\",\"playground\":\"simple\",\"description\":\"Gets a list of all known currencies.\\n Note: Not all currencies may be currently in use for trading.\",\"href\":\"/api-reference/exchange-api/rest-api/currencies/get-all-known-currencies\"}]},{\"group\":\"Fees\",\"pages\":[{\"title\":\"Get fees\",\"openapi\":\"GET /fees\",\"playground\":\"simple\",\"description\":\"Get fees rates and 30 days trailing volume.\",\"href\":\"/api-reference/exchange-api/rest-api/fees/get-fee\"}]},{\"group\":\"Futures\",\"pages\":[{\"title\":\"Get auto loan setting\",\"openapi\":\"GET /margin/auto-loan\",\"playground\":\"simple\",\"description\":\"Get the setting to automatically initiate loans to meet margin calls with Coinbase affiliates in accordance with the Lending Agreement and Side Letter\",\"href\":\"/api-reference/exchange-api/rest-api/futures/get-auto-loan-setting\"},{\"title\":\"Get USDC conversion\",\"openapi\":\"GET /margin/usdc\",\"playground\":\"simple\",\"description\":\"Get the USDC to USD auto conversion setting to meet margin calls with eligible Coinbase Affiliate\",\"href\":\"/api-reference/exchange-api/rest-api/futures/get-usdc-conversion\"},{\"title\":\"Set auto loan\",\"openapi\":\"POST  /margin/auto-loan\",\"playground\":\"simple\",\"description\":\"Automatically initiate loans to meet margin calls with Coinbase affiliates in accordance with the Lending Agreement and Side Letter\",\"href\":\"/api-reference/exchange-api/rest-api/futures/set-auto-loan\"},{\"title\":\"Set USDC conversion\",\"openapi\":\"POST /margin/usdc\",\"playground\":\"simple\",\"description\":\"Set the USDC to USD auto conversion to meet margin calls with eligible Coinbase Affiliate\",\"href\":\"/api-reference/exchange-api/rest-api/futures/set-usdc-conversion\"}]},{\"group\":\"Loan\",\"pages\":[{\"title\":\"Get lending overview\",\"openapi\":\"GET /loans/lending-overview\",\"playground\":\"simple\",\"description\":\"This API summarizes lending for a given client. It calculates the overall loan balance, collateral level, and amounts available to borrow. It also returns any withdrawal restrictions in force on the client.\",\"href\":\"/api-reference/exchange-api/rest-api/loan/get-lending-overview\"},{\"title\":\"Get lending overview XM\",\"openapi\":\"GET /loans/lending-overview-xm\",\"playground\":\"simple\",\"description\":\"Get lending overview for a cross margin user with margin requirements and account equity information.\",\"href\":\"/api-reference/exchange-api/rest-api/loan/get-lending-overview-xm\"},{\"title\":\"Get new loan preview\",\"openapi\":\"GET /loans/loan-preview\",\"playground\":\"simple\",\"description\":\"This API is similar to lending-overview but is used to preview the results of opening a new loan. The values returned in the preview response take the existing loans, collateral and the potential change being previewed into account. Note the preview request accepts native currency amounts as input.\",\"href\":\"/api-reference/exchange-api/rest-api/loan/get-new-loan-preview\"},{\"title\":\"Get loan preview XM\",\"openapi\":\"GET /loans/loan-preview-xm\",\"playground\":\"simple\",\"description\":\"Preview the results of a loan for a cross margin user.\",\"href\":\"/api-reference/exchange-api/rest-api/loan/get-loan-preview-xm\"},{\"title\":\"Get principal repayment preview\",\"openapi\":\"GET /loans/repayment-preview\",\"playground\":\"simple\",\"description\":\"Preview the results of a loan principal repayment.\",\"href\":\"/api-reference/exchange-api/rest-api/loan/get-principal-repayment-preview\"},{\"title\":\"Get repayment preview XM\",\"openapi\":\"GET /loans/repayment-preview-xm\",\"playground\":\"simple\",\"description\":\"Preview the results of a loan principal repayment for a cross margin user.\",\"href\":\"/api-reference/exchange-api/rest-api/loan/get-repayment-preview-xm\"},{\"title\":\"List interest charges\",\"openapi\":\"GET /loans/interest/{loan_id}\",\"playground\":\"simple\",\"description\":\"List interest charges for a loan\",\"href\":\"/api-reference/exchange-api/rest-api/loan/list-interest-charges\"},{\"title\":\"List interest rate history\",\"openapi\":\"GET /loans/interest/history/{loan_id}\",\"playground\":\"simple\",\"description\":\"List interest rate history for a loan\",\"href\":\"/api-reference/exchange-api/rest-api/loan/list-interest-rate-history\"},{\"title\":\"List interest summaries\",\"openapi\":\"GET /loans/interest\",\"playground\":\"simple\",\"description\":\"List summaries of interest owed by asset\",\"href\":\"/api-reference/exchange-api/rest-api/loan/list-interest-summaries\"},{\"title\":\"List loan assets\",\"openapi\":\"GET /loans/assets\",\"playground\":\"simple\",\"description\":\"Get a list of lendable assets, a map of assets we accept as collateral for loans, and the haircut weight.\",\"href\":\"/api-reference/exchange-api/rest-api/loan/list-loan-assets\"},{\"title\":\"List loans\",\"openapi\":\"GET /loans\",\"playground\":\"simple\",\"description\":\"Accepts zero or more loan IDs as input. If no loan IDs are specified, it returns all loans for the user. Otherwise it returns only the loan IDs specified.\",\"href\":\"/api-reference/exchange-api/rest-api/loan/list-loans\"},{\"title\":\"List new loan options\",\"openapi\":\"GET /loans/options\",\"playground\":\"simple\",\"description\":\"Get available currencies and interest rates for new loans. All amounts returned by this API are notional values (i.e., USD).\",\"href\":\"/api-reference/exchange-api/rest-api/loan/list-new-loan-options\"},{\"title\":\"Open new loan\",\"openapi\":\"POST /loans/open\",\"playground\":\"simple\",\"description\":\"This API triggers a loan open request. Funding is not necessarily instantaneous and there is no SLA. You are notified when funds have settled in your Exchange account. Loan open requests, once initiated, cannot be canceled.\",\"href\":\"/api-reference/exchange-api/rest-api/loan/open-new-loan\"},{\"title\":\"Repay loan interest\",\"openapi\":\"POST  /loans/repay-interest\",\"playground\":\"simple\",\"description\":\"Submit an interest repayment for a loan.\",\"href\":\"/api-reference/exchange-api/rest-api/loan/repay-loan-interest\"},{\"title\":\"Repay loan principal\",\"openapi\":\"POST /loans/repay-principal\",\"playground\":\"simple\",\"description\":\"Submit a principal repayment for a loan.\",\"href\":\"/api-reference/exchange-api/rest-api/loan/repay-loan-principal\"}]},{\"group\":\"Orders\",\"pages\":[{\"title\":\"Cancel all orders\",\"openapi\":\"DELETE /orders\",\"playground\":\"simple\",\"description\":\"With best effort, cancel all open orders. This may require you to make the request multiple times until all of the open orders are deleted.\",\"href\":\"/api-reference/exchange-api/rest-api/orders/cancel-all-orders\"},{\"title\":\"Cancel an order\",\"openapi\":\"DELETE /orders/{order_id}\",\"playground\":\"simple\",\"description\":\"Cancel a single open order by `{id}`.\",\"href\":\"/api-reference/exchange-api/rest-api/orders/cancel-an-order\"},{\"title\":\"Create a new order\",\"openapi\":\"POST /orders\",\"playground\":\"simple\",\"description\":\"Create an order. You can place two types of orders: limit and market. Orders can only be placed if your account has sufficient funds. Once an order is placed, your account funds will be put on hold for the duration of the order. How much and which funds are put on hold depends on the order type and parameters specified.\",\"href\":\"/api-reference/exchange-api/rest-api/orders/create-new-order\"},{\"title\":\"Get all fills\",\"openapi\":\"GET /fills\",\"playground\":\"simple\",\"description\":\"Get a list of fills. A fill is a partial or complete match on a specific order.\",\"href\":\"/api-reference/exchange-api/rest-api/orders/get-all-fills\"},{\"title\":\"Get all orders\",\"openapi\":\"GET /orders\",\"playground\":\"simple\",\"description\":\"List your current open orders. Only open or un-settled orders are returned by default. As soon as an order is no longer open and settled, it will no longer appear in the default request. Open orders may change state between the request and the response depending on market conditions.\",\"href\":\"/api-reference/exchange-api/rest-api/orders/get-all-orders\"},{\"title\":\"Get single order\",\"openapi\":\"GET /orders/{order_id}\",\"playground\":\"simple\",\"description\":\"Get a single order by `id`.\",\"href\":\"/api-reference/exchange-api/rest-api/orders/get-single-order\"}]},{\"group\":\"Products\",\"pages\":[{\"title\":\"Get all known trading pairs\",\"openapi\":\"GET /products\",\"playground\":\"simple\",\"description\":\"Gets a list of available currency pairs for trading.\",\"href\":\"/api-reference/exchange-api/rest-api/products/get-all-known-trading-pairs\"},{\"title\":\"Get all product volume\",\"openapi\":\"GET  /products/volume-summary\",\"playground\":\"simple\",\"description\":\"Gets 30day and 24hour volume for all products and market types\",\"href\":\"/api-reference/exchange-api/rest-api/products/get-all-product-volume\"},{\"title\":\"Get product book\",\"openapi\":\"GET /products/{product_id}/book\",\"playground\":\"simple\",\"description\":\"Get a list of open orders for a product. The amount of detail shown can be customized with the `level` parameter.\",\"href\":\"/api-reference/exchange-api/rest-api/products/get-product-book\"},{\"title\":\"Get product candles\",\"openapi\":\"GET /products/{product_id}/candles\",\"playground\":\"simple\",\"description\":\"Historic rates for a product. Rates are returned in grouped buckets. Candle schema is of the form `[timestamp, price_low, price_high, price_open, price_close]`\",\"href\":\"/api-reference/exchange-api/rest-api/products/get-product-candles\"},{\"title\":\"Get product stats\",\"openapi\":\"GET /products/{product_id}/stats\",\"playground\":\"simple\",\"description\":\"Gets 30day and 24hour stats for a product.\",\"href\":\"/api-reference/exchange-api/rest-api/products/get-product-stats\"},{\"title\":\"Get product ticker\",\"openapi\":\"GET /products/{product_id}/ticker\",\"playground\":\"simple\",\"description\":\"Gets snapshot information about the last trade (tick), best bid/ask and 24h volume.\",\"href\":\"/api-reference/exchange-api/rest-api/products/get-product-ticker\"},{\"title\":\"Get product trades\",\"openapi\":\"GET /products/{product_id}/trades\",\"playground\":\"simple\",\"description\":\"Gets a list the latest trades for a product.\",\"href\":\"/api-reference/exchange-api/rest-api/products/get-product-trades\"},{\"title\":\"Get single product\",\"openapi\":\"GET /products/{product_id}\",\"playground\":\"simple\",\"description\":\"Get information on a single product.\",\"href\":\"/api-reference/exchange-api/rest-api/products/get-single-product\"}]},{\"group\":\"Profiles\",\"pages\":[{\"title\":\"Create a profile\",\"openapi\":\"POST /profiles\",\"playground\":\"simple\",\"description\":\"Create a new profile. Will fail if no name is provided or if user already has max number of profiles.\",\"href\":\"/api-reference/exchange-api/rest-api/profiles/create-profile\"},{\"title\":\"Delete a profile\",\"openapi\":\"PUT /profiles/{profile_id}/deactivate\",\"playground\":\"simple\",\"description\":\"Deletes the profile specified by `profile_id` and transfers all funds to the profile specified by `to`. Fails if there are any open orders on the profile to be deleted.\",\"href\":\"/api-reference/exchange-api/rest-api/profiles/delete-profile\"},{\"title\":\"Get profile by id\",\"openapi\":\"GET /profiles/{profile_id}\",\"playground\":\"simple\",\"description\":\"Information for a single profile. Use this endpoint when you know the profile_id.\",\"href\":\"/api-reference/exchange-api/rest-api/profiles/get-profile-by-id\"},{\"title\":\"Get profiles\",\"openapi\":\"GET /profiles\",\"playground\":\"simple\",\"description\":\"Gets a list of all of the current user's profiles.\",\"href\":\"/api-reference/exchange-api/rest-api/profiles/get-profiles\"},{\"title\":\"Rename a profile\",\"openapi\":\"PUT /profiles/{profile_id}\",\"playground\":\"simple\",\"description\":\"Rename a profile. Names 'default' and 'margin' are reserved.\",\"href\":\"/api-reference/exchange-api/rest-api/profiles/rename-profile\"},{\"title\":\"Transfer funds between profiles\",\"openapi\":\"POST /profiles/transfer\",\"playground\":\"simple\",\"description\":\"Transfer an amount of currency from one profile to another.\",\"href\":\"/api-reference/exchange-api/rest-api/profiles/transfer-funds-profile\"}]},{\"group\":\"Reports\",\"pages\":[{\"title\":\"Create a report\",\"openapi\":\"POST /reports\",\"playground\":\"simple\",\"description\":\"Generates a report. You can create reports with historical data for all report types. [Balance reports](#balance-reports) can be snapshots of historical or current data.\",\"href\":\"/api-reference/exchange-api/rest-api/reports/create-report\"},{\"title\":\"Get a report\",\"openapi\":\"GET /reports/{report_id}\",\"playground\":\"simple\",\"description\":\"Get a specific report by `report_id`.\",\"href\":\"/api-reference/exchange-api/rest-api/reports/get-report\"},{\"title\":\"Get all reports\",\"openapi\":\"GET /reports\",\"playground\":\"simple\",\"description\":\"Gets a list of all user generated reports.\",\"href\":\"/api-reference/exchange-api/rest-api/reports/get-all-reports\"}]},{\"group\":\"Transfers\",\"pages\":[{\"title\":\"Deposit from Coinbase account\",\"openapi\":\"POST /deposits/coinbase-account\",\"playground\":\"simple\",\"description\":\"Deposits funds from a www.coinbase.com wallet to the specified `profile_id`.\",\"href\":\"/api-reference/exchange-api/rest-api/transfers/deposit-from-coinbase-account\"},{\"title\":\"Deposit from payment method\",\"openapi\":\"POST  /deposits/payment-method\",\"playground\":\"simple\",\"description\":\"Deposits funds from a linked external payment method to the specified `profile_id`.\",\"href\":\"/api-reference/exchange-api/rest-api/transfers/deposit-from-payment-method\"},{\"title\":\"Get a single transfer\",\"openapi\":\"GET /transfers/{transfer_id}\",\"playground\":\"simple\",\"description\":\"Get information on a single transfer.\",\"href\":\"/api-reference/exchange-api/rest-api/transfers/get-single-transfer\"},{\"title\":\"Get all payment methods\",\"openapi\":\"GET /payment-methods\",\"playground\":\"simple\",\"description\":\"Gets a list of the user's linked payment methods.\",\"href\":\"/api-reference/exchange-api/rest-api/transfers/get-all-payment-methods\"},{\"title\":\"Get all transfers\",\"openapi\":\"GET /transfers\",\"playground\":\"simple\",\"description\":\"Gets a list of in-progress and completed transfers of funds in/out of any of the user's accounts.\",\"href\":\"/api-reference/exchange-api/rest-api/transfers/get-all-transfers\"},{\"title\":\"Get fee estimate for crypto withdrawal\",\"openapi\":\"GET /withdrawals/fee-estimate\",\"playground\":\"simple\",\"description\":\"Gets the fee estimate for the crypto withdrawal to crypto address\",\"href\":\"/api-reference/exchange-api/rest-api/transfers/get-fee-estimate\"},{\"title\":\"Submit travel information for a transfer\",\"openapi\":\"POST /transfers/{transfer_id}/travel-rules\",\"playground\":\"simple\",\"description\":\"Submit travel information for a transfer\",\"href\":\"/api-reference/exchange-api/rest-api/transfers/submit-travel-info\"},{\"title\":\"Withdraw to Coinbase account\",\"openapi\":\"POST /withdrawals/coinbase-account\",\"playground\":\"simple\",\"description\":\"Withdraws funds from the specified `profile_id` to a www.coinbase.com wallet.\",\"href\":\"/api-reference/exchange-api/rest-api/transfers/withdraw-to-coinbase-account\"},{\"title\":\"Withdraw to counterparty Id\",\"openapi\":\"post /withdrawals/counterparty\",\"playground\":\"simple\",\"description\":\"Withdraw funds from a specified currency account to a counterparty account\",\"href\":\"/api-reference/exchange-api/rest-api/transfers/withdraw-to-counterparty\"},{\"title\":\"Withdraw to crypto address\",\"openapi\":\"POST /withdrawals/crypto\",\"playground\":\"simple\",\"description\":\"Withdraws funds from the specified `profile_id` to an external crypto address\",\"href\":\"/api-reference/exchange-api/rest-api/transfers/withdraw-to-crypto-address\"},{\"title\":\"Withdraw to payment method\",\"openapi\":\"POST /withdrawals/payment-method\",\"playground\":\"simple\",\"description\":\"Withdraws funds from the specified `profile_id` to a linked external payment method\",\"href\":\"/api-reference/exchange-api/rest-api/transfers/withdraw-to-payment-method\"}]},{\"group\":\"Travel Rules\",\"pages\":[{\"title\":\"Create travel rule entry\",\"openapi\":\"POST /travel-rules\",\"playground\":\"simple\",\"description\":\"Create travel rule entry for sending address\",\"href\":\"/api-reference/exchange-api/rest-api/travel-rules/create-travel-rule\"},{\"title\":\"Delete existing travel rule entry\",\"openapi\":\"DELETE /travel-rules/{id}\",\"playground\":\"simple\",\"description\":\"Delete existing travel rule entry\",\"href\":\"/api-reference/exchange-api/rest-api/travel-rules/delete-existing-travel-rule\"},{\"title\":\"Get all travel rule information\",\"openapi\":\"GET /travel-rules\",\"playground\":\"simple\",\"description\":\"Return a list of all stored travel rule information\",\"href\":\"/api-reference/exchange-api/rest-api/travel-rules/get-all-travel-rule\"}]},{\"group\":\"Users\",\"pages\":[{\"title\":\"Get user exchange limits\",\"openapi\":\"GET /users/{user_id}/exchange-limits\",\"playground\":\"simple\",\"description\":\"Gets exchange limits information for a single user.\",\"href\":\"/api-reference/exchange-api/rest-api/users/get-user-exchange-limits\"},{\"title\":\"Get user trading volume\",\"openapi\":\"GET /users/{user_id}/trading-volumes\",\"playground\":\"simple\",\"description\":\"Gets aggregated and individual trading volumes for users.\",\"href\":\"/api-reference/exchange-api/rest-api/users/get-user-trading-volume\"},{\"title\":\"Update settlement preference\",\"openapi\":\"POST /users/{user_id}/settlement-preferences\",\"playground\":\"simple\",\"description\":\"Updates the settlement preference to hold funds in either USDC or USD.\",\"href\":\"/api-reference/exchange-api/rest-api/users/update-settlement-preference\"}]},{\"group\":\"Wrapped Assets\",\"pages\":[{\"title\":\"Create a new redeem\",\"openapi\":\"POST /wrapped-assets/redeem\",\"playground\":\"simple\",\"description\":\"Redeems `from_currency` to `to_currency`. Funds are redeemed in the profile associated with the API key.\",\"href\":\"/api-reference/exchange-api/rest-api/wrapped-assets/create-new-redeem\"},{\"title\":\"Create a new stake-wrap\",\"openapi\":\"POST /wrapped-assets/stake-wrap\",\"playground\":\"simple\",\"description\":\"Stakes and wraps `from_currency` to `to_currency`. Funds are stake-wrapped in the profile associated with the API key.\",\"href\":\"/api-reference/exchange-api/rest-api/wrapped-assets/create-new-stake-wrap\"},{\"title\":\"Get a single redeem\",\"openapi\":\"GET /wrapped-assets/redeem/{redeem_id}\",\"playground\":\"simple\",\"description\":\"Get details for a specific redeem in the profile associated with the API key.\",\"href\":\"/api-reference/exchange-api/rest-api/wrapped-assets/get-single-redeem\"},{\"title\":\"Get a single stake-wrap\",\"openapi\":\"GET /wrapped-assets/stake-wrap/{stake_wrap_id}\",\"playground\":\"simple\",\"description\":\"Get details for a specific stake-wrap in the profile associated with the API key.\",\"href\":\"/api-reference/exchange-api/rest-api/wrapped-assets/get-a-single-stake-wrap\"},{\"title\":\"Get all redeems\",\"openapi\":\"GET  /wrapped-assets/redeem\",\"playground\":\"simple\",\"description\":\"Get details for all redeems in the profile associated with the API key.\",\"href\":\"/api-reference/exchange-api/rest-api/wrapped-assets/get-all-redeems\"},{\"title\":\"Get all stake-wraps\",\"openapi\":\"GET /wrapped-assets/stake-wrap\",\"playground\":\"simple\",\"description\":\"Get details for all stake-wraps in the profile associated with the API key.\",\"href\":\"/api-reference/exchange-api/rest-api/wrapped-assets/get-all-stake-wraps\"},{\"title\":\"Get all wrapped assets\",\"openapi\":\"GET /wrapped-assets\",\"playground\":\"simple\",\"description\":\"Returns a list of all supported wrapped assets details objects\",\"href\":\"/api-reference/exchange-api/rest-api/wrapped-assets/get-all-wrapped-assets\"},{\"title\":\"Get wrapped asset conversion rate\",\"openapi\":\"GET /wrapped-assets/{wrapped_asset_id}/conversion-rate\",\"playground\":\"simple\",\"description\":\"Returns the conversion rate of a wrapped asset\",\"href\":\"/api-reference/exchange-api/rest-api/wrapped-assets/get-wrapped-asset-conversion-rate\"},{\"title\":\"Get wrapped asset details\",\"openapi\":\"GET /wrapped-assets/{wrapped_asset_id}\",\"playground\":\"simple\",\"description\":\"Returns the circulating and total supply of a wrapped asset, and its conversion rate\",\"href\":\"/api-reference/exchange-api/rest-api/wrapped-assets/get-wrapped-asset-details\"}]}]},{\"group\":\"FIX API\",\"pages\":[{\"title\":\"Exchange FIX API Connectivity\",\"sidebarTitle\":\"Connectivity\",\"description\":null,\"href\":\"/exchange/fix-api/connectivity\"},{\"title\":\"Exchange FIX Best Practices\",\"sidebarTitle\":\"Best Practices\",\"description\":null,\"href\":\"/exchange/fix-api/best-practices\"},{\"title\":\"FIX Rate Limits Overview\",\"sidebarTitle\":\"Rate Limits\",\"description\":null,\"href\":\"/exchange/fix-api/rate-limits\"},{\"title\":\"Exchange FIX Drop Copy 5.0\",\"sidebarTitle\":\"Drop Copy\",\"description\":null,\"href\":\"/exchange/fix-api/drop-copy\"},{\"group\":\"Order Entry Messages\",\"pages\":[{\"title\":\"Exchange FIX Order Entry Messages 5.0\",\"sidebarTitle\":\"Order Entry Messages 5.0\",\"description\":null,\"href\":\"/exchange/fix-api/order-entry-messages/order-entry-messages5\"},{\"title\":\"Exchange Take Profit Stop Loss Orders\",\"sidebarTitle\":\"TPSL Orders\",\"description\":null,\"href\":\"/exchange/fix-api/order-entry-messages/tpsl-orders\"},{\"title\":\"Exchange Limit With Funds Orders\",\"sidebarTitle\":\"Limit With Funds Orders\",\"description\":null,\"href\":\"/exchange/fix-api/order-entry-messages/limit-orders\"},{\"title\":\"Exchange Synthetic Product Orders\",\"sidebarTitle\":\"Synthetic Product Orders\",\"description\":null,\"href\":\"/exchange/fix-api/order-entry-messages/synthetic-product-orders\"}]},{\"title\":\"Exchange FIX Market Data Messages 5.0\",\"sidebarTitle\":\"Market Data Messages\",\"description\":null,\"href\":\"/exchange/fix-api/market-data\"},{\"title\":\"Exchange FIX Dictionary Downloads\",\"sidebarTitle\":\"Dictionary Downloads\",\"description\":null,\"href\":\"/exchange/fix-api/dictionary-downloads\"}]},{\"group\":\"Websocket Feed\",\"pages\":[{\"title\":\"Exchange WebSocket Overview\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/exchange/websocket-feed/overview\"},{\"title\":\"Exchange WebSocket Best Practices\",\"sidebarTitle\":\"Best Practices\",\"description\":null,\"href\":\"/exchange/websocket-feed/best-practices\"},{\"title\":\"Exchange WebSocket Authentication\",\"sidebarTitle\":\"Authentication\",\"description\":null,\"href\":\"/exchange/websocket-feed/authentication\"},{\"title\":\"Exchange WebSocket Channels\",\"sidebarTitle\":\"Channels\",\"description\":null,\"href\":\"/exchange/websocket-feed/channels\"},{\"title\":\"Exchange WebSocket Rate Limits\",\"sidebarTitle\":\"Rate Limits\",\"description\":null,\"href\":\"/exchange/websocket-feed/rate-limits\"},{\"title\":\"Exchange WebSocket Errors\",\"sidebarTitle\":\"Errors\",\"description\":null,\"href\":\"/exchange/websocket-feed/errors\"}]}]},{\"dropdown\":\"Coinbase International Exchange API\",\"icon\":\"https://mintlify-assets.b-cdn.net/internationalExchangeProduct-0.svg\",\"groups\":[{\"group\":\"REST API\",\"pages\":[{\"title\":\"Welcome to Coinbase INTX API\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/api-reference/international-exchange-api/rest-api/introduction\"},{\"title\":\"INTX REST API Authentication\",\"sidebarTitle\":\"Authentication\",\"description\":null,\"href\":\"/api-reference/international-exchange-api/rest-api/authentication\"},{\"group\":\"Address Book\",\"pages\":[{\"title\":\"Get address book\",\"openapi\":\"GET /api/v1/address-book\",\"playground\":\"simple\",\"description\":\"Returns all eligible recipients for withdrawal.\",\"href\":\"/api-reference/international-exchange-api/rest-api/address-book/get-address-book\"}]},{\"group\":\"Assets\",\"pages\":[{\"title\":\"Get asset details\",\"openapi\":\"GET /api/v1/assets/{asset}\",\"playground\":\"simple\",\"description\":\"Retrieves information for a specific asset.\",\"href\":\"/api-reference/international-exchange-api/rest-api/assets/get-asset-details\"},{\"title\":\"Get supported networks per asset\",\"openapi\":\"GET /api/v1/assets/{asset}/networks\",\"playground\":\"simple\",\"description\":\"Returns a list of supported networks and network information for a specific asset.\",\"href\":\"/api-reference/international-exchange-api/rest-api/assets/get-supported-networks\"},{\"title\":\"List assets\",\"openapi\":\"GET /api/v1/assets\",\"playground\":\"simple\",\"description\":\"Returns a list of all supported assets.\",\"href\":\"/api-reference/international-exchange-api/rest-api/assets/list-assets\"}]},{\"group\":\"Fee Rates\",\"pages\":[{\"title\":\"List fee rate tiers\",\"openapi\":\"GET /api/v1/fee-rate-tiers\",\"playground\":\"simple\",\"description\":\"Return all the fee rate tiers.\",\"href\":\"/api-reference/international-exchange-api/rest-api/fee-rates/list-fee-rate-tiers\"}]},{\"group\":\"Index\",\"pages\":[{\"title\":\"Get index candles\",\"openapi\":\"GET /api/v1/index/{index}/candles\",\"playground\":\"simple\",\"description\":\"Retrieves the historical daily index prices in time descending order. The daily values are represented as aggregated entries for the day in typical OHLC format.\",\"href\":\"/api-reference/international-exchange-api/rest-api/index/get-index-candles\"},{\"title\":\"Get index composition\",\"openapi\":\"GET  /api/v1/index/{index}/composition\",\"playground\":\"simple\",\"description\":\"Retrieves the latest index composition (metadata) with an ordered set of constituents.\",\"href\":\"/api-reference/international-exchange-api/rest-api/index/get-index-composition\"},{\"title\":\"Get index composition history\",\"openapi\":\"GET  /api/v1/index/{index}/composition-history\",\"playground\":\"simple\",\"description\":\"Retrieves a history of index composition records in a descending time order. The results are an array of index composition data recorded at different \\\"timestamps\\\".\",\"href\":\"/api-reference/international-exchange-api/rest-api/index/get-index-composition-history\"},{\"title\":\"Get index price\",\"openapi\":\"GET /api/v1/index/{index}/price\",\"playground\":\"simple\",\"description\":\"Retrieves the latest index price\",\"href\":\"/api-reference/international-exchange-api/rest-api/index/get-index-price\"}]},{\"group\":\"Instruments\",\"pages\":[{\"title\":\"Get aggregated candles data per instrument\",\"openapi\":\"GET /api/v1/instruments/{instrument}/candles\",\"playground\":\"simple\",\"description\":\"Retrieves a list of aggregated candles data for a given instrument, granularity and time range\",\"href\":\"/api-reference/international-exchange-api/rest-api/instruments/get-aggegated-candles\"},{\"title\":\"Get daily trading volumes\",\"openapi\":\"GET /api/v1/instruments/volumes/daily\",\"playground\":\"simple\",\"description\":\"Retrieves the trading volumes for each instrument separated by day.\",\"href\":\"/api-reference/international-exchange-api/rest-api/instruments/get-daily-trading-volume\"},{\"title\":\"Get historical funding rates\",\"openapi\":\"GET /api/v1/instruments/{instrument}/funding\",\"playground\":\"simple\",\"description\":\"Retrieves the historical funding rates for a specific instrument.\",\"href\":\"/api-reference/international-exchange-api/rest-api/instruments/get-historical-funding-rate\"},{\"title\":\"Get instrument details\",\"openapi\":\"GET /api/v1/instruments/{instrument}\",\"playground\":\"simple\",\"description\":\"Retrieves market information for a specific instrument.\",\"href\":\"/api-reference/international-exchange-api/rest-api/instruments/get-instrument-details\"},{\"title\":\"Get quote per instrument\",\"openapi\":\"GET /api/v1/instruments/{instrument}/quote\",\"playground\":\"simple\",\"description\":\"Retrieves the current quote for a specific instrument.\",\"href\":\"/api-reference/international-exchange-api/rest-api/instruments/get-quote-per-instrument\"},{\"title\":\"List instruments\",\"openapi\":\"GET  /api/v1/instruments\",\"playground\":\"simple\",\"description\":\"Returns all of the instruments available for trading.\",\"href\":\"/api-reference/international-exchange-api/rest-api/instruments/list-instruments\"}]},{\"group\":\"Orders\",\"pages\":[{\"title\":\"Cancel order\",\"openapi\":\"DELETE /api/v1/orders/{id}\",\"playground\":\"simple\",\"description\":\"Cancels a single open order.\",\"href\":\"/api-reference/international-exchange-api/rest-api/orders/cancel-order\"},{\"title\":\"Cancel orders\",\"openapi\":\"DELETE /api/v1/orders\",\"playground\":\"simple\",\"description\":\"Cancels all orders matching the requested criteria.\",\"href\":\"/api-reference/international-exchange-api/rest-api/orders/cancel-orders\"},{\"title\":\"Create order\",\"openapi\":\"POST /api/v1/orders\",\"playground\":\"simple\",\"description\":\"Creates a new order.\",\"href\":\"/api-reference/international-exchange-api/rest-api/orders/create-order\"},{\"title\":\"Get order details\",\"openapi\":\"GET /api/v1/orders/{id}\",\"playground\":\"simple\",\"description\":\"Retrieves a single order. The order retrieved can be either active or inactive.\",\"href\":\"/api-reference/international-exchange-api/rest-api/orders/get-order-details\"},{\"title\":\"List open orders\",\"openapi\":\"GET /api/v1/orders\",\"playground\":\"simple\",\"description\":\"Returns a list of active orders resting on the order book matching the requested criteria. Does not return any rejected, cancelled, or fully filled orders as they are not active.\",\"href\":\"/api-reference/international-exchange-api/rest-api/orders/list-open-orders\"},{\"title\":\"Modify open order\",\"openapi\":\"PUT /api/v1/orders/{id}\",\"playground\":\"simple\",\"description\":\"Modifies an open order.\",\"href\":\"/api-reference/international-exchange-api/rest-api/orders/modify-open-order\"}]},{\"group\":\"Portfolios\",\"pages\":[{\"title\":\"Acquire/repay loan\",\"openapi\":\"POST /api/v1/portfolios/{portfolio}/loans/{asset}\",\"playground\":\"simple\",\"description\":\"Acquire or repay loan for a given portfolio and asset.\",\"href\":\"/api-reference/international-exchange-api/rest-api/portfolios/acquire-and-repay-loan\"},{\"title\":\"Create portfolio\",\"openapi\":\"POST /api/v1/portfolios\",\"playground\":\"simple\",\"description\":\"Create a new portfolio. Request will fail if no name is provided or if user already has max number of portfolios. Max number of portfolios is 20.\",\"href\":\"/api-reference/international-exchange-api/rest-api/portfolios/create-portfolio\"},{\"title\":\"Enable/Disable portfolio auto margin mode\",\"openapi\":\"POST /api/v1/portfolios/{portfolio}/auto-margin-enabled\",\"playground\":\"simple\",\"description\":\"Enable or disable the auto margin feature, which lets the portfolio automatically post margin amounts required to exceed the high leverage position restrictions.\",\"href\":\"/api-reference/international-exchange-api/rest-api/portfolios/enable-and-disable-portfolio\"},{\"title\":\"Enable/Disable portfolio cross collateral\",\"openapi\":\"POST  /api/v1/portfolios/{portfolio}/cross-collateral-enabled\",\"playground\":\"simple\",\"description\":\"Enable or disable the cross collateral feature for the portfolio, which allows the portfolio to use non-USDC assets as collateral for margin trading.\",\"href\":\"/api-reference/international-exchange-api/rest-api/portfolios/enable-and-disable-cross\"},{\"title\":\"Get balance for portfolio/asset\",\"openapi\":\"GET /api/v1/portfolios/{portfolio}/balances/{asset}\",\"playground\":\"simple\",\"description\":\"Retrieves the balance for a given portfolio and asset.\",\"href\":\"/api-reference/international-exchange-api/rest-api/portfolios/get-balance-for-assests\"},{\"title\":\"Get fund transfer limit between portfolios\",\"openapi\":\"GET /api/v1/portfolios/transfer/{portfolio}/{asset}/transfer-limit\",\"playground\":\"simple\",\"description\":\"Get fund transfer limit between portfolios of the same beneficial owner\",\"href\":\"/api-reference/international-exchange-api/rest-api/portfolios/get-fund-transfer-limit\"},{\"title\":\"Get loan info for portfolio/asset\",\"openapi\":\"GET /api/v1/portfolios/{portfolio}/loans/{asset}\",\"playground\":\"simple\",\"description\":\"Retrieves the loan info for a given portfolio and asset.\",\"href\":\"/api-reference/international-exchange-api/rest-api/portfolios/get-loan-info-for-portfolio\"},{\"title\":\"Get portfolio details\",\"openapi\":\"GET  /api/v1/portfolios/{portfolio}/detail\",\"playground\":\"simple\",\"description\":\"Retrieves the summary, positions, and balances of a portfolio.\",\"href\":\"/api-reference/international-exchange-api/rest-api/portfolios/get-portfolio-details\"},{\"title\":\"Get portfolio margin call status\",\"openapi\":\"GET /api/v1/portfolios/{portfolio}/margin-call-status\",\"playground\":\"simple\",\"description\":\"Returns the margin call status for a given portfolio.\",\"href\":\"/api-reference/international-exchange-api/rest-api/portfolios/get-portfolio-margin-call\"},{\"title\":\"Get portfolio summary\",\"openapi\":\"GET /api/v1/portfolios/{portfolio}/summary\",\"playground\":\"simple\",\"description\":\"Retrieves the high level overview of a portfolio.\",\"href\":\"/api-reference/international-exchange-api/rest-api/portfolios/get-portfolio-summary\"},{\"title\":\"Get position for portfolio/instrument\",\"openapi\":\"GET /api/v1/portfolios/{portfolio}/positions/{instrument}\",\"playground\":\"simple\",\"description\":\"Retrieves the position for a given portfolio and symbol.\",\"href\":\"/api-reference/international-exchange-api/rest-api/portfolios/get-position-portfolio\"},{\"title\":\"Get the open position limits for the portfolio instrument\",\"openapi\":\"GET /api/v1/portfolios/{portfolio}/position-limits/positions/{instrument}\",\"playground\":\"simple\",\"description\":\"Retrieves the position limits for a given portfolio and symbol.\",\"href\":\"/api-reference/international-exchange-api/rest-api/portfolios/get-the-open-position-limits\"},{\"title\":\"Get the total open position limit for the portfolio\",\"openapi\":\"GET /api/v1/portfolios/{portfolio}/position-limits\",\"playground\":\"simple\",\"description\":\"Retrieves the total open position limit across instruments for a given portfolio.\",\"href\":\"/api-reference/international-exchange-api/rest-api/portfolios/get-the-total-open-position-limits\"},{\"title\":\"Get user portfolio\",\"openapi\":\"GET /api/v1/portfolios/{portfolio}\",\"playground\":\"simple\",\"description\":\"Returns the user's specified portfolio.\",\"href\":\"/api-reference/international-exchange-api/rest-api/portfolios/get-user-portfolio\"},{\"title\":\"List active loans for the portfolio\",\"openapi\":\"GET /api/v1/portfolios/{portfolio}/loans\",\"playground\":\"simple\",\"description\":\"Retrieves all loan info for a given portfolio.\",\"href\":\"/api-reference/international-exchange-api/rest-api/portfolios/list-active-loans-for-the-portfolio\"},{\"title\":\"List all user portfolios\",\"openapi\":\"GET /api/v1/portfolios\",\"playground\":\"simple\",\"description\":\"Returns all of the user's portfolios.\",\"href\":\"/api-reference/international-exchange-api/rest-api/portfolios/list-all-user-portfolios\"},{\"title\":\"List fills by portfolios\",\"openapi\":\"GET /api/v1/portfolios/fills\",\"playground\":\"simple\",\"description\":\"Returns fills for specified portfolios or fills for all portfolios if none are provided.\",\"href\":\"/api-reference/international-exchange-api/rest-api/portfolios/list-fills-portfolio\"},{\"title\":\"List portfolio balances\",\"openapi\":\"GET /api/v1/portfolios/{portfolio}/balances\",\"playground\":\"simple\",\"description\":\"Returns all of the balances for a given portfolio.\",\"href\":\"/api-reference/international-exchange-api/rest-api/portfolios/list-portfolio-balances\"},{\"title\":\"List portfolio fee rates\",\"openapi\":\"GET /api/v1/portfolios/fee-rates\",\"playground\":\"simple\",\"description\":\"Retrieves the Perpetual Future and Spot fee rate tiers for the user.\",\"href\":\"/api-reference/international-exchange-api/rest-api/portfolios/list-portfolio-fee-rates\"},{\"title\":\"List portfolio fills\",\"openapi\":\"GET /api/v1/portfolios/{portfolio}/fills\",\"playground\":\"simple\",\"description\":\"Returns all of the fills for a given portfolio.\",\"href\":\"/api-reference/international-exchange-api/rest-api/portfolios/list-portfolio-fills\"},{\"title\":\"List portfolio positions\",\"openapi\":\"GET /api/v1/portfolios/{portfolio}/positions\",\"playground\":\"simple\",\"description\":\"Returns all of the positions for a given portfolio.\",\"href\":\"/api-reference/international-exchange-api/rest-api/portfolios/list-portfolio-positions\"},{\"title\":\"List the open position limits for all instruments\",\"openapi\":\"GET /api/v1/portfolios/{portfolio}/position-limits/positions\",\"playground\":\"simple\",\"description\":\"Retrieves position limits for all positions a given portfolio currently has or has opened in the past.\",\"href\":\"/api-reference/international-exchange-api/rest-api/portfolios/list-open-position-limit\"},{\"title\":\"Patch portfolio\",\"openapi\":\"PATCH /api/v1/portfolios/{portfolio}\",\"playground\":\"simple\",\"description\":\"Update parameters for existing portfolio\",\"href\":\"/api-reference/international-exchange-api/rest-api/portfolios/patch-portfolio\"},{\"title\":\"Preview loan update\",\"openapi\":\"POST /api/v1/portfolios/{portfolio}/loans/{asset}/preview\",\"playground\":\"simple\",\"description\":\"Preview acquire or repay loan for a given portfolio and asset.\",\"href\":\"/api-reference/international-exchange-api/rest-api/portfolios/preview-loan-update\"},{\"title\":\"Set portfolio margin override\",\"openapi\":\"POST /api/v1/portfolios/margin\",\"playground\":\"simple\",\"description\":\"Specify the margin override value for a portfolio to either increase notional requirements or opt-in to higher leverage.\",\"href\":\"/api-reference/international-exchange-api/rest-api/portfolios/set-profile-margin\"},{\"title\":\"Transfer funds between portfolios\",\"openapi\":\"POST /api/v1/portfolios/transfer\",\"playground\":\"simple\",\"description\":\"Transfer assets from one portfolio to another.\",\"href\":\"/api-reference/international-exchange-api/rest-api/portfolios/transfer-funds\"},{\"title\":\"Transfer positions between portfolios\",\"openapi\":\"POST /api/v1/portfolios/transfer-position\",\"playground\":\"simple\",\"description\":\"Transfer an existing position from one portfolio to another. The position transfer must fulfill the same portfolio-level margin requirements as submitting a new order on the opposite side for the sender's portfolio and a new order on the same side  for the recipient's portfolio. Additionally, organization-level requirements must be satisfied when evaluating the outcome of the position transfer.\",\"href\":\"/api-reference/international-exchange-api/rest-api/portfolios/transfer-positions\"},{\"title\":\"Update portfolio\",\"openapi\":\"PUT /api/v1/portfolios/{portfolio}\",\"playground\":\"simple\",\"description\":\"Update existing user portfolio.\",\"href\":\"/api-reference/international-exchange-api/rest-api/portfolios/update-portfolio\"},{\"title\":\"View max loan availability\",\"openapi\":\"GET /api/v1/portfolios/{portfolio}/loans/{asset}/availability\",\"playground\":\"simple\",\"description\":\"View the maximum amount of loan that could be acquired now\",\"href\":\"/api-reference/international-exchange-api/rest-api/portfolios/view-max-loan\"}]},{\"group\":\"Position Offsets\",\"pages\":[{\"title\":\"List position offsets\",\"openapi\":\"GET /api/v1/position-offsets\",\"playground\":\"simple\",\"description\":\"Returns all active position offsets\",\"href\":\"/api-reference/international-exchange-api/rest-api/position-offsets/list-position-offsets\"}]},{\"group\":\"Rankings\",\"pages\":[{\"title\":\"Get your rankings\",\"openapi\":\"GET /api/v1/rankings/statistics\",\"playground\":\"simple\",\"description\":\"Retrieve your volume rankings for maker, taker, and total volume.\",\"href\":\"/api-reference/international-exchange-api/rest-api/rankings/get-your-rankings\"}]},{\"group\":\"Transfers\",\"pages\":[{\"title\":\"Create counterparty Id\",\"openapi\":\"POST /api/v1/transfers/create-counterparty-id\",\"playground\":\"simple\",\"description\":null,\"href\":\"/api-reference/international-exchange-api/rest-api/transfers/create-counterparty-id\"},{\"title\":\"Create crypto address\",\"openapi\":\"POST /api/v1/transfers/address\",\"playground\":\"simple\",\"description\":null,\"href\":\"/api-reference/international-exchange-api/rest-api/transfers/create-crypto-address\"},{\"title\":\"Get counterparty withdrawal limit\",\"openapi\":\"GET /api/v1/transfers/withdraw/{portfolio}/{asset}/counterparty-withdrawal-limit\",\"playground\":\"simple\",\"description\":\"Get counterparty withdrawal limit within coinbase transfer network\",\"href\":\"/api-reference/international-exchange-api/rest-api/transfers/get-counterparty-withdrawal-limit\"},{\"title\":\"Get transfer\",\"openapi\":\"GET /api/v1/transfers/{transfer_uuid}\",\"playground\":\"simple\",\"description\":null,\"href\":\"/api-reference/international-exchange-api/rest-api/transfers/get-transfer\"},{\"title\":\"List matching transfers\",\"openapi\":\"GET /api/v1/transfers\",\"playground\":\"simple\",\"description\":null,\"href\":\"/api-reference/international-exchange-api/rest-api/transfers/list-matching-transfers\"},{\"title\":\"Validate counterparty Id\",\"openapi\":\"POST /api/v1/transfers/validate-counterparty-id\",\"playground\":\"simple\",\"description\":null,\"href\":\"/api-reference/international-exchange-api/rest-api/transfers/validate-counterparty-id\"},{\"title\":\"Withdraw to counterparty Id\",\"openapi\":\"POST /api/v1/transfers/withdraw/counterparty\",\"playground\":\"simple\",\"description\":null,\"href\":\"/api-reference/international-exchange-api/rest-api/transfers/withdraw-to-counterparty-id\"},{\"title\":\"Withdraw to crypto address\",\"openapi\":\"POST /api/v1/transfers/withdraw\",\"playground\":\"simple\",\"description\":null,\"href\":\"/api-reference/international-exchange-api/rest-api/transfers/withdraw-to-crypto-address\"}]}]},{\"group\":\"FIX API\",\"pages\":[{\"title\":\"INTX FIX API Overview\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/international-exchange/fix-api/fix-api-overview\"},{\"title\":\"INTX FIX Dictionary Downloads\",\"sidebarTitle\":\"Dictionary Downloads\",\"description\":null,\"href\":\"/international-exchange/fix-api/dictionary-downloads\"},{\"title\":\"INTX FIX Common Components\",\"sidebarTitle\":\"Common Components\",\"description\":null,\"href\":\"/international-exchange/fix-api/common-components\"},{\"title\":\"INTX FIX Admin Messages\",\"sidebarTitle\":\"Admin Messages\",\"description\":null,\"href\":\"/international-exchange/fix-api/admin-messages\"},{\"title\":\"INTX FIX Order Entry Messages\",\"sidebarTitle\":\"Order Entry Messages\",\"description\":null,\"href\":\"/international-exchange/fix-api/order-entry-messages\"},{\"title\":\"INTX Take Profit Stop Loss Orders\",\"sidebarTitle\":\"TPSL Orders\",\"description\":null,\"href\":\"/international-exchange/fix-api/tpsl-orders\"},{\"title\":\"INTX FIX Market Data Messages\",\"sidebarTitle\":\"Market Data Messages\",\"description\":null,\"href\":\"/international-exchange/fix-api/market-data\"},{\"title\":\"INTX FIX Drop Copy Messages\",\"sidebarTitle\":\"Drop Copy Messages\",\"description\":null,\"href\":\"/international-exchange/fix-api/drop-copy\"}]},{\"group\":\"WEBSOCKET FEED\",\"pages\":[{\"title\":\"INTX WebSocket Overview\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/international-exchange/websocket-feed/websocket-overview\"},{\"title\":\"INTX WebSocket Authentication\",\"sidebarTitle\":\"Authentication\",\"description\":null,\"href\":\"/international-exchange/websocket-feed/authentication\"},{\"title\":\"INTX WebSocket Channels\",\"sidebarTitle\":\"Channels\",\"description\":null,\"href\":\"/international-exchange/websocket-feed/channels\"},{\"title\":\"INTX WebSocket Errors\",\"sidebarTitle\":\"Errors\",\"description\":null,\"href\":\"/international-exchange/websocket-feed/errors\"}]}]},{\"dropdown\":\"Coinbase Prime API\",\"icon\":\"https://mintlify-assets.b-cdn.net/primeProduct-1.svg\",\"groups\":[{\"group\":\"REST API\",\"pages\":[{\"title\":\"Welcome to Coinbase Prime API\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/api-reference/prime-api/rest-api/introduction\"},{\"title\":\"Prime Overview\",\"description\":null,\"href\":\"/prime/concepts/overview\"},{\"title\":\"Prime REST API Requests\",\"sidebarTitle\":\"Requests\",\"description\":null,\"href\":\"/prime/rest-api/requests\"},{\"title\":\"Prime REST API Rate Limits\",\"sidebarTitle\":\"Rate Limits\",\"description\":null,\"href\":\"/prime/rest-api/rate-limits\"},{\"title\":\"Prime REST API Authentication\",\"sidebarTitle\":\"Authentication\",\"description\":null,\"href\":\"/prime/rest-api/authentication\"},{\"title\":\"API Key Rotation\",\"sidebarTitle\":\"API Key Rotation\",\"description\":null,\"href\":\"/prime/rest-api/api-key-rotation\"},{\"title\":\"Prime REST API Pagination\",\"sidebarTitle\":\"Pagination\",\"description\":null,\"href\":\"/prime/rest-api/pagination\"},{\"title\":\"Prime REST API CLI Setup Guide\",\"sidebarTitle\":\"CLI Setup\",\"description\":null,\"href\":\"/prime/rest-api/cli-setup\"},{\"title\":\"Prime REST API SDKs\",\"sidebarTitle\":\"SDKs\",\"description\":null,\"href\":\"/prime/rest-api/sdks\"},{\"title\":\"Prime Types\",\"sidebarTitle\":\"Types\",\"description\":null,\"href\":\"/prime/rest-api/types\"},{\"title\":\"Error Dictionary\",\"description\":null,\"href\":\"/api-reference/prime-api/rest-api/errors\"},{\"group\":\"Activities\",\"pages\":[{\"title\":\"Get Activity by Activity ID\",\"openapi\":\"GET /v1/activities/{activity_id}\",\"playground\":\"simple\",\"description\":\"Retrieve an activity by its activity ID - this endpoint can retrieve both portfolio and entity activities when passed the appropriate API key\",\"href\":\"/api-reference/prime-api/rest-api/activities/get-activity-by-activity-id\"},{\"title\":\"Get Portfolio Activity by Activity ID\",\"openapi\":\"GET /v1/portfolios/{portfolio_id}/activities/{activity_id}\",\"playground\":\"simple\",\"description\":\"Retrieve an activity by its activity ID\",\"href\":\"/api-reference/prime-api/rest-api/activities/get-portfolio-activity-by-activity-id\"},{\"title\":\"List Activities\",\"openapi\":\"GET /v1/portfolios/{portfolio_id}/activities\",\"playground\":\"simple\",\"description\":\"List all activities associated with a given portfolio.\",\"href\":\"/api-reference/prime-api/rest-api/activities/list-activities\"},{\"title\":\"List Entity Activities\",\"openapi\":\"GET /v1/entities/{entity_id}/activities\",\"playground\":\"simple\",\"description\":\"List all activities associated with a given entity.\",\"href\":\"/api-reference/prime-api/rest-api/activities/list-entity-activities\"}]},{\"group\":\"Address Book\",\"pages\":[{\"title\":\"Get Address Book\",\"openapi\":\"GET /v1/portfolios/{portfolio_id}/address_book\",\"playground\":\"simple\",\"description\":\"Gets a list of address book addresses.\",\"href\":\"/api-reference/prime-api/rest-api/address-book/get-address-book\"},{\"title\":\"Create Address Book Entry\",\"openapi\":\"POST /v1/portfolios/{portfolio_id}/address_book\",\"playground\":\"simple\",\"description\":\"Creates an entry for a portfolio's trusted addresses.\",\"href\":\"/api-reference/prime-api/rest-api/address-book/create-address-book-entry\"}]},{\"group\":\"Advanced Transfer\",\"pages\":[{\"openapi\":\"get /v1/portfolios/{portfolio_id}/counterparty\",\"playground\":\"simple\",\"title\":\"Get Portfolio Counterparty ID\",\"description\":\"Retrieve the counterparty ID for a given portfolio.\",\"href\":\"/api-reference/prime-api/rest-api/advanced-transfer/get-portfolio-counterparty-id\"},{\"openapi\":\"get /v1/portfolios/{portfolio_id}/advanced_transfers\",\"playground\":\"simple\",\"title\":\"List Advanced Transfers\",\"description\":\"List advanced transfers for a given portfolio. This API is currently not available to all clients. Please reach out to Prime Operations with any questions.\",\"href\":\"/api-reference/prime-api/rest-api/advanced-transfer/list-advanced-transfers\"},{\"openapi\":\"post /v1/portfolios/{portfolio_id}/advanced_transfers/{advanced_transfer_id}/cancel\",\"playground\":\"simple\",\"title\":\"Cancel Advanced Transfer\",\"description\":\"Cancel advanced transfer for a given portfolio. This API is currently not available to all clients. Please reach out to Prime Operations with any questions.\",\"href\":\"/api-reference/prime-api/rest-api/advanced-transfer/cancel-advanced-transfer\"},{\"openapi\":\"post /v1/portfolios/{portfolio_id}/advanced_transfers\",\"playground\":\"simple\",\"title\":\"Create Advanced Transfer\",\"description\":\"Create advanced transfer for a given portfolio. This API is currently not available to all clients. Please reach out to Prime Operations with any questions.\",\"href\":\"/api-reference/prime-api/rest-api/advanced-transfer/create-advanced-transfer\"}]},{\"group\":\"Allocations\",\"pages\":[{\"title\":\"Get Allocation by ID\",\"openapi\":\"GET /v1/portfolios/{portfolio_id}/allocations/{allocation_id}\",\"playground\":\"simple\",\"description\":\"Retrieve an allocation by allocation ID.\",\"href\":\"/api-reference/prime-api/rest-api/allocations/get-allocation-by-id\"},{\"title\":\"Get Net Allocations by Netting ID\",\"openapi\":\"GET /v1/portfolios/{portfolio_id}/allocations/net/{netting_id}\",\"playground\":\"simple\",\"description\":\"Retrieve an allocation by netting ID.\",\"href\":\"/api-reference/prime-api/rest-api/allocations/get-net-allocations-by-netting-id\"},{\"openapi\":\"get /v1/portfolios/{portfolio_id}/allocations\",\"playground\":\"simple\",\"title\":\"List Portfolio Allocations\",\"description\":\"List historical allocations for a given portfolio.\",\"href\":\"/api-reference/prime-api/rest-api/allocations/list-portfolio-allocations\"},{\"title\":\"Create Portfolio Allocations\",\"openapi\":\"POST /v1/allocations\",\"playground\":\"simple\",\"description\":\"Create allocation for a given portfolio.\",\"href\":\"/api-reference/prime-api/rest-api/allocations/create-portfolio-allocations\"},{\"title\":\"Create Portfolio Net Allocations\",\"openapi\":\"POST /v1/allocations/net\",\"playground\":\"simple\",\"description\":\"Create net allocation for a given portfolio.\",\"href\":\"/api-reference/prime-api/rest-api/allocations/create-portfolio-net-allocations\"}]},{\"group\":\"API Key Management\",\"pages\":[{\"title\":\"Rotate API Key\",\"openapi\":\"POST /v1/api-keys/rotate\",\"playground\":\"simple\",\"description\":\"Generates a new API key with the same configuration as the invoking key.\",\"href\":\"/api-reference/prime-api/rest-api/api-key-management/rotate-api-key\"}]},{\"group\":\"Assets\",\"pages\":[{\"title\":\"List Assets\",\"openapi\":\"GET /v1/entities/{entity_id}/assets\",\"playground\":\"simple\",\"description\":\"List all assets available for a given entity.\",\"href\":\"/api-reference/prime-api/rest-api/assets/list-assets\"}]},{\"group\":\"Balances\",\"pages\":[{\"title\":\"Get Wallet Balance\",\"openapi\":\"GET /v1/portfolios/{portfolio_id}/wallets/{wallet_id}/balance\",\"playground\":\"simple\",\"description\":\"Query balance for a specific wallet.\",\"href\":\"/api-reference/prime-api/rest-api/balances/get-wallet-balance\"},{\"title\":\"List Entity Balances\",\"openapi\":\"GET  /v1/entities/{entity_id}/balances\",\"playground\":\"simple\",\"description\":\"List all balances for a specific entity.\",\"href\":\"/api-reference/prime-api/rest-api/balances/list-entity-balances\"},{\"title\":\"List Onchain Wallet Balances\",\"openapi\":\"GET  /v1/portfolios/{portfolio_id}/wallets/{wallet_id}/web3_balances\",\"playground\":\"simple\",\"description\":\"Query balances for a specific onchain wallet.\",\"href\":\"/api-reference/prime-api/rest-api/balances/list-onchain-wallet-balances\"},{\"title\":\"List Portfolio Balances\",\"openapi\":\"GET /v1/portfolios/{portfolio_id}/balances\",\"playground\":\"simple\",\"description\":\"List all balances for a specific portfolio.\",\"href\":\"/api-reference/prime-api/rest-api/balances/list-portfolio-balances\"}]},{\"group\":\"Commission\",\"pages\":[{\"title\":\"Get Portfolio Commission\",\"openapi\":\"GET /v1/portfolios/{portfolio_id}/commission\",\"playground\":\"simple\",\"description\":\"Retrieve commission associated with a given portfolio.\",\"href\":\"/api-reference/prime-api/rest-api/commission/get-portfolio-commission\"}]},{\"group\":\"Financing\",\"pages\":[{\"openapi\":\"get /v1/conversion/fees\",\"playground\":\"simple\",\"title\":\"Get Conversion Fees\",\"description\":\"Get your organization's stablecoin conversion fee tiers and month-to-date net conversion volume per currency. The organization is resolved from the authenticated API key, which must be organization-scoped.\",\"href\":\"/api-reference/prime-api/rest-api/financing/get-conversion-fees\"},{\"openapi\":\"get /v1/entities/{entity_id}/cross_margin/liquidation\",\"playground\":\"simple\",\"title\":\"Get Cross Margin Liquidation\",\"description\":\"Gets detailed liquidation data for an XM customer. Returns the active or most recent liquidation by default.\",\"href\":\"/api-reference/prime-api/rest-api/financing/get-cross-margin-liquidation\"},{\"openapi\":\"get /v1/entities/{entity_id}/cross_margin/risk_parameters\",\"playground\":\"simple\",\"title\":\"Get Cross Margin Risk Parameters\",\"description\":\"Gets the current Cross Margin (XM) risk parameters for an entity.\",\"href\":\"/api-reference/prime-api/rest-api/financing/get-cross-margin-risk-parameters\"},{\"title\":\"Get Entity Locate Availabilities\",\"openapi\":\"GET /v1/entities/{entity_id}/locates_availability\",\"playground\":\"simple\",\"description\":\"Get currencies available to be located with their corresponding amount and rate.\",\"href\":\"/api-reference/prime-api/rest-api/financing/get-entity-locate-availabilities\"},{\"openapi\":\"get /v1/entities/{entity_id}/rewards/rate\",\"playground\":\"simple\",\"title\":\"Get Entity Rewards Rate (Beta)\",\"description\":\"Returns the current rewards rate and available rate tiers for the entity.\",\"href\":\"/api-reference/prime-api/rest-api/financing/get-entity-rewards-rate-beta\"},{\"openapi\":\"get /v1/entities/{entity_id}/cross_margin\",\"playground\":\"simple\",\"title\":\"Get Exchange Cross Margin Overview\",\"description\":\"Gets live data for Cross Margin (XM) for a specific XM customer\",\"href\":\"/api-reference/prime-api/rest-api/financing/get-exchange-cross-margin-overview\"},{\"title\":\"Get Margin Information\",\"openapi\":\"GET /v1/entities/{entity_id}/margin\",\"playground\":\"simple\",\"description\":\"Gets real-time evaluation of the margin model based on current positions and spot rates.\",\"href\":\"/api-reference/prime-api/rest-api/financing/get-margin-information\"},{\"openapi\":\"get /v1/entities/{entity_id}/market_data\",\"playground\":\"simple\",\"title\":\"Get Market Data\",\"description\":\"Retrieves market data including volatility and average daily volume for an entity.\",\"href\":\"/api-reference/prime-api/rest-api/financing/get-market-data\"},{\"title\":\"Get Portfolio Buying Power\",\"openapi\":\"GET /v1/portfolios/{portfolio_id}/buying_power\",\"playground\":\"simple\",\"description\":\"Returns the size of a buy trade that can be performed based on existing holdings and available credit. The result will differ for different assets due to asset specific credit configurations and caps. Note that this result is changing based on asset price fluctuations, so may be rejected when submitted.\",\"href\":\"/api-reference/prime-api/rest-api/financing/get-portfolio-buying-power\"},{\"title\":\"Get Portfolio Credit Information\",\"openapi\":\"GET  /v1/portfolios/{portfolio_id}/credit\",\"playground\":\"simple\",\"description\":\"Retrieve a portfolio's post-trade credit information.\",\"href\":\"/api-reference/prime-api/rest-api/financing/get-portfolio-credit-information\"},{\"openapi\":\"get /v1/portfolios/{portfolio_id}/rewards/rate\",\"playground\":\"simple\",\"title\":\"Get Portfolio Rewards Rate (Beta)\",\"description\":\"Returns the current rewards rate and available rate tiers for the portfolio.\",\"href\":\"/api-reference/prime-api/rest-api/financing/get-portfolio-rewards-rate-beta\"},{\"title\":\"Get Portfolio Withdrawal Power\",\"openapi\":\"GET /v1/portfolios/{portfolio_id}/withdrawal_power\",\"playground\":\"simple\",\"description\":\"Returns the nominal quantity of a given asset that can be withdrawn based on holdings and current portfolio equity.\",\"href\":\"/api-reference/prime-api/rest-api/financing/get-portfolio-withdrawal-power\"},{\"openapi\":\"get /v2/entities/{entity_id}/cross_margin/prime\",\"playground\":\"simple\",\"title\":\"Get Prime Cross Margin Overview\",\"description\":\"Returns real time risk data from the cross margin model.\",\"href\":\"/api-reference/prime-api/rest-api/financing/get-prime-cross-margin-overview\"},{\"title\":\"Get Trade Finance Tiered Pricing Fees\",\"openapi\":\"GET /v1/entities/{entity_id}/tf_tiered_fees\",\"playground\":\"simple\",\"description\":\"Get trade finance tiered pricing fees for a given entity at a specific time, default to current time.\",\"href\":\"/api-reference/prime-api/rest-api/financing/get-trade-finance-tiered-pricing-fees\"},{\"openapi\":\"get /v1/entities/{entity_id}/cross_margin/liquidations\",\"playground\":\"simple\",\"title\":\"List Cross Margin Liquidations\",\"description\":\"Lists historical liquidation records for an XM customer\",\"href\":\"/api-reference/prime-api/rest-api/financing/list-cross-margin-liquidations\"},{\"title\":\"List Existing Locates\",\"openapi\":\"GET /v1/portfolios/{portfolio_id}/locates\",\"playground\":\"simple\",\"description\":\"List locates for the portfolio\",\"href\":\"/api-reference/prime-api/rest-api/financing/list-existing-locates\"},{\"openapi\":\"get /v1/financing/eligible-assets\",\"playground\":\"simple\",\"title\":\"List Financing Eligible Assets\",\"description\":\"Get all assets eligible for Trade Finance with their adjustment factors.\",\"href\":\"/api-reference/prime-api/rest-api/financing/list-financing-eligible-assets\"},{\"title\":\"List Interest Accruals\",\"openapi\":\"GET /v1/entities/{entity_id}/accruals\",\"playground\":\"simple\",\"description\":\"Lists interest accruals for an entity between the specified date range given\",\"href\":\"/api-reference/prime-api/rest-api/financing/list-interest-accruals\"},{\"title\":\"List Interest Accruals For Portfolio\",\"openapi\":\"GET /v1/portfolios/{portfolio_id}/accruals\",\"playground\":\"simple\",\"description\":\"Lists interest accruals between the specified date range for a specific portfolio ID\",\"href\":\"/api-reference/prime-api/rest-api/financing/list-interest-accruals-for-portfolio\"},{\"title\":\"List Margin Call Summaries\",\"openapi\":\"GET /v1/entities/{entity_id}/margin_summaries\",\"playground\":\"simple\",\"description\":\"Lists the margin call history for a given entity ID.\",\"href\":\"/api-reference/prime-api/rest-api/financing/list-margin-call-summaries\"},{\"title\":\"List Margin Conversions\",\"openapi\":\"GET /v1/portfolios/{portfolio_id}/margin_conversions\",\"playground\":\"simple\",\"description\":\"Lists conversions and short collateral requirement between specified date range. This endpoint is deprecated and will be removed in the future. Use /v1/entities/{entity_id}/margin_summaries instead.\",\"href\":\"/api-reference/prime-api/rest-api/financing/list-margin-conversions\"},{\"openapi\":\"get /v1/entities/{entity_id}/tf_obligations\",\"playground\":\"simple\",\"title\":\"List Trade Finance Obligations\",\"description\":\"List trade finance obligations for a given entity.\",\"href\":\"/api-reference/prime-api/rest-api/financing/list-trade-finance-obligations\"},{\"title\":\"Create New Locates\",\"openapi\":\"POST /v1/portfolios/{portfolio_id}/locates\",\"playground\":\"simple\",\"description\":\"Create a new locate\",\"href\":\"/api-reference/prime-api/rest-api/financing/create-new-locates\"},{\"openapi\":\"post /v1/entities/{entity_id}/funding_settings\",\"playground\":\"simple\",\"title\":\"Update Funding Settings\",\"description\":\"Sets FCM funding configuration for the entity and submits the desired configuration to Prime API for approval.\",\"href\":\"/api-reference/prime-api/rest-api/financing/update-funding-settings\"}]},{\"group\":\"Futures\",\"pages\":[{\"title\":\"Get Entity FCM Balance\",\"openapi\":\"GET /v1/entities/{entity_id}/futures/balance_summary\",\"playground\":\"simple\",\"description\":\"Retrieve fcm balance for a given entity.\",\"href\":\"/api-reference/prime-api/rest-api/futures/get-entity-fcm-balance\"},{\"title\":\"Get Entity Positions\",\"openapi\":\"GET /v1/entities/{entity_id}/futures/positions\",\"playground\":\"simple\",\"description\":\"Retrieve all active fcm positions for a given entity.\",\"href\":\"/api-reference/prime-api/rest-api/futures/get-entity-positions\"},{\"openapi\":\"get /v1/entities/{entity_id}/futures/equity\",\"playground\":\"simple\",\"title\":\"Get FCM Equity\",\"description\":\"Retrieve the equity data for a given entity.\",\"href\":\"/api-reference/prime-api/rest-api/futures/get-fcm-equity\"},{\"title\":\"Get Margin Call Details\",\"openapi\":\"GET /v1/entities/{entity_id}/futures/margin_call_details\",\"playground\":\"simple\",\"description\":\"Retrieve the margin call details for a given entity.\",\"href\":\"/api-reference/prime-api/rest-api/futures/get-fcm-margin-call-details\"},{\"title\":\"Get Risk Limits\",\"openapi\":\"GET /v1/entities/{entity_id}/futures/risk_limits\",\"playground\":\"simple\",\"description\":\"Retrieve the risk limits for a given entity.\",\"href\":\"/api-reference/prime-api/rest-api/futures/get-fcm-risk-limits\"},{\"openapi\":\"get /v1/entities/{entity_id}/futures/settings\",\"playground\":\"simple\",\"title\":\"Get FCM Settings\",\"description\":\"Get settings related to FCM.\",\"href\":\"/api-reference/prime-api/rest-api/futures/get-fcm-settings\"},{\"openapi\":\"get /v1/portfolios/{portfolio_id}/derivatives/currency_summary\",\"playground\":\"simple\",\"title\":\"Get Portfolio Derivatives Currency Summary\",\"description\":\"Retrieve per-currency international derivatives balances for a given portfolio. US Futures balances roll up to a single clearing account per entity rather than per portfolio, and are available from the entity futures balance summary and risk limits endpoints instead.\",\"href\":\"/api-reference/prime-api/rest-api/futures/get-portfolio-derivatives-currency-summary\"},{\"title\":\"List Entity Futures Sweeps\",\"openapi\":\"GET /v1/entities/{entity_id}/futures/sweeps\",\"playground\":\"simple\",\"description\":\"Retrieve fcm sweeps in open status, including pending and processing sweeps.\",\"href\":\"/api-reference/prime-api/rest-api/futures/list-entity-futures-sweeps\"},{\"openapi\":\"get /v1/portfolios/{portfolio_id}/derivatives/positions\",\"playground\":\"simple\",\"title\":\"List Portfolio Derivative Positions\",\"description\":\"Retrieve all active derivative positions for a given portfolio.\",\"href\":\"/api-reference/prime-api/rest-api/futures/list-portfolio-derivative-positions\"},{\"title\":\"Schedule Entity Futures Sweep\",\"openapi\":\"POST  /v1/entities/{entity_id}/futures/sweeps\",\"playground\":\"simple\",\"description\":\"Schedule a sweep for a given entity from FCM wallet to USD Spot wallet. Only one pending sweep is allowed at a time per entity.\",\"href\":\"/api-reference/prime-api/rest-api/futures/schedule-entity-futures-sweep\"},{\"title\":\"Set Auto Sweep\",\"openapi\":\"POST  /v1/entities/{entity_id}/futures/auto_sweep\",\"playground\":\"simple\",\"description\":\"Set auto sweep for a given entity.\",\"href\":\"/api-reference/prime-api/rest-api/futures/set-auto-sweep\"},{\"openapi\":\"post /v1/entities/{entity_id}/futures/settings\",\"playground\":\"simple\",\"title\":\"Set FCM Settings\",\"description\":\"Update settings related to FCM.\",\"href\":\"/api-reference/prime-api/rest-api/futures/set-fcm-settings\"},{\"title\":\"Cancel Entity Futures Sweep\",\"openapi\":\"delete /v1/entities/{entity_id}/futures/sweeps\",\"playground\":\"simple\",\"description\":\"Cancel the pending sweep for a given entity. A user will only be able to have one pending sweep at a time. If the sweep is not found, a 404 will be returned.\",\"href\":\"/api-reference/prime-api/rest-api/futures/cancel-entity-futures-sweep\"}]},{\"group\":\"Invoice\",\"pages\":[{\"title\":\"List Invoices\",\"openapi\":\"GET /v1/entities/{entity_id}/invoices\",\"playground\":\"simple\",\"description\":\"Retrieve a list of invoices belonging to an entity.\",\"href\":\"/api-reference/prime-api/rest-api/invoice/list-invoices\"}]},{\"group\":\"Onchain Address Book\",\"pages\":[{\"title\":\"List Onchain Address Groups\",\"openapi\":\"GET /v1/portfolios/{portfolio_id}/onchain_address_groups\",\"playground\":\"simple\",\"description\":\"Lists all onchain address groups for a given portfolio ID\",\"href\":\"/api-reference/prime-api/rest-api/onchain-address-book/list-onchain-address-groups\"},{\"title\":\"Create Onchain Address Book Entry\",\"openapi\":\"POST /v1/portfolios/{portfolio_id}/onchain_address_group\",\"playground\":\"simple\",\"description\":\"Creates an entry to the portfolio's onchain address groups.\",\"href\":\"/api-reference/prime-api/rest-api/onchain-address-book/create-onchain-address-book-entry\"},{\"title\":\"Update Onchain Address Book Entry\",\"openapi\":\"PUT /v1/portfolios/{portfolio_id}/onchain_address_group\",\"playground\":\"simple\",\"description\":\"Updates an entry to the portfolio's onchain address groups.\",\"href\":\"/api-reference/prime-api/rest-api/onchain-address-book/update-onchain-address-book-entry\"},{\"title\":\"Delete Onchain Address Group\",\"openapi\":\"DELETE /v1/portfolios/{portfolio_id}/onchain_address_group/{address_group_id}\",\"playground\":\"simple\",\"description\":\"Deletes an entry in the portfolio's onchain address groups.\",\"href\":\"/api-reference/prime-api/rest-api/onchain-address-book/delete-onchain-address-group\"}]},{\"group\":\"Orders\",\"pages\":[{\"title\":\"Get Order by Order ID\",\"openapi\":\"GET /v1/portfolios/{portfolio_id}/orders/{order_id}\",\"playground\":\"simple\",\"description\":\"Retrieve an order by order ID.\",\"href\":\"/api-reference/prime-api/rest-api/orders/get-order-by-order-id\"},{\"title\":\"List Open Orders\",\"openapi\":\"GET /v1/portfolios/{portfolio_id}/open_orders\",\"playground\":\"simple\",\"description\":\"List all open orders. \u003cbr /\u003e\u003cbr /\u003e**Caution:** The maximum number of orders returned is 5000. If a client has more than 5000 open orders, an error is returned prompting the user to use Websocket API, or FIX API to stream open orders.\",\"href\":\"/api-reference/prime-api/rest-api/orders/list-open-orders\"},{\"title\":\"List Order Edit History\",\"openapi\":\"GET  /v1/portfolios/{portfolio_id}/orders/{order_id}/edit_history\",\"playground\":\"simple\",\"description\":\"List edit history for a specific order\",\"href\":\"/api-reference/prime-api/rest-api/orders/list-order-edit-history\"},{\"title\":\"List Order Fills\",\"openapi\":\"GET /v1/portfolios/{portfolio_id}/orders/{order_id}/fills\",\"playground\":\"simple\",\"description\":\"Retrieve fills on a given order. This endpoint returns a payload with a default limit of 100 if not specified by the user. The maximum allowed limit is 3000.\",\"href\":\"/api-reference/prime-api/rest-api/orders/list-order-fills\"},{\"title\":\"List Portfolio Fills\",\"openapi\":\"GET /v1/portfolios/{portfolio_id}/fills\",\"playground\":\"simple\",\"description\":\"Retrieve fills on a given portfolio. This endpoint requires a start_date, and returns a payload with a default limit of 100 if not specified by the user. The maximum allowed limit is 3000.\",\"href\":\"/api-reference/prime-api/rest-api/orders/list-portfolio-fills\"},{\"title\":\"List Portfolio Orders\",\"openapi\":\"GET  /v1/portfolios/{portfolio_id}/orders\",\"playground\":\"simple\",\"description\":\"List historical orders for a given portfolio. This endpoint returns a payload with a default limit of 100 if not specified by the user. The maximum allowed limit is 3000. \u003cbr /\u003e\u003cbr /\u003e**Caution:** Currently, you cannot query open orders with this endpoint: use List Open Orders if you have less than 1000 open orders, otherwise use Websocket API, or FIX API to stream open orders.\",\"href\":\"/api-reference/prime-api/rest-api/orders/list-portfolio-orders\"},{\"title\":\"Accept Quote\",\"openapi\":\"POST /v1/portfolios/{portfolio_id}/accept_quote\",\"playground\":\"simple\",\"description\":\"Accepts the quote received by the quote request and creates an order with the provided quote ID.\\n\\nAlways required: portfolio_id, product_id, side, quote_id, client_quote_id.\",\"href\":\"/api-reference/prime-api/rest-api/orders/accept-quote\"},{\"title\":\"Cancel Order\",\"openapi\":\"POST /v1/portfolios/{portfolio_id}/orders/{order_id}/cancel\",\"playground\":\"simple\",\"description\":\"Cancel an order. (Filled orders cannot be canceled.)\",\"href\":\"/api-reference/prime-api/rest-api/orders/cancel-order\"},{\"title\":\"Create Order\",\"openapi\":\"POST  /v1/portfolios/{portfolio_id}/order\",\"playground\":\"simple\",\"description\":\"Create an order.\",\"href\":\"/api-reference/prime-api/rest-api/orders/create-order\"},{\"title\":\"Create Quote Request\",\"openapi\":\"POST /v1/portfolios/{portfolio_id}/rfq\",\"playground\":\"simple\",\"description\":\"A Quote Request is the start of the RFQ process. Coinbase Prime sends a Quote Request to Liquidity Providers (LPs) on behalf of a customer looking to participate in an RFQ trade.\\n\\nAlways required: portfolio_id, product_id, side, client_quote_id, and limit_price. One of either base_quantity or quote_value is always required.\",\"href\":\"/api-reference/prime-api/rest-api/orders/create-quote-request\"},{\"title\":\"Get Order Preview\",\"openapi\":\"POST /v1/portfolios/{portfolio_id}/order_preview\",\"playground\":\"simple\",\"description\":\"Retrieve an order preview.\",\"href\":\"/api-reference/prime-api/rest-api/orders/get-order-preview\"},{\"openapi\":\"put /v1/portfolios/{portfolio_id}/orders/{order_id}/edit\",\"playground\":\"simple\",\"title\":\"Edit Order\",\"description\":\"Edit an open order.\",\"href\":\"/api-reference/prime-api/rest-api/orders/edit-order\"}]},{\"group\":\"Payment Methods\",\"pages\":[{\"title\":\"Get Entity Payment Method\",\"openapi\":\"GET /v1/entities/{entity_id}/payment-methods/{payment_method_id}\",\"playground\":\"simple\",\"description\":\"Get payment method details by id for a given entity.\",\"href\":\"/api-reference/prime-api/rest-api/payment-methods/get-entity-payment-method\"},{\"title\":\"List Entity Payment Methods\",\"openapi\":\"GET /v1/entities/{entity_id}/payment-methods\",\"playground\":\"simple\",\"description\":\"Retrieve all payment methods for a given entity.\",\"href\":\"/api-reference/prime-api/rest-api/payment-methods/list-entity-payment-methods\"}]},{\"group\":\"Portfolios\",\"pages\":[{\"title\":\"Get Portfolio by Portfolio ID\",\"openapi\":\"GET /v1/portfolios/{portfolio_id}\",\"playground\":\"simple\",\"description\":\"Retrieve a given portfolio by its portfolio ID.\",\"href\":\"/api-reference/prime-api/rest-api/portfolios/get-portfolio-by-portfolio-id\"},{\"title\":\"List Portfolios\",\"openapi\":\"GET /v1/portfolios\",\"playground\":\"simple\",\"description\":\"List all portfolios for which the current API key has read access.\",\"href\":\"/api-reference/prime-api/rest-api/portfolios/list-portfolios\"}]},{\"group\":\"Positions\",\"pages\":[{\"title\":\"List Aggregate Entity Positions\",\"openapi\":\"GET /v1/entities/{entity_id}/aggregate_positions\",\"playground\":\"simple\",\"description\":\"List paginated aggregate positions for a specific entity.\",\"href\":\"/api-reference/prime-api/rest-api/positions/list-aggregate-entity-positions\"},{\"title\":\"List Entity Positions\",\"openapi\":\"GET /v1/entities/{entity_id}/positions\",\"playground\":\"simple\",\"description\":\"List paginated positions for a specific entity.\",\"href\":\"/api-reference/prime-api/rest-api/positions/list-entity-positions\"}]},{\"group\":\"Products\",\"pages\":[{\"openapi\":\"get /v1/portfolios/{portfolio_id}/candles\",\"playground\":\"simple\",\"title\":\"Get Public Product Candles\",\"description\":\"Get rates for a single product by product ID, grouped in buckets.\",\"href\":\"/api-reference/prime-api/rest-api/products/get-public-product-candles\"},{\"title\":\"List Portfolio Products\",\"openapi\":\"GET /v1/portfolios/{portfolio_id}/products\",\"playground\":\"simple\",\"description\":\"List products for a given portfolio.\",\"href\":\"/api-reference/prime-api/rest-api/products/list-portfolio-products\"}]},{\"group\":\"Staking\",\"pages\":[{\"openapi\":\"get /v1/portfolios/{portfolio_id}/wallets/{wallet_id}/staking/status\",\"playground\":\"simple\",\"title\":\"Get Staking Status\",\"description\":\"Get staking status for a wallet. Returns estimated completion times for active staking requests.\",\"href\":\"/api-reference/prime-api/rest-api/staking/get-staking-status\"},{\"openapi\":\"get /v1/portfolios/{portfolio_id}/wallets/{wallet_id}/staking/unstake/status\",\"playground\":\"simple\",\"title\":\"Get Unstaking Status\",\"description\":\"Get unstaking estimates for a wallet. Returns estimated completion times for active unstaking requests.\",\"href\":\"/api-reference/prime-api/rest-api/staking/get-unstaking-status\"},{\"title\":\"Claim Wallet Staking Rewards\",\"openapi\":\"post /v1/portfolios/{portfolio_id}/wallets/{wallet_id}/staking/claim_rewards\",\"playground\":\"simple\",\"description\":\"Request to claim staking rewards. This feature is only for ETH Pectra (0x02) validators.\",\"href\":\"/api-reference/prime-api/rest-api/staking/claim-wallet-staking-rewards-alpha\"},{\"title\":\"Query Transaction Validators\",\"openapi\":\"post /v1/portfolios/{portfolio_id}/staking/transaction-validators/query\",\"playground\":\"simple\",\"description\":\"List ETH 0x02 validators associated with wallet-level stake transactions for a given portfolio. It will not return data for unstake transactions, portfolio stake transactions, transactions which staked different currencies, or which staked to Ethereum 0x01 validators.\",\"href\":\"/api-reference/prime-api/rest-api/staking/list-transaction-validators\"},{\"openapi\":\"post /v1/portfolios/{portfolio_id}/wallets/{wallet_id}/staking/unstake/preview\",\"playground\":\"simple\",\"title\":\"Preview Unstake\",\"description\":\"Previews an unstaking request with the given amount and returns the estimated amount that would be unstaked. This feature currently only supports ETH.\",\"href\":\"/api-reference/prime-api/rest-api/staking/preview-unstake\"},{\"title\":\"Request to stake currency in a portfolio\",\"openapi\":\"post /v1/portfolios/{portfolio_id}/staking/initiate\",\"playground\":\"simple\",\"description\":\"Creates an execution request to stake funds across a portfolio.  This will stake funds in one or more wallets in the portfolio, with a total bondable balance up to the requested stake amount. This feature is gated. Please contact your account manager or primeops@coinbase.com to enable.\",\"href\":\"/api-reference/prime-api/rest-api/staking/request-to-stake-currency-in-a-portfolio\"},{\"title\":\"Request to stake or delegate a wallet\",\"openapi\":\"post /v1/portfolios/{portfolio_id}/wallets/{wallet_id}/staking/initiate\",\"playground\":\"simple\",\"description\":\"Creates an execution request to stake or delegate funds to a validator\",\"href\":\"/api-reference/prime-api/rest-api/staking/request-to-stake-or-delegate-a-wallet\"},{\"title\":\"Request to unstake a wallet\",\"openapi\":\"POST /v1/portfolios/{portfolio_id}/wallets/{wallet_id}/staking/unstake\",\"playground\":\"simple\",\"description\":\"Creates an execution request to unstake delegated or staked funds in a wallet\",\"href\":\"/api-reference/prime-api/rest-api/staking/request-to-unstake-a-wallet\"},{\"title\":\"Request to unstake currency across a portfolio\",\"openapi\":\"post /v1/portfolios/{portfolio_id}/staking/unstake\",\"playground\":\"simple\",\"description\":\"Creates an execution request to unstake funds across a portfolio.  This will unstake funds in one or more wallets in the portfolio, with a total bonded balance up to the requested unstake amount. This feature is gated. Please contact your account manager or primeops@coinbase.com to enable.\",\"href\":\"/api-reference/prime-api/rest-api/staking/request-to-unstake-currency-across-a-portfolio\"}]},{\"group\":\"Transactions\",\"pages\":[{\"title\":\"Get Transaction by Transaction ID\",\"openapi\":\"GET /v1/portfolios/{portfolio_id}/transactions/{transaction_id}\",\"playground\":\"simple\",\"description\":\"Retrieve a specific transaction by its transaction ID.\",\"href\":\"/api-reference/prime-api/rest-api/transactions/get-transaction-by-transaction-id\"},{\"title\":\"List Portfolio Transactions\",\"openapi\":\"GET /v1/portfolios/{portfolio_id}/transactions\",\"playground\":\"simple\",\"description\":\"List transactions for a given portfolio.\",\"href\":\"/api-reference/prime-api/rest-api/transactions/list-portfolio-transactions\"},{\"openapi\":\"get /v1/portfolios/{portfolio_id}/advanced_transfers/{advanced_transfer_id}/transactions\",\"playground\":\"simple\",\"title\":\"List transactions associated with an Advanced Transfer\",\"description\":\"List transactions associated with an Advanced Transfer. This API is currently not available to all clients. Please reach out to Prime Operations with any questions.\",\"href\":\"/api-reference/prime-api/rest-api/transactions/list-transactions-associated-with-an-advanced-transfer\"},{\"title\":\"List Wallet Transactions\",\"openapi\":\"GET /v1/portfolios/{portfolio_id}/wallets/{wallet_id}/transactions\",\"playground\":\"simple\",\"description\":\"Retrieve transactions for a given wallet.\",\"href\":\"/api-reference/prime-api/rest-api/transactions/list-wallet-transactions\"},{\"title\":\"Create Conversion\",\"openapi\":\"POST /v1/portfolios/{portfolio_id}/wallets/{wallet_id}/conversion\",\"playground\":\"simple\",\"description\":\"Perform a conversion between 2 assets.\",\"href\":\"/api-reference/prime-api/rest-api/transactions/create-conversion\"},{\"title\":\"Create Onchain Transaction\",\"openapi\":\"POST  /v1/portfolios/{portfolio_id}/wallets/{wallet_id}/onchain_transaction\",\"playground\":\"simple\",\"description\":\"Create an onchain transaction.\",\"href\":\"/api-reference/prime-api/rest-api/transactions/create-onchain-transaction\"},{\"title\":\"Create Transfer\",\"openapi\":\"POST /v1/portfolios/{portfolio_id}/wallets/{wallet_id}/transfers\",\"playground\":\"simple\",\"description\":\"Create a wallet transfer.\",\"href\":\"/api-reference/prime-api/rest-api/transactions/create-transfer\"},{\"title\":\"Create Withdrawal\",\"openapi\":\"POST /v1/portfolios/{portfolio_id}/wallets/{wallet_id}/withdrawals\",\"playground\":\"simple\",\"description\":\"Create a withdrawal.\",\"href\":\"/api-reference/prime-api/rest-api/transactions/create-withdrawal\"}]},{\"group\":\"Travel Rule\",\"pages\":[{\"openapi\":\"get /v1/portfolios/{portfolio_id}/transactions/{transaction_id}/travel_rule\",\"playground\":\"simple\",\"title\":\"Get Transaction Travel Rule Data\",\"description\":\"(Beta) Get fulfilled travel rule data for a transaction.\",\"href\":\"/api-reference/prime-api/rest-api/travel-rule/get-transaction-travel-rule-data\"},{\"openapi\":\"post /v1/portfolios/{portfolio_id}/transactions/{transaction_id}/travel_rule/deposit\",\"playground\":\"simple\",\"title\":\"Submit Deposit Travel Rule Data\",\"description\":\"Submit travel rule data for an existing deposit transaction.\",\"href\":\"/api-reference/prime-api/rest-api/travel-rule/submit-deposit-travel-rule-data\"}]},{\"group\":\"Users\",\"pages\":[{\"title\":\"List Portfolio Users\",\"openapi\":\"GET /v1/portfolios/{portfolio_id}/users\",\"playground\":\"simple\",\"description\":\"List all users associated with a given portfolio.\",\"href\":\"/api-reference/prime-api/rest-api/users/list-portfolio-users\"},{\"title\":\"List Users\",\"openapi\":\"GET /v1/entities/{entity_id}/users\",\"playground\":\"simple\",\"description\":\"List all users associated with a given entity.\",\"href\":\"/api-reference/prime-api/rest-api/users/list-users\"}]},{\"group\":\"Wallets\",\"pages\":[{\"title\":\"Get Wallet by Wallet ID\",\"openapi\":\"GET /v1/portfolios/{portfolio_id}/wallets/{wallet_id}\",\"playground\":\"simple\",\"description\":\"Retrieve a specific wallet by Wallet ID.\",\"href\":\"/api-reference/prime-api/rest-api/wallets/get-wallet-by-wallet-id\"},{\"title\":\"Get Wallet Deposit Instructions\",\"openapi\":\"GET /v1/portfolios/{portfolio_id}/wallets/{wallet_id}/deposit_instructions\",\"playground\":\"simple\",\"description\":\"Retrieve a specific wallet's deposit instructions.\",\"href\":\"/api-reference/prime-api/rest-api/wallets/get-wallet-deposit-instructions\"},{\"title\":\"List Portfolio Wallets\",\"openapi\":\"GET /v1/portfolios/{portfolio_id}/wallets\",\"playground\":\"simple\",\"description\":\"List all wallets associated with a given portfolio.\",\"href\":\"/api-reference/prime-api/rest-api/wallets/list-portfolio-wallets\"},{\"title\":\"List Wallet Addresses\",\"openapi\":\"GET /v1/portfolios/{portfolio_id}/wallets/{wallet_id}/addresses\",\"playground\":\"simple\",\"description\":\"Returns all deposit addresses associated with a wallet\",\"href\":\"/api-reference/prime-api/rest-api/wallets/list-wallet-addresses\"},{\"title\":\"Create Wallet\",\"openapi\":\"POST  /v1/portfolios/{portfolio_id}/wallets\",\"playground\":\"simple\",\"description\":\"Create a wallet. Note: The first ONCHAIN wallet for each network family must be created through the Prime UI.\",\"href\":\"/api-reference/prime-api/rest-api/wallets/create-wallet\"},{\"title\":\"Create Wallet Deposit Address\",\"openapi\":\"POST /v1/portfolios/{portfolio_id}/wallets/{wallet_id}/addresses\",\"playground\":\"simple\",\"description\":\"Creates a new deposit address for a wallet. Only applicable to wallets that support multiple deposit addresses on a given network\",\"href\":\"/api-reference/prime-api/rest-api/wallets/create-wallet-deposit-address\"}]}]},{\"group\":\"Websocket Feed\",\"pages\":[{\"title\":\"Prime WebSocket Overview\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/prime/websocket-feed/overview\"},{\"title\":\"Prime WebSocket Channels\",\"sidebarTitle\":\"Channels\",\"description\":null,\"href\":\"/prime/websocket-feed/channels\"}]},{\"group\":\"FIX 4.2 API\",\"pages\":[{\"title\":\"Prime FIX API Connectivity\",\"sidebarTitle\":\"Connectivity\",\"description\":null,\"href\":\"/prime/fix-api/connectivity\"},{\"title\":\"Prime FIX 4.2 Data Dictionary\",\"sidebarTitle\":\"Dictionaries\",\"description\":\"The Coinbase Prime FIX 4.2 client data dictionary.\",\"href\":\"/prime/fix-api/fix-data-dictionaries\"},{\"group\":\"Messages\",\"pages\":[{\"title\":\"Prime FIX Administrative Messages\",\"sidebarTitle\":\"Administrative Messages\",\"description\":null,\"href\":\"/prime/fix-api/admin-messages\"},{\"title\":\"Prime FIX Order Entry Messages\",\"sidebarTitle\":\"Order Entry Messages\",\"description\":null,\"href\":\"/prime/fix-api/order-entry-messages\"}]}]},{\"group\":\"FIX 5.0 API\",\"pages\":[{\"title\":\"Prime FIX 5.0 API\",\"sidebarTitle\":\"Overview\",\"description\":\"Connect to the Coinbase Prime FIX 5.0 API for spot and derivatives trading.\",\"href\":\"/prime/fix-5-0-api/overview\"},{\"title\":\"Coinbase Prime FIX 4.2 → FIX 5.0 SP2 Order Entry Migration Guide\",\"sidebarTitle\":\"FIX 4.2 to FIX 5.0 Migration\",\"description\":\"Migrate order entry integrations from the Coinbase Prime FIX 4.2 API to FIX 5.0 SP2.\",\"href\":\"/prime/fix-5-0-api/order-entry-migration-guide\"},{\"title\":\"Prime FIX 5.0 Data Dictionary\",\"sidebarTitle\":\"Dictionaries\",\"description\":\"The Coinbase Prime FIX 5.0 SP2 client data dictionary.\",\"href\":\"/prime/fix-5-0-api/dictionaries\"},{\"title\":\"Prime FIX 5.0 Session Management\",\"sidebarTitle\":\"Session management\",\"description\":\"Session-level messages for the Coinbase Prime FIX 5.0 API.\",\"href\":\"/prime/fix-5-0-api/session-management\"},{\"title\":\"Prime FIX 5.0 Market Data\",\"sidebarTitle\":\"Market Data\",\"description\":\"Market data messages for the Coinbase Prime FIX 5.0 API.\",\"tag\":\"Beta\",\"href\":\"/prime/fix-5-0-api/market-data\"},{\"title\":\"Prime FIX 5.0 Order Entry\",\"sidebarTitle\":\"Order Entry\",\"description\":\"Order entry messages for the Coinbase Prime FIX 5.0 API.\",\"href\":\"/prime/fix-5-0-api/order-entry\"},{\"title\":\"Prime FIX 5.0 RFQ\",\"sidebarTitle\":\"RFQ\",\"description\":\"Request, receive, and accept spot RFQ quotes through the Coinbase Prime FIX 5.0 API.\",\"href\":\"/prime/fix-5-0-api/rfq\"},{\"title\":\"Prime FIX 5.0 Code Sets\",\"sidebarTitle\":\"Code Sets\",\"description\":\"Supported code sets for the Coinbase Prime FIX 5.0 API.\",\"href\":\"/prime/fix-5-0-api/code-sets\"}]}]},{\"dropdown\":\"Coinbase Derivatives API\",\"icon\":\"https://mintlify-assets.b-cdn.net/derivativesProduct-2.svg\",\"groups\":[{\"group\":\"REST API Overview\",\"pages\":[{\"title\":\"Welcome to the Coinbase Derivatives REST API\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/api-reference/derivatives-api/rest-api/introduction\"},{\"title\":\"Coinbase Derivatives REST API Authentication\",\"sidebarTitle\":\"Authentication\",\"description\":null,\"href\":\"/api-reference/derivatives-api/rest-api/authentication\"}]},{\"group\":\"REST Endpoints\",\"pages\":[{\"group\":\"Block Trades\",\"pages\":[{\"title\":\"Get Block Trades\",\"description\":\"Retrieves all block trades where user owns the reporting firm/entity.\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json get /rest/block-trade\",\"href\":\"/api-reference/derivatives-api/rest-api/block-trades/get-block-trades\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Filtered Block Trades\",\"description\":\"Retrieves permissioned block trades matching the specified filter criteria. All filter parameters are optional and can be combined.\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json post /rest/block-trade\",\"href\":\"/api-reference/derivatives-api/rest-api/block-trades/get-filtered-block-trades\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Bookable Block Trade Accounts\",\"description\":\"Retrieves the list of block trade accounts that the authenticated user can book trades for.\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json get /rest/block-trade/booking/bookable-accounts\",\"href\":\"/api-reference/derivatives-api/rest-api/block-trades/get-bookable-block-trade-accounts\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Bookable Block Trade Entities\",\"description\":\"Retrieves the list of block trade entities that the authenticated user can book trades for.\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json get /rest/block-trade/booking/bookable-entities\",\"href\":\"/api-reference/derivatives-api/rest-api/block-trades/get-bookable-block-trade-entities\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Bookable Block Traders\",\"description\":\"Retrieves the list of block traders that the authenticated user can book trades for.\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json get /rest/block-trade/booking/bookable-traders\",\"href\":\"/api-reference/derivatives-api/rest-api/block-trades/get-bookable-block-traders\",\"autogeneratedByOpenApi\":true},{\"title\":\"Book a Block Trade\",\"description\":\"Books a new block trade between two parties. For TAS requests, set tas_sub_type=TAS, omit price, and provide tick_differential. If tas_sub_type is omitted, the request is treated as a non-TAS block trade: price is required and tick_differential must not be provided. tick_differential is expressed as the number of ticks from settlement.\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json post /rest/block-trade/new\",\"href\":\"/api-reference/derivatives-api/rest-api/block-trades/book-a-block-trade\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Block Trade Accounts\",\"pages\":[{\"title\":\"Get All Block Trade Account Permissions\",\"description\":\"Retrieves a list of all block trade account permissions you have access to.\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json get /rest/block-trade-account-permissions\",\"href\":\"/api-reference/derivatives-api/rest-api/block-trade-accounts/get-all-block-trade-account-permissions\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Block Trade Account Permission\",\"description\":\"Retrieves information for a block trade account permission with the specified UUID.\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json get /rest/block-trade-account-permissions/{uuid}\",\"href\":\"/api-reference/derivatives-api/rest-api/block-trade-accounts/get-block-trade-account-permission\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get All Block Trade Accounts\",\"description\":\"Retrieves a list of all block trade accounts you have access to.\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json get /rest/block-trade-accounts\",\"href\":\"/api-reference/derivatives-api/rest-api/block-trade-accounts/get-all-block-trade-accounts\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Block Trade Account\",\"description\":\"Retrieves information for a block trade account with the specified UUID.\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json get /rest/block-trade-accounts/{uuid}\",\"href\":\"/api-reference/derivatives-api/rest-api/block-trade-accounts/get-block-trade-account\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get All Block Trade Position Limits\",\"description\":\"Retrieves a list of all block trade position limits you have access to.\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json get /rest/block-trade-position-limits\",\"href\":\"/api-reference/derivatives-api/rest-api/block-trade-accounts/get-all-block-trade-position-limits\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Block Trade Position Limit\",\"description\":\"Retrieves information for a block trade position limit with the specified UUID.\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json get /rest/block-trade-position-limits/{uuid}\",\"href\":\"/api-reference/derivatives-api/rest-api/block-trade-accounts/get-block-trade-position-limit\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Block Trade Entities\",\"pages\":[{\"title\":\"Get All Block Trade Entities\",\"description\":\"Retrieves a list of all block trade entities you have access to.\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json get /rest/block-trade-entities\",\"href\":\"/api-reference/derivatives-api/rest-api/block-trade-entities/get-all-block-trade-entities\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Block Trade Entity\",\"description\":\"Retrieves information for a block trade entity with the specified UUID.\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json get /rest/block-trade-entities/{uuid}\",\"href\":\"/api-reference/derivatives-api/rest-api/block-trade-entities/get-block-trade-entity\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Block Trade Entities by Firm\",\"description\":\"Retrieves the block trade entity associated with the specified firm.\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json get /rest/firm-block-trade-entities/{firm_uuid}\",\"href\":\"/api-reference/derivatives-api/rest-api/block-trade-entities/get-block-trade-entities-by-firm\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Block Traders\",\"pages\":[{\"title\":\"Get All Block Traders\",\"description\":\"Retrieves a list of all block traders you have access to.\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json get /rest/block-traders\",\"href\":\"/api-reference/derivatives-api/rest-api/block-traders/get-all-block-traders\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Block Trader\",\"description\":\"Retrieves information for a block trader with the specified UUID.\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json get /rest/block-traders/{uuid}\",\"href\":\"/api-reference/derivatives-api/rest-api/block-traders/get-block-trader\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Firm Position Limits\",\"pages\":[{\"title\":\"List All Position Limits\",\"description\":\"Retrieves position limits for all firms that the user has access to.\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json get /rest/firm-position-limits\",\"href\":\"/api-reference/derivatives-api/rest-api/firm-position-limits/list-all-position-limits\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Firm Position Limits\",\"description\":\"Retrieves position limits from a specific firm.\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json get /rest/firm-position-limits/{firm_uuid}\",\"href\":\"/api-reference/derivatives-api/rest-api/firm-position-limits/get-firm-position-limits\",\"autogeneratedByOpenApi\":true},{\"title\":\"Update Firm Position Limits\",\"description\":\"Updates position limits for a specific firm\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json post /rest/firm-position-limits/{firm_uuid}\",\"href\":\"/api-reference/derivatives-api/rest-api/firm-position-limits/update-firm-position-limits\",\"autogeneratedByOpenApi\":true},{\"title\":\"List All Position Limits\",\"description\":\"Retrieves position limits for all firms that the user has access to.\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json get /rest/v2/firm-position-limits\",\"href\":\"/api-reference/derivatives-api/rest-api/firm-position-limits/list-all-position-limits-1\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Firm Position Limits\",\"description\":\"Retrieves position limits from a specific firm.\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json get /rest/v2/firm-position-limits/{firm_uuid}\",\"href\":\"/api-reference/derivatives-api/rest-api/firm-position-limits/get-firm-position-limits-1\",\"autogeneratedByOpenApi\":true},{\"title\":\"Update Firm Position Limits\",\"description\":\"Updates position limits for a specific firm\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json post /rest/v2/firm-position-limits/{firm_uuid}\",\"href\":\"/api-reference/derivatives-api/rest-api/firm-position-limits/update-firm-position-limits-1\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Firm Product Group Limits\",\"pages\":[{\"title\":\"Create Zero Firm Product Group Limit\",\"description\":\"Creates a zero position limit to a specific firm/product group that disables trading for that combination.\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json post /rest/firm-product-group-limit\",\"href\":\"/api-reference/derivatives-api/rest-api/firm-product-group-limits/create-zero-firm-product-group-limit\",\"autogeneratedByOpenApi\":true},{\"title\":\"Remove Firm Product Group Limit\",\"description\":\"Removes any product group level limit for a specific firm/product group combination\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json post /rest/firm-product-group-limit/remove\",\"href\":\"/api-reference/derivatives-api/rest-api/firm-product-group-limits/remove-firm-product-group-limit\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Firm Product Group Limits\",\"description\":\"Retrieves product group limits for a specific firm, including individual product limits within each group\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json get /rest/firm-product-group-limit/{firm_uuid}\",\"href\":\"/api-reference/derivatives-api/rest-api/firm-product-group-limits/get-firm-product-group-limits\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create Zero Firm Product Group Limit\",\"description\":\"Creates a zero position limit to a specific firm/product group that disables trading for that combination.\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json post /rest/v2/firm-product-group-limit\",\"href\":\"/api-reference/derivatives-api/rest-api/firm-product-group-limits/create-zero-firm-product-group-limit-1\",\"autogeneratedByOpenApi\":true},{\"title\":\"Remove Firm Product Group Limit\",\"description\":\"Removes any product group level limit for a specific firm/product group combination\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json post /rest/v2/firm-product-group-limit/remove\",\"href\":\"/api-reference/derivatives-api/rest-api/firm-product-group-limits/remove-firm-product-group-limit-1\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Firm Product Group Limits\",\"description\":\"Retrieves product group limits for a specific firm, including individual product limits within each group\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json get /rest/v2/firm-product-group-limit/{firm_uuid}\",\"href\":\"/api-reference/derivatives-api/rest-api/firm-product-group-limits/get-firm-product-group-limits-1\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Firm Product Limits\",\"pages\":[{\"title\":\"Create Zero Firm Product Limit\",\"description\":\"Creates a limit that will block the firm from trading the corresponding product.\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json post /rest/firm-product-limit\",\"href\":\"/api-reference/derivatives-api/rest-api/firm-product-limits/create-zero-firm-product-limit\",\"autogeneratedByOpenApi\":true},{\"title\":\"Remove Firm Product Limit\",\"description\":\"Removes any product level limit for a specific firm and product\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json post /rest/firm-product-limit/remove\",\"href\":\"/api-reference/derivatives-api/rest-api/firm-product-limits/remove-firm-product-limit\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Firm Product Limits\",\"description\":\"Gets product limits for a specific firm and optional product combination.\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json get /rest/firm-product-limit/{firm_uuid}\",\"href\":\"/api-reference/derivatives-api/rest-api/firm-product-limits/get-firm-product-limits\",\"autogeneratedByOpenApi\":true},{\"title\":\"Set Firm Product Limit\",\"description\":\"Set position limits on a product.\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json post /rest/v2/firm-product-limit\",\"href\":\"/api-reference/derivatives-api/rest-api/firm-product-limits/set-firm-product-limit\",\"autogeneratedByOpenApi\":true},{\"title\":\"Batch Set Firm Product Limit\",\"description\":\"Set position limits for multiple products.\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json post /rest/v2/firm-product-limit/batch\",\"href\":\"/api-reference/derivatives-api/rest-api/firm-product-limits/batch-set-firm-product-limit\",\"autogeneratedByOpenApi\":true},{\"title\":\"Remove Firm Product Limit\",\"description\":\"Removes any product level limit for a specific firm and product\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json post /rest/v2/firm-product-limit/remove\",\"href\":\"/api-reference/derivatives-api/rest-api/firm-product-limits/remove-firm-product-limit-1\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Firm Product Limits\",\"description\":\"Gets product limits for a specific firm and optional product combination.\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json get /rest/v2/firm-product-limit/{firm_uuid}\",\"href\":\"/api-reference/derivatives-api/rest-api/firm-product-limits/get-firm-product-limits-1\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Firms\",\"pages\":[{\"title\":\"Get All Firms\",\"description\":\"Retrieves a list of all firms you have access to.\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json get /rest/firms\",\"href\":\"/api-reference/derivatives-api/rest-api/firms/get-all-firms\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Firm\",\"description\":\"Retrieves information for a firm with the specified UUID.\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json get /rest/firms/{uuid}\",\"href\":\"/api-reference/derivatives-api/rest-api/firms/get-firm\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Funding Rate\",\"pages\":[{\"title\":\"Get historical funding rates\",\"description\":\"Retrieves the historical funding rate data for a specific instrument.\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json get /rest/funding-rate\",\"href\":\"/api-reference/derivatives-api/rest-api/funding-rate/get-historical-funding-rates\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Instruments\",\"pages\":[{\"title\":\"Get Instrument Details\",\"description\":\"Retrieves detailed information about instruments based on the provided filter criteria. Allows optional filtering by product codes, symbols, instrument IDs, trading states, activation date, and expiration date.\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json post /rest/instruments\",\"href\":\"/api-reference/derivatives-api/rest-api/instruments/get-instrument-details\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Valid Series\",\"description\":\"Retrieves valid series information for instruments based on the provided filter criteria. Returns series data including product code, expiry, contract size, trading dates, and settlement information. Allows optional filtering by product codes, symbols, instrument IDs, trading states, activation date, and expiration date.\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json post /rest/valid-series\",\"href\":\"/api-reference/derivatives-api/rest-api/instruments/get-valid-series\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Risk\",\"pages\":[{\"title\":\"Kill Switch\",\"description\":\"Activates a kill switch to cancel orders and lock trading for specified users, firms, or FCMs. Must only include one uuid (fcm, firm, or trading user). When activated, all open orders will be cancelled and new orders will be rejected.\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json post /rest/kill-switch\",\"href\":\"/api-reference/derivatives-api/rest-api/risk/kill-switch\",\"autogeneratedByOpenApi\":true},{\"title\":\"Unlock Trading\",\"description\":\"Deactivates kill switch to cancel orders and unlocks trading for specified users, firms, or FCMs. Must only include one uuid (fcm, firm, or trading user).\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json post /rest/unlock-trading\",\"href\":\"/api-reference/derivatives-api/rest-api/risk/unlock-trading\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Positions\",\"pages\":[{\"title\":\"Get All Firm Positions\",\"description\":\"Retrieves firm-level positions for all firms you have access to\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json get /rest/positions\",\"href\":\"/api-reference/derivatives-api/rest-api/positions/get-all-firm-positions\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Firm Position\",\"description\":\"Retrieves positions for the specified firm\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json get /rest/positions/{firm_uuid}\",\"href\":\"/api-reference/derivatives-api/rest-api/positions/get-firm-position\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get All Firm Positions\",\"description\":\"Retrieves firm-level positions for all firms you have access to\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json get /rest/v2/positions\",\"href\":\"/api-reference/derivatives-api/rest-api/positions/get-all-firm-positions-1\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Firm Position\",\"description\":\"Retrieves positions for the specified firm\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json get /rest/v2/positions/{firm_uuid}\",\"href\":\"/api-reference/derivatives-api/rest-api/positions/get-firm-position-1\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Users\",\"pages\":[{\"title\":\"Get All Users\",\"description\":\"Retrieves a list of all users you have access to, or all users in the specified firm.\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json get /rest/users\",\"href\":\"/api-reference/derivatives-api/rest-api/users/get-all-users\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get User\",\"description\":\"Retrieves information for a user with the specified UUID.\",\"deprecated\":false,\"version\":null,\"openapi\":\"/api-reference/derivatives-api/rest-api/cde-spec.json get /rest/users/{uuid}\",\"href\":\"/api-reference/derivatives-api/rest-api/users/get-user\",\"autogeneratedByOpenApi\":true}]}]},{\"group\":\"FIX\",\"pages\":[{\"title\":\"Derivatives FIX Overview\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/derivatives/fix/overview\"},{\"title\":\"Derivatives FIX Header/Trailer Messages\",\"sidebarTitle\":\"Header/Trailer\",\"description\":null,\"href\":\"/derivatives/fix/header-trailer\"},{\"title\":\"Derivatives FIX Session Messages\",\"sidebarTitle\":\"Session\",\"description\":null,\"href\":\"/derivatives/fix/session\"},{\"title\":\"Derivatives FIX Market Data Messages\",\"sidebarTitle\":\"Market Data\",\"description\":null,\"href\":\"/derivatives/fix/market-data\"},{\"title\":\"Derivatives FIX Order Entry Messages\",\"sidebarTitle\":\"Order Entry\",\"description\":null,\"href\":\"/derivatives/fix/order-entry\"},{\"title\":\"Derivatives FIX Drop Copy Messages\",\"sidebarTitle\":\"Drop Copy\",\"description\":null,\"href\":\"/derivatives/fix/drop-copy\"},{\"title\":\"Derivatives FIX Security Definitions\",\"sidebarTitle\":\"Security Definitions\",\"description\":null,\"href\":\"/derivatives/fix/security-definitions\"},{\"title\":\"Derivatives FIX Code Sets\",\"sidebarTitle\":\"Code Sets\",\"description\":null,\"href\":\"/derivatives/fix/code-sets\"}]},{\"group\":\"SBE\",\"pages\":[{\"title\":\"Derivatives SBE Overview\",\"sidebarTitle\":\"Overview\",\"description\":null,\"href\":\"/derivatives/sbe/overview\"},{\"title\":\"Derivatives SBE Header Message\",\"sidebarTitle\":\"Header\",\"description\":null,\"href\":\"/derivatives/sbe/header\"},{\"title\":\"Derivatives SBE Session Messages\",\"sidebarTitle\":\"Session\",\"description\":null,\"href\":\"/derivatives/sbe/session\"},{\"title\":\"Derivatives SBE Order Entry Messages\",\"sidebarTitle\":\"Order Entry\",\"description\":null,\"href\":\"/derivatives/sbe/order-entry\"}]},{\"group\":\"UDP\",\"pages\":[{\"title\":\"Derivatives UDP Overview\",\"siderbarTitle\":\"Overview\",\"description\":null,\"href\":\"/derivatives/udp/overview\"},{\"ttitle\":\"Derivatives UDP Message Structure\",\"sidebarTitle\":\"Message Structure\",\"title\":null,\"description\":null,\"href\":\"/derivatives/udp/message-structure\"},{\"title\":\"Derivatives UDP Realtime Incremental Updates\",\"sidebarTitle\":\"Incrementals\",\"description\":null,\"href\":\"/derivatives/udp/incrementals\"},{\"title\":\"Derivatives UDP Periodic Snapshots\",\"sidebarTitle\":\"Snapshots\",\"description\":null,\"href\":\"/derivatives/udp/snapshots\"},{\"title\":\"Derivatives UDP Retransmits\",\"sidebarTitle\":\"Retransmits\",\"description\":null,\"href\":\"/derivatives/udp/retransmits\"}]}]},{\"dropdown\":\"CDP API V1\",\"icon\":\"https://mintlify-assets.b-cdn.net/layerNetworks-3.svg\",\"groups\":[{\"group\":\"CDP API V1\",\"pages\":[{\"title\":\"Welcome to CDP APIs\",\"sidebarTitle\":\"Overview\",\"description\":\"The Coinbase Developer Platform (CDP) APIs allow you to safely and securely connect to CDP suite of backend services to easily build onchain apps.\",\"href\":\"/api-reference/introduction\"},{\"title\":\"API Authentication\",\"sidebarTitle\":\"Authentication\",\"description\":null,\"href\":\"/api-reference/authentication\"},{\"title\":\"Networks\",\"description\":null,\"href\":\"/api-reference/networks\"}]},{\"group\":\"REST API\",\"pages\":[{\"group\":\"Staking\",\"pages\":[{\"title\":\"Build a new staking operation\",\"openapi\":\"POST /v1/stake/build\",\"description\":\"Builds a new staking operation containing a dynamic list of staking transactions based on the specified network, asset, address, and [custom options](/staking/staking-api/reference/api-usage#staking-options).\\n\\nIt returns a StakingOperation resource, a unified interface for the entire staking process. Regardless of network complexity, the API abstracts away all the underlying details through it.\\nYou can iterate through this resource to access each staking transaction and have them be signed and broadcasted to land the staking transaction onchain.\\n\\nRead up more about the stake operation and how to interact with it [here](/staking/staking-api/introduction/the-staking-operation).\\n\",\"href\":\"/api-reference/rest-api/staking/build-a-new-staking-operation\"},{\"title\":\"Fetch historical staking balances\",\"openapi\":\"GET /v1/networks/{network_id}/addresses/{address_id}/stake/balances\",\"description\":\"Fetch historical staking balances for given address. This API is available for mainnet only.\",\"href\":\"/api-reference/rest-api/staking/fetch-historical-staking-balances\"},{\"title\":\"Fetch staking rewards\",\"openapi\":\"POST /v1/stake/rewards/search\",\"description\":\"Fetch staking rewards for a list of addresses. This API is available for mainnet only.\",\"href\":\"/api-reference/rest-api/staking/fetch-staking-rewards\"},{\"title\":\"Get latest staking operation\",\"openapi\":\"GET /v1/networks/{network_id}/addresses/{address_id}/staking_operations/{staking_operation_id}\",\"description\":\"Fetches the latest staking operation for the specified network and address given the staking operation ID.\\n\\nThis API can be used to poll the status of a staking operation and check if it has been successfully completed or not.\\n\\nA completed staking operation will have a status of `completed` which is indicative of the fact that all staking transactions have been successfully created and no more staking transactions will be generated.\\n\",\"href\":\"/api-reference/rest-api/staking/get-latest-staking-operation\"},{\"title\":\"Get staking context\",\"openapi\":\"POST /v1/stake/context\",\"description\":\"Fetches the staking context for an address given the network, asset, address and [custom options](/staking/staking-api/reference/api-usage#staking-options).\\n\\nThis API offers a point-in-time snapshot of key staking details, such as current stakeable, unstakeable, and claimable balances, which reflect the address’s staking position at the time of the request.\\n\\nThis information can be used to gate staking actions on your platform or to provide users with precise details on their staking positions. For example, knowing the current unstakeable balance allows you to inform users of the maximum amount they can unstake at that moment.\\n\",\"href\":\"/api-reference/rest-api/staking/get-staking-context\"},{\"title\":\"Get validator by ID\",\"openapi\":\"GET /v1/networks/{network_id}/assets/{asset_id}/validators/{validator_id}\",\"description\":\"Get a validator by its ID for a given network and asset.\",\"href\":\"/api-reference/rest-api/staking/get-validator-by-id\"},{\"title\":\"List validators\",\"openapi\":\"GET /v1/networks/{network_id}/assets/{asset_id}/validators\",\"description\":\"List validators belonging to the user for a given network and asset.\",\"href\":\"/api-reference/rest-api/staking/list-validators\"}]},{\"group\":\"Onramp/Offramp\",\"pages\":[{\"title\":\"Create buy quote\",\"openapi\":\"POST /v1/buy/quote\",\"description\":\"The Buy Quote API provides clients with a quote based on the asset the user would like to purchase, the network they want to receive it on, the fiat amount of the payment, the payment currency, the payment method, and country of the user.\",\"href\":\"/api-reference/rest-api/onramp-offramp/create-buy-quote\"},{\"title\":\"Create sell quote\",\"openapi\":\"POST /v1/sell/quote\",\"description\":\"The Sell Quote API provides clients with a quote based on the asset the user would like to sell, the network they plan to send it on, the crypto amount of the sale, the sale currency, the fiat deposit method, and country of the user.\",\"href\":\"/api-reference/rest-api/onramp-offramp/create-sell-quote\"},{\"title\":\"Create session token\",\"openapi\":\"POST /v1/token\",\"description\":\"Creates a single use token that can be used to initialize an Onramp or Offramp session.\\n This API should be called once for every new user session. The returned token will expire after 5 minutes.\",\"href\":\"/api-reference/rest-api/onramp-offramp/create-session-token\"},{\"title\":\"Get all offramp transactions\",\"openapi\":\"GET /v1/sell/transactions\",\"description\":\"Returns all offramp transactions created by your app in the provided time period.\",\"href\":\"/api-reference/rest-api/onramp-offramp/get-all-offramp-transactions\"},{\"title\":\"Get all onramp transactions\",\"openapi\":\"GET /v1/buy/transactions\",\"description\":\"Returns all onramp transactions created by your app in the provided time period.\",\"href\":\"/api-reference/rest-api/onramp-offramp/get-all-onramp-transactions\"},{\"title\":\"Get buy config\",\"openapi\":\"GET /v1/buy/config\",\"description\":\"The Buy Config API returns the list of countries supported by Coinbase Pay Onramp, and the payment methods available in each country. Clients should call this API periodically and cache the response.\",\"href\":\"/api-reference/rest-api/onramp-offramp/get-buy-config\"},{\"title\":\"Get buy options\",\"openapi\":\"GET /v1/buy/options\",\"description\":\"The Buy Options API provides clients with a way to discover the available options for buying Crypto with Coinbase Onramp. It returns the supported fiat currencies and available crypto assets that can be passed into the Buy Quote API. Clients should call this API periodically for each country they support and cache the response.\",\"href\":\"/api-reference/rest-api/onramp-offramp/get-buy-options\"},{\"title\":\"Get offramp transactions by ID\",\"openapi\":\"GET /v1/sell/user/{partnerUserRef}/transactions\",\"description\":\"When you initialize the Offramp Widget you can pass a `partnerUserRef` parameter to associate the transaction created during that session with the ID. You can then use that ID in this API to retrieve that transaction and any others that share the ID. The value of the `partnerUserRef` param can be any string you want e.g. the ID of the user in your app, a unique transaction ID, or a combination of values. Anything that is meaningful to your app.\",\"href\":\"/api-reference/rest-api/onramp-offramp/get-offramp-transactions-by-id\"},{\"title\":\"Get onramp transactions by ID\",\"openapi\":\"GET /v1/buy/user/{partnerUserRef}/transactions\",\"description\":\"When you initialize the Onramp Widget you can pass a `partnerUserRef` parameter to associate the transaction created during that session with the ID. You can then use that ID in this API to retrieve that transaction and any others that share the ID. The value of the `partnerUserRef` param can be any string you want e.g. the ID of the user in your app, a unique transaction ID, or a combination of values. Anything that is meaningful to your app.\",\"href\":\"/api-reference/rest-api/onramp-offramp/get-onramp-transactions-by-id\"},{\"title\":\"Get sell config\",\"openapi\":\"GET /v1/sell/config\",\"description\":\"The Sell Config API returns the list of countries supported by Coinbase Pay Offramp, and the fiat deposit methods available in each country. Clients should call this API periodically and cache the response.\",\"href\":\"/api-reference/rest-api/onramp-offramp/get-sell-config\"},{\"title\":\"Get sell options\",\"openapi\":\"GET /v1/sell/options\",\"description\":\"The Sell Options API provides clients with a way to discover the available options for selling Crypto with Coinbase Offramp. It returns the supported fiat deposit currencies and available crypto assets that can be passed into the Sell Quote API. Clients should call this API periodically for each country they support and cache the response.\",\"href\":\"/api-reference/rest-api/onramp-offramp/get-sell-options\"}]}]},{\"group\":\"JSON-RPC API\",\"pages\":[{\"title\":\"Core JSON-RPC Methods\",\"sidebarTitle\":\"Core\",\"description\":\"The following EVM-compatible JSON-RPC methods provide convenient access to onchain data on Base.\",\"href\":\"/api-reference/json-rpc-api/core\"},{\"title\":\"Paymaster JSON-RPC Methods\",\"sidebarTitle\":\"Paymaster\",\"description\":null,\"href\":\"/api-reference/json-rpc-api/paymaster\"},{\"title\":\"Address History JSON-RPC Methods\",\"sidebarTitle\":\"Address History\",\"description\":\"The following JSON-RPC APIs provide convenient access to historical data for your onchain addresses.\",\"href\":\"/api-reference/json-rpc-api/address-history\"}]}]}]},{\"tab\":\"SDKs\",\"pages\":[{\"title\":\"SDKs\",\"href\":\"/sdks\"}]},{\"tab\":\"Recipes\",\"pages\":[{\"title\":\"Recipes\",\"href\":\"/recipes/settle-customer-stablecoins-as-usd\"}]},{\"tab\":\"Changelogs\",\"pages\":[{\"title\":\"Changelogs\",\"href\":\"/get-started/changelog\"}]}]},\"maps\":{\"firstHrefInVersion\":{},\"firstHrefInLanguage\":{}},\"children\":\"$L5d\"}]\n"])</script><script>self.__next_f.push([1,"5e:I[601054,[\"/mintlify-assets/_next/static/chunks/0ea0e179f06dc225.js?dpl=dpl_CVf3WfFBtkHHBU6F9v7HCtdt1o45\",\"/mintlify-assets/_next/static/chunks/1e7a188add93a653.js?dpl=dpl_CVf3WfFBtkHHBU6F9v7HCtdt1o45\",\"/mintlify-assets/_next/static/chunks/343f3c7f568a2e5d.js?dpl=dpl_CVf3WfFBtkHHBU6F9v7HCtdt1o45\",\"/mintlify-assets/_next/static/chunks/2f91bdeb60f2c888.js?dpl=dpl_CVf3WfFBtkHHBU6F9v7HCtdt1o45\",\"/mintlify-assets/_next/static/chunks/ccee8d9b3189ccd9.js?dpl=dpl_CVf3WfFBtkHHBU6F9v7HCtdt1o45\",\"/mintlify-assets/_next/static/chunks/5d8daede99904aca.js?dpl=dpl_CVf3WfFBtkHHBU6F9v7HCtdt1o45\",\"/mintlify-assets/_next/static/chunks/d6a774160f99cc71.js?dpl=dpl_CVf3WfFBtkHHBU6F9v7HCtdt1o45\",\"/mintlify-assets/_next/static/chunks/75e727c985b9e4db.js?dpl=dpl_CVf3WfFBtkHHBU6F9v7HCtdt1o45\",\"/mintlify-assets/_next/static/chunks/8d0901e40ed4b058.js?dpl=dpl_CVf3WfFBtkHHBU6F9v7HCtdt1o45\",\"/mintlify-assets/_next/static/chunks/2d1c4482dd93de98.js?dpl=dpl_CVf3WfFBtkHHBU6F9v7HCtdt1o45\",\"/mintlify-assets/_next/static/chunks/3f8f2653ff1ad14e.js?dpl=dpl_CVf3WfFBtkHHBU6F9v7HCtdt1o45\",\"/mintlify-assets/_next/static/chunks/a344c3701d853a98.js?dpl=dpl_CVf3WfFBtkHHBU6F9v7HCtdt1o45\",\"/mintlify-assets/_next/static/chunks/57fafae36dfe4636.js?dpl=dpl_CVf3WfFBtkHHBU6F9v7HCtdt1o45\",\"/mintlify-assets/_next/static/chunks/12c0103b562ad56d.js?dpl=dpl_CVf3WfFBtkHHBU6F9v7HCtdt1o45\",\"/mintlify-assets/_next/static/chunks/8a19ec8c194a3b47.js?dpl=dpl_CVf3WfFBtkHHBU6F9v7HCtdt1o45\",\"/mintlify-assets/_next/static/chunks/3788d0413d447c7b.js?dpl=dpl_CVf3WfFBtkHHBU6F9v7HCtdt1o45\",\"/mintlify-assets/_next/static/chunks/8580190afe0e7452.js?dpl=dpl_CVf3WfFBtkHHBU6F9v7HCtdt1o45\",\"/mintlify-assets/_next/static/chunks/d9038181f2c2898b.js?dpl=dpl_CVf3WfFBtkHHBU6F9v7HCtdt1o45\",\"/mintlify-assets/_next/static/chu