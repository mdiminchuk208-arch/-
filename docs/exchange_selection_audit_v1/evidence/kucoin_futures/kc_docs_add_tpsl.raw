2\":112,\"_161\":146,\"_307\":146},349055,\"apiDetailFolder.349055\",{\"_283\":284,\"_285\":286},[4468],{\"_152\":276,\"_277\":144,\"_158\":4469,\"_18\":2714,\"_192\":4470,\"_281\":4471,\"_180\":4472,\"_220\":4464,\"_221\":-7,\"_19\":-7,\"_306\":276,\"_11\":-7,\"_162\":112,\"_161\":146,\"_307\":146},349056,\"apiDetailFolder.349056\",{\"_283\":284,\"_285\":286},[4473],{\"_152\":328,\"_158\":4474,\"_18\":2738,\"_192\":4475,\"_332\":333,\"_334\":4476,\"_336\":337,\"_220\":4469,\"_221\":-7,\"_222\":4477,\"_19\":-7,\"_339\":133,\"_11\":-7,\"_162\":4478,\"_161\":146},3470280,\"apiDetail.3470280\",\"/api/v1/broker/api/rebase/download\",[224,225],\"/docs-new/3470280e0\",{\"_152\":276,\"_277\":144,\"_158\":4480,\"_18\":4481,\"_192\":4482,\"_281\":4483,\"_180\":4484,\"_220\":144,\"_221\":-7,\"_19\":-7,\"_306\":276,\"_11\":-7,\"_162\":112,\"_161\":146,\"_307\":146},348188,\"Developing\",\"apiDetailFolder.348188\",{\"_283\":284,\"_285\":286},[4485],{\"_152\":216,\"_158\":4486,\"_18\":218,\"_192\":4487,\"_220\":4480,\"_221\":-7,\"_222\":4488,\"_11\":-7,\"_162\":4489,\"_161\":146},338210,\"doc.338210\",[224,231,232,233,251],\"/docs-new/338210m0\",\"selectedSidebarTreeNode\",{\"_152\":328,\"_158\":2284,\"_18\":2285,\"_192\":2286,\"_332\":546,\"_334\":2287,\"_336\":337,\"_220\":2261,\"_221\":-7,\"_222\":2288,\"_19\":-7,\"_339\":133,\"_11\":-7,\"_162\":2289,\"_161\":49},\"parentSidebarTreeApiFolderNodes\",[4494,4496,4498],{\"_152\":276,\"_277\":144,\"_158\":1137,\"_18\":1138,\"_192\":1139,\"_281\":1140,\"_180\":4495,\"_220\":144,\"_221\":-7,\"_19\":-7,\"_306\":276,\"_11\":-7,\"_162\":112,\"_161\":146,\"_307\":49},[],{\"_152\":276,\"_277\":144,\"_158\":2154,\"_18\":2155,\"_192\":2156,\"_281\":2157,\"_180\":4497,\"_220\":1137,\"_221\":-7,\"_19\":-7,\"_306\":276,\"_11\":-7,\"_162\":112,\"_161\":146,\"_307\":49},[],{\"_152\":276,\"_277\":144,\"_158\":2261,\"_18\":777,\"_192\":2262,\"_281\":2263,\"_180\":4499,\"_220\":2154,\"_221\":-7,\"_19\":-7,\"_306\":276,\"_11\":-7,\"_162\":112,\"_161\":146,\"_307\":49},[],\"previousSidebarTreeNode\",{\"_152\":328,\"_158\":2278,\"_18\":1593,\"_192\":2279,\"_332\":546,\"_334\":2280,\"_336\":337,\"_220\":2261,\"_221\":-7,\"_222\":2281,\"_19\":-7,\"_339\":133,\"_11\":-7,\"_162\":2282,\"_161\":146},\"nextSidebarTreeNode\",{\"_152\":328,\"_158\":2291,\"_18\":1607,\"_192\":2292,\"_332\":699,\"_334\":2293,\"_336\":337,\"_220\":2261,\"_221\":-7,\"_222\":2294,\"_19\":-7,\"_339\":133,\"_11\":-7,\"_162\":2295,\"_161\":146},\"docsBaseConfig\",{\"_29\":4506,\"_4507\":4506,\"_19\":112,\"_4508\":4509,\"_4512\":13,\"_4513\":4514,\"_4525\":33,\"_4526\":4527,\"_4528\":49,\"_4529\":49,\"_4530\":146,\"_4531\":146,\"_4532\":146,\"_4533\":49,\"_4534\":4535,\"_4544\":49,\"_4545\":49,\"_4546\":49,\"_4547\":146,\"_4548\":146,\"_4549\":49,\"_4550\":49,\"_4551\":146,\"_4552\":4553,\"_4555\":4556,\"_4558\":4559,\"_4560\":4561,\"_4565\":4566,\"_4568\":146,\"_4569\":49,\"_4570\":49,\"_4571\":4572,\"_4573\":4574,\"_4577\":49,\"_4578\":146,\"_4579\":146,\"_4580\":146,\"_4581\":146,\"_4582\":-7},\"KUCOIN API\",\"siteName\",\"logoSettings\",{\"_4510\":13,\"_4511\":13},\"light\",\"dark\",\"favicon\",\"themePrimarySettings\",{\"_4510\":4515,\"_4511\":4523},{\"_4516\":4517,\"_4518\":4519,\"_4520\":4521,\"_4522\":4517},\"primaryColor\",\"purple\",\"textColor\",\"WHITE\",\"backgroundColor\",\"#ffffff\",\"accentColor\",{\"_4516\":4517,\"_4518\":4519,\"_4520\":4524,\"_4522\":4517},\"#1a1922\",\"language\",\"theme\",\"system\",\"displayThemeToggle\",\"isShowPrefixUrl\",\"isShowMaintainer\",\"isShowTags\",\"isShowUpdatedAt\",\"isShowLastModifiedAt\",\"displayFieldIds\",[4536,4537,4538,4539,4540,4541,4542,4543],\"api.label.sampleCode\",\"11\",\"12\",\"13\",\"18\",\"14\",\"15\",\"16\",\"hidePoweredBy\",\"hideBuiltWith\",\"hideRunInAppButton\",\"hideTryItOutButton\",\"exportable\",\"hideCloneButton\",\"hideMyAppButton\",\"hideAppFormatExportOption\",\"googleAnalytics\",{\"_4554\":112},\"measurementId\",\"visibilitySettings\",{\"_152\":4557},\"PUBLIC\",\"apiDocLayout\",\"OneColumn\",\"mockRule\",{\"_4562\":4563,\"_4564\":49},\"rules\",[],\"enableSystemRule\",\"corsProxySettings\",{\"_158\":4567},1,\"enableVibeCodingViaMCP\",\"enableCopyPage\",\"enableLLMs\",\"globalMetadata\",\"[\\n  {\\\"name\\\": \\\"description\\\", \\\"content\\\": \\\"{{DESCRIPTION}}\\\"},\\n  {\\\"name\\\": \\\"keywords\\\", \\\"content\\\": \\\"{{KEYWORDS}}\\\"},\\n  {\\\"name\\\": \\\"viewpoint\\\", \\\"content\\\": \\\"width=device-width, initial-scale=1.0, viewport-fit=cover\\\"}\\n]\",\"robotsFile\",{\"_4575\":49,\"_20\":4576},\"enable\",\"User-Agent: *\\nAllow: /\\n\\nSitemap: {{SITEMAP_URL}}\",\"enableSitemapFile\",\"persistEnvVariables\",\"showDataSchemas\",\"showDataSchemasExample\",\"showDataSchemasAutoGenerateExample\",\"landingPageType\",\"versionList\",[4585],{\"_158\":4586,\"_18\":4587,\"_161\":49,\"_162\":212,\"_164\":146},\"308240\",\"latest\",\"resourceData\",{\"_152\":328,\"_4590\":4591,\"_4998\":4999},\"data\",{\"_158\":2284,\"_18\":2285,\"_4592\":112,\"_4593\":4594,\"_4595\":4596,\"_4597\":4598,\"_4599\":4600,\"_19\":4601,\"_4602\":112,\"_4603\":112,\"_332\":546,\"_334\":2287,\"_222\":4604,\"_336\":337,\"_4605\":4606,\"_4607\":4608,\"_4609\":4610,\"_4611\":4612,\"_4613\":2261,\"_4614\":4615,\"_4616\":144,\"_4617\":4618,\"_4619\":4620,\"_4623\":4624,\"_4633\":112,\"_4634\":4635,\"_4636\":4637,\"_4638\":4639,\"_4640\":4641,\"_4642\":4643,\"_4644\":4645,\"_4646\":4647,\"_4648\":112,\"_152\":133,\"_4649\":4650,\"_4658\":4659,\"_4665\":4666,\"_4837\":4838,\"_4839\":4840,\"_4961\":4962,\"_4995\":4996},\"serverId\",\"preProcessors\",[],\"postProcessors\",[],\"inheritPreProcessors\",{},\"inheritPostProcessors\",{},\":::info[Description]\\nPlace take profit and stop loss order supports both take-profit and stop-loss functions, and other functions are exactly the same as the place order interface.\\n\\nYou can place two types of orders: limit and market. Orders can only be placed if your account has sufficient funds. Once an order is placed, your funds will be put on hold for the duration of the order. The amount of funds on hold depends on the order type and parameters specified.\\n\\nPlease be noted that the system would hold the fees from the orders entered the orderbook in advance. \\n:::\",\"operationId\",\"sourceUrl\",[],\"auth\",{},\"responseExamples\",[],\"projectId\",345089,\"moduleId\",300305,\"folderId\",\"ordering\",87,\"responsibleId\",\"commonResponseStatus\",{},\"advancedSettings\",{\"_4621\":4622},\"disabledSystemHeaders\",{},\"customApiFields\",{\"_4625\":4626,\"_4627\":3507,\"_4537\":4628,\"_4538\":3507,\"_4539\":3507,\"_4541\":3507,\"_4542\":1075,\"_4543\":4629,\"_4630\":4631,\"_4540\":4632},\"9\",\"normal\",\"10\",\"Private\",\"addTPSLOrder\",\"17\",\"Place take profit and stop loss order supports both take-profit and stop-loss functions, and other functions are exactly the same as the place order interface.\",2,\"oasExtensions\",\"mockScript\",{},\"createdAt\",\"2025-02-22T03:15:55.000Z\",\"updatedAt\",\"2026-08-03T07:49:01.000Z\",\"creatorId\",345036,\"editorId\",345057,\"visibility\",\"INHERITED\",\"securityScheme\",{},\"callbacks\",\"parameters\",{\"_4651\":4652,\"_334\":4653,\"_4654\":4655,\"_4656\":4657},\"query\",[],[],\"cookie\",[],\"header\",[],\"commonParameters\",{\"_4651\":4660,\"_4661\":4662,\"_4656\":4663,\"_4654\":4664},[],\"body\",[],[],[],\"requestBody\",{\"_152\":4667,\"_4649\":4668,\"_4669\":4670,\"_4831\":112,\"_4678\":4832,\"_4633\":112,\"_4590\":4834},\"application/json\",[],\"jsonSchema\",{\"_152\":4671,\"_4672\":4673,\"_4827\":4828,\"_4829\":4830},\"object\",\"properties\",{\"_4674\":4675,\"_4683\":4684,\"_4696\":4697,\"_4701\":4702,\"_152\":4707,\"_4719\":4720,\"_4722\":4723,\"_4739\":4740,\"_4743\":4744,\"_4746\":4747,\"_4749\":4750,\"_4763\":4764,\"_4774\":4775,\"_4779\":4780,\"_4782\":4783,\"_4795\":4796,\"_4798\":4799,\"_4801\":4802,\"_4804\":4805,\"_4807\":4808,\"_4810\":4811},\"clientOid\",{\"_152\":4676,\"_19\":4677,\"_4678\":4679,\"_4681\":4682},\"string\",\"Unique order id created by users to identify their orders, the maximum length cannot exceed 40, e.g. UUID, Only allows numbers, characters, underline(_), and separator(-)\",\"examples\",[4680],\"5c52e11203aa677f33e493fb\",\"x-apidog-mock\",\"ab\",\"side\",{\"_152\":4676,\"_19\":4685,\"_4686\":4687,\"_4690\":4691,\"_4678\":4695},\"specify if the order is to 'buy' or 'sell'\",\"enum\",[4688,4689],\"buy\",\"sell\",\"x-apidog-enum\",[4692,4694],{\"_4693\":4688,\"_18\":4688,\"_19\":4688},\"value\",{\"_4693\":4689,\"_18\":4689,\"_19\":4689},[4688],\"symbol\",{\"_152\":4676,\"_19\":4698,\"_4678\":4699},\"Symbol of the contract, Please refer to [Get Symbol endpoint: symbol](/docs-new/rest/futures-trading/market-data/get-all-symbols) \",[4700],\"XBTUSDTM\",\"leverage\",{\"_152\":4703,\"_19\":4704,\"_4678\":4705},\"integer\",\"Optional for type is 'isolated margin' order, Set the order leverage. If you are to close the position, or add 'cross margin' order, this parameter is not required.\",[4706],3,{\"_152\":4676,\"_19\":4708,\"_4686\":4709,\"_4690\":4712,\"_4678\":4717,\"_4718\":4710},\"specify if the order is an 'limit' order or 'market' order\",[4710,4711],\"limit\",\"market\",[4713,4715],{\"_4693\":4710,\"_18\":4710,\"_19\":4714},\"limit order\",{\"_4693\":4711,\"_18\":4711,\"_19\":4716},\"market order\",[4710],\"default\",\"remark\",{\"_152\":4676,\"_19\":4721},\"remark for the order, length cannot exceed 100 utf8 characters\",\"stopPriceType\",{\"_152\":4676,\"_19\":4724,\"_4686\":4725,\"_4690\":4729},\"Either 'TP', 'IP' or 'MP'\",[4726,4727,4728],\"TP\",\"MP\",\"IP\",[4730,4733,4736],{\"_4693\":4726,\"_18\":4731,\"_19\":4732},\"trade price\",\"TP for trade price, The last trade price is the last price at which an order was filled. This price can be found in the latest match message.\",{\"_4693\":4727,\"_18\":4734,\"_19\":4735},\"mark price\",\"MP for mark price, The mark price can be obtained through relevant OPEN API for index services\",{\"_4693\":4728,\"_18\":4737,\"_19\":4738},\"index price\",\"IP for index price, The index price can be obtained through relevant OPEN API for index services\",\"reduceOnly\",{\"_152\":4741,\"_19\":4742,\"_4718\":146},\"boolean\",\"This parameter ensures that the current order **only reduces the existing position** without increasing it.\\n\\n- When `reduceOnly` is enabled, the system will only attempt to reduce the current position. You must set the quantity manually; the system does not guarantee a full close in one order.\\n- If the order would result in an increased position, it will be rejected.\\n- If the order is a valid reduce order but the quantity **exceeds the current position size**, it will be canceled.\\n- The total quantity of all active reduce (close) orders must be **less than or equal to the current position size**. If exceeded, reduce orders with worse prices will be canceled or partially canceled.\\n- When this parameter is set, the system **does not check the available balance**.\",\"closeOrder\",{\"_152\":4741,\"_19\":4745,\"_4718\":146},\"This parameter is used to **completely close the current position**.\\n\\n- When `closeOrder` is enabled, the system automatically determines the direction and quantity based on your current position (`side`, `size`, and `leverage` fields should be left blank).\\n- The system will execute a full close order based on the current position size.\\n- If both `reduceOnly` and `closeOrder` are set, **`closeOrder`** takes precedence.\\n- When this parameter is enabled, the system **does not verify the available balance**.\",\"forceHold\",{\"_152\":4741,\"_19\":4748,\"_4718\":146},\"A mark to forcely hold the funds for an order, even though it's an order to reduce the position size. This helps the order stay on the order book and not get canceled when the position size changes. Set to false by default. The system will forcely freeze certain amount of funds for this order, including orders whose direction is opposite to the current positions. This feature is to ensure that the order won’t be canceled by the matching engine in such a circumstance that not enough funds are frozen for the order.\",\"stp\",{\"_152\":4676,\"_19\":4751,\"_4686\":4752,\"_4690\":4756},\"[Self Trade Prevention](/docs-new/enums-definitions) is divided into these strategies: CN, CO, CB. Not supported DC at the moment.\",[4753,4754,4755],\"CN\",\"CO\",\"CB\",[4757,4759,4761],{\"_4693\":4753,\"_18\":4753,\"_19\":4758},\"Cancel new, Cancel the new order\",{\"_4693\":4754,\"_18\":4754,\"_19\":4760},\"Cancel old, Cancel the old order\",{\"_4693\":4755,\"_18\":4755,\"_19\":4762},\"Cancel both, Cancel both sides\",\"marginMode\",{\"_152\":4676,\"_19\":4765,\"_4686\":4766,\"_4690\":4769,\"_4718\":4767},\"Margin mode: ISOLATED, CROSS, default: ISOLATED\",[4767,4768],\"ISOLATED\",\"CROSS\",[4770,4772],{\"_4693\":4768,\"_18\":4768,\"_19\":4771},\"Cross margin\",{\"_4693\":4767,\"_18\":4767,\"_19\":4773},\"Isolated margin\",\"price\",{\"_152\":4676,\"_19\":4776,\"_4678\":4777},\"Required for type is 'limit' order, indicating the operating price\",[4778],\"0.1\",\"size\",{\"_152\":4703,\"_19\":4781},\"Specified in **lots** and must be a positive integer.  \\nFor **coin-swap contracts**, only `size` (lot) is supported; other units are not supported.  \\n**Choose one of `size`, `qty`, or `valueQty`.**\",\"timeInForce\",{\"_152\":4676,\"_19\":4784,\"_4686\":4785,\"_4690\":4788,\"_4718\":4786},\"Optional for type is 'limit' order, [Time in force](/docs-new/enums-definitions) is a special strategy used during trading, default is GTC\",[4786,4787],\"GTC\",\"IOC\",[4789,4792],{\"_4693\":4786,\"_18\":4790,\"_19\":4791},\"Good Till Canceled\",\"order remains open on the order book until canceled. This is the default type if the field is left empty.\",{\"_4693\":4787,\"_18\":4793,\"_19\":4794},\"Immediate Or Cancel\",\"being matched or not, the remaining size of the order will be instantly canceled instead of entering the order book.\",\"postOnly\",{\"_152\":4741,\"_19\":4797,\"_4718\":146},\"Optional for type is 'limit' order,  post only flag, invalid when timeInForce is IOC. The post-only flag ensures that the trader always pays the maker fee and provides liquidity to the order book. If any part of the order is going to pay taker fee, the order will be fully rejected.\",\"triggerStopUpPrice\",{\"_152\":4676,\"_19\":4800},\"Take profit price\",\"triggerStopDownPrice\",{\"_152\":4676,\"_19\":4803},\"Stop loss price\",\"qty\",{\"_152\":4676,\"_19\":4806},\"Specified in **base currency** and must be an integer multiple of the multiplier.  \\nFor **coin-swap contracts**, `qty` is not supported; use `size` (lot) instead.  \\n**Choose one of `size`, `qty`, or `valueQty`.**\",\"valueQty\",{\"_152\":4676,\"_19\":4809},\"Specified in **quote currency**. For **USDS-Swap**, the quote currency is **USDT** or **USDC**.  \\nFor **coin-swap contracts**, `valueQty` is not supported; use `size` (lot) instead.  \\n**Choose one of `size`, `qty`, or `valueQty`.**\",\"positionSide\",{\"_152\":4676,\"_19\":4812,\"_4686\":4813,\"_4690\":4817},\"Position direction, optional in one-way mode, defaults to BOTH. Required in hedge mode.\",[4814,4815,4816],\"BOTH\",\"LONG\",\"SHORT\",[4818,4821,4824],{\"_4693\":4814,\"_18\":4819,\"_19\":4820},\"both\",\"BOTH for one-way mode.\",{\"_4693\":4815,\"_18\":4822,\"_19\":4823},\"long\",\"LONG for long position in hedge mode.\",{\"_4693\":4816,\"_18\":4825,\"_19\":4826},\"short\",\"SHORT for short position in hedge mode.\",\"x-apidog-orders\",[4674,4683,4696,4701,152,4719,4798,4722,4801,4739,4743,4746,4749,4763,4774,4779,4804,4807,4782,4795,4810],\"required\",[4674,4696,4683],\"mediaType\",[4833],{\"_4693\":4834,\"_4831\":4667,\"_19\":112,\"_192\":4835,\"_18\":4836},\"{\\n    \\\"clientOid\\\": \\\"5c52e11203aa677f33e493fb\\\",\\n    \\\"side\\\": \\\"buy\\\",\\n    \\\"symbol\\\": \\\"XBTUSDTM\\\",\\n    \\\"leverage\\\": 3,\\n    \\\"type\\\": \\\"limit\\\",\\n    \\\"remark\\\": \\\"order remarks\\\",\\n    \\\"reduceOnly\\\": false,\\n    \\\"marginMode\\\": \\\"ISOLATED\\\",\\n    \\\"positionSide\\\": \\\"BOTH\\\",\\n    \\\"price\\\": \\\"0.2\\\",\\n    \\\"size\\\": 1,\\n    \\\"timeInForce\\\": \\\"GTC\\\",\\n    \\\"triggerStopUpPrice\\\": \\\"0.3\\\",\\n    \\\"triggerStopDownPrice\\\": \\\"0.1\\\",\\n    \\\"stopPriceType\\\": \\\"TP\\\"\\n}\",\"0\",\"Example 1\",\"codeSamples\",[],\"codeSampleLanguages\",[4841,4859,4877,4884,4890,4895,4906,4914,4917,4924,4930,4936,4942,4948,4953],{\"_192\":4842,\"_4843\":4844,\"_4845\":4846,\"_4847\":4848},\"shell\",\"label\",\"Shell\",\"syntaxMode\",\"powershell\",\"variants\",[4849,4851,4853,4855,4857],{\"_192\":4850},\"cURL\",{\"_192\":4852},\"cURL-Windows\",{\"_192\":4854},\"Httpie\",{\"_192\":4856},\"wget\",{\"_192\":4858},\"PowerShell\",{\"_192\":4860,\"_4843\":4861,\"_4845\":4860,\"_4847\":4862},\"javascript\",\"JavaScript\",[4863,4865,4867,4869,4871,4873,4875],{\"_192\":4864},\"Fetch\",{\"_192\":4866},\"Axios\",{\"_192\":4868},\"jQuery\",{\"_192\":4870},\"XHR\",{\"_192\":4872},\"Native\",{\"_192\":4874},\"Request\",{\"_192\":4876},\"Unirest\",{\"_192\":4878,\"_4843\":4879,\"_4845\":4878,\"_4847\":4880},\"java\",\"Java\",[4881,4882],{\"_192\":4876},{\"_192\":4883},\"OkHttp\",{\"_192\":4885,\"_4843\":4886,\"_4845\":4885,\"_4847\":4887},\"swift\",\"Swift\",[4888],{\"_192\":4889},\"URLSession\",{\"_192\":4891,\"_4843\":4892,\"_4845\":4891,\"_4847\":4893},\"go\",\"Go\",[4894],{\"_192\":4872},{\"_192\":4896,\"_4843\":4897,\"_4845\":4896,\"_4847\":4898},\"php\",\"PHP\",[4899,4900,4902,4904],{\"_192\":4850},{\"_192\":4901},\"HTTP_Request2\",{\"_192\":4903},\"pecl_http\",{\"_192\":4905},\"Guzzle\",{\"_192\":4907,\"_4843\":4908,\"_4845\":4907,\"_4847\":4909},\"python\",\"Python\",[4910,4912],{\"_192\":4911},\"http.client\",{\"_192\":4913},\"Requests\",{\"_192\":133,\"_4843\":3489,\"_4845\":203,\"_4847\":4915},[4916],{\"_192\":3489},{\"_192\":4918,\"_4843\":4919,\"_4845\":4920,\"_4847\":4921},\"c\",\"C\",\"