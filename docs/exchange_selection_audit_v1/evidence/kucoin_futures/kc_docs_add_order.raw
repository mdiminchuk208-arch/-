"_192\":5038,\"_18\":5039,\"_4691\":4629,\"_5021\":146},\"16-sdk-method-name\",\"sdk-method-name\",{\"_152\":203,\"_192\":5041,\"_18\":5042,\"_4691\":5043,\"_5021\":146},\"18-api-rate-limit-weight\",\"api-rate-limit-weight\",\"2\",\"dataSchemaDefinitions\",{},\"requestCollection\",{\"_5048\":5049,\"_4656\":5064,\"_332\":5067,\"_4661\":5068,\"_4605\":5071},\"url\",{\"_5050\":5051,\"_334\":5052,\"_5056\":5057,\"_4651\":5061,\"_5062\":5063},\"protocol\",\"https\",[5053,5054,5055],\"api\",\"v1\",\"orders\",\"host\",[5058,5059,5060],\"api-futures\",\"kucoin\",\"com\",[],\"variable\",[],[5065],{\"_192\":5066,\"_4691\":4667},\"Content-Type\",\"POST\",{\"_5069\":5070,\"_5070\":4847},\"mode\",\"raw\",{\"_152\":5072,\"_5072\":5073},\"noauth\",[],\"defaultRequestSampleCode\",{\"_4980\":5076,\"_4525\":4856,\"_5077\":4864,\"_5078\":4860,\"_5079\":-7},\"curl --location --request POST 'https://api-futures.kucoin.com/api/v1/orders' \\\\\\n--header 'Content-Type: application/json' \\\\\\n--data-raw '{\\n    \\\"clientOid\\\": \\\"5c52e11203aa677f33e493fb\\\",\\n    \\\"symbol\\\": \\\"XBTUSDTM\\\",\\n    \\\"marginMode\\\": \\\"ISOLATED\\\",\\n    \\\"leverage\\\": 3,\\n    \\\"positionSide\\\": \\\"BOTH\\\",\\n    \\\"side\\\": \\\"buy\\\",\\n    \\\"type\\\": \\\"limit\\\",\\n    \\\"size\\\": 1,\\n    \\\"price\\\": \\\"100000\\\",\\n    \\\"timeInForce\\\": \\\"GTC\\\",\\n    \\\"reduceOnly\\\": false,\\n    \\\"remark\\\": \\\"order_remarks\\\"\\n}'\",\"variant\",\"codeBlockLanguage\",\"prompt\",\"262e8619-b3a3-4273-abec-c66aa7b18371\",\"securitySchemeMap\",{},\"inheritAuthInfo\",{\"_5085\":5086,\"_4605\":5089,\"_4646\":5090,\"_5094\":-7},\"definitionInheritFrom\",{\"_18\":5087,\"_158\":5088},\"Root\",348125,{\"_152\":5072},{\"_5091\":-7,\"_5092\":5093},\"use\",\"scopes\",{},\"valueInheritFrom\",\"apiFolderMap\",{\"_5097\":5098,\"_5142\":5143,\"_5162\":5163,\"_5178\":5179,\"_5195\":5196,\"_5211\":5212,\"_5228\":5229,\"_5243\":5244,\"_5258\":5259,\"_5272\":5273,\"_5289\":5290,\"