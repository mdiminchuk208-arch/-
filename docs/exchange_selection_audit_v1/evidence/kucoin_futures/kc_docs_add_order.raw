6,\"_18\":476,\"_192\":2257,\"_332\":333,\"_334\":1557,\"_336\":337,\"_220\":2165,\"_221\":-7,\"_222\":2258,\"_19\":-7,\"_339\":133,\"_11\":-7,\"_162\":2259,\"_161\":146},\"nextSidebarTreeNode\",{\"_152\":328,\"_158\":2272,\"_18\":1586,\"_192\":2273,\"_332\":546,\"_334\":2274,\"_336\":337,\"_220\":2261,\"_221\":-7,\"_222\":2275,\"_19\":-7,\"_339\":133,\"_11\":-7,\"_162\":2276,\"_161\":146},\"docsBaseConfig\",{\"_29\":4506,\"_4507\":4506,\"_19\":112,\"_4508\":4509,\"_4512\":13,\"_4513\":4514,\"_4525\":33,\"_4526\":4527,\"_4528\":49,\"_4529\":49,\"_4530\":146,\"_4531\":146,\"_4532\":146,\"_4533\":49,\"_4534\":4535,\"_4544\":49,\"_4545\":49,\"_4546\":49,\"_4547\":146,\"_4548\":146,\"_4549\":49,\"_4550\":49,\"_4551\":146,\"_4552\":4553,\"_4555\":4556,\"_4558\":4559,\"_4560\":4561,\"_4565\":4566,\"_4568\":146,\"_4569\":49,\"_4570\":49,\"_4571\":4572,\"_4573\":4574,\"_4577\":49,\"_4578\":146,\"_4579\":146,\"_4580\":146,\"_4581\":146,\"_4582\":-7},\"KUCOIN API\",\"siteName\",\"logoSettings\",{\"_4510\":13,\"_4511\":13},\"light\",\"dark\",\"favicon\",\"themePrimarySettings\",{\"_4510\":4515,\"_4511\":4523},{\"_4516\":4517,\"_4518\":4519,\"_4520\":4521,\"_4522\":4517},\"primaryColor\",\"purple\",\"textColor\",\"WHITE\",\"backgroundColor\",\"#ffffff\",\"accentColor\",{\"_4516\":4517,\"_4518\":4519,\"_4520\":4524,\"_4522\":4517},\"#1a1922\",\"language\",\"theme\",\"system\",\"displayThemeToggle\",\"isShowPrefixUrl\",\"isShowMaintainer\",\"isShowTags\",\"isShowUpdatedAt\",\"isShowLastModifiedAt\",\"displayFieldIds\",[4536,4537,4538,4539,4540,4541,4542,4543],\"api.label.sampleCode\",\"11\",\"12\",\"13\",\"18\",\"14\",\"15\",\"16\",\"hidePoweredBy\",\"hideBuiltWith\",\"hideRunInAppButton\",\"hideTryItOutButton\",\"exportable\",\"hideCloneButton\",\"hideMyAppButton\",\"hideAppFormatExportOption\",\"googleAnalytics\",{\"_4554\":112},\"measurementId\",\"visibilitySettings\",{\"_152\":4557},\"PUBLIC\",\"apiDocLayout\",\"OneColumn\",\"mockRule\",{\"_4562\":4563,\"_4564\":49},\"rules\",[],\"enableSystemRule\",\"corsProxySettings\",{\"_158\":4567},1,\"enableVibeCodingViaMCP\",\"enableCopyPage\",\"enableLLMs\",\"globalMetadata\",\"[\\n  {\\\"name\\\": \\\"description\\\", \\\"content\\\": \\\"{{DESCRIPTION}}\\\"},\\n  {\\\"name\\\": \\\"keywords\\\", \\\"content\\\": \\\"{{KEYWORDS}}\\\"},\\n  {\\\"name\\\": \\\"viewpoint\\\", \\\"content\\\": \\\"width=device-width, initial-scale=1.0, viewport-fit=cover\\\"}\\n]\",\"robotsFile\",{\"_4575\":49,\"_20\":4576},\"enable\",\"User-Agent: *\\nAllow: /\\n\\nSitemap: {{SITEMAP_URL}}\",\"enableSitemapFile\",\"persistEnvVariables\",\"showDataSchemas\",\"showDataSchemasExample\",\"showDataSchemasAutoGenerateExample\",\"landingPageType\",\"versionList\",[4585],{\"_158\":4586,\"_18\":4587,\"_161\":49,\"_162\":212,\"_164\":146},\"308240\",\"latest\",\"resourceData\",{\"_152\":328,\"_4590\":4591,\"_5012\":5013},\"data\",{\"_158\":2266,\"_18\":1122,\"_4592\":112,\"_4593\":4594,\"_4595\":4596,\"_4597\":4598,\"_4599\":4600,\"_19\":4601,\"_4602\":112,\"_4603\":112,\"_332\":546,\"_334\":2268,\"_222\":4604,\"_336\":337,\"_4605\":4606,\"_4607\":4608,\"_4609\":4610,\"_4611\":4612,\"_4613\":2261,\"_4614\":4615,\"_4616\":144,\"_4617\":4618,\"_4619\":4620,\"_4623\":4624,\"_4633\":112,\"_4634\":4635,\"_4636\":4637,\"_4638\":4639,\"_4640\":4641,\"_4642\":4643,\"_4644\":4645,\"_4646\":4647,\"_4648\":112,\"_152\":133,\"_4649\":4650,\"_4658\":4659,\"_4665\":4666,\"_4851\":4852,\"_4853\":4854,\"_4975\":4976,\"_5009\":5010},\"serverId\",\"preProcessors\",[],\"postProcessors\",[],\"inheritPreProcessors\",{},\"inheritPostProcessors\",{},\":::info[Description]\\nPlace order in the futures trading system. You can place two major types of order: Limit and market. Orders can only be placed if your account has sufficient funds. Once an order is placed, your funds will be put on hold for the duration of the order. The amount of funds on hold depends on the order type and parameters specified.\\n:::\\n\\n:::tip[Tips]\\nThe maximum limit orders for a single contract are 100 per account, and the maximum stop orders for a single contract are 200 per account.\\n:::\",\"operationId\",\"sourceUrl\",[],\"auth\",{},\"responseExamples\",[],\"projectId\",345089,\"moduleId\",300305,\"folderId\",\"ordering\",18,\"responsibleId\",\"commonResponseStatus\",{},\"advancedSettings\",{\"_4621\":4622},\"disabledSystemHeaders\",{},\"customApiFields\",{\"_4625\":4626,\"_4627\":3507,\"_4537\":4628,\"_4538\":3507,\"_4539\":3507,\"_4541\":3507,\"_4542\":1075,\"_4543\":4629,\"_4630\":4631,\"_4540\":4632},\"9\",\"normal\",\"10\",\"Private\",\"addOrder\",\"17\",\"Place order in the futures trading system. You can place two major types of order: Limit and market. Orders can only be placed if your account has sufficient funds. Once an order is placed, your funds will be put on hold for the duration of the order. The amount of funds on hold depends on the order type and parameters specified.\",2,\"oasExtensions\",\"mockScript\",{},\"createdAt\",\"2025-02-22T03:11:51.000Z\",\"updatedAt\",\"2026-09-09T06:32:34.000Z\",\"creatorId\",345036,\"editorId\",345075,\"visibility\",\"INHERITED\",\"securityScheme\",{},\"callbacks\",\"parameters\",{\"_4651\":4652,\"_334\":4653,\"_4654\":4655,\"_4656\":4657},\"query\",[],[],\"cookie\",[],\"header\",[],\"commonParameters\",{\"_4651\":4660,\"_4661\":4662,\"_4656\":4663,\"_4654\":4664},[],\"body\",[],[],[],\"requestBody\",{\"_152\":4667,\"_4649\":4668,\"_4669\":4670,\"_4843\":112,\"_4678\":4844,\"_4633\":112,\"_4590\":4847},\"application/json\",[],\"jsonSchema\",{\"_152\":4671,\"_4672\":4673,\"_4839\":4840,\"_4841\":4842},\"object\",\"properties\",{\"_4674\":4675,\"_4681\":4682,\"_4694\":4695,\"_4699\":4700,\"_152\":4705,\"_4717\":4718,\"_4720\":4721,\"_4731\":4732,\"_4748\":4749,\"_4751\":4752,\"_4755\":4756,\"_4758\":4759,\"_4761\":4762,\"_4775\":4776,\"_4786\":4787,\"_4791\":4792,\"_4794\":4795,\"_4813\":4814,\"_4816\":4817,\"_4819\":4820,\"_4822\":4823},\"clientOid\",{\"_152\":4676,\"_19\":4677,\"_4678\":4679},\"string\",\"Unique order ID created by users to identify their orders. The maximum length cannot exceed 40, e.g. UUID only allows numbers, characters, underline(_), and separator (-).\",\"examples\",[4680],\"5c52e11203aa677f33e493fb\",\"side\",{\"_152\":4676,\"_19\":4683,\"_4684\":4685,\"_4688\":4689,\"_4678\":4693},\"Specify if the order is to 'buy' or 'sell'.\",\"enum\",[4686,4687],\"buy\",\"sell\",\"x-apidog-enum\",[4690,4692],{\"_4691\":4686,\"_18\":4686,\"_19\":4686},\"value\",{\"_4691\":4687,\"_18\":4687,\"_19\":4687},[4686],\"symbol\",{\"_152\":4676,\"_19\":4696,\"_4678\":4697},\"Symbol of the contract. Please refer to [Get Symbol endpoint: symbol](/docs-new/rest/futures-trading/market-data/get-all-symbols) \",[4698],\"XBTUSDTM\",\"leverage\",{\"_152\":4701,\"_19\":4702,\"_4678\":4703},\"integer\",\"Optional for type is 'isolated margin' order, Set the order leverage. If you are to close the position, or add 'cross margin' order, this parameter is not required.\",[4704],3,{\"_152\":4676,\"_19\":4706,\"_4684\":4707,\"_4688\":4710,\"_4678\":4715,\"_4716\":4708},\"Specify if the order is a 'limit' order or 'market' order\",[4708,4709],\"limit\",\"market\",[4711,4713],{\"_4691\":4708,\"_18\":4708,\"_19\":4712},\"limit order\",{\"_4691\":4709,\"_18\":4709,\"_19\":4714},\"market order\",[4708],\"default\",\"remark\",{\"_152\":4676,\"_19\":4719},\"Remark for the order: Length cannot exceed 100 utf8 characters\",\"stop\",{\"_152\":4676,\"_19\":4722,\"_4684\":4723,\"_4688\":4726},\"Either 'down' or 'up'.  If stop is used, parameter stopPrice and stopPriceType also need to be provided.\",[4724,4725],\"down\",\"up\",[4727,4729],{\"_4691\":4724,\"_18\":4724,\"_19\":4728},\"Triggers when the price reaches or goes below the stopPrice.\",{\"_4691\":4725,\"_18\":4725,\"_19\":4730},\"Triggers when the price reaches or goes above the stopPrice.\",\"stopPriceType\",{\"_152\":4676,\"_19\":4733,\"_4684\":4734,\"_4688\":4738},\"Either 'TP', 'IP' or 'MP', Need to be defined if stop is specified.\",[4735,4736,4737],\"TP\",\"MP\",\"IP\",[4739,4742,4745],{\"_4691\":4735,\"_18\":4740,\"_19\":4741},\"trade price\",\"TP for trade price, The last trade price is the last price at which an order was filled. This price can be found in the latest match message.\",{\"_4691\":4736,\"_18\":4743,\"_19\":4744},\"mark price\",\"MP for mark price. The mark price can be obtained through relevant OPEN API for index services.\",{\"_4691\":4737,\"_18\":4746,\"_19\":4747},\"index price\",\"IP for index price. The index price can be obtained through relevant OPEN API for index services.\",\"stopPrice\",{\"_152\":4676,\"_19\":4750},\"Needs to be defined if stop is specified. \",\"reduceOnly\",{\"_152\":4753,\"_19\":4754,\"_4716\":146},\"boolean\",\"This parameter ensures that the current order **only reduces the existing position** without increasing it.\\n\\n- When `reduceOnly` is enabled, the system will only attempt to reduce the current position. You must set the quantity manually; the system does not guarantee a full close in one order.\\n- If the order would result in an increased position, it will be rejected.\\n- If the order is a valid reduce order but the quantity **exceeds the current position size**, it will be canceled.\\n- The total quantity of all active reduce (close) orders must be **less than or equal to the current position size**. If exceeded, reduce orders with worse prices will be canceled or partially canceled.\\n- When this parameter is set, the system **does not check the available balance**.\",\"closeOrder\",{\"_152\":4753,\"_19\":4757,\"_4716\":146},\"This parameter is used to **completely close the current position**.\\n\\n- When `closeOrder` is enabled, the system automatically determines the direction and quantity based on your current position (`side`, `size`, and `leverage` fields should be left blank).\\n- The system will execute a full close order based on the current position size.\\n- If both `reduceOnly` and `closeOrder` are set, **`closeOrder`** takes precedence.\\n- When this parameter is enabled, the system **does not verify the available balance**.\",\"forceHold\",{\"_152\":4753,\"_19\":4760,\"_4716\":146},\"A mark to force-hold the funds for an order, even though it's an order to reduce the position size. This helps the order stay on the order book and not get canceled when the position size changes. Set to false by default. The system will force-freeze a certain amount of funds for this order, including orders whose direction is opposite to the current positions. This feature is to ensure that the order won’t be canceled by the matching engine in such a way that not enough funds are frozen for the order.\",\"stp\",{\"_152\":4676,\"_19\":4763,\"_4684\":4764,\"_4688\":4768},\"[Self Trade Prevention](/docs-new/enums-definitions) is divided into these strategies: CN, CO, CB. DC not currently supported.\",[4765,4766,4767],\"CN\",\"CO\",\"CB\",[4769,4771,4773],{\"_4691\":4765,\"_18\":4765,\"_19\":4770},\"Cancel new, Cancel the new order\",{\"_4691\":4766,\"_18\":4766,\"_19\":4772},\"Cancel old, Cancel the old order\",{\"_4691\":4767,\"_18\":4767,\"_19\":4774},\"Cancel both, Cancel both sides\",\"marginMode\",{\"_152\":4676,\"_19\":4777,\"_4684\":4778,\"_4688\":4781,\"_4716\":4779},\"Margin mode: ISOLATED, CROSS, default: ISOLATED\",[4779,4780],\"ISOLATED\",\"CROSS\",[4782,4784],{\"_4691\":4779,\"_18\":4779,\"_19\":4783},\"Isolated Margin\",{\"_4691\":4780,\"_18\":4780,\"_19\":4785},\"Cross Margin\",\"price\",{\"_152\":4676,\"_19\":4788,\"_4678\":4789},\"Required for type is 'limit' order, indicating the operating price\",[4790],\"0.1\",\"size\",{\"_152\":4701,\"_19\":4793},\"Specified in **lots** and must be a positive integer.  \\nFor **coin-swap contracts**, only `size` (lot) is supported; other units are not supported.  \\n**Choose one of `size`, `qty`, or `valueQty`.**\",\"timeInForce\",{\"_152\":4676,\"_19\":4796,\"_4684\":4797,\"_4688\":4802,\"_4716\":4798},\"Optional for type is 'limit' order, [Time in force](/docs-new/enums-definitions) is a special strategy used during trading, default is GTC\",[4798,4799,4800,4801],\"GTC\",\"IOC\",\"RPI\",\"FOK\",[4803,4806,4809,4811],{\"_4691\":4798,\"_18\":4804,\"_19\":4805},\"Good Till Canceled\",\"Order remains open on the order book until canceled. This is the default type if the field is left empty.\",{\"_4691\":4799,\"_18\":4807,\"_19\":4808},\"Immediate Or Cancel\",\"Being matched or not, the remaining size of the order will be instantly canceled instead of entering the order book.\",{\"_4691\":4800,\"_18\":4800,\"_19\":4810},\"Retail Price Improvement Order\",{\"_4691\":4801,\"_18\":4801,\"_19\":4812},\"Fill Or Kill\",\"postOnly\",{\"_152\":4753,\"_19\":4815,\"_4716\":146},\"Optional for type is 'limit' order, post only flag, invalid when timeInForce is IOC. The post-only flag ensures that the trader always pays the maker fee and provides liquidity to the order book. If any part of the order is going to pay taker fees, the order will be fully rejected.\",\"qty\",{\"_152\":4676,\"_19\":4818},\"Specified in **base currency** and must be an integer multiple of the multiplier.  \\nFor **coin-swap contracts**, `qty` is not supported; use `size` (lot) instead.  \\n**Choose one of `size`, `qty`, or `valueQty`.**\",\"valueQty\",{\"_152\":4676,\"_19\":4821},\"Specified in **quote currency**. For **USDS-Swap**, the quote currency is **USDT** or **USDC**.  \\nFor **coin-swap contracts**, `valueQty` is not supported; use `size` (lot) instead.  \\n**Choose one of `size`, `qty`, or `valueQty`.**\",\"positionSide\",{\"_152\":4676,\"_19\":4824,\"_4684\":4825,\"_4688\":4829},\"Position direction, optional in one-way mode, defaults to BOTH. Required in hedge mode.\",[4826,4827,4828],\"BOTH\",\"LONG\",\"SHORT\",[4830,4833,4836],{\"_4691\":4826,\"_18\":4831,\"_19\":4832},\"both\",\"BOTH for one-way mode.\",{\"_4691\":4827,\"_18\":4834,\"_19\":4835},\"long\",\"LONG for long position in hedge mode.\",{\"_4691\":4828,\"_18\":4837,\"_19\":4838},\"short\",\"SHORT for short position in hedge mode.\",\"x-apidog-orders\",[4674,4681,4694,4699,152,4717,4720,4731,4748,4751,4755,4758,4761,4775,4786,4791,4816,4819,4794,4813,4822],\"required\",[4674,4694,4681],\"mediaType\",[4845,4849],{\"_18\":4846,\"_4691\":4847,\"_4843\":4667,\"_192\":4848},\"One-way Position Mode\",\"{\\n    \\\"clientOid\\\": \\\"5c52e11203aa677f33e493fb\\\",\\n    \\\"symbol\\\": \\\"XBTUSDTM\\\",\\n    \\\"marginMode\\\": \\\"ISOLATED\\\",\\n    \\\"leverage\\\": 3,\\n    \\\"positionSide\\\": \\\"BOTH\\\",\\n    \\\"side\\\": \\\"buy\\\",\\n    \\\"type\\\": \\\"limit\\\",\\n    \\\"size\\\": 1,\\n    \\\"price\\\": \\\"100000\\\",\\n    \\\"timeInForce\\\": \\\"GTC\\\",\\n    \\\"reduceOnly\\\": false,\\n    \\\"remark\\\": \\\"order_remarks\\\"\\n}\",\"0\",{\"_18\":3271,\"_4691\":4850,\"_4843\":4667,\"_192\":159},\"{\\n    \\\"clientOid\\\": \\\"5c52e11203aa677f33e493fb\\\",\\n    \\\"symbol\\\": \\\"XBTUSDTM\\\",\\n    \\\"marginMode\\\": \\\"CROSS\\\",\\n    \\\"leverage\\\": 3,\\n    \\\"positionSide\\\": \\\"BOTH\\\",\\n    \\\"side\\\": \\\"buy\\\",\\n    \\\"type\\\": \\\"limit\\\",\\n    \\\"size\\\": 1,\\n    \\\"price\\\": \\\"30000\\\",\\n    \\\"stopPrice\\\": \\\"29000\\\",\\n    \\\"stop\\\": \\\"down\\\",\\n    \\\"stopPriceType\\\": \\\"TP\\\",\\n    \\\"timeInForce\\\": \\\"GTC\\\",\\n    \\\"reduceOnly\\\": false,\\n    \\\"remark\\\": \\\"order_remarks\\\"\\n}\",\"codeSamples\",[],\"codeSampleLanguages\",[4855,4873,4891,4898,4904,4909,4920,4928,4931,4938,4944,4950,4956,4962,4967],{\"_192\":4856,\"_4857\":4858,\"_4859\":4860,\"_4861\":4862},\"shell\",\"label\",\"Shell\",\"syntaxMode\",\"powershell\",\"variants\",[4863,4865,4867,4869,4871],{\"_192\":4864},\"cURL\",{\"_192\":4866},\"cURL-Windows\",{\"_192\":4868},\"Httpie\",{\"_192\":4870},\"wget\",{\"_192\":4872},\"PowerShell\",{\"_192\":4874,\"_4857\":4875,\"_4859\":4874,\"_4861\":4876},\"javascript\",\"JavaScript\",[4877,4879,4881,48