9},\"Delivery contract type\",\"firstOpenDate\",{\"_152\":4852,\"_19\":4853,\"_4854\":4855},\"integer\",\"First Open Date (milliseconds)\",\"format\",\"int64\",\"expireDate\",{\"_152\":4858,\"_19\":4860,\"_4854\":4855},[4852,4859],\"null\",\"Expiration date (milliseconds) Null means it will never expire\",\"settleDate\",{\"_152\":4863,\"_19\":4864,\"_4854\":4855},[4852,4859],\"Settlement date (milliseconds) Null indicates that automatic settlement is not supported\",\"baseCurrency\",{\"_152\":4663,\"_19\":4867},\"Base currency\",\"quoteCurrency\",{\"_152\":4663,\"_19\":4870},\"Quote currency\",\"settleCurrency\",{\"_152\":4663,\"_19\":4873},\"Currency used to clear and settle the trades\",\"maxOrderQty\",{\"_152\":4852,\"_19\":4876},\"Maximum order quantity\",\"maxPrice\",{\"_152\":4879,\"_19\":4880},\"number\",\"Maximum order price\",\"lotSize\",{\"_152\":4852,\"_19\":4883},\"Minimum lot size\",\"tickSize\",{\"_152\":4879,\"_19\":4886},\"Minimum price changes\",\"indexPriceTickSize\",{\"_152\":4879,\"_19\":4889},\"Index price of tick size\",\"multiplier\",{\"_152\":4879,\"_19\":4892},\"The basic unit of the contract API is lots. For the number of coins in each lot, please refer to the param multiplier. For example, for XBTUSDTM, multiplier=0.001, which corresponds to the value of each XBTUSDTM contract being 0.001 BTC. There is also a special case. All coin-swap contracts, such as each XBTUSDM contract, correspond to 1 USD.\",\"initialMargin\",{\"_152\":4879,\"_19\":4895},\"Initial margin requirement\",\"maintainMargin\",{\"_152\":4879,\"_19\":4898},\"Maintenance margin requirement\",\"maxRiskLimit\",{\"_152\":4852,\"_19\":4901},\"Maximum risk limit (unit: XBT)\",\"minRiskLimit\",{\"_152\":4852,\"_19\":4904},\"Minimum risk limit (unit: XBT)\",\"riskStep\",{\"_152\":4852,\"_19\":4907},\"Risk limit increment value (unit: XBT)\",\"makerFeeRate\",{\"_152\":4879,\"_19\":4910},\"Maker fee rate\",\"takerFeeRate\",{\"_152\":4879,\"_19\":4913},\"Taker fee rate\",\"takerFixFee\",{\"_152\":4879,\"_19\":4916},\"Deprecated param\",\"makerFixFee\",{\"_152\":4879,\"_19\":4916},\"settlementFee\",{\"_152\":4879,\"_19\":4921},\"Settlement fee\",\"isDeleverage\",{\"_152\":4924,\"_19\":4925},\"boolean\",\"Enabled ADL or not\",\"isQuanto\",{\"_152\":4924,\"_19\":4916},\"isInverse\",{\"_152\":4924,\"_19\":4930},\"Whether it is a reverse contract\",\"markMethod\",{\"_152\":4663,\"_19\":4933,\"_4840\":4934,\"_4844\":4936},\"Marking method\",[4935],\"FairPrice\",[4937],{\"_4665\":4935,\"_18\":4935,\"_19\":4935},\"fairMethod\",{\"_152\":4663,\"_19\":4940,\"_4840\":4941,\"_4844\":4943},\"Fair price marking method; the Futures contract is null\",[4942],\"FundingRate\",[4944],{\"_4665\":4942,\"_18\":4942,\"_19\":4942},\"fundingBaseSymbol\",{\"_152\":4663,\"_19\":4947},\"Ticker symbol of the base currency\",\"fundingQuoteSymbol\",{\"_152\":4663,\"_19\":4950},\"Ticker symbol of the quote currency\",\"fundingRateSymbol\",{\"_152\":4663,\"_19\":4953},\"Funding rate symbol\",\"indexSymbol\",{\"_152\":4663,\"_19\":4956},\"Index symbol\",\"settlementSymbol\",{\"_152\":4663,\"_19\":4959},\"Settlement symbol\",{\"_152\":4663,\"_19\":4961,\"_4840\":4962,\"_4844\":4970},\"Contract status\",[4963,4964,4965,4966,4967,4968,4969],\"Init\",\"Open\",\"BeingSettled\",\"Settled\",\"Paused\",\"Closed\",\"CancelOnly\",[4971,4973,4975,4977,4978,4980,4982],{\"_4665\":4963,\"_18\":4963,\"_19\":4972},\"Initial\",{\"_4665\":4964,\"_18\":4964,\"_19\":4974},\"Online\",{\"_4665\":4965,\"_18\":4965,\"_19\":4976},\"Settling\",{\"_4665\":4966,\"_18\":4966,\"_19\":4966},{\"_4665\":4967,\"_18\":4967,\"_19\":4979},\"Suspended\",{\"_4665\":4968,\"_18\":4968,\"_19\":4981},\"Offline\",{\"_4665\":4969,\"_18\":4969,\"_19\":4983},\"Orders can only be canceled\",\"fundingFeeRate\",{\"_152\":4879,\"_19\":4986},\"Funding fee rate\",\"predictedFundingFeeRate\",{\"_152\":4879,\"_19\":4989},\"Predicted funding fee rate\",\"fundingRateGranularity\",{\"_152\":4852,\"_19\":4992},\"Configured funding rate interval. If this value is modified, it means the funding interval for the next cycle will also be changed\\n\\nFor example:\\n\\nIf the current settlement cycle is:\\ncurrentFundingRateGranularity = 8 hours, and the next settlement time is 16:00.\\n\\nIf the current time is 11:10, and the system then changes fundingRateGranularity to 2 hours,\\n\\nthen the next settlement time will become 12:00.\\n\\nIt is recommended to refer to effectiveFundingRateCycleStartTime to determine the exact next settlement time.\",\"openInterest\",{\"_152\":4663,\"_19\":4995},\"Open interest (unit: lots)\",\"turnoverOf24h\",{\"_152\":4879,\"_19\":4998},\"24-hour turnover, calculated as the total traded lots from both maker and taker sides.\",\"volumeOf24h\",{\"_152\":4879,\"_19\":5001},\"24-hour volume, calculated as the total traded lots from both maker and taker sides.\",\"markPrice\",{\"_152\":4879,\"_19\":5004},\"Mark price\",\"indexPrice\",{\"_152\":4879,\"_19\":5007},\"Index price\",\"lastTradePrice\",{\"_152\":4879,\"_19\":5010},\"Last trade price\",\"nextFundingRateTime\",{\"_152\":4852,\"_19\":5013},\"Next funding rate time (milliseconds)\",\"maxLeverage\",{\"_152\":4852,\"_19\":5016},\"Maximum leverage\",\"sourceExchanges\",{\"_152\":5019,\"_5020\":5021,\"_19\":5022},\"array\",\"items\",{\"_152\":4663},\"The contract index price source exchange\",\"premiumsSymbol1M\",{\"_152\":4663,\"_19\":5025},\"Premium index symbol (1 minute)\",\"premiumsSymbol8H\",{\"_152\":4663,\"_19\":5028},\"Premium index symbol (8 hours)\",\"fundingBaseSymbol1M\",{\"_152\":4663,\"_19\":5031},\"Base currency interest rate symbol (1 minute)\",\"fundingQuoteSymbol1M\",{\"_152\":4663,\"_19\":5034},\"Quote currency interest rate symbol (1 minute)\",\"lowPrice\",{\"_152\":4879,\"_19\":5037},\"24-hour lowest price\",\"highPrice\",{\"_152\":4879,\"_19\":5040},\"24-hour highest price\",\"priceChgPct\",{\"_152\":4879,\"_19\":5043},\"24-hour % price change \",\"priceChg\",{\"_152\":4879,\"_19\":5046},\"24-hour price change\",\"k\",{\"_152\":4879},\"m\",{\"_152\":4879},\"f\",{\"_152\":4879},\"mmrLimit\",{\"_152\":4879},\"mmrLevConstant\",{\"_152\":4879},\"supportCross\",{\"_152\":4924,\"_19\":5059},\"Whether support Cross Margin\",\"buyLimit\",{\"_152\":4879,\"_19\":5062},\"The current maximum buying price allowed\",\"sellLimit\",{\"_152\":4879,\"_19\":5065},\"The current minimum selling price allowed\",\"marketMaxOrderQty\",{\"_152\":4879,\"_19\":5068},\"Maximum order quantity allowed for a market order.\",\"fundingRateCap\",{\"_152\":4879,\"_19\":5071},\"Upper limit (cap) of the funding rate.\",\"fundingRateFloor\",{\"_152\":4879,\"_19\":5074},\"Lower limit (floor) of the funding rate.\",\"period\",{\"_152\":4852,\"_4840\":5077,\"_4844\":5078,\"_19\":5084},[144,4567],[5079,5082],{\"_4665\":144,\"_18\":5080,\"_19\":5081},\"0\",\"Deferred period\",{\"_4665\":4567,\"_18\":159,\"_19\":5083},\"Current period\",\"Funding fee collection mode (0 = deferred period, 1 = current period). This field is deprecated; all fees are now collected in the current period.\",\"nextFundingRateDateTime\",{\"_152\":4852,\"_19\":5087,\"_4854\":4855},\"Timestamp of the next funding fee settlement time.\",\"adjustK\",{\"_152\":4879,\"_19\":5090},\"Pending effective k value. If there are no pending values, this field is null.\",\"adjustM\",{\"_152\":4879,\"_19\":5093},\"Pending effective m value. If there are no pending values, this field is null.\",\"adjustMmrLevConstant\",{\"_152\":4879,\"_19\":5096},\"Pending effective mmrLevConstant. If there are no pending values, this field is null.\",\"adjustActiveTime\",{\"_152\":4852,\"_19\":5099,\"_4854\":4855},\"Effective time of new K/M/mmrLevConstant parameters. If there are no pending values, this field is null. Unit: milliseconds.\",\"crossRiskLimit\",{\"_152\":4879,\"_19\":5102},\"The hard cap of the maximum limit under Cross Margin mode (taking the smaller value between the system’s hard cap and the maximum openable amount).\",\"marketStage\",{\"_1