nt\\\": \\\"{{KEYWORDS}}\\\"},\\n  {\\\"name\\\": \\\"viewpoint\\\", \\\"content\\\": \\\"width=device-width, initial-scale=1.0, viewport-fit=cover\\\"}\\n]\",\"robotsFile\",{\"_4573\":49,\"_20\":4574},\"enable\",\"User-Agent: *\\nAllow: /\\n\\nSitemap: {{SITEMAP_URL}}\",\"enableSitemapFile\",\"persistEnvVariables\",\"showDataSchemas\",\"showDataSchemasExample\",\"showDataSchemasAutoGenerateExample\",\"landingPageType\",\"versionList\",[4583],{\"_158\":4584,\"_18\":4585,\"_161\":49,\"_162\":212,\"_164\":146},\"308240\",\"latest\",\"resourceData\",{\"_152\":216,\"_4588\":4589,\"_4607\":4608},\"data\",{\"_158\":2160,\"_18\":218,\"_4590\":112,\"_20\":4591,\"_4592\":2154,\"_4593\":4594,\"_4595\":4596,\"_4597\":4598,\"_4599\":4600,\"_4601\":4602,\"_4603\":4602,\"_152\":112,\"_222\":4604,\"_4605\":4606},\"sidebarTitle\",\"KuCoin Futures currently offers two types of products:\\n\\nUSDT-Margined Futures: Also known as forward contracts, settled in USDT or USDC. For example, in the BTC Perpetual/USDT futures, BTC is the base currency (the currency being traded), and USDT is the settlement currency (used to buy the futures and calculate position PNL).\\n\\nCoin-Margined Futures: Also known as inverse contracts, settled in cryptocurrencies. For example, the BTC-margined (BTC Perpetual-USD) future has BTC as both the base and settlement currency.\\n\\n\\n**FAQ Guidelines**\\n- How to Use Kucoin Futures Cross Margin Via API\\nhttps://www.kucoin.com/support/47497300093771\\n- What is Cross Margin Mode\\nhttps://www.kucoin.com/support/35081196925209\\n- Advantages of Cross Margin Mode\\nhttps://www.kucoin.com/support/35084093025049\\n- Maximum Open Position Size in Cross Margin Mode\\nhttps://www.kucoin.com/support/35084240398361\\n- Risk Rate of Cross Margin Mode\\nhttps://www.kucoin.com/support/35233217061785\\n- Liquidation Price in Cross Margin Mode\\nhttps://www.kucoin.com/support/35084431335065\\n- Auto Deleverage in Cross-Margin Mode\\nhttps://www.kucoin.com/support/35084312224281\\n\\n\",\"folderId\",\"projectId\",345089,\"moduleId\",300305,\"createdAt\",\"2025-06-17T02:02:59.000Z\",\"updatedAt\",\"2025-09-26T10:03:05.000Z\",\"creatorId\",345036,\"editorId\",[224,233,225],\"visibility\",\"INHERITED\",\"extraData\",{\"_4609\":4610,\"_4618\":4619},\"apiFieldList\",[4611],{\"_152\":4599,\"_192\":4612,\"_18\":4613,\"_4614\":4600,\"_4615\":4616,\"_4617\":49},\"updateAt\",\"Last modified:\",\"value\",\"format\",\"2025-09-26 10:03:05\",\"hidden\",\"dataSchemaDefinitions\",{},\"docsIdTypeData\",{\"_4622\":4623,\"_4624\":4625,\"_4593\":4594,\"_4626\":4627,\"_4628\":4629,\"_4630\":4631,\"_4632\":4633,\"_4634\":-7},\"onlineType\",\"APIDOC\",\"onlineId\",6000028,\"teamId\",71,\"branchId\",308240,\"visitType\",\"customDomain\",\"subdirectory\",\"docs-new\",\"specialFileType\",\"notification\",[],\"footerBanner\",[],\"projectSetting\",{\"_4641\":4642,\"_4644\":4645,\"_4669\":4670,\"_4671\":4672,\"_4673\":4674,\"_4675\":4676},\"auth\",{\"_152\":4643},\"noauth\",\"advancedSettings\",{\"_4646\":49,\"_4647\":146,\"_4648\":49,\"_4649\":4650,\"_4651\":146,\"_4652\":146,\"_4653\":4654,\"_4659\":4660,\"_4661\":4662,\"_4667\":4668},\"enableJsonc\",\"enableBigint\",\"responseValidate\",\"isDefaultUrlEncoding\",2,\"enableTestScenarioSetting\",\"enableYAPICompatScript\",\"publishedDocUrlRules\",{\"_4655\":4656,\"_4657\":4658},\"defaultRule\",\"RESOURCE_KEY_ONLY\",\"resourceKeyStandard\",\"NEW\",\"preferredHttpVersion\",{},\"folderShareExpandModeSettings\",{\"_4663\":4664,\"_4665\":4666},\"expandId\",[],\"mode\",\"AUTO\",\"parameterDisplayMode\",\"MODERN\",\"securityScheme\",{},\"mockSettings\",{},\"preProcessors\",[],\"postProcessors\",[],\"environments\",{\"_4679\":4680,\"_4758\":4759,\"_4788\":4789},\"selectedEnvironment\",{\"_158\":4681,\"_18\":4682,\"_4683\":4684,\"_4685\":4686,\"_4698\":4699,\"_4706\":4707,\"_4718\":4719,\"_4734\":4735,\"_4744\":4745,\"_152\":4746,\"_4605\":4747,\"_4593\":4594,\"_4748\":3489,\"_4601\":4602,\"_4749\":4750,\"_222\":4751,\