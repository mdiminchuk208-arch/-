{
  "capture_environment": "Codex managed cloud, inherited HTTPS proxy and CA; no cookies, authentication, VPN or alternate routing; no automatic redirect following",
  "document_quotes": {
    "docs_main#order-book-trading-algo-trading-post-place-algo-order": [
      "The algo order includes trigger order, oco order, chase order, conditional order, twap order and trailing order.",
      "only stop-loss logic will be performed and take-profit logic will be ignored."
    ],
    "docs_main#order-book-trading-market-data-get-candlesticks-history": [
      "Retrieve history candlestick charts from recent years(It is last 3 months supported for 1s candlestick).",
      "after String No Pagination of data to return records earlier than the requested ts",
      "before String No Pagination of data to return records newer than the requested ts.",
      "0: K line is uncompleted1: K line is completed"
    ],
    "docs_main#order-book-trading-market-data-get-order-book": [
      "\"10\" is the quantity at the price (number of contracts for derivatives, quantity in base currency for Spot and Spot Margin)",
      "Order book depth per side. Maximum 400, e.g. 400 bids + 400 asks"
    ],
    "docs_main#order-book-trading-market-data-get-trades-history": [
      "Retrieve the recent transactions of an instrument from the last 3 months with pagination."
    ],
    "docs_main#order-book-trading-trade-post-place-order": [
      "For FUTURES/SWAP/OPTION orders, it refers to the number of contracts.",
      "Notional value = sz × ctVal × markPx (linear contracts)",
      "reduceOnly When placing an order with this parameter set to true, it means that the order will reduce the size of the position only"
    ],
    "docs_main#overview-api-key-creation-api-key-permissions": [
      "Trade : Can place and cancel orders, funding transfer, make settings which need write permission",
      "Withdraw : Can make withdrawals"
    ],
    "docs_main#overview-api-key-creation-api-key-security": [
      "Each API key can bind up to 20 IP addresses"
    ],
    "docs_main#public-data-rest-api-get-funding-rate": [
      "positive = long positions pay short positions at the next fundingTime; negative = short positions pay long positions.",
      "users should focus on the difference between `fundingTime` and `nextFundingTime` fields to determine the funding fee interval of a contract."
    ],
    "docs_main#public-data-rest-api-get-funding-rate-history": [
      "This endpoint can return data up to three months.",
      "realizedRate String Actual funding rate"
    ],
    "docs_main#public-data-rest-api-get-instruments": [
      "SWAP: Perpetual Futures",
      "Face value of one contract. Denomination depends on ctType: for linear contracts, ctVal is in the base currency (e.g., ctVal=0.01 BTC for BTC-USDT-SWAP)",
      "Users should use this endpoint together with fee rates endpoint to get the trading fee of a specific symbol.",
      "Instruments REST endpoints and WebSocket channel will update `expTime` once the delisting announcement is published."
    ],
    "docs_main#trading-account-rest-api-get-fee-rates": [
      "GET /api/v5/account/trade-fee",
      "negative number, which means the rate of commission.",
      "The Open API will not reflect zero-fee trading."
    ],
    "docs_main#trading-account-rest-api-set-leverage": [
      "Set leverage for `SWAP` instruments under `isolated-margin` trade mode and buy/sell order placement mode at contract level."
    ],
    "docs_main#trading-statistics-rest-api-get-contract-open-interest-history": [
      "This endpoint can retrieve the latest 1,440 data entries.",
      "for other periods, the data time range is up to early February 2024."
    ],
    "fee_help_en": [
      "Trader A (Maker fee: 0.02%; Taker fee: 0.05%)"
    ],
    "fee_page_en": [
      "\"tabName\":\"Spot\""
    ]
  },
