ader><div class="home-container"><div id="root" role="main"><div id="hc-container"><div class="okx-sticky-container  " style="position:sticky;top:0px" id="okx-sticky_1"><div id="support-banner-notice" class="index_banner__QPEln index_visible__Ppz1A" style="--animation-duration:300ms"><div class="index_content__CujdD" role="banner" aria-label="Announcement:" aria-describedby="banner__R_2_"><i class="icon iconfont okx-support-information index_infoIcon__eCLrS" role="img" aria-hidden="true"></i><p id="banner__R_2_" class="index_description__sbI5d">Not all products mentioned are available in all jurisdictions.</p><i class="icon iconfont okx-support-close index_closeIcon__n3hhX okui-a11y-button" role="button" aria-label="Close" aria-description="Announcement:" tabindex="0"></i></div></div></div><div id="article-container" class="index_articleWrap__I538H"><!--$--><div class="index_header__L6uwU index_pageHeader__qkW2v"><div class="index_inputWrapper__O0dCI index_searchBar__gXfnu" id="search-container-_R_1b_"><div class="okui-input-var okui-input okui-input-md okui-input-search"><div class="okui-input-box input-circle" role="none"><span class="okui-input-prefix" data-testid="okd-input-prefix"><i class="icon iconfont okds-search okui-input-search-prefix-icon prefix-icon okui-a11y-button" role="button" aria-label="Search FAQ articles" data-testid="okd-input-prefix-icon" tabindex="0"></i></span><input data-testid="okd-input" type="search" aria-owns="_R_1bH1_" aria-controls="_R_1bH1_" aria-haspopup="listbox" role="combobox" aria-expanded="false" inputMode="search" autoCapitalize="off" autoCorrect="off" placeholder="Search FAQ articles" aria-label="Search FAQ articles" id="_R_db_" class="okui-input-input" value=""/></div></div></div><div class="index_breadcrumb__ywq82"><div class="okui-breadcrumbs-var okui-breadcrumbs okui-breadcrumbs-secondary okui-breadcrumbs-md index_breadcrumb__suoXK" role="navigation"><div class="okui-overflowscroll-var okui-overflow_scroll"><div class="okui-overflow_scroll-nav"><div class="okui-overflow_scroll-nav-icon icon-left  icon-hide" data-testid="okd-overflow-scroll-icon-prev"><i class="icon iconfont okds-arrow-chevron-right-centered-sm
 icon-left-inner" role="img" aria-hidden="true"></i></div><div class="okui-overflow_scroll-nav-icon icon-right  icon-hide" data-testid="okd-overflow-scroll-icon-next"><i class="icon iconfont okds-arrow-chevron-right-centered-sm" role="img" aria-hidden="true"></i></div></div><div class="okui-overflow_scroll-scroll"><div class="okui-overflow_scroll-scroll-children"><div class="okui-breadcrumbs-crumb"><div class="okui-hyperlink-var okui-hyperlink okui-hyperlink-secondary okui-hyperlink-md okui-hyperlink-medium okui-breadcrumbs-crumb-link" data-testid="okd-hyperlink"><a href="/en-us/help" rel="noopener" target="_self" class="okui-powerLink-a11y okui-hyperlink-text">Support center</a></div><i class="icon iconfont okds-arrow-chevron-right-centered-md crumb-icon" role="img" aria-hidden="true"></i></div><div class="okui-breadcrumbs-crumb"><div class="okui-hyperlink-var okui-hyperlink okui-hyperlink-secondary okui-hyperlink-md okui-hyperlink-medium okui-breadcrumbs-crumb-link" data-testid="okd-hyperlink"><a href="/en-us/help/category/faq" rel="noopener" target="_self" class="okui-powerLink-a11y okui-hyperlink-text">FAQ</a></div><i class="icon iconfont okds-arrow-chevron-right-centered-md crumb-icon" role="img" aria-hidden="true"></i></div><div class="okui-breadcrumbs-crumb"><div class="okui-hyperlink-var okui-hyperlink okui-hyperlink-secondary okui-hyperlink-md okui-hyperlink-medium okui-breadcrumbs-crumb-link" data-testid="okd-hyperlink"><a href="/en-us/help/section/faq-trading" rel="noopener" target="_self" class="okui-powerLink-a11y okui-hyperlink-text">Trading</a></div><i class="icon iconfont okds-arrow-chevron-right-centered-md crumb-icon" role="img" aria-hidden="true"></i></div><div class="okui-breadcrumbs-crumb"><div class="okui-hyperlink-var okui-hyperlink okui-hyperlink-secondary okui-hyperlink-md okui-hyperlink-medium okui-breadcrumbs-crumb-link" data-testid="okd-hyperlink"><a href="/en-us/help/section/faq-trading-general-info" rel="noopener" target="_self" class="okui-powerLink-a11y okui-hyperlink-text">Trading general info</a></div><i class="icon iconfont okds-arrow-chevron-right-centered-md crumb-icon" role="img" aria-hidden="true"></i></div><div class="okui-breadcrumbs-crumb okui-breadcrumbs-crumb-active" aria-current="location">Article</div></div></div></div></div></div></div><!--/$--><article aria-label="Trading Fee Rules FAQ"><!--$--><div class="index_headerContainer__jcJZD"><div class="index_article-row__xv6Xx"><h1 class="index_article-title-h1__izWG0">Trading Fee Rules FAQ</h1></div><div class="index_detail-row__DEj+n"><div class="index_dividerRow__FHkzs index_timeWrap__lvPHm"><span class="index_hideSm__lJK44">Published on Mar 22, 2024</span><span class="">Updated on Sep 9, 2026</span><span>29 min read</span><span class="index_likeDisplay__zDiwu index_likeCountWrap__+Pshw index_smSingleRow__q-D5h" aria-label="1,101 likes"><i class="icon iconfont okx-support-thumb-up" role="img" aria-hidden="true"></i>1,101</span></div><div class="index_share__ZwtFp"><i class="icon iconfont okx-support-share index_shareIcon__4FFoD okui-a11y-button" style="font-size:20px" role="button" aria-label="Share" tabindex="0"></i></div></div></div><!--/$--><div class="index_articleContainer__ZEzTe"><div class="index_contentContainer__Ysxwq"><div class="okui-reminder-var okui-reminder notice-reminder index_reminder__ljgfG index_custom__wKd9r index_noticeBanner__ktkqb" data-testid="okd-reminder-notice" aria-labelledby="_R_mj_" aria-label=""><div class="okui-reminder-container"><i class="icon iconfont okui-reminder-icon okds-warning-circle-fill" role="img" data-testid="okd-reminder-icon" aria-hidden="true"></i><div class="okui-reminder-content"><div id="_R_mj_" class="okui-reminder-title">This information may not apply to all customers</div><div class="okui-reminder-desc"><span class="okui-hyperlink-var okui-hyperlink okui-hyperlink-primary okui-hyperlink-no-hover-underline okui-hyperlink-underline okui-hyperlink-xs okui-hyperlink-muted okui-a11y-button" data-testid="okd-hyperlink" role="button" tabindex="0"><span class="okui-hyperlink-text index_link__v5cti">Log in</span></span> to check if the products, features, rules, and terms in this article apply to you.</div></div></div></div><div class="index_content__XU1MV"><div class="index_richTextContent__nBEOc"><p>This article covers everything you need to know about OKX trading fees (also referred to as transaction fees, service fees, trading commission, or trading costs), including maker and taker fee rates, spot fees, futures fees and options fees, how fees are calculated, where to find the fee schedule and the fee rate for a specific pair, how to check your current fee tier and your 30-day trading volume, what you&#x27;re charged when a position is closed or liquidated, how a funding fee differs from a trading fee, and how to reduce your fees.</p><h2 id="1-when-will-the-maker-and-taker-fees-occur-what-is-the-difference-between-maker-and-taker-fees">1. When will the maker and taker fees occur? What is the difference between maker and taker fees?</h2><p>A taker order occurs when you place a trade that is immediately filled against an order already on the order book. Taker orders incur a fee based on the taker fee rate.</p><p>A maker order happens when you place an order that goes on the order book with a set price and quantity, such as a limit order that sits on the book until matched. </p><p>Maker orders are charged a fee based on the maker fee rate. Maker orders add to the order book’s liquidity, providing more depth to the market. In contrast, taker orders remove liquidity by filling orders on the order book, reducing market depth. To incentivize liquidity provision by makers, maker fees are typically lower than taker fees. For detailed rules, you can read more about our <span class="okui-hyperlink-var okui-hyperlink okui-hyperlink-accent okui-hyperlink-underline okui-hyperlink-md okui-hyperlink-muted index_hyperlink__f2YQn" data-testid="okd-hyperlink"><a href="/en-us/fees" rel="nofollow noopener noreferrer" target="_self" class="okui-powerLink-a11y okui-hyperlink-text index_mutedLink__UPRKk">trading fee schedule</a></span>.</p><h2 id="2-why-are-the-fees-different-for-market-orders-and-limit-orders">2. Why are the fees different for market orders and limit orders?</h2><p>Fees may differ because they’re based on <b>how an order is executed</b>, not on whether it’s a market order or a limit order. Specifically, fees depend on whether your order is executed as a <b>taker</b> or a <b>maker</b>.</p><ul><li><p><b>Market orders</b> usually execute immediately against existing orders in the orderbook, so they’re typically charged <b>taker fees</b>. In periods of low liquidity or high volatility, a market order may be partially filled, and any unfilled portion may be cancelled.</p></li><li><p><b>Limit orders</b> may incur <b>maker or taker fees</b>, depending on execution. If a limit order matches immediately with an existing order, it’s treated as a taker order. If it’s placed on the orderbook and filled later, it’s treated as a maker order.</p></li></ul><p>In short, the fee applied depends on the order’s actual execution rather than the order type.</p><h2 id="3-how-do-i-check-my-current-trading-fee-rate-what-are-the-fee-rates-and-commissions-for-each-vip-level">3. How do I check my current trading fee rate? What are the fee rates and commissions for each VIP level?</h2><p>The fee rates that apply to your account are the ones shown while you&#x27;re logged in. Rates displayed to a logged-out visitor aren&#x27;t tied to any account and can differ from your own fee tier.</p><p>You can log in to your account on <span class="okui-hyperlink-var okui-hyperlink okui-hyperlink-accent okui-hyperlink-underline okui-hyperlink-md okui-hyperlink-muted index_hyperlink__f2YQn" data-testid="okd-hyperlink"><a href="/en-us" rel="nofollow noopener noreferrer" target="_self" class="okui-powerLink-a11y okui-hyperlink-text index_mutedLink__UPRKk">our website</a></span> and go to <span class="okui-hyperlink-var okui-hyperlink okui-hyperlink-accent okui-hyperlink-underline okui-hyperlink-md okui-hyperlink-muted index_hyperlink__f2YQn" data-testid="okd-hyperlink"><a href="/en-us/balance/fee" rel="nofollow noopener noreferrer" target="_self" class="okui-powerLink-a11y okui-hyperlink-text index_mutedLink__UPRKk"><b>Assets &gt; My trading fees</b></a></span>. You can refer to <b>My fee tier</b> for your current fee tier level and the trading fee schedule, which includes the fee rates for each instrument and trading pair.</p><figure class="assetContainer"><button type="button" aria-haspopup="dialog" aria-label="undefined CT-web-asset dropdown-my trading fees" data-testid="okd-image-viewer" class="okui-plain-button okui-image-viewer index_container__iJVBI"><picture class="okui-picture okui-picture-font"><source data-testid="okd-image-source-webp-media" media="(min-width: 1270px) and (max-width: 1859px)" srcSet="//www.okx.com/cdn/assets/plugins/announcements/contentful/tofttmniq0qv/4bxXejo6NUF9S7N0fdOrnW/fb3170fb0b87bec7900948e2ecbb91b5/web-asset_dropdown-my_trading_fees.png?x-oss-process=image/format,webp/ignore-error,1"/><source data-testid="okd-image-source-media" media="(min-width: 1270px) and (max-width: 1859px)" srcSet="//www.okx.com/cdn/assets/plugins/announcements/contentful/tofttmniq0qv/4bxXejo6NUF9S7N0fdOrnW/fb3170fb0b87bec7900948e2ecbb91b5/web-asset_dropdown-my_trading_fees.png"/><source data-testid="okd-image-source-webp-media" media="(min-width: 1024px) and (max-width: 1269px)" srcSet="//www.okx.com/cdn/assets/plugins/announcements/contentful/tofttmniq0qv/4bxXejo6NUF9S7N0fdOrnW/fb3170fb0b87bec7900948e2ecbb91b5/web-asset_dropdown-my_trading_fees.png?x-oss-process=image/resize,w_976,type_6/format,webp/ignore-error,1"/><source data-testid="okd-image-source-media" media="(min-width: 1024px) and (max-width: 1269px)" srcSet="//www.okx.com/cdn/assets/plugins/announcements/contentful/tofttmniq0qv/4bxXejo6NUF9S7