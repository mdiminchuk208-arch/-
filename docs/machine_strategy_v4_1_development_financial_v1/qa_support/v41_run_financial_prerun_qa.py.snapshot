 rows.append({'command':command,'exit_code':result.returncode,'log':str(log.relative_to(r))})
 print(i,result.returncode,flush=True)
 if result.returncode:raise SystemExit(result.returncode)
receipt={'status':'PASS','scope':'PRE_FIRST_HISTORICAL_FINANCIAL_OUTCOME','commands':rows,'tested_sha256':{n:hashlib.sha256((r/n).read_bytes()).hexdigest() for n in new},'log_sha256':{c['log']:hashlib.sha256((r/c['log']).read_bytes()).hexdigest() for c in rows},'historical_financial_runs':0,'historical_outcomes_viewed':False,'trade_entry_allowed':False,'environment':{'PYTHONPATH':'scripts'},'frozen_implementation_manifest_sha256':'e18fa81383bac27af8524ad62703a894018c6b761241faa5015109efebcf0e61'}
