from pathlib import Path
import hashlib,json,subprocess,os,shutil
r=Path('/workspace/-');d=r/'docs/machine_strategy_v4_1_development_financial_v1';q=d/'qa';q.mkdir(exist_ok=True)
for n in ('v41_financial_tests_attempt1.log','v41_financial_tests_attempt2.log'):
 shutil.copyfile(Path('/tmp')/n,q/n)
