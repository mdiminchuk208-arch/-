commands=[[py,'-m','unittest','discover','-s','tests','-p','test_machine_strategy_v4_1*.py','-v'],['/workspace/crypto-bot-venv/bin/ruff','check',*new],['/workspace/crypto-bot-venv/bin/ruff','format','--check',*new],['/workspace/crypto-bot-venv/bin/mypy','--follow-imports=silent',*new[:2]],[py,'-m','py_compile',*new],[py,'scripts/verify_machine_strategy_v4_1_implementation_v1.py','--resume-existing','--expected-manifest-sha256','e18fa81383bac27af8524ad62703a894018c6b761241faa5015109efebcf0e61'],[py,'scripts/run_machine_strategy_v4_1_development_financial_v1.py','--verify-authorization']]
