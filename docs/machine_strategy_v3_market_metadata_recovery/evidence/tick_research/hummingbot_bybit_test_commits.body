.io","date":"2022-05-31T20:54:11Z"},"committer":{"name":"abel","email":"abel@hummingbot.io","date":"2022-05-31T20:54:11Z"},"message":"(feat) Fix all failing unit tests after refactoring to transfor client_config_map to Pydantic configuration\n\nSince all connectors have now a new parameter (the client config), all connectors' unit tests had to be updated to instantiate them passing the new configuration object.\nAdded a new ReadOnly configuration adapter to be used in the connectors, to ensure no connector will change the client configuration by mistake.","tree":{"sha":"e3a5f7b6414e69208df810318ceadc6304031d4e","url":"https://api.github.com/repos/hummingbot/hummingbot/git/trees/e3a5f7b6414e69208df810318ceadc6304031d4e"},"url":"https://api.github.com/repos/hummingbot/hummingbot/git/commits/a6e4da633016e38c49b701b064220ddfdf953507","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/hummingbot/hummingbot/commits/a6e4da633016e38c49b701b064220ddfdf953507","html_url":"https://github.com/hummingbot/hummingbot/commit/a6e4da633016e38c49b701b064220ddfdf953507","comments_url":"https://api.github.com/repos/hummingbot/hummingbot/commits/a6e4da633016e38c49b701b064220ddfdf953507/comments","author":null,"committer":null,"parents":[{"sha":"b8f042858681a430fd47d01735cea1bb8439a532","url":"https://api.github.com/repos/hummingbot/hummingbot/commits/b8f042858681a430fd47d01735cea1bb8439a532","html_url":"https://github.com/hummingbot/hummingbot/commit/b8f042858681a430fd47d01735cea1bb8439a532"}]},{"sha":"1cd0a7c6dcf92c7b4503c04a094ea55800fee349","node_id":"C_kwDOCq3P9NoAKDFjZDBhN2M2ZGNmOTJjN2I0NTAzYzA0YTA5NGVhNTU4MDBmZWUzNDk","commit":{"author":{"name":"abel","email":"abel@hummingbot.io","date":"2022-05-24T00:05:21Z"},"committer":{"name":"abel","email":"abel@hummingbot.io","date":"2022-05-24T00:05:21Z"},"message":"(refactor) Move NetworkMockingAssistant to the model modules, so that it can be included when generating the Hummingbot wheel file.\n\nIt is important that the assistant is part of the wheel file so that it can be used in any plugin repository created in the future (so that the plugin repository tests can be executed without having access to the full project code base).","tree":{"sha":"f1fdb5fd7b1b44546f74c35c258ec734e9a9e1ca","url":"https://api.github.com/repos/hummingbot/hummingbot/git/trees/f1fdb5fd7b1b44546f74c35c258ec734e9a9e1ca"},"url":"https://api.github.com/repos/hummingbot/hummingbot/git/commits/1cd0a7c6dcf92c7b4503c04a094ea55800fee349","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/hummingbot/hummingbot/commits/1cd0a7c6dcf92c7b4503c04a094ea55800fee349","html_url":"https://github.com/hummingbot/hummingbot/commit/1cd0a7c6dcf92c7b4503c04a094ea55800fee349","comments_url":"https://api.github.com/repos/hummingbot/hummingbot/commits/1cd0a7c6dcf92c7b4503c04a094ea55800fee349/comments","author":null,"committer":null,"parents":[{"sha":"eee491a36e3afa0bfb465d92244dbe63af7e123a","url":"https://api.github.com/repos/hummingbot/hummingbot/commits/eee491a36e3afa0bfb465d92244dbe63af7e123a","html_url":"https://github.com/hummingbot/hummingbot/commit/eee491a36e3afa0bfb465d92244dbe63af7e123a"}]},{"sha":"6a8f947ae7f850ed5b2865fb952c0f977d7984a6","node_id":"C_kwDOCq3P9NoAKDZhOGY5NDdhZTdmODUwZWQ1YjI4NjVmYjk1MmMwZjk3N2Q3OTg0YTY","commit":{"author":{"name":"Abel Armoa","email":"30988000+aarmoa@users.noreply.github.com","date":"2022-05-19T01:49:03Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2022-05-19T01:49:03Z"},"message":"Merge branch 'feat/gate_io_connector_update' into feat/update_okx_connector","tree":{"sha":"d51b6b25460497dab5c572f08bb147cceae30b29","url":"https://api.github.com/repos/hummingbot/hummingbot/git/trees/d51b6b25460497dab5c572f08bb147cceae30b29"},"url":"https://api.github.com/repos/hummingbot/humm