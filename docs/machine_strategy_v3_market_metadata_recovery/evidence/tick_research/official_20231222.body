 for any inconvenience this may cause."}],"uid":"e7929f720e1c4735866a4d771af8c713"}],"_version":1,"type":"doc","attrs":{}}},"locale":"en"},"recommendData":[],"articleUID":"blt35cb771098a20607","articleObjectID":"article.blt35cb771098a20607","theme":"light","hrefFrom":"normal","initialCategory":"latest_bybit_news","initialSearchKeyword":"","host":"announcements.bybit.com","canonical":"https://announcements.bybit.com/en/article/changes-to-tick-size-for-usdt-perpetual-contracts-dec-22-2023--blt35cb771098a20607/"},"__N_SSP":true},"page":"/article/[articleTitle]","query":{"articleTitle":"changes-to-tick-size-for-usdt-perpetual-contracts-dec-22-2023--blt35cb771098a20607"},"buildId":"pcvyqvMj_1H9F8Ifi5RVy","assetPrefix":"/static/announcements","isFallback":false,"gssp":true,"customServer":true,"appGip":true,"locale":"en","locales":["en","id-ID","es-ES","es-MX","es-AR","kk-KZ","fr-FR","pt-BR","pt-PT","ru-RU","vi-VN","uk-UA","ar-SA","ja-JP","zh-MY","zh-TW","my-MM","km-KH","en-GB","pl-PL","ro-RO","zh-HK","en-HK","tr-TUR","en-TR","ru-KAZ","kk-KAZ","en-KAZ","nl-NL","en-NL","en-EU","cs-EU","da-EU","de-EU","es-EU","el-EU","fr-EU","it-EU","lt-EU","hu-EU","nl-EU","no-EU","pl-EU","pt-EU","ro-EU","fi-EU","sv-EU","ka-GEO","ru-GEO","en-GEO","id-IDN","en-IDN","en-ARE","ar-ARE","en-USA","th-THA","en-THA","ja-JPN","en-JPN","en-US","es-419","zh-CN","pl-POL","ro-ROU","es-ESP","pt-PRT"],"defaultLocale":"en","scriptLoader":[]}</script><script src="/common-static/fhs/react.18.2.0.min-860f1d37ec17b010c94069b99a49ae7b.js"></script><script src="/common-static/cht-static/user-svc/file/gt4.js" async=""></script><script src="/common-static/cht-static/user-svc/file/gt.js" async=""></script><script src="/static/by-vendors/by-vendors.latest.js"></script><script src="/static/by-globals/by-globals.latest.js"></script><script>if (typeof window !== 'undefined' && window.ByGlobals) { window.ByGlobals.init({ navHeader: { skeleton: true, skeletonContainerId: "skeletonNavHeader", containerId: "navHeader" }, na