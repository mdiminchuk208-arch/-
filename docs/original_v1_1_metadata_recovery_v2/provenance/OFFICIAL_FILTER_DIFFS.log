+        <tr>
+            <td>>> minOrderQty</td><td>string</td><td>Min. trade quantity per order </td>
+        </tr>
+        <tr>
+            <td>>> qtyStep</td><td>string</td><td>Min. order quantity increment </td>
+        </tr>
+    </table>
